// Pia reference grammar (Lark, Earley).
//
// Executable form of the phrase grammar in docs/grammar.md. Terminals come
// from pia_lexer.py; see that file for the lexical rules, including the
// layout rule that inserts SEP between top-level items.

%declare LET REC META IN TYPE OF WHERE IF THEN ELSE MATCH WITH FOR SPREAD
%declare WHILE STEP SPEC LEMMA DO DONE REQUIRES ENSURES INVARIANT DECREASES ASSERT
%declare ASSUME FORALL EXISTS INTERFACE SIG MODULE STRUCT END IMPORT OPERATOR
%declare ADAPTER HANDLE DEFER QUESTION AS THEORY SORT AXIOM MODEL
%declare TRUE FALSE BORROWED MOVED OUT INOUT FIXED MUTABLE
%declare IDENT INT FLOAT STRING QIDENT SPLICE_IDENT SPLICE_OPEN QUOTE_OPEN
%declare ATTR ATTR_OPEN TARGS_OPEN TARGS_CLOSE LBRACE_ADJ HOLE
%declare LPAREN RPAREN LBRACKET RBRACKET LBRACE RBRACE DOT_LBRACKET
%declare COMMA COLON SEMI SEP DOT QDOT DOTDOT
%declare ARROW FATARROW LARROW EQ BAR OP_IMP OP_OR OP_AND OP_CMP OP_ADD OP_MUL
%declare OP_SHIFT OP_BXOR OP_BAND OP_TILDE

// ---------------------------------------------------------------- program

start: program

program: SEP? ((module_header | item) (SEP item)*)? SEP?

// The first item of a file may be its module header (ADR 0039).
module_header: MODULE path attribute* (COLON path (COMMA path)*)?

?item: let_item
     | meta_operator
     | interface_item
     | adapter_item
     | theory_item
     | model_item
     | file_attr
     | module_item
     | import_item
     | expr_item

// A bare top-level expression runs at compile time and must yield items,
// e.g. `tiled_matmul `sgemm_4x16 f32 4 16 64 4`.
expr_item: app

import_item: IMPORT path
path: IDENT (DOT IDENT)*

// ---------------------------------------------------------------- bindings

let_item: LET REC? (SPEC | LEMMA)? META? binder param* ret_annot? contract* EQ handled

binder: IDENT | SPLICE_IDENT

param: IDENT                              -> param_bare
     | SPLICE_IDENT                       -> param_bare
     | LPAREN IDENT COLON annot RPAREN    -> param_typed
     | LPAREN SPLICE_IDENT COLON annot RPAREN -> param_typed
     | LPAREN RPAREN                      -> param_unit
     | LPAREN HOLE RPAREN                 -> param_hole

ret_annot: COLON annot attribute*
         | attribute+

contract: REQUIRES stmt          -> requires
        | ENSURES stmt           -> ensures
        | DECREASES stmt         -> decreases
        | REQUIRES clause_eq     -> requires
        | ENSURES clause_eq      -> ensures

// Longest predicate rule: when a clause predicate could end either before or
// after a top-level `=`, the predicate takes the `=` and the next `=` starts
// the body. So `ensures total x = old (total x) = body` reads as
// `ensures (total x = old (total x))` followed by the body.
clause_eq.2: range_e EQ (range_e | quantifier) -> binop

// `let meta operator ( + ) : prec 6 left = ...`
// `let meta operator ( + ) for vec<T, k> = ...`
meta_operator: LET META OPERATOR LPAREN operator RPAREN fixity? (FOR type)? EQ seq
fixity: COLON IDENT (INT | FLOAT) IDENT  // prec <level> left|right|none

?operator: OP_IMP | OP_OR | OP_AND | OP_CMP | OP_ADD | OP_MUL | EQ

// ---------------------------------------------------------------- annotations and types

// A parameter or binding annotation: modifiers, a type, an optional predicate.
// Modifiers before a function type belong to its first parameter, so
// `borrowed in [u8] -> [pixel]` takes a borrowed input slice.
annot: modifiers union_type (WHERE stmt)?
     | arrow (WHERE stmt)?

modifiers: ownership? access? mutability?
ownership: BORROWED | MOVED
access: IN | OUT | INOUT
mutability: FIXED | MUTABLE

?type: arrow_type

?arrow_type: arrow
           | union_type
arrow: arrow_dom ARROW arrow_type

arrow_dom: modifiers union_type
         | LPAREN IDENT COLON annot RPAREN   -> named_dom

?union_type: app_type (BAR app_type)+ -> union
           | app_type

?app_type: type_atom type_arg+ -> type_app
         | type_atom

?type_arg: type_atom
         | INT
         | LPAREN expr RPAREN

type_atom: IDENT (DOT IDENT)*                         -> type_name
         | TYPE                                      -> type_kind
         | IDENT TARGS_OPEN targs TARGS_CLOSE        -> type_inst
         | IDENT LBRACE_ADJ add_e DOTDOT add_e RBRACE -> range_type
         | LBRACKET type RBRACKET                    -> slice_type
         | LBRACKET type SEMI expr RBRACKET          -> array_type
         | LBRACE field_decls RBRACE                 -> record_type
         | LBRACE IDENT COLON type BAR stmt RBRACE   -> refinement_type
         | LPAREN type RPAREN
         | LPAREN RPAREN                             -> unit_type
         | SPLICE_IDENT                              -> splice
         | SPLICE_OPEN expr RPAREN                   -> splice

targs: targ (COMMA targ)*
targ: type
    | elem
    | named_targ
// `halo = 1` in a type argument list is a named argument, not a comparison.
named_targ.2: IDENT EQ elem

field_decls: field_decl (SEMI field_decl)* SEMI?
field_decl: IDENT COLON annot

// A type value: `type | A | B of t`, `type { ... } where p`, `type t @fp(reassoc)`.
type_value: TYPE type_body attribute* (WHERE stmt)? attribute*
?type_body: variants | type
variants: (BAR ctor)+
ctor: IDENT (OF app_type)?

attribute: ATTR
         | ATTR_OPEN attr_args? RPAREN
attr_args: attr_arg (COMMA attr_arg)*
attr_arg: stmt
        | named_attr_arg
named_attr_arg.2: IDENT EQ stmt

// ---------------------------------------------------------------- expressions

?expr: seq

// Constructs that extend as far right as possible sit at the sequence level.
?seq: stmt SEMI seq -> sequence
    | stmt SEMI     -> sequence
    | stmt
    | let_in
    | match_e
    | lambda

let_in: LET REC? binder param* ret_annot? contract* EQ handled IN seq

// `body handle | p -> e ...` (ADR 0028) ends a function body, a `let`
// value, a parenthesised expression or a loop body.
?handled: seq
        | seq HANDLE arms -> handle

lambda: LET lparam+ FATARROW seq
// Inside lists, records and argument lists `;` and `,` separate elements, so
// a function literal there has a body without top-level sequencing.
?elem: stmt
     | LET lparam+ FATARROW elem -> lambda

lparam: LPAREN pattern (COLON annot)? RPAREN
      | LPAREN RPAREN -> lparam_unit

match_e: MATCH seq WITH arms
arms: BAR? arm (BAR arm)*
arm: pattern arm_contract* ARROW seq
arm_contract: REQUIRES stmt -> requires
            | ENSURES stmt  -> ensures

?stmt: assign
     | if_e
     | for_e
     | spread_e
     | while_e
     | quantifier
     | ASSERT imp_e  -> assert_e
     | ASSUME imp_e  -> assume_e
     | DEFER imp_e   -> defer_e
     | type_value
     | sig_value
     | imp_e

assign: postfix LARROW stmt

if_e: IF seq THEN stmt (ELSE stmt)?

for_e: FOR pattern IN or_e (STEP add_e)? loop_annot* DO handled DONE
spread_e: SPREAD pattern IN or_e attribute* loop_annot* DO handled DONE
while_e: WHILE seq loop_annot* DO handled DONE
loop_annot: INVARIANT stmt   -> invariant
          | DECREASES stmt   -> decreases

quantifier: (FORALL | EXISTS) binders QDOT stmt
binders: qbinder+
qbinder: IDENT (COLON type)?                       -> qbinder_typed
       | IDENT IN range_e                          -> qbinder_range
       | LPAREN IDENT COLON type RPAREN            -> qbinder_typed
       | LPAREN IDENT IN range_e RPAREN            -> qbinder_range

// Binary operators, loosest first. Levels match the bootstrap table:
// ==> 1 right, || 2 right, && 3 right, comparisons 4 none, .. 5 none,
// << >> 5.5 left, + 6 left, ^ 6.4 left, & 6.5 left, * 7 left. Bitwise `|`
// (6.3, only inside brackets) is left out: telling it from the `|` of match
// arms needs the C++ parser's context flag, which this grammar does not model.
// A quantifier may be the right operand of a logical operator or comparison
// (`p ==> forall i. q i`); its body then extends as far right as possible.
?imp_e: or_e OP_IMP (imp_e | quantifier) -> binop
      | or_e
?or_e: and_e OP_OR (or_e | quantifier) -> binop
     | and_e
?and_e: cmp_e OP_AND (and_e | quantifier) -> binop
      | cmp_e
?cmp_e: range_e (OP_CMP | EQ) (range_e | quantifier) -> binop
      | range_e
?range_e: shift_e DOTDOT shift_e -> range
        | shift_e
?shift_e: shift_e OP_SHIFT add_e -> binop
        | add_e
?add_e: add_e OP_ADD bxor_e -> binop
      | bxor_e
?bxor_e: bxor_e OP_BXOR band_e -> binop
       | band_e
?band_e: band_e OP_BAND mul_e -> binop
       | mul_e
?mul_e: mul_e OP_MUL unary -> binop
      | unary
?unary: OP_ADD unary -> neg
      | OP_TILDE unary -> bnot
      | app

// `e?` (ADR 0028) applies to the whole application.
?app: app QUESTION         -> try_e
    | postfix postfix+     -> apply
    | postfix

?postfix: postfix DOT IDENT                      -> field
        | postfix DOT SPLICE_IDENT               -> field
        | postfix DOT_LBRACKET seq RBRACKET      -> index
        | postfix TARGS_OPEN targs TARGS_CLOSE   -> instantiate
        | atom

?atom: IDENT                                   -> name
     | INT                                     -> int_lit
     | FLOAT                                   -> float_lit
     | STRING                                  -> string_lit
     | TRUE                                    -> bool_lit
     | FALSE                                   -> bool_lit
     | QIDENT                                  -> quoted_ident
     | HOLE                                    -> hole
     | LPAREN handled RPAREN
     | LPAREN RPAREN                           -> unit
     | LPAREN operator RPAREN                  -> operator_value
     | LBRACKET (elem (SEMI elem)* SEMI?)? RBRACKET        -> list_lit
     | lbrace field_inits RBRACE               -> record_lit
     | lbrace postfix WITH field_inits RBRACE  -> record_update
     | QUOTE_OPEN quoted RPAREN                -> quote
     | SPLICE_IDENT                            -> splice
     | SPLICE_OPEN seq RPAREN                  -> splice

lbrace: LBRACE | LBRACE_ADJ
field_inits: field_init (SEMI field_init)* SEMI?
field_init: IDENT EQ elem

// Quoted syntax: items, a declaration (`add : $t -> $t -> $t`), or an expression.
?quoted: quoted_items
       | IDENT COLON type -> quoted_decl
       | seq
quoted_items: (let_item | meta_operator) (SEP? (let_item | meta_operator))*

// ---------------------------------------------------------------- patterns

?pattern: pattern_core
        | pattern_core AS IDENT -> as_pattern
?pattern_core: IDENT pattern_atom+ -> ctor_pattern
             | pattern_atom

?pattern_atom: IDENT                         -> pvar
             | INT                           -> plit
             | STRING                        -> plit
             | TRUE                          -> plit
             | FALSE                         -> plit
             | SPLICE_IDENT                  -> psplice
             | LPAREN pattern COLON type RPAREN -> ptyped
             | LPAREN pattern RPAREN
             | LPAREN RPAREN                 -> punit
             | LBRACE pfields RBRACE         -> precord
             | LBRACKET pattern RBRACKET     -> pslice
             | LBRACKET pattern SEMI pattern RBRACKET -> parray
pfields: pfield (SEMI pfield)* SEMI?
pfield: IDENT (EQ pattern)?

// ---------------------------------------------------------------- modules

interface_item: INTERFACE IDENT attribute* EQ SIG sig_item* END
sig_item: LET binder COLON annot ret_attrs contract*   -> sig_val
        | LET binder EQ type_value                     -> sig_type
        | HOLE                                         -> sig_hole

// A concept's body (ADR 0034): a signature that may also include another
// concept and state laws. `include` is a contextual word.
sig_value: SIG concept_item* END
concept_item: sig_item
            | IDENT type                                 -> sig_include  // `include`
            | LET LEMMA IDENT param* contract*         -> sig_lemma
ret_attrs: attribute*

// `let theory T = sig ... end` (ADR 0036): sorts, abstract spec functions
// (no body), spec functions, axioms (no body) and lemmas.
theory_item: LET THEORY IDENT EQ SIG theory_member* END
theory_member: LET SORT IDENT (EQ type)?                      -> sort_decl
             | LET SPEC binder COLON annot attribute*         -> abstract_spec
             | LET AXIOM IDENT param* ret_annot? contract+    -> axiom
             | let_item
// `let model m : T = struct ... end` (ADR 0036): a type for each sort and a
// spec function for each abstract function.
model_item: LET MODEL IDENT COLON IDENT EQ STRUCT model_member* END
model_member: LET SORT IDENT EQ type                          -> model_sort
            | let_item
// `@trusted` on a line of its own marks the file (ADR 0036).
file_attr: ATTR

// `let adapter name : C t = struct ... end` (ADR 0034).
adapter_item: LET ADAPTER IDENT COLON type EQ STRUCT struct_body END

module_item: MODULE IDENT (COLON path (COMMA path)*)? EQ STRUCT struct_body END
struct_body: item*

// ---------------------------------------------------------------- fragments

// Used by tests for snippets that are not whole programs.
contract_fragment: contract+
