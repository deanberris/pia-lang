#!/bin/sh
# Installs or updates the prebuilt pia, piac and pia-lsp from the moving
# `latest` GitHub prerelease that CI publishes from main (.github/workflows/ci.yml,
# job publish-latest), so nobody has to build LLVM, MLIR and Z3 to use them.
#
#   pia-update            download and install if the release changed
#   pia-update --check    say whether an update is waiting; exit 1 if so
#   pia-update --quiet    print nothing unless something changed or failed
#   pia-update --force    reinstall even if it looks current
#
# Binaries go to $PIA_PREFIX (default ~/.local/pia) and are linked from
# $PIA_BIN (default ~/.local/bin), which must be on PATH: the Claude Code
# plugin runs `pia mcp` and `pia-lsp` from PATH. Each binary is removed and
# then moved in, never copied over: overwriting a signed macOS binary in place
# gets it killed on its next launch. Nothing is backed up.
#
# The installed tarball's SHA-256 is kept in $PIA_PREFIX/.pia-update; the
# plugin's SessionStart hook (hooks/hooks.json) updates in the background only
# when that file exists, so a prefix linked to bazel-bin is never touched.
set -eu

repo="${PIA_REPO:-deanberris/pia-lang}"
prefix="${PIA_PREFIX:-$HOME/.local/pia}"
bin="${PIA_BIN:-$HOME/.local/bin}"
base="https://github.com/$repo/releases/download/latest"
mode=install
quiet=0
force=0
for arg in "$@"; do
  case "$arg" in
    --check) mode=check ;;
    --quiet) quiet=1 ;;
    --force) force=1 ;;
    -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "pia-update: unknown argument $arg" >&2; exit 2 ;;
  esac
done

say() { [ "$quiet" = 1 ] || echo "$@"; }

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) asset=pia-macos-arm64.tar.gz ;;
  Linux-x86_64) asset=pia-linux-x86_64.tar.gz ;;
  *) echo "pia-update: no prebuilt binaries for $(uname -s) $(uname -m); build from source" >&2; exit 2 ;;
esac

if command -v shasum >/dev/null 2>&1; then sha() { shasum -a 256 "$1" | cut -d' ' -f1; }
else sha() { sha256sum "$1" | cut -d' ' -f1; }; fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/pia-update.XXXXXX")
trap 'rm -rf "$tmp"' EXIT INT TERM

curl -fsSL --retry 3 -o "$tmp/SHA256SUMS.txt" "$base/SHA256SUMS.txt"
want=$(awk -v a="$asset" '$2 == a || $2 == "*" a { print $1 }' "$tmp/SHA256SUMS.txt")
[ -n "$want" ] || { echo "pia-update: $asset is not in the latest release" >&2; exit 1; }
have=$(cat "$prefix/.pia-update" 2>/dev/null || true)

if [ "$mode" = check ]; then
  if [ "$have" = "$want" ]; then say "pia-update: up to date"; exit 0; fi
  say "pia-update: an update is waiting (run pia-update)"; exit 1
fi

if [ "$have" = "$want" ] && [ "$force" = 0 ]; then
  say "pia-update: up to date ($prefix)"; exit 0
fi

# One update at a time: a second session that starts while the first is
# downloading leaves it to finish.
mkdir -p "$prefix" "$bin"
lock="$prefix/.pia-update.lock"
# A lock left by an update that was killed is given up after half an hour.
find "$lock" -maxdepth 0 -mmin +30 -exec rm -rf {} \; 2>/dev/null || true
if ! mkdir "$lock" 2>/dev/null; then say "pia-update: another update is running"; exit 0; fi
trap 'rm -rf "$tmp" "$lock"' EXIT INT TERM

curl -fsSL --retry 3 -o "$tmp/$asset" "$base/$asset"
got=$(sha "$tmp/$asset")
[ "$got" = "$want" ] || { echo "pia-update: checksum mismatch for $asset" >&2; exit 1; }
mkdir "$tmp/x"
tar -xzf "$tmp/$asset" -C "$tmp/x"

installed=""
for b in pia piac pia-lsp; do
  [ -f "$tmp/x/$b" ] || continue
  chmod 755 "$tmp/x/$b"
  rm -f "$prefix/$b"
  mv "$tmp/x/$b" "$prefix/$b"
  ln -sf "$prefix/$b" "$bin/$b"
  installed="$installed $b"
done
echo "$want" > "$prefix/.pia-update"
echo "pia-update: installed$installed from the latest build of $repo into $prefix"
