load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "piac",
    srcs = ["piac.cpp"],
    # MLIR's generated headers trip -Wunused-parameter.
    copts = [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/codegen",
        "//src/irgen",
        "//src/syntax",
        "//src/verify",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
    ],
)
