load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools:copts.bzl", "PIA_MLIR_COPTS")
load("//tools:link.bzl", "TOOL_LINKOPTS")

cc_binary(
    name = "piac",
    srcs = ["piac.cpp"],
    copts = PIA_MLIR_COPTS,
    linkopts = TOOL_LINKOPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//src/cert",
        "//src/codegen",
        "//src/dialect",
        "//src/gpu",
        "//src/irgen",
        "//src/meta",
        "//src/migrate",
        "//src/syntax",
        "//src/verify",
        "//src/version",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Parser",
    ],
)

# The platforms piac compiles for (tools/piac/targets.bzl, ADR 0049).
config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)
