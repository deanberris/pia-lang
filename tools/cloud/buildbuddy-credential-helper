#!/bin/sh
# Bazel credential helper for BuildBuddy (--config=cloud in .bazelrc).
#
# Cloud sessions keep the API key in the BUILDBUDDY_API_KEY environment
# variable of their environment, never in a file, so this hands it to Bazel as
# the x-buildbuddy-api-key header for remote.buildbuddy.io. Bazel runs it as
# `buildbuddy-credential-helper get` with the request URI as JSON on stdin,
# which it does not need: the key is the same for every BuildBuddy call.
set -eu

if [ "${1:-}" != "get" ]; then
  echo "usage: $0 get" >&2
  exit 1
fi
cat >/dev/null

if [ -z "${BUILDBUDDY_API_KEY:-}" ]; then
  # Without a key BuildBuddy answers UNAUTHENTICATED, which is clearer than a
  # failing helper: say once why, and send no headers.
  echo "BUILDBUDDY_API_KEY is not set; see tools/cloud/README.md" >&2
  echo '{"headers":{}}'
  exit 0
fi

printf '{"headers":{"x-buildbuddy-api-key":["%s"]}}\n' "$BUILDBUDDY_API_KEY"
