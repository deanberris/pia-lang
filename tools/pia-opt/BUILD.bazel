load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools:copts.bzl", "PIA_MLIR_COPTS")
load("//tools:link.bzl", "TOOL_LINKOPTS")

# mlir-opt for Pia. M0 registers the upstream dialects Pia lowers through;
# Pia's own dialects: pia, pia_contract and pia_par (M3).
cc_binary(
    name = "pia-opt",
    srcs = ["pia-opt.cpp"],
    copts = PIA_MLIR_COPTS,
    linkopts = TOOL_LINKOPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//src/dialect",
        "//src/gpu",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:ArmNeonDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:LLVMDialect",
        "@llvm-project//mlir:MemRefDialect",
        "@llvm-project//mlir:MlirOptLib",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:SMTDialect",
        "@llvm-project//mlir:Transforms",
        "@llvm-project//mlir:VectorDialect",
    ],
)
