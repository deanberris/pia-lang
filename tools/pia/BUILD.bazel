load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//tools:link.bzl", "TOOL_LINKOPTS")

# `pia repl`: the interactive, verified REPL (docs/repl.md).
cc_binary(
    name = "pia",
    linkopts = TOOL_LINKOPTS,
    srcs = ["pia.cpp"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/lsp",
        "//src/repl",
        "//src/repl:line_editor",
    ],
)
