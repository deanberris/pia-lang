(* WIP, not built: the Kraft lemma for Pia.Compress.Huffman, `kraft l n <= 32768 ==> room l n 1`.
   Paste above `u16at` in lib/Pia/Compress/Huffman.pia to prove. Round 2: 121 of 129 goals;
   see README.md. *)

(* The Kraft sum by length: the first k lengths' codes of lengths 1 to b,
   each count times its weight. *)
let spec ksum (l : [u8]) (k : int{0..320}) (b : int{0..15}) : int
  requires k <= len l
  ensures 0 <= result
  decreases b
= if b = 0 then 0
  else (let b' : int{0..14} = b - 1 in let bb : int{1..15} = b in
    ksum l k b' + int (len_count l k bb) * int (weight bb))

(* One more length moves ksum by its weight, when it is 1 to b. *)
let lemma ks_step (l : [u8]) (k : int{0..319}) (b : int{0..15}) : unit
  requires k < len l
  ensures ksum l (k + 1) b = ksum l k b + (if 1 <= l.[k] && l.[k] <= b then int (weight l.[k]) else 0)
  decreases b
= if b > 0 then (
    let b' : int{0..14} = b - 1 in
    let bb : int{1..15} = b in
    ks_step l k b';
    let k1 : int{1..320} = k + 1 in
    assert len_count l k1 bb = len_count l k bb + (if l.[k] = bb then 1 else 0);
    assert int (len_count l k1 bb) * int (weight bb) = int (len_count l k bb) * int (weight bb) + (if l.[k] = bb then int (weight bb) else 0))
  else ()

(* The sum by length is at most the Kraft sum, which counts lengths over
   15 too. *)
let lemma ks_kraft (l : [u8]) (k : int{0..320}) : unit
  requires k <= len l
  ensures ksum l k 15 <= int (kraft l k)
  decreases k
  with kraft
= if k > 0 then (
    let k' : int{0..319} = k - 1 in
    ks_kraft l k';
    ks_step l k' 15;
    assert int (kraft l k) = int (kraft l k') + int (weight l.[k']))
  else ()

(* ksum grows with b. *)
let lemma ks_mono (l : [u8]) (n : int{0..320}) (b : int{0..15}) : unit
  requires n <= len l
  ensures ksum l n b <= ksum l n 15
  decreases 15 - b
= if b < 15 then (let b1 : int{1..15} = b + 1 in ks_mono l n b1) else ()

(* first_code, scaled by its weight, is the sum by length below it. *)
let lemma fc_scaled (l : [u8]) (n : int{0..320}) (b : int{1..15}) : unit
  requires n <= len l
  ensures int (first_code l n b) * int (weight b) = ksum l n (b - 1)
  decreases b
= if b > 1 then (
    let b' : int{1..14} = b - 1 in
    fc_scaled l n b';
    assert int (weight b') = 2 * int (weight b);
    assert int (first_code l n b) = 2 * (int (first_code l n b') + int (len_count l n b'));
    assert int (first_code l n b) * int (weight b) = (int (first_code l n b') + int (len_count l n b')) * int (weight b');
    assert ksum l n b' = ksum l n (b' - 1) + int (len_count l n b') * int (weight b'))
  else ()

(* Within the Kraft bound, the codes of length b fit below 2^b. *)
let lemma room_at (l : [u8]) (n : int{0..320}) (b : int{1..15}) : unit
  requires n <= len l && kraft l n <= 32768
  ensures first_code l n b + len_count l n b <= B.pow2 b
= fc_scaled l n b;
  ks_mono l n b;
  ks_kraft l n;
  assert (int (first_code l n b) + int (len_count l n b)) * int (weight b) = ksum l n b;
  assert ksum l n b <= 32768;
  if b = 1 then assert first_code l n b + len_count l n b <= 2
  else if b = 2 then assert first_code l n b + len_count l n b <= 4
  else if b = 3 then assert first_code l n b + len_count l n b <= 8
  else if b = 4 then assert first_code l n b + len_count l n b <= 16
  else if b = 5 then assert first_code l n b + len_count l n b <= 32
  else if b = 6 then assert first_code l n b + len_count l n b <= 64
  else if b = 7 then assert first_code l n b + len_count l n b <= 128
  else if b = 8 then assert first_code l n b + len_count l n b <= 256
  else if b = 9 then assert first_code l n b + len_count l n b <= 512
  else if b = 10 then assert first_code l n b + len_count l n b <= 1024
  else if b = 11 then assert first_code l n b + len_count l n b <= 2048
  else if b = 12 then assert first_code l n b + len_count l n b <= 4096
  else if b = 13 then assert first_code l n b + len_count l n b <= 8192
  else if b = 14 then assert first_code l n b + len_count l n b <= 16384
  else assert first_code l n b + len_count l n b <= 32768

(* A code within the Kraft bound has room at every length from b up. *)
let lemma kraft_room (l : [u8]) (n : int{0..320}) (b : int{1..16}) : unit
  requires n <= len l && kraft l n <= 32768
  ensures room l n b
  decreases 16 - b
  with room
= if b < 16 then (
    let bb : int{1..15} = b in
    room_at l n bb;
    let b1 : int{1..16} = b + 1 in
    kraft_room l n b1)
  else ()

