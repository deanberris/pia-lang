{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pia",
  "scopeName": "source.pia",
  "fileTypes": ["pia"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#let" },
    { "include": "#keywords" },
    { "include": "#attribute" },
    { "include": "#quote" },
    { "include": "#number" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "include": "#comment-doc" },
        { "include": "#comment-block" },
        { "include": "#comment-line" }
      ]
    },
    "comment-doc": {
      "begin": "\\(\\*\\*(?![*)])",
      "end": "\\*\\)",
      "name": "comment.block.documentation.pia",
      "patterns": [{ "include": "#comment-block" }]
    },
    "comment-block": {
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "name": "comment.block.pia",
      "patterns": [{ "include": "#comment-block" }]
    },
    "comment-line": {
      "match": "\\\\.*$",
      "name": "comment.line.backslash.pia"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.pia",
      "patterns": [
        { "match": "\\\\(?:[\\\\\"nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})", "name": "constant.character.escape.pia" }
      ]
    },
    "let": {
      "match": "\\b(let)\\s+(?:(rec)\\s+)?(?:(meta)\\s+)?(?:(operator)\\b|([A-Za-z_][A-Za-z0-9_']*))",
      "captures": {
        "1": { "name": "keyword.declaration.pia" },
        "2": { "name": "keyword.declaration.pia" },
        "3": { "name": "keyword.declaration.pia" },
        "4": { "name": "keyword.declaration.pia" },
        "5": { "name": "entity.name.function.pia" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(requires|ensures|invariant|decreases|assert|assume|forall|exists)\\b",
          "name": "keyword.other.contract.pia"
        },
        {
          "match": "\\b(if|then|else|match|with|for|spread|while|do|done|step|in|where|of|handle|defer|as)\\b",
          "name": "keyword.control.pia"
        },
        {
          "match": "\\b(let|rec|meta|type|interface|sig|module|struct|end|import|operator)\\b",
          "name": "keyword.declaration.pia"
        },
        {
          "match": "\\b(borrowed|moved|out|inout|fixed|mutable)\\b",
          "name": "storage.modifier.pia"
        },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.pia" },
        { "match": "\\b(result|old|len|mod)\\b", "name": "support.function.builtin.pia" }
      ]
    },
    "attribute": {
      "match": "@[A-Za-z_][A-Za-z0-9_']*",
      "name": "entity.other.attribute-name.pia"
    },
    "quote": {
      "patterns": [
        { "match": "`(?=\\()", "name": "keyword.operator.quote.pia" },
        { "match": "`[A-Za-z_][A-Za-z0-9_']*", "name": "constant.other.symbol.pia" },
        { "match": "\\$[A-Za-z_][A-Za-z0-9_']*|\\$(?=\\()", "name": "variable.other.splice.pia" }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b[0-9][0-9_]*(?:'[0-9][0-9_]*)*\\.[0-9][0-9_]*(?:'[0-9][0-9_]*)*(?:[eE][+-]?[0-9]+)?(?:f(?:32|64))?\\b|\\b[0-9][0-9_]*(?:'[0-9][0-9_]*)*[eE][+-]?[0-9]+(?:f(?:32|64))?\\b",
          "name": "constant.numeric.float.pia"
        },
        {
          "match": "\\b(?:0x[0-9A-Fa-f_]+(?:'[0-9A-Fa-f_]+)*|0o[0-7_]+(?:'[0-7_]+)*|0b[01_]+(?:'[01_]+)*|[0-9][0-9_]*(?:'[0-9_]+)*)(?:[ui](?:8|16|32|64|128)|usize|isize|f(?:32|64))?\\b",
          "name": "constant.numeric.integer.pia"
        }
      ]
    },
    "types": {
      "match": "\\b(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|usize|isize|f32|f64|bool|unit|int|vec|dyn|concept|adapter|item|ident)\\b",
      "name": "support.type.pia"
    },
    "operators": {
      "patterns": [
        { "match": "=>|->|<-|==>|\\.\\.|\\.\\[", "name": "keyword.operator.pia" },
        { "match": "[-+*/%<>=!&|^~.:?]+", "name": "keyword.operator.pia" }
      ]
    }
  }
}
