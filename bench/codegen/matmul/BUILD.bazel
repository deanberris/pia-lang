    name = "matmul",
    c = "//third_party/benchmarks/plb2:matmul.c",
    check_args = ["7"],
    driver = "main.c",
    expected = "-0.501458",
    pia = "matmul.pia",
    rust = "//third_party/benchmarks/plb2:matmul_rs",
    zig = "//third_party/benchmarks/plb2:matmul_zig",
)
