# Shared settings, following llvm-project's utils/bazel/.bazelrc where LLVM
# needs them.

common --enable_platform_specific_config
common --incompatible_disallow_empty_glob
common --@rules_python//python/config_settings:bootstrap_impl=script

build --dynamic_mode=off
build --strip=never
build --incompatible_no_implicit_file_export

# C++17 is what LLVM builds with; Pia's own code uses the same.
build --cxxopt=-std=c++17 --host_cxxopt=-std=c++17

build:linux --force_pic
# Z3 5.4.1 uses C++20 std::format, which Apple libc++ gates on macOS 13.3.
build:macos --macos_minimum_os=13.3 --host_macos_minimum_os=13.3

# Keep LLVM's warnings quiet; Pia's own targets turn warnings back on, and
# every Pia C/C++ source treats warnings as errors.
build --per_file_copt=external/.*@-w
build --host_per_file_copt=external/.*@-w
build --per_file_copt=^(src|tools|tests|examples)/.*@-Werror
build --host_per_file_copt=^(src|tools|tests|examples)/.*@-Werror

# Building LLVM/MLIR is slow the first time. A disk cache makes clean builds
# and branch switches cheap.
build --disk_cache=~/.cache/pia-bazel-disk
# Without a cap the disk cache grows with every worktree and branch (it
# reached 249 GB on the iMac). Bazel trims it to this size when idle.
build --experimental_disk_cache_gc_max_size=50G

test --test_output=errors

# CI logs: no progress bar, and a progress line at most once a minute.
common:ci --curses=no --show_progress_rate_limit=60

# Release builds: optimised, with ThinLTO across Pia, LLVM, MLIR and Z3,
# for the targets and for the tools Bazel runs (piac in pia_object). The
# first build compiles everything again as LLVM bitcode, so day-to-day work
# stays on the default fastbuild, and --config=lto is for releases and the
# build-time benchmark.
build:lto -c opt
build:lto --copt=-flto=thin --linkopt=-flto=thin
build:lto --host_copt=-flto=thin --host_linkopt=-flto=thin

# Stamped builds: piac's version from git (src/version, ADR 0073), for the
# binaries CI publishes. Only those are stamped, since a stamped piac
# changes with every commit and so would every test that runs it.
build:release --stamp
build:release --workspace_status_command=src/version/workspace_status.sh

# Split DWARF (fission): on ELF, debug info goes to .dwo files beside the
# objects, so links stay small and fast. Mach-O already works this way: ld64
# never copies DWARF into the binary, which only points at the objects (or a
# .dSYM made by dsymutil), so macOS needs no flag.
build:linux --fission=dbg,fastbuild

# BuildBuddy remote cache and build results UI (app.buildbuddy.io). The API
# key never goes in the repo: CI writes it to user.bazelrc from the
# BUILDBUDDY_API_KEY secret together with --config=buildbuddy, and a local
# user.bazelrc can do the same. Cache entries are per platform, so macOS and
# Linux jobs each fill their own.
common:buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
common:buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_timeout=10m
common:buildbuddy --remote_cache_compression
# Upload only what a later build can use, and keep CI from downloading every
# LLVM object file: the free plan's 100 GB of monthly transfer is the limit
# to watch.
common:buildbuddy --remote_build_event_upload=minimal
common:buildbuddy --remote_download_toplevel

# BuildBuddy remote execution: Linux x86_64 builds and tests on BuildBuddy's
# executors (Ubuntu 24.04, Clang 19 via toolchains_llvm), for CI's Linux job.
# Needs the API key, as --config=buildbuddy does. macOS builds cannot use it:
# BuildBuddy's cloud executors are Linux only.
common:rbe --config=buildbuddy
common:rbe --remote_executor=grpcs://remote.buildbuddy.io
common:rbe --platforms=@toolchains_buildbuddy//platforms:linux_x86_64
common:rbe --extra_execution_platforms=@toolchains_buildbuddy//platforms:linux_x86_64
common:rbe --extra_toolchains=@llvm_rbe//:cc-toolchain-x86_64-linux
# The longest actions are LLVM links and proof tests, under 15 minutes.
common:rbe --remote_timeout=1h
# Actions run remotely, so many at once; --local_resources still limits what
# runs on the machine itself.
common:rbe --jobs=100
# The Linux settings, whatever the host.
build:rbe --config=linux

# Claude Code cloud sessions (docs/cloud.md): remote execution as CI's Linux
# job, since the container's 4 cores cannot build LLVM in a session. The API
# key is the environment's BUILDBUDDY_API_KEY variable, which the credential
# helper hands to Bazel, so it is never written to a file. The egress proxy
# refuses github.com source archives of repositories outside the session, so
# BuildBuddy downloads external archives (Remote Asset API) and caches them.
# tools/cloud/setup.sh turns this on in user.bazelrc.
common:cloud --config=rbe
common:cloud --credential_helper=remote.buildbuddy.io=%workspace%/tools/cloud/buildbuddy-credential-helper
common:cloud --experimental_remote_downloader=grpcs://remote.buildbuddy.io
common:cloud --build_metadata=ROLE=CLOUD
# Bazel's build event upload does not use credential helpers, so cloud
# builds send no results to BuildBuddy's UI; logs stay in the session.
common:cloud --bes_backend= --bes_results_url=

# Local overrides (remote caches, jobs) go in user.bazelrc, which is ignored.
try-import %workspace%/user.bazelrc
