load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools:copts.bzl", "PIA_COPTS", "PIA_MLIR_COPTS")

# The GPU path's lowering to SPIR-V (ADR 0068, step 1): upstream MLIR's gpu
# and spirv dialects and conversions, linked into piac and pia-opt.
# SPIR-V to MSL by SPIRV-Cross, which reports errors by exceptions, so this
# library alone is built with them.
cc_library(
    name = "msl",
    srcs = ["Msl.cpp"],
    hdrs = ["Msl.h"],
    copts = PIA_COPTS + ["-fexceptions"],
    strip_include_prefix = "/src",
    deps = ["@spirv_cross"],
)

# Spreads placed on the GPU (ADR 0068, step 3) are outlined, lowered and
# compiled to a .metallib here, while piac runs.
cc_library(
    name = "gpu",
    srcs = [
        "Place.cpp",
        "Spirv.cpp",
    ],
    hdrs = [
        "Place.h",
        "Spirv.h",
    ],
    copts = PIA_MLIR_COPTS,
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = [
        ":msl",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:GPUDialect",
        "@llvm-project//mlir:GPUToSPIRV",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:MemRefDialect",
        "@llvm-project//mlir:MemRefToSPIRV",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:SPIRVDialect",
        "@llvm-project//mlir:SPIRVSerialization",
        "@llvm-project//mlir:SPIRVTransforms",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:TransformUtils",
    ],
)
