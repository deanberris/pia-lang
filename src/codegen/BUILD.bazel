load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools:copts.bzl", "PIA_MLIR_COPTS")

# Codegen v0 (milestone M6): erase contracts, lower pia to core MLIR and
# LLVM, and emit an object file (docs/codegen.md). Linalg, Tensor,
# Bufferization and Transform are for lowerings written in Pia (ADR 0065).
cc_library(
    name = "codegen",
    srcs = [
        "ArrayResults.cpp",
        "Codegen.cpp",
        "Lowerings.cpp",
        "Phases.cpp",
        "SliceBuffers.cpp",
    ],
    hdrs = [
        "ArrayResults.h",
        "Codegen.h",
        "Lowerings.h",
        "Phases.h",
        "SliceBuffers.h",
    ],
    copts = PIA_MLIR_COPTS,
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = [
        "//src/cert",
        "//src/dialect",
        "//src/gpu",
        "//src/syntax",
        "//src/transforms",
        "@llvm-project//llvm:AllTargetsCodeGens",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:MC",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:Target",
        "@llvm-project//llvm:TargetParser",
        "@llvm-project//llvm:TransformUtils",
        "@llvm-project//mlir:AffineDialect",
        "@llvm-project//mlir:AffineToStandard",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:ArithToLLVM",
        "@llvm-project//mlir:AsyncDialect",
        "@llvm-project//mlir:AsyncToLLVM",
        "@llvm-project//mlir:AsyncTransforms",
        "@llvm-project//mlir:BufferizationDialect",
        "@llvm-project//mlir:BuiltinToLLVMIRTranslation",
        "@llvm-project//mlir:ControlFlowDialect",
        "@llvm-project//mlir:ControlFlowToLLVM",
        "@llvm-project//mlir:ExecutionEngineUtils",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:FuncToLLVM",
        "@llvm-project//mlir:FuncTransforms",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:IndexDialect",
        "@llvm-project//mlir:IndexToLLVM",
        "@llvm-project//mlir:LLVMDialect",
        "@llvm-project//mlir:LinalgDialect",
