load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools:copts.bzl", "PIA_MLIR_COPTS")

# Verifier v0 (milestone M5): obligations, interval checks, an encoding in
# the upstream smt dialect, and Z3 (docs/verifier.md).
cc_library(
    name = "verify",
    srcs = ["Verifier.cpp"],
    hdrs = ["Verifier.h"],
    copts = PIA_MLIR_COPTS,
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = [
        ":strategy",
        ":triggers",
        "//src/dialect",
        "//src/sema",
        "//src/transforms",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:SMTDialect",
        "@llvm-project//mlir:TargetSMTLIB",
        "@z3//:z3_static",
    ],
)

# An axiom's triggers (ADR 0036), shared by IRGen, which reports an axiom
# with none, and the verifier, which encodes them as patterns.
cc_library(
    name = "triggers",
    srcs = ["Triggers.cpp"],
    hdrs = ["Triggers.h"],
    copts = PIA_MLIR_COPTS,
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = [
        "//src/dialect",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
    ],
)

# Solver strategies (ADR 0036), shared by IRGen, which checks `@solver(...)`,
# and the verifier, which solves with them.
cc_library(
    name = "strategy",
    srcs = ["Strategy.cpp"],
    hdrs = ["Strategy.h"],
    copts = PIA_MLIR_COPTS,
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = [
        "@llvm-project//llvm:Support",
        "@z3//:z3_static",
    ],
)
