    name = "meta",
    srcs = [
        "Expand.cpp",
        "Interpreter.cpp",
        "Totality.cpp",
    ],
    hdrs = [
        "Expand.h",
        "Interpreter.h",
        "Totality.h",
    ],
    copts = PIA_COPTS,
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = ["//src/syntax"],
