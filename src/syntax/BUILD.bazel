load("@rules_cc//cc:defs.bzl", "cc_library")

# Lexer, parser and syntax tree (milestone M2). No LLVM dependency, so the
# front end builds and tests in seconds.
cc_library(
    name = "syntax",
    srcs = [
        "Comments.cpp",
        "Embeds.cpp",
        "Interfaces.cpp",
        "Lean.cpp",
        "Lexer.cpp",
        "Lint.cpp",
        "Parser.cpp",
        "Prelude.cpp",
        "RecTypes.cpp",
        "Syntax.cpp",
    ],
    hdrs = [
        "Comments.h",
        "Diagnostics.h",
        "Embeds.h",
        "Interfaces.h",
        "Lean.h",
        "Lexer.h",
        "Lint.h",
        "Parser.h",
        "RecTypes.h",
        "Syntax.h",
        "Token.h",
    ],
    copts = ["-Wall", "-Wextra", "-Werror"],
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
)
