load("@rules_cc//cc:defs.bzl", "cc_library")

# The language guide `pia mcp` teaches with (src/repl/Guide.h), cut from
# the agent skills so the two cannot drift.
GUIDE_SKILLS = [
    "//skills:pia-language/SKILL.md",
    "//skills:pia-contracts/SKILL.md",
    "//skills:pia-mcp/SKILL.md",
]

genrule(
    name = "guide_text",
    srcs = GUIDE_SKILLS + ["//skills:pia-mcp/instructions.md"],
    outs = ["GuideText.inc"],
    cmd = "python3 $(location embed_guide.py) $@ " +
          "$(location //skills:pia-mcp/instructions.md) " +
          " ".join(["$(location %s)" % s for s in GUIDE_SKILLS]),
    tools = ["embed_guide.py"],
)

# The REPL's session API (ADR 0031, docs/repl.md): a persistent, verified
# environment, evaluation with the ORC JIT through MLIR's ExecutionEngine,
# and an asynchronous Kernel for tools such as the MCP server. It is a
# development tool: nothing in Pia.Rt or in compiled programs links it.
cc_library(
    name = "repl",
    srcs = [
        "Guide.cpp",
        "Kernel.cpp",
        "Mcp.cpp",
        "Session.cpp",
        "State.cpp",
    ],
    hdrs = [
        "Guide.h",
        "Kernel.h",
        "Mcp.h",
        "Session.h",
        "State.h",
    ],
    textual_hdrs = ["GuideText.inc"],
    # MLIR's generated headers trip -Wunused-parameter.
    copts = [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    linkopts = ["-lpthread"],
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = [
        "//src/codegen",
        "//src/dialect",
        "//src/irgen",
        "//src/lsp",
        "//src/meta",
        "//src/sema",
        "//src/syntax",
        "//src/verify",
        "@llvm-project//llvm:Core",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:TargetParser",
        "@llvm-project//mlir:ExecutionEngine",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
    ],
)

# The terminal line editor. No LLVM dependency.
cc_library(
    name = "line_editor",
    srcs = ["LineEditor.cpp"],
    hdrs = ["LineEditor.h"],
    copts = ["-Wall", "-Wextra", "-Werror"],
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
)
