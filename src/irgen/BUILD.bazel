load("@rules_cc//cc:defs.bzl", "cc_library")
load("//tools:copts.bzl", "PIA_MLIR_COPTS")

# The built-in theory `Target` (ADR 0049), compiled into piac as a string.
genrule(
    name = "target_source",
    srcs = ["Target.pia"],
    outs = ["TargetSource.inc"],
    cmd = "(echo 'R\"pia('; cat $<; echo ')pia\"') > $@",
)

# The built-in theory `Memory`, RC11 (ADR 0052), compiled in the same way.
genrule(
    name = "memory_source",
    srcs = ["Memory.pia"],
    outs = ["MemorySource.inc"],
    cmd = "(echo 'R\"pia('; cat $<; echo ')pia\"') > $@",
)

exports_files([
    "Memory.pia",
    "Target.pia",
])

# IRGen for the scalar subset (milestone M4): syntax tree to the pia and
# pia_contract dialects, with control flow in scf.
cc_library(
    name = "irgen",
    srcs = [
        "Boxes.cpp",
        "IRGen.cpp",
        "Memory.cpp",
        "Regions.cpp",
        "Target.cpp",
        "Theories.cpp",
    ],
    hdrs = [
        "Boxes.h",
        "IRGen.h",
        "Memory.h",
        "Regions.h",
        "Target.h",
        "Theories.h",
    ],
    textual_hdrs = [
        "MemorySource.inc",
        "TargetSource.inc",
    ],
    copts = PIA_MLIR_COPTS,
    strip_include_prefix = "/src",
    visibility = ["//visibility:public"],
    deps = [
        "//src/dialect",
        "//src/meta",
        "//src/sema",
        "//src/syntax",
        "//src/transforms",
        "//src/verify:strategy",
        "//src/verify:triggers",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:ArithDialect",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:SCFDialect",
        "@llvm-project//mlir:Support",
    ],
)
