load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//tests/lit:lit.bzl", "lit_tests")
load("//tools:copts.bzl", "PIA_COPTS")

# `pia repl` end to end, through the JSON protocol and a pipe.
# It verifies and JITs dozens of cells, so it runs in shards (each shard
# runs every fourth test; tests/repl/shard.py).
py_test(
    name = "repl_test",
    srcs = [
        "repl_test.py",
        "shard.py",
    ],
    args = ["$(rootpath //tools/pia)"],
    data = ["//tools/pia"],
    main = "repl_test.py",
    shard_count = 4,
)

# `pia mcp`: the execute and poll tools over stdio.
py_test(
    name = "mcp_test",
    srcs = ["mcp_test.py"],
    args = ["$(rootpath //tools/pia)"],
    data = ["//tools/pia"],
    main = "mcp_test.py",
)

# The asynchronous Kernel that the MCP server is built on.
cc_test(
    name = "kernel_test",
    srcs = ["kernel_test.cpp"],
    copts = PIA_COPTS,
    deps = [
        "//src/repl",
        "@googletest//:gtest_main",
    ],
)

# Compiled programs have no Pia.Live.
lit_tests(
    name = "piac_tests",
    srcs = glob(["*.pia"]),
    tools = ["//tools/piac"],
)
