(* Recursive values in core MLIR (ADR 0047, step 3): a struct of the tag
   and each constructor's payload fields, where a box's slot is its memref
   descriptor. A constructor inserts its tag and payload into a zero
   struct; `match` extracts them.
// RUN: piac --emit=core %s | FileCheck %s
*)

let box = let (t : type) => type { slot : [t] }
let rec tree = type
  | Leaf
  | Node of { left : box tree; key : u32; right : box tree }

(*
// CHECK-LABEL: func.func @leaf() -> !llvm.struct<"pia.rec.tree", (i8, struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>, i32, struct<(ptr, ptr, i64, array<1 x i64>, array<1 x i64>)>)>
// CHECK: llvm.mlir.zero
// CHECK: llvm.insertvalue %{{.*}}[0]
*)
let leaf () : tree = Leaf

(*
// CHECK-LABEL: func.func @key
// CHECK: llvm.extractvalue %{{.*}}[0]
// CHECK: llvm.extractvalue %{{.*}}[2]
*)
let key (t : tree) : u32 =
  match t with
  | Leaf -> 0
  | Node n -> n.key

(*
// CHECK-LABEL: func.func @node
// CHECK: builtin.unrealized_conversion_cast %{{.*}} : memref<?x!llvm.struct<"pia.rec.tree"
// CHECK: llvm.insertvalue %{{.*}}[1]
// CHECK: llvm.insertvalue %{{.*}}[2]
// CHECK: llvm.insertvalue %{{.*}}[3]
*)
let node (l : box tree) (k : u32) (r : box tree) : tree = Node { left = l; key = k; right = r }
