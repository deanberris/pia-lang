(* Recursive values have no layout until ADR 0047, step 3: piac generates
   no code for a function that takes, makes or returns one, even with its
   goals accepted, and says which. A module whose recursive types no
   function uses compiles as before.
// RUN: not piac --emit=core --allow-unproved=bump %s 2>&1 | FileCheck %s
*)

let box = let (t : type) => type { slot : [t] }
let rec tree = type
  | Leaf
  | Node of { left : box tree; key : u32; right : box tree }

(*
// CHECK: rec_types.pia":[[@LINE+2]]:1): error: 'leaf' uses a recursive type, which has no code yet (ADR 0047, step 3)
*)
let leaf () : tree = Leaf

(*
// CHECK: rec_types.pia":[[@LINE+2]]:1): error: 'bump' uses a recursive type, which has no code yet (ADR 0047, step 3)
*)
let bump (t : tree) : u32 =
  match t with
  | Leaf -> 0
  | Node n -> n.key + 1

(*
// CHECK-NOT: 'plain'
*)
let plain (a : u8) (b : u8) : u16 = a + b
