(* Foreign functions (#55), compiled for Apple Silicon and linked with
   ffi_test.c, which defines the C functions and calls these.
*)
module Ffi : Calls

interface Calls @abi(c) = sig
  let total : (xs : [u8]) -> u32
  let tail_total : (xs : [u8]) -> u32
    requires len xs >= 1
  let pct : (x : i32) -> i32
  let twice_raw : (x : i32) -> i32
  let va_two : (a : i64) -> (b : i64) -> i64
  let va_three : (a : i64) -> (b : i64) -> (c : i64) -> i64
  let va_mix : (a : u32) -> (xs : [u8]) -> u64
  let plus_answer : (x : i32) -> i32
    requires x <= 1000
end

let sum_bytes (xs : [u8]) (n : usize) : u32
  requires n <= len xs
  ensures true
= extern "sum_bytes"

let clamp (x : i32) : i32
  ensures result >= 0 && result <= 100
= extern "clamp_c"

let raw (x : i32) : i32 = extern "raw_c"

let total (xs : [u8]) : u32 = sum_bytes xs (len xs)

(* A view starts part way in: C gets a pointer to its first element. *)
let tail_total (xs : [u8]) : u32
  requires len xs >= 1
= let t = xs.[1 .. len xs] in sum_bytes t (len t)

let pct (x : i32) : i32 = clamp x
let twice_raw (x : i32) : i32 = unsafe raw x

(* C variadic functions (ADR 0051): the same symbol at two arities, and a
   buffer and a u32 among the variadic arguments. A call without the
   variadic convention would read garbage on Apple arm64. *)
let sum2 (n : i32) (a : i64) (b : i64) : i64 @variadic(1)
  requires n = 2
  ensures true
= extern "sum_va"

let sum3 (n : i32) (a : i64) (b : i64) (c : i64) : i64 @variadic(1)
  requires n = 3
  ensures true
= extern "sum_va"

let mix (n : i32) (a : u32) (xs : [u8]) (k : usize) : u64 @variadic(1)
  requires k <= len xs
  ensures true
= extern "mix_va"

let va_two (a : i64) (b : i64) : i64 = sum2 2 a b
let va_three (a : i64) (b : i64) (c : i64) : i64 = sum3 3 a b c
let va_mix (a : u32) (xs : [u8]) : u64 = mix 3 a xs (len xs)

(* A C function of no arguments, `int answer(void)`. *)
let answer () : i32
  ensures result = 42
= extern "answer"

let plus_answer (x : i32) : i32
  requires x <= 1000
= x + answer ()
