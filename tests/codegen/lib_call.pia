(* A call of a function with a lowering is `pia_lib.call` (ADR 0078): the
   op names the Pia function whose body is its meaning, and stays one until
   codegen goes to LLVM. There `pia-lib-lower` substitutes the rule's MLIR
   for the call, so `dec2` has no call of `dec`, or with --lower=off
   expands it into a call of the Pia body. `dec`'s lowering gives its
   value as `$result`, which codegen returns.
// RUN: piac --emit=core %s | FileCheck %s
// RUN: piac --emit=core --lower=off %s | FileCheck %s --check-prefix=OFF
// RUN: piac --emit=core --lower=off %s | pia-opt | FileCheck %s --check-prefix=OFF
// RUN: piac --emit=llvm -O0 %s | FileCheck %s --check-prefix=LLVM
// RUN: piac --emit=llvm -O0 --lower=off %s | FileCheck %s --check-prefix=LLVMOFF
*)
@trusted

let dec (x : u8) : u8
  @lower("%one = arith.constant 1 : i8\n$result = arith.subi $x, %one : i8")
  requires x > 0
  ensures result = x - 1
= x - 1

let dec2 (x : u8) : u8
  requires x > 1
  ensures result = x - 2
= dec (dec x)

(*
// CHECK-LABEL: func.func @dec(
// CHECK: arith.subi
// CHECK-LABEL: func.func @dec2(
// CHECK: %[[A:[0-9]+]] = pia_lib.call @dec(%arg0) : (i8) -> i8
// CHECK: %[[B:[0-9]+]] = pia_lib.call @dec(%[[A]]) : (i8) -> i8
// CHECK: return %[[B]] : i8

// OFF-LABEL: func.func @dec2(
// OFF: pia_lib.call @dec
// OFF: pia_lib.call @dec

// LLVM-NOT: pia_lib
// LLVM-LABEL: define {{.*}}@dec2(
// LLVM-NOT: call
// LLVM: sub i8
// LLVM-NOT: call
// LLVM: sub i8
// LLVM-NOT: call
// LLVM: ret i8

// LLVMOFF-LABEL: define {{.*}}@dec2(
// LLVMOFF: call {{.*}}@dec(
*)
