(* A buffer whose elements hold slices is proved, but codegen does not
   lower it yet (ADR 0048, step 3), and says so.
// RUN: not piac --emit=llvm -o %t/out.ll %s 2>&1 | FileCheck %s
*)

let first (xs : borrowed [[u16]]) : u16
  requires len xs > 0 && len xs.[0] > 0
= xs.[0].[0]
(* CHECK: error: 'first' uses a buffer whose elements hold a slice, which is proved but not compiled yet (ADR 0048, step 3)
*)
