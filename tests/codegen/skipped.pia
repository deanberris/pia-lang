(* Goals the verifier skips, such as the termination of a while loop with
   no `decreases` measure, are not proved, so piac generates no code for
   them unless --allow-unproved accepts them (docs/codegen.md,
   "Verification comes first").
// RUN: not piac --emit=core %s 2>&1 | FileCheck %s --check-prefix=REFUSE
// RUN: piac --emit=core --allow-unproved=drain %s 2>&1 | FileCheck %s --check-prefix=FUNCTION
// RUN: piac --emit=core --allow-unproved=%s:33 %s 2>&1 | FileCheck %s --check-prefix=FUNCTION
// RUN: not piac --emit=core --allow-unproved=%s:33:3 %s 2>&1 | FileCheck %s --check-prefix=ONE
// RUN: piac --emit=core --allow-unproved=drain --allow-unproved=no_such_fn %s 2>&1 | FileCheck %s --check-prefix=UNUSED
*)

(*
// REFUSE: skipped.pia:33:3: unproved: the loop terminates [it has no 'decreases' measure] in 'drain'
// REFUSE-NEXT: skipped.pia:33:35: unproved: the loop terminates [it has no 'decreases' measure] in 'drain'
// REFUSE-NEXT: piac: error: 2 obligations not proved, so no code was generated
// REFUSE-NEXT: piac: note: prove them, or accept specific ones with --allow-unproved=<function> or --allow-unproved=<file:line[:col]>
// REFUSE-NOT: func.func

// FUNCTION: piac: warning: 2 obligations not proved, accepted by --allow-unproved; see piac --verify
// FUNCTION-LABEL: func.func @drain
// FUNCTION: scf.while

// ONE: skipped.pia:33:35: unproved: the loop terminates
// ONE-NEXT: piac: error: 1 obligation not proved, so no code was generated

// UNUSED: piac: warning: --allow-unproved=no_such_fn matches no unproved obligation
// UNUSED-NEXT: piac: warning: 2 obligations not proved, accepted by --allow-unproved
// UNUSED-LABEL: func.func @drain
*)
let drain (a : u32) (b : u32) : u32 =
  let x : mutable u32 = a in
  let y : mutable u32 = b in
  while x > 0 do x <- x - 1 done; while y > 0 do y <- y - 1 done;
  x + y
