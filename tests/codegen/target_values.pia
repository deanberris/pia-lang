(* Target's constants as values in code (ADR 0049). Code gets the value of
   the model for the target it is compiled for, and `if Target.is m` keeps
   only the branch for that target, so the other's code is never compiled.
// RUN: piac --emit=core %s | FileCheck %s --check-prefix=ARM
// RUN: piac --emit=core --target=x86_64-unknown-linux-gnu --cpu=x86-64-v3 %s | FileCheck %s --check-prefix=X86
*)

(* The padding that keeps a contended atomic on a line of its own. *)
let line (x : u8) : usize = Target.cache_line

let page (x : u8) : usize = Target.page_size

(* Whether a locked add sets the flags (ADR 0052): codegen's to read. *)
let flags (x : u8) : bool = Target.rmw_flags

let wide (x : u8) : usize @target(x86_64_linux) = Target.vector_bits

let vector (x : u8) : usize
= if Target.is x86_64_linux then wide x else Target.vector_bits

(*
// ARM-LABEL: func.func @line
// ARM: constant 128
// ARM-LABEL: func.func @page
// ARM: constant 16384
// ARM-LABEL: func.func @flags
// ARM: constant false
// ARM-NOT: @wide
// ARM-LABEL: func.func @vector
// ARM: constant 128
// X86-LABEL: func.func @line
// X86: constant 64
// X86-LABEL: func.func @page
// X86: constant 4096
// X86-LABEL: func.func @flags
// X86: constant true
// X86-LABEL: func.func @wide
// X86: constant 256
// X86-LABEL: func.func @vector
// X86: call @wide
*)
