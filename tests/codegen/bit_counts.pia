(* The bit builtins clz, ctz, popcount, bswap, rotl and rotr (ADR 0023
   group 2, ADR 0040), compiled for Apple Silicon and run by
   bit_counts_test.c against the C compiler's builtins over every u8 and
   u16 input and a sweep of the wider types. Every goal here must be
   proved.
*)
module BitCounts : BitCountOps

interface BitCountOps @abi(c) = sig
  let clz8 : (x : u8) -> u8
  let ctz8 : (x : u8) -> u8
  let pop8 : (x : u8) -> u8
  let clz16 : (x : u16) -> u8
  let ctz16 : (x : u16) -> u8
  let pop16 : (x : u16) -> u8
  let swap16 : (x : u16) -> u16
  let clz32 : (x : u32) -> u8
  let ctz32 : (x : u32) -> u8
  let pop32 : (x : u32) -> u8
  let swap32 : (x : u32) -> u32
  let rotl32 : (x : u32) -> (n : u8) -> u32
    requires n < 32
  let rotr32 : (x : u32) -> (n : u8) -> u32
    requires n < 32
  let clz64 : (x : u64) -> u8
  let ctz64 : (x : u64) -> u8
  let pop64 : (x : u64) -> u8
  let swap64 : (x : u64) -> u64
  let rotl64 : (x : u64) -> (n : u8) -> u64
    requires n < 64
  let rotr8 : (x : u8) -> (n : u8) -> u8
    requires n < 8
end

let clz8 (x : u8) : u8 = clz x
let ctz8 (x : u8) : u8 = ctz x
let pop8 (x : u8) : u8 = popcount x
let clz16 (x : u16) : u8 = clz x
let ctz16 (x : u16) : u8 = ctz x
let pop16 (x : u16) : u8 = popcount x
let swap16 (x : u16) : u16 = bswap x
let clz32 (x : u32) : u8 = clz x
let ctz32 (x : u32) : u8 = ctz x
let pop32 (x : u32) : u8 = popcount x
let swap32 (x : u32) : u32 = bswap x

let rotl32 (x : u32) (n : u8) : u32
  requires n < 32
= rotl x n

let rotr32 (x : u32) (n : u8) : u32
  requires n < 32
= rotr x n

let clz64 (x : u64) : u8 = clz x
let ctz64 (x : u64) : u8 = ctz x
let pop64 (x : u64) : u8 = popcount x
let swap64 (x : u64) : u64 = bswap x

let rotl64 (x : u64) (n : u8) : u64
  requires n < 64
= rotl x n

let rotr8 (x : u8) (n : u8) : u8
  requires n < 8
= rotr x n
