(* Each overload has its own symbol, which names its parameter types, and
   its own C entry point, where `eq(u8, u8)` becomes `eq__u8_u8`
   (ADR 0034). A name that is not overloaded keeps its plain entry point.
// RUN: piac --emit=llvm %s 2>&1 | FileCheck %s
*)

(*
// CHECK-DAG: define {{.*}} @eq__u8_u8(
// CHECK-DAG: define {{.*}} @eq__u16_u16(
// CHECK-DAG: define {{.*}} @both(
*)
let eq (a : u8) (b : u8) : bool = a = b
let eq (a : u16) (b : u16) : bool = a = b

let both (a : u8) (b : u16) : bool = eq a a && eq b b
