load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tests/lit:lit.bzl", "lit_tests")

# Codegen v0 (M6). The lit tests check the lowering and run on any host.
lit_tests(
    name = "codegen_tests",
    srcs = glob(["*.pia"], exclude = ["saturate.pia", "bits.pia", "ffi_run.pia", "slices.pia", "consts.pia", "variants.pia", "record_buffers.pia", "arena.pia", "pages.pia"]),
    tools = ["//tools/piac"],
)

# saturate.pia compiled for Apple Silicon and linked with a C harness that
# compares it with C reference implementations. It runs only on arm64 macOS.
APPLE_SILICON = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

genrule(
    name = "saturate_obj",
    srcs = ["saturate.pia"],
    outs = ["saturate.o"],
    # add_rows's subscripts are inside a loop, which v0 does not verify yet
    # (docs/verifier.md, "Limits of v0"), so its three bounds goals are
    # accepted unproved. Every other goal in saturate.pia must be proved.
    cmd = "$(location //tools/piac) --emit=obj -o $@ $<",
    target_compatible_with = APPLE_SILICON,
    tools = ["//tools/piac"],
)

cc_test(
    name = "saturate_test",
    srcs = [
        "saturate_test.c",
        ":saturate_obj",
    ],
    target_compatible_with = APPLE_SILICON,
)

