load("@rules_cc//cc:defs.bzl", "cc_test")
load("//tests/lit:lit.bzl", "lit_tests")
load("//tools/piac:targets.bzl", "PIA_TARGETS", "PIAC_TARGET_FLAGS")

# Codegen v0 (M6). The lit tests check the lowering and run on any host.
lit_tests(
    name = "codegen_tests",
    srcs = glob(["*.pia"], exclude = ["floats.pia", "saturate.pia", "bits.pia", "bit_counts.pia", "ffi_run.pia", "slices.pia", "consts.pia", "variants.pia", "record_buffers.pia", "arena.pia", "pages.pia", "spec_state.pia", "box_concept.pia", "box_error_payload.pia", "rec_run.pia", "slice_buffers_run.pia", "local_arrays.pia", "spread.pia", "collectives.pia"]),
    tools = [
        "//tools/pia-cert",
        "//tools/pia-opt",
        "//tools/piac",
    ],
)

# saturate.pia compiled for the platform being built for and linked with a
# C harness that compares it with C reference implementations.
genrule(
    name = "saturate_obj",
    srcs = ["saturate.pia"],
    outs = ["saturate.o"],
    # add_rows's subscripts are inside a loop, which v0 does not verify yet
    # (docs/verifier.md, "Limits of v0"), so its three bounds goals are
    # accepted unproved. Every other goal in saturate.pia must be proved.
    cmd = "$(location //tools/piac) --emit=obj " + PIAC_TARGET_FLAGS + " -o $@ $<",
    target_compatible_with = PIA_TARGETS,
    tools = ["//tools/piac"],
)

cc_test(
    name = "saturate_test",
    srcs = [
        "saturate_test.c",
        ":saturate_obj",
    ],
    target_compatible_with = PIA_TARGETS,
)

# floats.pia, f32 and f64 (M11), against C bit for bit. Both sides are
# strict IEEE 754: no FMA contraction, subnormals kept.
genrule(
    name = "floats_obj",
    srcs = ["floats.pia"],
    outs = ["floats.o"],
    cmd = "$(location //tools/piac) --emit=obj " + PIAC_TARGET_FLAGS + " -o $@ $<",
    target_compatible_with = PIA_TARGETS,
    tools = ["//tools/piac"],
)

cc_test(
    name = "floats_test",
    srcs = [
        "floats_test.c",
        ":floats_obj",
    ],
    copts = ["-ffp-contract=off"],
    linkopts = ["-lm"],
    target_compatible_with = PIA_TARGETS,
)

