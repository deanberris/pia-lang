(* The instruction table of ADR 0052, section 5, as LLVM emits it for each
   target: one function per (operation, order), on a u32 cell unless the
   name says otherwise. A change in the pinned LLVM that picks other
   instructions fails here; the table is proved against each hardware
   model in a later step (ADR 0052, section 8).
// RUN: piac --emit=asm %s | FileCheck %s --check-prefix=ARM
// RUN: piac --emit=asm --target=x86_64-unknown-linux-gnu --cpu=x86-64-v3 %s | FileCheck %s --check-prefix=X86
*)

module Atomics : Ops

interface Ops @abi(c) = sig
  let load_relaxed : (c : borrowed atomic u32) -> u32
  let load_acquire : (c : borrowed atomic u32) -> u32
  let load_seq_cst : (c : borrowed atomic u32) -> u32
  let store_relaxed : (c : borrowed atomic u32) -> (v : u32) -> unit
  let store_release : (c : borrowed atomic u32) -> (v : u32) -> unit
  let store_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> unit
  let swap_relaxed : (c : borrowed atomic u32) -> (v : u32) -> u32
  let swap_acquire : (c : borrowed atomic u32) -> (v : u32) -> u32
  let swap_release : (c : borrowed atomic u32) -> (v : u32) -> u32
  let swap_acq_rel : (c : borrowed atomic u32) -> (v : u32) -> u32
  let swap_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> u32
  let cas_relaxed_relaxed : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let cas_acquire_relaxed : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let cas_acquire_acquire : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let cas_release_relaxed : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let cas_acq_rel_relaxed : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let cas_acq_rel_acquire : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let cas_seq_cst_relaxed : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let cas_seq_cst_acquire : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let cas_seq_cst_seq_cst : (c : borrowed atomic u32) -> (e : u32) -> (d : u32) -> u32
  let add_relaxed : (c : borrowed atomic u32) -> (v : u32) -> u32
  let add_acquire : (c : borrowed atomic u32) -> (v : u32) -> u32
  let add_release : (c : borrowed atomic u32) -> (v : u32) -> u32
  let add_acq_rel : (c : borrowed atomic u32) -> (v : u32) -> u32
  let add_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> u32
  let sub_relaxed : (c : borrowed atomic u32) -> (v : u32) -> u32
  let sub_acquire : (c : borrowed atomic u32) -> (v : u32) -> u32
  let sub_release : (c : borrowed atomic u32) -> (v : u32) -> u32
  let sub_acq_rel : (c : borrowed atomic u32) -> (v : u32) -> u32
  let sub_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> u32
  let and_relaxed : (c : borrowed atomic u32) -> (v : u32) -> u32
  let and_acquire : (c : borrowed atomic u32) -> (v : u32) -> u32
  let and_release : (c : borrowed atomic u32) -> (v : u32) -> u32
  let and_acq_rel : (c : borrowed atomic u32) -> (v : u32) -> u32
  let and_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> u32
  let or_relaxed : (c : borrowed atomic u32) -> (v : u32) -> u32
  let or_acquire : (c : borrowed atomic u32) -> (v : u32) -> u32
  let or_release : (c : borrowed atomic u32) -> (v : u32) -> u32
  let or_acq_rel : (c : borrowed atomic u32) -> (v : u32) -> u32
  let or_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> u32
  let xor_relaxed : (c : borrowed atomic u32) -> (v : u32) -> u32
  let xor_acquire : (c : borrowed atomic u32) -> (v : u32) -> u32
  let xor_release : (c : borrowed atomic u32) -> (v : u32) -> u32
  let xor_acq_rel : (c : borrowed atomic u32) -> (v : u32) -> u32
  let xor_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> u32
  let min_relaxed : (c : borrowed atomic u32) -> (v : u32) -> u32
  let min_acquire : (c : borrowed atomic u32) -> (v : u32) -> u32
  let min_release : (c : borrowed atomic u32) -> (v : u32) -> u32
  let min_acq_rel : (c : borrowed atomic u32) -> (v : u32) -> u32
  let min_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> u32
  let max_relaxed : (c : borrowed atomic u32) -> (v : u32) -> u32
  let max_acquire : (c : borrowed atomic u32) -> (v : u32) -> u32
  let max_release : (c : borrowed atomic u32) -> (v : u32) -> u32
  let max_acq_rel : (c : borrowed atomic u32) -> (v : u32) -> u32
  let max_seq_cst : (c : borrowed atomic u32) -> (v : u32) -> u32
  let fence_acquire : (x : u8) -> unit
  let fence_release : (x : u8) -> unit
  let fence_acq_rel : (x : u8) -> unit
  let fence_seq_cst : (x : u8) -> unit
  let add_trap : (c : borrowed atomic u32) -> (v : u32) -> u32
  let add_saturate : (c : borrowed atomic u32) -> (v : u32) -> u32
  let min_signed : (c : borrowed atomic i32) -> (v : i32) -> i32
  let swap_bool : (c : borrowed atomic bool) -> (v : bool) -> bool
end

let load_relaxed (c : borrowed atomic u32) : u32 = atomic_load relaxed c
let load_acquire (c : borrowed atomic u32) : u32 = atomic_load acquire c
let load_seq_cst (c : borrowed atomic u32) : u32 = atomic_load seq_cst c
let store_relaxed (c : borrowed atomic u32) (v : u32) : unit = atomic_store relaxed c v
let store_release (c : borrowed atomic u32) (v : u32) : unit = atomic_store release c v
let store_seq_cst (c : borrowed atomic u32) (v : u32) : unit = atomic_store seq_cst c v
let swap_relaxed (c : borrowed atomic u32) (v : u32) : u32 = atomic_swap relaxed c v
let swap_acquire (c : borrowed atomic u32) (v : u32) : u32 = atomic_swap acquire c v
let swap_release (c : borrowed atomic u32) (v : u32) : u32 = atomic_swap release c v
let swap_acq_rel (c : borrowed atomic u32) (v : u32) : u32 = atomic_swap acq_rel c v
let swap_seq_cst (c : borrowed atomic u32) (v : u32) : u32 = atomic_swap seq_cst c v
let cas_relaxed_relaxed (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas relaxed relaxed c e d
let cas_acquire_relaxed (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas acquire relaxed c e d
let cas_acquire_acquire (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas acquire acquire c e d
let cas_release_relaxed (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas release relaxed c e d
let cas_acq_rel_relaxed (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas acq_rel relaxed c e d
let cas_acq_rel_acquire (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas acq_rel acquire c e d
let cas_seq_cst_relaxed (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas seq_cst relaxed c e d
let cas_seq_cst_acquire (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas seq_cst acquire c e d
let cas_seq_cst_seq_cst (c : borrowed atomic u32) (e : u32) (d : u32) : u32 = atomic_cas seq_cst seq_cst c e d
let add_relaxed (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_add relaxed c v)
let add_acquire (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_add acquire c v)
let add_release (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_add release c v)
let add_acq_rel (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_add acq_rel c v)
let add_seq_cst (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_add seq_cst c v)
let sub_relaxed (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_sub relaxed c v)
let sub_acquire (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_sub acquire c v)
let sub_release (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_sub release c v)
let sub_acq_rel (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_sub acq_rel c v)
let sub_seq_cst (c : borrowed atomic u32) (v : u32) : u32 = @wrap (atomic_sub seq_cst c v)
let and_relaxed (c : borrowed atomic u32) (v : u32) : u32 = atomic_and relaxed c v
let and_acquire (c : borrowed atomic u32) (v : u32) : u32 = atomic_and acquire c v
let and_release (c : borrowed atomic u32) (v : u32) : u32 = atomic_and release c v
let and_acq_rel (c : borrowed atomic u32) (v : u32) : u32 = atomic_and acq_rel c v
let and_seq_cst (c : borrowed atomic u32) (v : u32) : u32 = atomic_and seq_cst c v
let or_relaxed (c : borrowed atomic u32) (v : u32) : u32 = atomic_or relaxed c v
let or_acquire (c : borrowed atomic u32) (v : u32) : u32 = atomic_or acquire c v
let or_release (c : borrowed atomic u32) (v : u32) : u32 = atomic_or release c v
let or_acq_rel (c : borrowed atomic u32) (v : u32) : u32 = atomic_or acq_rel c v
let or_seq_cst (c : borrowed atomic u32) (v : u32) : u32 = atomic_or seq_cst c v
let xor_relaxed (c : borrowed atomic u32) (v : u32) : u32 = atomic_xor relaxed c v
let xor_acquire (c : borrowed atomic u32) (v : u32) : u32 = atomic_xor acquire c v
let xor_release (c : borrowed atomic u32) (v : u32) : u32 = atomic_xor release c v
let xor_acq_rel (c : borrowed atomic u32) (v : u32) : u32 = atomic_xor acq_rel c v
let xor_seq_cst (c : borrowed atomic u32) (v : u32) : u32 = atomic_xor seq_cst c v
let min_relaxed (c : borrowed atomic u32) (v : u32) : u32 = atomic_min relaxed c v
let min_acquire (c : borrowed atomic u32) (v : u32) : u32 = atomic_min acquire c v
let min_release (c : borrowed atomic u32) (v : u32) : u32 = atomic_min release c v
let min_acq_rel (c : borrowed atomic u32) (v : u32) : u32 = atomic_min acq_rel c v
let min_seq_cst (c : borrowed atomic u32) (v : u32) : u32 = atomic_min seq_cst c v
let max_relaxed (c : borrowed atomic u32) (v : u32) : u32 = atomic_max relaxed c v
let max_acquire (c : borrowed atomic u32) (v : u32) : u32 = atomic_max acquire c v
let max_release (c : borrowed atomic u32) (v : u32) : u32 = atomic_max release c v
let max_acq_rel (c : borrowed atomic u32) (v : u32) : u32 = atomic_max acq_rel c v
let max_seq_cst (c : borrowed atomic u32) (v : u32) : u32 = atomic_max seq_cst c v
let fence_acquire (x : u8) : unit = fence acquire
let fence_release (x : u8) : unit = fence release
let fence_acq_rel (x : u8) : unit = fence acq_rel
let fence_seq_cst (x : u8) : unit = fence seq_cst
let add_trap (c : borrowed atomic u32) (v : u32) : u32 = @trap (atomic_add acq_rel c v)
let add_saturate (c : borrowed atomic u32) (v : u32) : u32 = @saturate (atomic_add acq_rel c v)
let min_signed (c : borrowed atomic i32) (v : i32) : i32 = atomic_min relaxed c v
let swap_bool (c : borrowed atomic bool) (v : bool) : bool = atomic_swap seq_cst c v

