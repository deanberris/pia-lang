(* Metafunction compile-time byte access on @embed (ADR 0070, step 4):
   validates the "MTLB" magic header and extracts a compile-time constant from
   the blob in `let meta`, and fails compilation on a corrupt header.
// RUN: piac --verify --embed=magic.bin=%S/Inputs/magic.bin %s | FileCheck %s
// RUN: printf 'BAD!\001\002\003\004' > %t/bad.bin
// RUN: not piac --dump-expanded --embed=magic.bin=%t/bad.bin %s 2>&1 | FileCheck %s --check-prefix=BAD
*)
let magic : [u8] @embed(file = "magic.bin")

let meta check_mtlb blob : item =
  if len blob >= 4 &&
     blob.[0] = 0x4d && blob.[1] = 0x54 &&
     blob.[2] = 0x4c && blob.[3] = 0x42
  then (
    let version = blob.[4] in
    `( let mtlb_version () : u8 ensures result = $version = $version )
  )
  else
    fail "embedded blob is missing the MTLB magic header"

check_mtlb magic

let read_ver () : u8
  ensures result = 1
= mtlb_version ()

(* CHECK: 0 failed, 0 skipped
// BAD: embedded blob is missing the MTLB magic header
*)
