(* Direct LLVM ConstantDataArray emission for @embed (ADR 0070):
   - private @embed without symbol -> private constant [8 x i8], align 8
   - explicit symbol + align -> external constant + <symbol>_len i64
   - custom section -> section attribute + @llvm.used
// RUN: piac --emit=llvm --embed=magic.bin=%S/Inputs/magic.bin %s | FileCheck %s
*)
let priv_blob : [u8] @embed(file = "magic.bin")
let pub_blob : [u8] @embed(file = "magic.bin", symbol = "pia_test_magic", align = 16)
let sec_blob : [u8] @embed(file = "magic.bin", symbol = "pia_test_sec", section = "__DATA,__pia_test")

let read_priv () : u8 = priv_blob.[0]
let read_pub () : u8 = pub_blob.[1]

(* CHECK-DAG: @__pia_embed_priv_blob = private constant [8 x i8] c"MTLB\01\02\03\04", align 8
// CHECK-DAG: @pia_test_magic = constant [8 x i8] c"MTLB\01\02\03\04", align 16
// CHECK-DAG: @pia_test_magic_len = constant i64 8, align 8
// CHECK-DAG: @pia_test_sec = constant [8 x i8] c"MTLB\01\02\03\04", section "__DATA,__pia_test", align 8
// CHECK-DAG: @pia_test_sec_len = constant i64 8, align 8
// CHECK-DAG: @llvm.used = appending global {{.*}}@pia_test_sec
*)
