(* Pia.Core.Algo.Search (ADR 0040): every algorithm is proved once, over
   its type parameter (ADR 0043), and its interface exports the generic
   functions and the spec functions their contracts use. The unary
   predicate overloads are proved once over the predicate's type too; the
   binary ones, mismatch and equal with a predicate, at each call
   (tests/std/search_pred_edges.pia).
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Order.pia
// RUN: piac --verify --iface-path=%t %S/../../lib/Pia/Core/Algo/Search.pia | FileCheck %s
// RUN: mkdir -p %t/search && piac --emit=interface -o %t/search %S/../../lib/Pia/Core/Algo/Search.pia
// RUN: FileCheck --check-prefix=IFACE %s < %t/search/Pia.Core.Algo.Search.Search.piai
*)

(* Every goal is a generic one. minmax_element returns a record, so it is
   proved at each instance, from min_element's and last_max_element's
   contracts.
// CHECK-NOT: failed
// CHECK-DAG: proved: the postcondition holds [generic]
// CHECK-DAG: not proved generically: 'minmax_element' is proved at each instance, since it returns a value of extremes [generic]
// CHECK-DAG: proved: the loop invariant holds after each iteration [generic]
// CHECK: 393 proved, 0 failed, 0 skipped
*)

