(* Pia.Core.Algo.Numeric (ADR 0040, phase 1.6): the algorithms of
   <numeric>, each with an operation and proved once, over the element
   type and any such function (ADR 0043, ADR 0044); iota counting by one
   is stamped out per integer type and proved at each. The interface
   exports the generic functions, the spec functions their contracts use,
   and the per-type iota with its contract.
// RUN: FileCheck %s < %S/../../lib/Pia/Core/Algo/numeric.goals
// RUN: mkdir -p %t && piac --emit=interface -o %t %S/../../lib/Pia/Core/Algo/Numeric.pia
// RUN: FileCheck --check-prefix=IFACE %s < %t/Pia.Core.Algo.Numeric.Numeric.piai
*)

(* No function of the module is left unproved.
// CHECK-NOT: not proved generically
// CHECK-NOT: failed
// CHECK: 165 proved, 0 failed, 0 skipped
*)

(*
// IFACE:      {{^}}module Pia.Core.Algo.Numeric{{$}}
// IFACE-NEXT: {{^}}interface Numeric = sig{{$}}
