(* Importers of Pia.Core.Algo.Set and Pia.Core.Algo.SetUnion work on
   strictly increasing u8 sets by `<`, and know each result from the
   interfaces alone: includes says every element is there, and the four
   operations count what they write, write it strictly increasing, and
   write only members of the right sets.
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Fn.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Order.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Algo/BinarySearch.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Algo/Set.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Algo/SetUnion.pia
// RUN: piac --verify --iface-path=%t %s | FileCheck %s
*)
import Pia.Fn.Laws
import Pia.Core.Order.Ops
import Pia.Core.Algo.BinarySearch.BinarySearch as B
import Pia.Core.Algo.Set.Set as S
import Pia.Core.Algo.SetUnion.SetUnion as U

let has_all (xs : [u8]) (ys : [u8]) : bool
  requires forall (i in 0 .. len xs) (j in 0 .. len xs). i < j ==> xs.[i] < xs.[j]
  ensures result <==> (forall (b in 0 .. len ys). exists (k in 0 .. len xs). xs.[k] = ys.[b])
= S.includes xs ys (let (a : u8) (b : u8) : bool => a < b)

let common (dst : borrowed inout mutable [u8]) (xs : [u8]) (ys : [u8]) : usize
  requires forall (i in 0 .. len xs) (j in 0 .. len xs). i < j ==> xs.[i] < xs.[j]
  requires forall (i in 0 .. len ys) (j in 0 .. len ys). i < j ==> ys.[i] < ys.[j]
  requires len dst >= len xs
  ensures result <= len xs
  ensures forall (k in 0 .. result). exists (b in 0 .. len ys). ys.[b] = dst.[k]
= S.set_intersection dst xs ys (let (a : u8) (b : u8) : bool => a < b)

let only_first (dst : borrowed inout mutable [u8]) (xs : [u8]) (ys : [u8]) : usize
  requires forall (i in 0 .. len xs) (j in 0 .. len xs). i < j ==> xs.[i] < xs.[j]
  requires forall (i in 0 .. len ys) (j in 0 .. len ys). i < j ==> ys.[i] < ys.[j]
  requires len dst >= len xs
  ensures forall (k in 0 .. result). forall (b in 0 .. len ys). ys.[b] <> dst.[k]
= S.set_difference dst xs ys (let (a : u8) (b : u8) : bool => a < b)

let either (dst : borrowed inout mutable [u8]) (xs : [u8]) (ys : [u8]) : usize
  requires forall (i in 0 .. len xs) (j in 0 .. len xs). i < j ==> xs.[i] < xs.[j]
  requires forall (i in 0 .. len ys) (j in 0 .. len ys). i < j ==> ys.[i] < ys.[j]
  requires len dst >= len xs + len ys
  ensures result <= len xs + len ys
  ensures forall (i in 0 .. result) (j in 0 .. result). i < j ==> dst.[i] < dst.[j]
= U.set_union dst xs ys (let (a : u8) (b : u8) : bool => a < b)

let one_of (dst : borrowed inout mutable [u8]) (xs : [u8]) (ys : [u8]) : usize
  requires forall (i in 0 .. len xs) (j in 0 .. len xs). i < j ==> xs.[i] < xs.[j]
  requires forall (i in 0 .. len ys) (j in 0 .. len ys). i < j ==> ys.[i] < ys.[j]
  requires len dst >= len xs + len ys
  ensures result <= len xs + len ys
= U.set_symmetric_difference dst xs ys (let (a : u8) (b : u8) : bool => a < b)

(* Every goal is proved, and each call is an instance of its proof.
// CHECK-NOT: failed
// CHECK-DAG: 'Pia.Core.Algo.Set.set_intersection[lambda@set_edges.pia:{{[0-9:]+}}]<u8>' is an instance of the generic proof of 'Pia.Core.Algo.Set.set_intersection#proof' [generic]
// CHECK-DAG: 'Pia.Core.Algo.SetUnion.set_union[lambda@set_edges.pia:{{[0-9:]+}}]<u8>' is an instance of the generic proof of 'Pia.Core.Algo.SetUnion.set_union#proof' [generic]
// CHECK: 88 proved, 0 failed, 0 skipped
*)
