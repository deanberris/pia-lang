(* @derive(json_dom) on a tagged variant (ADR 0045, sections 2 and 6): a
   document conforms when it is an object with exactly one member called
   the tag, whose value is one constructor's name, and that constructor's
   record payload's members, each conforming, and no other. check decides
   it, from_dom is that constructor with that payload, and to_dom's
   document is valid and conforms, all proved where derived.
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Order.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Option.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Spec.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Lex.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Read.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Write.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Derive.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Mem/Alloc.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Dom.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Shape.pia
// RUN: piac --verify --iface-path=%t %s | FileCheck %s
// CHECK-NOT: failed
// CHECK: {{[0-9]+}} proved, 0 failed, 0 skipped
*)
import Pia.Core.Order.Ops
import Pia.Core.Option.Optional as O
import Pia.Text.Json.Spec.Grammar
import Pia.Text.Json.Lex.Lexer
import Pia.Text.Json.Read.Reader
import Pia.Text.Json.Write.Writer
import Pia.Text.Json.Derive.Derive as Json
import Pia.Mem.Alloc.Allocators
import Pia.Text.Json.Dom.Document
import Pia.Text.Json.Shape.Shapes

let press = type { x : u16; y : u16 } @derive(json, json_dom)

let keypress = type { code : u8; repeat : O.option bool } @derive(json, json_dom)

(* `{"kind": "click", "x": 3, "y": 4}`, `{"kind": "Key", "code": 9}` or
   `{"kind": "Quit"}`. *)
let event = type
  | Click @json(name = "click") of press
  | Key of keypress
  | Quit
  @derive(json, json_dom) @json(tag = "kind")

(* An event from a document, or that it is not one. *)
let get (s : [u8]) (v : Pia.Text.Json.Dom.json) : result event Pia.Text.Json.Shape.nonconforming =
  if check_json_event s v then Ok (from_dom_json_event s v) else Err Nonconforming

(* A click is where its document says. *)
let click_x (s : [u8]) (v : Pia.Text.Json.Dom.json) : u16
  requires conforms_json_event s v
= match from_dom_json_event s v with
  | Click p -> p.x
  | _ -> 0
