(* Importers of Pia.Core.Ratio fold ratios at compile time, as C++'s
   std::ratio does: SI prefixes, sums and products in lowest terms, and
   comparisons checked by `check`. Each `define` makes a function whose
   contract states the exact parts, so proofs use the folded values.
// RUN: mkdir -p %t && piac --emit=interface -o %t %S/../../lib/Pia/Core/Ratio.pia
// RUN: piac --verify --iface-path=%t %s | FileCheck %s
// RUN: not piac --verify --iface-path=%t %S/Inputs/ratio_errors.pia 2>&1 | FileCheck --check-prefix=ERR %s
*)
import Pia.Core.Ratio.Ratio as R

R.define "milli" (R.si "milli")
R.define "kilo" (R.si "kilo")
(* 1/1000 + 1000 = 1000001/1000 *)
R.define "both" (R.add (R.si "milli") (R.si "kilo"))
(* 1/1000 * 1000 = 1 *)
R.define "one" (R.multiply (R.si "milli") (R.si "kilo"))
(* 6/-8 reduces to -3/4 *)
R.define "neg" (R.reduce 6 (0 - 8))
(* 1/3 - 1/2 = -1/6 *)
R.define "diff" (R.subtract (R.reduce 1 3) (R.reduce 1 2))
(* (2/3) / (4/9) = 3/2 *)
R.define "quot" (R.divide (R.reduce 2 3) (R.reduce 4 9))

R.check (R.less (R.si "milli") (R.si "kilo")) "milli < kilo"
R.check (R.equal (R.reduce 2 4) (R.reduce 1 2)) "2/4 = 1/2"
R.check (R.less_equal (R.reduce 1 2) (R.reduce 1 2)) "1/2 <= 1/2"
R.check (R.less (R.reduce (0 - 1) 2) (R.reduce 0 1)) "-1/2 < 0"

let parts (x : u8) : unit
  ensures milli.num = 1 && milli.den = 1000
  ensures kilo.num = 1000 && kilo.den = 1
  ensures both.num = 1000001 && both.den = 1000
  ensures one.num = 1 && one.den = 1
  ensures neg.num = 0 - 3 && neg.den = 4
  ensures diff.num = 0 - 1 && diff.den = 6
  ensures quot.num = 3 && quot.den = 2
= ()

let values (x : u8) : unit
  ensures R.value milli = 0.001
  ensures R.value one = 1.0
= ()

(*
// CHECK-NOT: failed
// CHECK: 0 failed, 0 skipped
// ERR-DAG: a ratio's denominator is 0
// ERR-DAG: a ratio divided by 0
// ERR-DAG: big: the ratio does not fit i64
// ERR-DAG: 1/2 < 1/3
*)
