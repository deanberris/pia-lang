// RUN: FileCheck --check-prefix=DICT %s < %t/Pia.Image.Gif.Spec.Lzw.piai
// RUN: piac --verify --iface-path=%t %S/../../lib/Pia/Image/Gif/Lzw.pia | FileCheck %s
// RUN: FileCheck --check-prefix=LZW %s < %t/Pia.Image.Gif.Lzw.Lzw.piai
*)

(* The spec's own goals: its reads are in bounds and the prefix chains
   it follows end.
// SPEC-NOT: failed
// SPEC: 128 proved, 0 failed, 0 skipped
*)

(* The decoder.
// CHECK-NOT: warning
// CHECK-NOT: failed
// CHECK: 175 proved, 0 failed, 0 skipped
*)

(*
// DICT:      {{^}}module Pia.Image.Gif.Spec{{$}}
// DICT-NEXT: {{^}}interface Lzw = sig{{$}}
// DICT-NEXT: {{^}}  let spec pre : (t : [u8]) -> (k : usize) -> u16{{$}}
// DICT-NEXT: {{^}}  let spec suf : (t : [u8]) -> (k : usize) -> u8{{$}}
// DICT-NEXT: {{^}}  let spec elen : (t : [u8]) -> (clear : usize) -> (k : usize) -> usize{{$}}
// DICT-NEXT: {{^}}  let spec sym : (t : [u8]) -> (clear : usize) -> (k : usize) -> (d : usize) -> usize{{$}}
// DICT-NEXT: {{^}}  let spec entry_ok : (t : [u8]) -> (clear : int{4..256}) -> (k : usize) -> bool{{$}}
// DICT-NEXT: {{^}}  let spec table_ok : (t : [u8]) -> (clear : int{4..256}) -> (nx : usize) -> bool{{$}}
