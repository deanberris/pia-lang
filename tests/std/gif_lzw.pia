(*
// LZW:      {{^}}module Pia.Image.Gif.Lzw{{$}}
// LZW-NEXT: {{^}}interface Lzw = sig{{$}}
// LZW-NEXT: {{^}}  let lzw_error = type | Truncated of usize | BadCode of usize | OutputFull of usize{{$}}
// LZW-NEXT: {{^}}  let entry_len : (t : [u8]) -> (clear : usize) -> (k : int{0..4095}) -> usize requires len t = 12288 ensures result = S.elen t clear k{{$}}
// LZW-NEXT: {{^}}  let put_entry : (t : [u8]) -> (clear : int{4..256}) -> (nx : int{0..4096}) -> (k : usize) -> (dst : borrowed inout mutable [u8]) -> (o : usize) -> (n : usize) -> unit requires len t = 12288 && S.table_ok t clear nx && S.valid clear nx k requires n = S.elen t clear k && o + n <= len dst requires forall (j in 0 .. o). dst.[j] < clear ensures forall (d in 0 .. n). dst.[o + d] = S.sym t clear k d ensures forall (j in 0 .. o + n). dst.[j] < clear ensures forall (j in 0 .. len dst). (j < o || o + n <= j) ==> dst.[j] = old (dst.[j]){{$}}
// LZW-NEXT: {{^}}  let decode : (s : [u8]) -> (m : int{2..8}) -> (t : borrowed inout mutable [u8]) -> (dst : borrowed inout mutable [u8]) -> result usize lzw_error requires len t = 12288 ensures (match result with | Ok n -> n <= len dst | Err _ -> true) ensures (match result with | Ok n -> (forall (i in 0 .. n). dst.[i] < B.pow2 m) | Err _ -> true) ensures (match result with | Ok n -> true | Err e -> (match e with | Truncated p -> p <= B.nbits s | BadCode p -> p < B.nbits s | OutputFull p -> p < B.nbits s)){{$}}
// LZW-NEXT: {{^}}end{{$}}
*)
