(* Importers of Pia.Core.Algo.Modify instantiate its generic functions and
   reason with their contracts alone: the edges are the empty slice, one
   element, and every element (ADR 0040, section 12). The instances are
   discharged by the generic proofs in Modify (ADR 0043).
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Order.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Algo/Modify.pia
// RUN: piac --verify --iface-path=%t %s | FileCheck %s
*)
import Pia.Core.Order.Ops
import Pia.Core.Algo.Modify.Modify as M

(* On an empty slice nothing is written, and nothing fails. *)
let empty (xs : borrowed inout mutable [u16]) (ys : borrowed inout mutable [u16]) : unit
  requires len xs = 0 && len ys = 0
= M.fill xs 9;
  M.copy xs ys;
  M.reverse xs;
  M.swap_ranges xs ys;
  ()

(* One element: reverse leaves it, fill sets it. *)
let one (xs : borrowed inout mutable [i64]) : unit
  requires len xs = 1
= let v = xs.[0] in
  M.reverse xs;
  assert xs.[0] = v;
  M.fill xs (-9223372036854775808);
  assert xs.[0] = -9223372036854775808;
  ()

(* Every element: replace changes exactly the ones that match, by value
   and by predicate. *)
let by_value (xs : borrowed inout mutable [u8]) : unit
  requires len xs = 3 && xs.[0] = 5 && xs.[1] = 6 && xs.[2] = 5
= M.replace xs 5 0;
  assert xs.[0] = 0;
  assert xs.[1] = 6;
  assert xs.[2] = 0;
  M.reverse xs;
  assert xs.[1] = 6;
  ()

let by_predicate (xs : borrowed inout mutable [u8]) : unit
  requires len xs = 3 && xs.[0] = 0 && xs.[1] = 6 && xs.[2] = 0
= M.replace xs (let (x : u8) : bool => x > 0) 255;
  assert xs.[1] = 255;
  assert xs.[0] = 0;
  assert xs.[2] = 0;
  ()

(* Every goal is proved.
// CHECK-NOT: failed
// CHECK: 92 proved, 0 failed, 0 skipped
*)
