(* @derive(json) on a distinct type (ADR 0064, step 4): a length is the
   JSON value it wraps, so `length 5` is the number 5, not an object. The
   reader checks the underlying range as it reads, and makes the value with
   the type's conversion; every goal of the codec is proved.
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Spec.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Lex.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Read.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Write.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Derive.pia
// RUN: piac --verify --iface-path=%t %s | FileCheck %s
// RUN: piac --dump-expanded --iface-path=%t %s | FileCheck %s --check-prefix=AST
// CHECK-NOT: failed
// CHECK: {{[0-9]+}} proved, 0 failed, 0 skipped
*)
import Pia.Text.Json.Spec.Grammar
import Pia.Text.Json.Lex.Lexer
import Pia.Text.Json.Read.Reader
import Pia.Text.Json.Write.Writer
import Pia.Text.Json.Derive.Derive as Json

(* An unsigned length is written with write_u32, ten bytes at most, and
   read with read_uint up to its maximum.
// AST: (LetItem "write_json_length"
// AST: (Name "Pia.Text.Json.Write.write_u32")
*)
let length = type u32 @derive(json)

(* A range type keeps its bounds: -41 and 61 are Range_temp. *)
let temp = type int{-40..60} @derive(json)

(* A bool reads only true or false, so its errors have no Range.
// AST: (LetItem "flag_json_error"
*)
let flag = type bool @derive(json)

(* The derived codec, called as any other. *)
let round (dst : borrowed inout mutable [u8]) (l : length) : usize
  requires len dst = 16
  ensures result <= 10
= write_json_length dst 0 l
