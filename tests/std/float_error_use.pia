(* Pia.Float.Error's kernels through its interface (ADR 0038, step 3): a
   caller states its inputs' bounds, and gets the kernel's result finite
   and within a relative error it can weaken to its own. A neuron of a
   small model, 4096 weights within 1 and activations within 10, is
   within 0.001 of its exact dot product, but not within 1e-6.
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Float/Error.pia
// RUN: not piac --verify --iface-path=%t %s 2>&1 | FileCheck %s
*)
import Pia.Float.Error.Error

(* The dot product of the weights and the activations.
// CHECK: float_error_use.pia:[[@LINE+6]]:{{[0-9]+}}: proved: the postcondition holds [smt]
// CHECK: float_error_use.pia:[[@LINE+6]]:{{[0-9]+}}: proved: the postcondition holds [smt]
*)
let neuron (w : [f32]) (x : [f32]) : f32
  requires len w = len x && len w <= 4096
  requires forall (i in 0..len w). finite w.[i] && finite x.[i] && Pia.Float.Error.near (to_real w.[i]) 0.0 1.0 && Pia.Float.Error.near (to_real x.[i]) 0.0 10.0
  ensures finite result
  ensures Pia.Float.Error.near (to_real result) (Pia.Float.Error.dot_r w x (len w)) (0.001 * Pia.Float.Error.dot_abs w x (len w) + 1.0e-40)
= Pia.Float.Error.dot w x 1.0 10.0 10.0

(* gamma 4096 is about 2.5e-4, so a tighter bound fails.
// CHECK: float_error_use.pia:[[@LINE+5]]:{{[0-9]+}}: failed: the postcondition holds
*)
let tight (w : [f32]) (x : [f32]) : f32
  requires len w = len x && len w <= 4096
  requires forall (i in 0..len w). finite w.[i] && finite x.[i] && Pia.Float.Error.near (to_real w.[i]) 0.0 1.0 && Pia.Float.Error.near (to_real x.[i]) 0.0 10.0
  ensures Pia.Float.Error.near (to_real result) (Pia.Float.Error.dot_r w x (len w)) (0.000001 * Pia.Float.Error.dot_abs w x (len w) + 1.0e-40)
= Pia.Float.Error.dot w x 1.0 10.0 10.0

(* The mean of n values within 1, finite and within 0.001 of the exact sum
   before it is divided.
// CHECK: float_error_use.pia:[[@LINE+5]]:{{[0-9]+}}: proved: the postcondition holds [smt]
*)
let total (xs : [f32]) : f32
  requires len xs <= 4096
  requires forall (i in 0..len xs). finite xs.[i] && Pia.Float.Error.near (to_real xs.[i]) 0.0 1.0
  ensures finite result && Pia.Float.Error.near (to_real result) (Pia.Float.Error.sum_r xs (len xs)) (0.001 * Pia.Float.Error.sum_abs xs (len xs) + 1.0e-40)
= Pia.Float.Error.sum xs 1.0

(* Too long for its bound: 2^24 roundings of f32 may lose every digit,
   so the kernel's precondition fails.
// CHECK: float_error_use.pia:[[@LINE+4]]:{{[0-9]+}}: failed: the precondition of 'Pia.Float.Error.sum' holds
*)
let huge (xs : [f32]) : f32
  requires forall (i in 0..len xs). finite xs.[i] && Pia.Float.Error.near (to_real xs.[i]) 0.0 1.0
= Pia.Float.Error.sum xs 1.0

(*
// CHECK: {{[0-9]+}} proved, 2 failed, 0 skipped
*)
