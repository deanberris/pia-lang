(*
// HI:      {{^}}module Pia.Compress.Huffman{{$}}
// HI-NEXT: {{^}}interface Huffman = sig{{$}}
// HI-NEXT: {{^}}  let fill = type | Complete | Incomplete | Oversubscribed{{$}}
// HI-NEXT: {{^}}  let decoded = type { sym : u16; pos : usize }{{$}}
// HI-NEXT: {{^}}  let spec weight : (l : u8) -> int{0..32768}{{$}}
// HI-NEXT: {{^}}  let spec kcap : (k : int{0..320}) -> u32{{$}}
// HI-NEXT: {{^}}  let spec kraft : (l : [u8]) -> (k : int{0..320}) -> u32{{$}}
// HI-NEXT: {{^}}  let spec len_count : (l : [u8]) -> (k : int{0..320}) -> (bits : int{1..15}) -> int{0..320}{{$}}
// HI-NEXT: {{^}}  let spec first_code : (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..15}) -> u32{{$}}
// HI-NEXT: {{^}}  let spec code_of : (l : [u8]) -> (n : int{0..320}) -> (sym : int{0..319}) -> u32{{$}}
// HI-NEXT: {{^}}  let spec hbits : (s : [u8]) -> (pos : usize) -> (k : int{0..15}) -> u32{{$}}
// HI-NEXT: {{^}}  let spec room : (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..16}) -> bool{{$}}
// HI-NEXT: {{^}}  let spec offs : (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..16}) -> int{0..4800}{{$}}
// HI-NEXT: {{^}}  let spec u16at : (t : [u8]) -> (i : usize) -> u16{{$}}
// HI-NEXT: {{^}}  let spec sym_ok : (t : [u8]) -> (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..15}) -> (i : int{0..319}) -> (r : int{0..320}) -> bool{{$}}
// HI-NEXT: {{^}}  let spec tab_from : (t : [u8]) -> (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..16}) -> bool{{$}}
// HI-NEXT: {{^}}  let spec miss : (s : [u8]) -> (pos : usize) -> (l : [u8]) -> (n : int{0..320}) -> (b : int{1..15}) -> bool{{$}}
// HI-NEXT: {{^}}  let spec none_at : (s : [u8]) -> (pos : usize) -> (l : [u8]) -> (n : int{0..320}) -> bool{{$}}
// HI-NEXT: {{^}}  let build : (l : [u8]) -> (n : int{0..320}) -> (t : borrowed inout mutable [u8]) -> fill requires len t = 704 && n <= len l ensures result = Complete <==> kraft l n = 32768 ensures result = Oversubscribed <==> kraft l n > 32768 ensures tab_from t l n 1{{$}}
// HI-NEXT: {{^}}  let decode : (s : [u8]) -> (pos : usize) -> (t : [u8]) -> (n : int{0..320}) -> (spec l : [u8]) -> (spec h : bool) -> result decoded usize requires len t = 704 && pos <= B.nbits s requires h ==> n <= len l && room l n 1 && tab_from t l n 1 ensures (match result with | Ok d -> pos < d.pos && d.pos - pos <= 15 && d.pos <= B.nbits s && d.sym < n | Err p -> p <= B.nbits s) ensures h ==> (match result with | Ok d -> (if d.sym < len l && d.sym < n && n <= len l && pos < d.pos && d.pos - pos <= 15 then (if l.[d.sym] = d.pos - pos then code_of l n d.sym = hbits s pos (d.pos - pos) else false) else false) | Err _ -> none_at s pos l n){{$}}
// HI-NEXT: {{^}}  let lemma kraft_room : (l : [u8]) -> (n : int{0..320}) -> (b : int{1..16}) -> unit requires n <= len l && kraft l n <= 32768 ensures room l n b{{$}}
// HI-NEXT: {{^}}  let lemma prefix_free : (s : [u8]) -> (p : usize) -> (l : [u8]) -> (n : int{0..320}) -> (a : int{0..319}) -> (b : int{0..319}) -> unit requires a < n && b < n && n <= len l requires 1 <= l.[a] && l.[a] <= 15 && 1 <= l.[b] && l.[b] <= 15 requires p <= B.nbits s && l.[a] <= B.nbits s - p && l.[b] <= B.nbits s - p requires code_of l n a = hbits s p l.[a] && code_of l n b = hbits s p l.[b] ensures a = b{{$}}
// HI-NEXT: {{^}}  let lemma no_code : (s : [u8]) -> (pos : usize) -> (l : [u8]) -> (n : int{0..320}) -> (sym : int{0..319}) -> unit requires pos <= B.nbits s && n <= len l && sym < n && 1 <= l.[sym] && l.[sym] <= 15 requires none_at s pos l n ensures l.[sym] > B.nbits s - pos || code_of l n sym <> hbits s pos l.[sym]{{$}}
// HI-NEXT: {{^}}end{{$}}
*)

(*
// II:      {{^}}module Pia.Compress.Inflate{{$}}
// II-NEXT: {{^}}interface Inflate = sig{{$}}
// II-NEXT: {{^}}  let inflate_error = type | Ends of usize | BadBlock of usize | BadCode of usize | BadLengths of usize | TooFar of usize | Full of usize{{$}}
// II-NEXT: {{^}}  let inflated = type { written : usize; pos : usize }{{$}}
// II-NEXT: {{^}}  let inflate : (s : [u8]) -> (pos : usize) -> (dst : borrowed inout mutable [u8]) -> (lb : borrowed inout mutable [u8]) -> (ltab : borrowed inout mutable [u8]) -> (dtab : borrowed inout mutable [u8]) -> result inflated inflate_error requires len s <= 1152921504606846975 && pos <= B.nbits s requires len lb = 320 && len ltab = 704 && len dtab = 704 ensures (match result with | Ok r -> r.written <= len dst && pos < r.pos && r.pos <= B.nbits s | Err _ -> true){{$}}
// II-NEXT: {{^}}end{{$}}
*)

(*
// ZI:      {{^}}module Pia.Compress.Zlib{{$}}
// ZI-NEXT: {{^}}interface Zlib = sig{{$}}
// ZI-NEXT: {{^}}  let zlib_error = type | ZHeader of usize | ZData of usize | ZChecksum of usize | ZEnds of usize{{$}}
// ZI-NEXT: {{^}}  let zout = type { n : usize; trailer : usize }{{$}}
// ZI-NEXT: {{^}}  let spec adler_a : (s : [u8]) -> (k : usize) -> u32{{$}}
// ZI-NEXT: {{^}}  let spec adler_b : (s : [u8]) -> (k : usize) -> u32{{$}}
// ZI-NEXT: {{^}}  let spec adler : (s : [u8]) -> (k : usize) -> u32{{$}}
// ZI-NEXT: {{^}}  let spec be32 : (s : [u8]) -> (q : usize) -> u32{{$}}
// ZI-NEXT: {{^}}  let adler32 : (s : [u8]) -> (n : usize) -> u32 requires n <= len s ensures result = adler s n{{$}}
// ZI-NEXT: {{^}}  let decompress : (s : [u8]) -> (dst : borrowed inout mutable [u8]) -> (lb : borrowed inout mutable [u8]) -> (ltab : borrowed inout mutable [u8]) -> (dtab : borrowed inout mutable [u8]) -> result zout zlib_error requires len s <= 1152921504606846975 requires len lb = 320 && len ltab = 704 && len dtab = 704 ensures (match result with | Ok r -> r.n <= len dst && r.trailer < len s && 4 <= len s - r.trailer && be32 s r.trailer = adler dst r.n | Err _ -> true){{$}}
// ZI-NEXT: {{^}}end{{$}}
*)
