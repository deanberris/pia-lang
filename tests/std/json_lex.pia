(* Pia.Text.Json.Spec and Pia.Text.Json.Lex (ADR 0045, step 1): every goal
   of the grammar and of the tokenizer is proved, with nothing accepted
   unproved: the lexer's reads are in bounds, its loops end, and each
   token it returns is one of its kind by the grammar.
// RUN: piac --verify %S/../../lib/Pia/Text/Json/Spec.pia | FileCheck --check-prefix=SPEC %s
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Spec.pia
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Text/Json/Lex.pia
// RUN: FileCheck --check-prefix=GRAMMAR %s < %t/Pia.Text.Json.Spec.Grammar.piai
// RUN: piac --verify --iface-path=%t %S/../../lib/Pia/Text/Json/Lex.pia | FileCheck %s
// RUN: FileCheck --check-prefix=LEXER %s < %t/Pia.Text.Json.Lex.Lexer.piai
*)

(* The grammar's own goals: its reads are in bounds and its recursive
   definitions terminate.
// SPEC-NOT: failed
// SPEC-DAG: proved: the measure of 'num_run' decreases [smt]
// SPEC-DAG: proved: the measure of 'chars' decreases [smt]
// SPEC: 121 proved, 0 failed, 0 skipped
*)

