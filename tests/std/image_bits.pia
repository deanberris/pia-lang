// IFACE-NEXT: {{^}}  let spec nbits : (s : [u8]) -> usize{{$}}
// IFACE-NEXT: {{^}}  let spec bits_at : (s : [u8]) -> (pos : usize) -> (n : int{0..16}) -> u32{{$}}
// IFACE-NEXT: {{^}}  let spec byte_or0 : (s : [u8]) -> (j : usize) -> u8{{$}}
// IFACE-NEXT: {{^}}  let spec win : (s : [u8]) -> (q : usize) -> u32{{$}}
// IFACE-NEXT: {{^}}  let spec field : (n : int{0..16}) -> (r : int{0..7}) -> u32{{$}}
// IFACE-NEXT: {{^}}  let bit_len : (s : [u8]) -> usize ensures result = nbits s{{$}}
// IFACE-NEXT: {{^}}  let read_bits : (s : [u8]) -> (pos : usize) -> (n : int{0..16}) -> u32 requires pos + n <= nbits s ensures result = bits_at s pos n ensures result < pow2 n{{$}}
// IFACE-NEXT: {{^}}  let write_bits : (dst : borrowed inout mutable [u8]) -> (pos : usize) -> (n : int{0..16}) -> (v : u32) -> unit requires v < pow2 n requires pos + n <= nbits dst ensures bits_at dst pos n = v ensures forall (k in 0 .. len dst). (k < pos / 8 || pos + n <= 8 * k) ==> dst.[k] = old (dst.[k]) ensures win dst (pos / 8) = ((old (win dst (pos / 8)) & ~(field n (pos % 8))) | (v << (pos % 8))){{$}}
// IFACE-NEXT: {{^}}end{{$}}
