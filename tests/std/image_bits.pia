(* Pia.Image.Bits (ADR 0054, step 1): LSB-first bit fields over a byte
   slice. read_bits and write_bits are proved against bits_at, the field
   as the bits it is made of, through the window lemma.
// RUN: piac --verify %S/../../lib/Pia/Image/Bits.pia | FileCheck %s
// RUN: mkdir -p %t && piac --emit=interface -o %t %S/../../lib/Pia/Image/Bits.pia
// RUN: FileCheck --check-prefix=IFACE %s < %t/Pia.Image.Bits.Bits.piai
*)

(* Every goal is proved, with no warning.
// CHECK-NOT: warning
// CHECK-NOT: failed
// CHECK: 177 proved, 0 failed, 0 skipped
*)

