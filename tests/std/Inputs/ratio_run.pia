(* Runs code made by Pia.Core.Ratio's metaprograms, linked by pia_binary:
   0 when each folded ratio has the parts C++'s std::ratio gives, and
   otherwise the number of the first wrong one. *)
import Pia.Core.Ratio.Ratio as R

R.define "nano" (R.si "nano")
R.define "sum" (R.add (R.reduce 1 6) (R.reduce 1 3))
R.define "big" (R.multiply (R.si "giga") (R.si "giga"))

let main () : i32 =
  if nano.num <> 1 || nano.den <> 1000000000 then 1
  else if sum.num <> 1 || sum.den <> 2 then 2
  else if big.num <> 1000000000000000000 || big.den <> 1 then 3
  else 0
