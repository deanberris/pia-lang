(* Runs Pia.Core.Algo.Heap's compiled code on a buffer in an arena, linked
   by pia_binary: 0 when every result is what C++'s heap algorithms give,
   and otherwise the number of the first wrong one. *)
import Pia.Fn.Laws
import Pia.Core.Order.Ops
import Pia.Core.Algo.Permutation.Permutation as P
import Pia.Core.Algo.Sort.Sort as S
import Pia.Core.Algo.Heap.Heap as H

let checks (xs : borrowed inout mutable [u8]) : i32
  requires len xs = 6
= xs.[0] <- 3; xs.[1] <- 1; xs.[2] <- 4; xs.[3] <- 1; xs.[4] <- 5; xs.[5] <- 9;
  if H.is_heap xs (let (a : u8) (b : u8) : bool => a < b) then 1
  else if H.is_heap_until xs (let (a : u8) (b : u8) : bool => a < b) <> 2 then 2
  else (
    H.make_heap xs (let (a : u8) (b : u8) : bool => a < b);
    if xs.[0] <> 9 || H.is_heap xs (let (a : u8) (b : u8) : bool => a < b) = false then 3
    else (
      H.pop_heap xs (let (a : u8) (b : u8) : bool => a < b) 6;
      if xs.[5] <> 9 || xs.[0] <> 5 then 4
      else (
        H.push_heap xs (let (a : u8) (b : u8) : bool => a < b);
        if xs.[0] <> 9 then 5
        else (
          H.sort_heap xs (let (a : u8) (b : u8) : bool => a < b);
          if xs.[0] <> 1 || xs.[1] <> 1 || xs.[2] <> 3 || xs.[3] <> 4 || xs.[4] <> 5 || xs.[5] <> 9 then 6
          else (
            H.sort xs (let (a : u8) (b : u8) : bool => a > b);
            if xs.[0] <> 9 || xs.[1] <> 5 || xs.[5] <> 1 then 7
            else 0)))))

let main () : i32 = with_arena 6 (let (m) => checks m.mem)
