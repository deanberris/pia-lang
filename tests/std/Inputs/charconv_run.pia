(* Runs Pia.Core.Charconv's compiled code on buffers in an arena, linked by
   pia_binary: 0 when every from_chars and to_chars result is what C++'s
   gives, and otherwise the number of the first wrong one. *)
import Pia.Core.Charconv.Charconv as C

let checks (s : borrowed inout mutable [u8]) : i32
  requires len s = 4
= s.[0] <- 52; s.[1] <- 50; s.[2] <- 32; s.[3] <- 55;
  let a : u32 = 7 in
  let r = C.from_chars s 10 a in
  if r.used <> 2 || C.is_ok (r.ec) = false || r.value <> 42 then 1
  else (
    s.[0] <- 70; s.[1] <- 102; s.[2] <- 103; s.[3] <- 48;
    let b : u8 = 0 in
    let h = C.from_chars s 16 b in
    if h.used <> 2 || h.value <> 255 then 2
    else (
      s.[0] <- 50; s.[1] <- 53; s.[2] <- 54; s.[3] <- 32;
      let c : u8 = 9 in
      let o = C.from_chars s 10 c in
      if o.used <> 3 || C.is_out_of_range (o.ec) = false || o.value <> 9 then 3
      else (
        s.[0] <- 45; s.[1] <- 49; s.[2] <- 50; s.[3] <- 56;
        let d : i8 = 0 in
        let n = C.from_chars s 10 d in
        if n.used <> 4 || C.is_ok (n.ec) = false || n.value <> -128 then 4
        else (
          s.[0] <- 45; s.[1] <- 120;
          let e : i32 = 5 in
          let m = C.from_chars s 10 e in
          if m.used <> 0 || C.is_invalid (m.ec) = false || m.value <> 5 then 5
          else (
            s.[0] <- 49; s.[1] <- 48; s.[2] <- 49; s.[3] <- 50;
            let f : u16 = 0 in
            let t = C.from_chars s 2 f in
            if t.used <> 3 || t.value <> 5 then 6
            else (
              let x : u32 = 42 in
              let w = C.to_chars s x 10 in
              if w.ok = false || w.used <> 2 || s.[0] <> 52 || s.[1] <> 50 then 7
              else (
                let y : u8 = 255 in
                let h2 = C.to_chars s y 16 in
                if h2.ok = false || h2.used <> 2 || s.[0] <> 102 || s.[1] <> 102 then 8
                else (
                  let z : i8 = -128 in
                  let n2 = C.to_chars s z 10 in
                  if n2.ok = false || n2.used <> 4 || s.[0] <> 45 || s.[1] <> 49 || s.[2] <> 50 || s.[3] <> 56 then 9
                  else (
                    let big : u64 = 100000 in
                    let f2 = C.to_chars s big 10 in
                    if f2.ok then 10
                    else (
                      let zero : u16 = 0 in
                      let z2 = C.to_chars s zero 2 in
                      if z2.ok = false || z2.used <> 1 || s.[0] <> 48 then 11
                      else 0))))))))))

let main () : i32 = with_arena 4 (let (m) => checks m.mem)
