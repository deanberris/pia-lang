 23; 12; 157; 76; 55; 12; 192; 64; 71; 246; 192; 129; 161; 222; 80; 36; 10; 12; 116; 177; 74; 54; 24; 232; 124; 59; 208; 169; 19; 21; 208; 176; 72; 28; 170; 69; 228; 64; 71; 9; 157; 1; 169; 165; 213; 176; 2; 3; 93; 138; 14; 34; 48; 208; 229; 50; 137; 128; 142; 5; 215; 224; 4; 3; 93; 76; 226; 4; 3; 93; 160; 13; 8; 24; 232; 212; 64; 111; 48; 208; 137; 12; 1; 104; 16; 153; 3; 93; 43; 13; 122; 48; 208; 117; 213; 208; 0; 3; 93; 69; 146; 10; 6; 186; 76; 25; 36; 96; 160; 11; 52; 170; 3; 26; 148; 144; 52; 2; 3; 29; 245; 244; 7; 195; 56; 194; 71; 43; 40; 58; 128; 129; 174; 51; 80; 192; 64; 103; 38; 12; 48; 200; 50; 209; 144; 240; 247; 160; 8; 41; 188; 96; 32; 11; 22; 252; 96; 160; 75; 131; 65; 1; 6; 186; 20; 162; 63; 24; 136; 76; 55; 40; 0; 189; 115; 62; 29; 192; 128; 21; 166; 36; 185; 114; 180; 0; 26; 232; 60; 63; 136; 192; 80; 106; 59; 208; 40; 215; 210; 19; 80; 55; 184; 7; 87; 244; 16; 31; 111; 244; 47; 116; 134; 84; 46; 162; 29; 24; 160; 4; 48; 120; 192; 0; 100; 121; 178; 192; 176; 140; 184; 129; 8; 200; 161; 215; 67; 163; 113; 81; 53; 76; 192; 64; 148; 158; 67; 6; 12; 182; 140; 61; 208; 225; 49; 184; 0; 189; 99; 103; 192; 1; 61; 202; 121; 218; 1; 106; 214; 32; 131; 166; 146; 25; 12; 96; 160; 171; 144; 193; 1; 6; 186; 52; 26; 116; 96; 72; 151; 55; 3; 29; 120; 184; 0; 229; 129; 58; 204; 0; 13; 226; 126; 180; 208; 39; 14; 12; 116; 137; 139; 11; 12; 116; 30; 69; 7; 3; 157; 69; 200; 1; 67; 182; 128; 196; 2; 6; 58; 44; 7; 30; 80; 181; 140; 27; 98; 96; 160; 75; 73; 58; 130; 129; 46; 120; 233; 8; 6; 186; 76; 25; 0; 48; 208; 133; 8; 57; 128; 6; 173; 179; 65; 0; 6; 58; 37; 12; 1; 48; 208; 9; 143; 104; 64; 82; 196; 15; 116; 93; 134; 7; 12; 116; 221; 67; 25; 24; 232; 234; 100; 112; 0; 0]

(* FNV-1a over the first n bytes of b. *)
let fnv (b : [u8]) (n : usize) : u32 @overflow(wrap)
  requires n <= len b
= let h : mutable u32 = 2166136261 in
  for i in 0 .. n do
    let x : u32 = b.[i] in
    h <- (h ^ x) * 16777619
  done;
  h

(* The zlib stream s decompresses to n bytes hashing to want. *)
let zlib_is (s : [u8]) (n : usize) (want : u32) (m : borrowed inout mutable [u8]) : bool
  requires len m = 131072
= if len s > 65536 then false
  else (
    let dst = m.[0 .. 65536] in
    match Z.decompress s dst (m.[65536 .. 65856]) (m.[66560 .. 67264]) (m.[67584 .. 68288]) with
    | Ok r -> r.n = n && fnv (m.[0 .. 65536]) r.n = want
    | Err _ -> false)

(* The raw deflate stream s decompresses to n bytes hashing to want. *)
let raw_is (s : [u8]) (n : usize) (want : u32) (m : borrowed inout mutable [u8]) : bool
  requires len m = 131072
= if len s > 65536 then false
  else (
    let dst = m.[0 .. 65536] in
    match I.inflate s 0 dst (m.[65536 .. 65856]) (m.[66560 .. 67264]) (m.[67584 .. 68288]) with
    | Ok r -> r.written = n && fnv (m.[0 .. 65536]) r.written = want
    | Err _ -> false)

(* Every prefix of s shorter than s fails. *)
let truncations (s : [u8]) (m : borrowed inout mutable [u8]) : bool
  requires len m = 131072 && len s <= 65536
= let bad : mutable bool = false in
  for k in 0 .. len s do
    match Z.decompress (s.[0 .. k]) (m.[0 .. 65536]) (m.[65536 .. 65856]) (m.[66560 .. 67264]) (m.[67584 .. 68288]) with
    | Ok _ -> bad <- true
    | Err _ -> ()
  done;
  bad = false

(* s with its last byte changed is ZChecksum; c is the copy. *)
let checksum_caught (s : [u8]) (c : borrowed inout mutable [u8]) (m : borrowed inout mutable [u8]) : bool
  requires len m = 131072 && len c = len s && len s > 0 && len s <= 65536
= for j in 0 .. len s do c.[j] <- s.[j] done;
  c.[len s - 1] <- c.[len s - 1] ^ 1;
  match Z.decompress c (m.[0 .. 65536]) (m.[65536 .. 65856]) (m.[66560 .. 67264]) (m.[67584 .. 68288]) with
  | Ok _ -> false
  | Err e -> (match e with | ZChecksum _ -> true | _ -> false)

(* s with each byte flipped in turn decodes or fails, never crashing;
   returns how many of them still decoded. *)
let flips (s : [u8]) (c : borrowed inout mutable [u8]) (m : borrowed inout mutable [u8]) : usize
  requires len m = 131072 && len c = len s && len s <= 65536
= let ok : mutable usize = 0 in
  for p in 0 .. len s
    invariant ok <= p
  do
    for j in 0 .. len s do c.[j] <- s.[j] done;
    c.[p] <- c.[p] ^ 0xFF;
    match Z.decompress c (m.[0 .. 65536]) (m.[65536 .. 65856]) (m.[66560 .. 67264]) (m.[67584 .. 68288]) with
    | Ok _ -> ok <- ok + 1
    | Err _ -> ()
  done;
  ok

let run (m : borrowed inout mutable [u8]) (c : borrowed inout mutable [u8]) : i32
  requires len m = 131072 && len c = 65536
= if zlib_is empty 0 2166136261 m = false then 1 else
  if zlib_is text_stored 2720 1405955437 m = false then 2 else
  if zlib_is text_fast 2720 1405955437 m = false then 3 else
  if zlib_is text_best 2720 1405955437 m = false then 4 else
  if zlib_is text_fixed 2720 1405955437 m = false then 5 else
  if zlib_is noise 3000 2586072193 m = false then 6 else
  if zlib_is runs 56760 1238469252 m = false then 7 else
  if zlib_is runs_rle 56760 1238469252 m = false then 8 else
  if zlib_is mid 6720 1790379493 m = false then 9 else
  if zlib_is far 43000 54563477 m = false then 10 else
  if zlib_is window 33000 1590389925 m = false then 11 else
  if raw_is raw_text 2720 1405955437 m = false then 12 else
  if raw_is raw_fixed 56760 1238469252 m = false then 13 else
  if truncations text_best m = false then 14 else
  if truncations text_fixed m = false then 15 else
  if truncations text_stored m = false then 16 else
  if checksum_caught runs (c.[0 .. len runs]) m = false then 17 else
  if flips text_best (c.[0 .. len text_best]) m > len text_best then 18 else
  if flips runs (c.[0 .. len runs]) m > len runs then 19 else
  0

let main () : i32 = with_arena 196608 (let (a) => run (a.mem.[0 .. 131072]) (a.mem.[131072 .. 196608]))
