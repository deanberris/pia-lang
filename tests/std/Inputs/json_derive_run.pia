(* Runs the code @derive(json) makes (ADR 0045, step 4), linked by
   pia_binary: it writes a record and checks the bytes, reads them back,
   reads members in another order with whitespace, and checks that each
   kind of bad input is the error it should be, at the place it should be.
   It exits 0 when all is as expected, and otherwise with the number of
   the first check that is not. *)
import Pia.Text.Json.Spec.Grammar
import Pia.Text.Json.Lex.Lexer
import Pia.Text.Json.Read.Reader
import Pia.Text.Json.Write.Writer

let point = type { x : i32 @json(name = "xx"); y : u8; ok : bool } @derive(json)

(* No integer field, so its errors have no Range. *)
let flags = type { a : bool; b : bool } @derive(json)

(* A range type and the widest unsigned type. *)
let level = type { n : int{1..20}; total : u64 } @derive(json)

(* Whether e is the error of kind k at p: 1 Syntax, 2 Unknown,
   3 Duplicate, 4 Missing, 5 Range. *)
let is (e : point_json_error) (k : u8) (p : usize) : bool =
  match e with
  | Syntax_point q -> k = 1 && q = p | Unknown_point q -> k = 2 && q = p
  | Duplicate_point q -> k = 3 && q = p | Missing_point q -> k = 4 && q = p
  | Range_point q -> k = 5 && q = p

let flag_is (e : flags_json_error) (k : u8) (p : usize) : bool =
  match e with
  | Syntax_flags q -> k = 1 && q = p | Unknown_flags q -> k = 2 && q = p
  | Duplicate_flags q -> k = 3 && q = p | Missing_flags q -> k = 4 && q = p

let level_is (e : level_json_error) (k : u8) (p : usize) : bool =
  match e with
  | Syntax_level q -> k = 1 && q = p | Unknown_level q -> k = 2 && q = p
  | Duplicate_level q -> k = 3 && q = p | Missing_level q -> k = 4 && q = p
  | Range_level q -> k = 5 && q = p

(* Reading s fails with the error of kind k at p. *)
let fails (s : [u8]) (k : u8) (p : usize) : bool =
  match read_json_point s 0 with
  | Ok _ -> false
  | Err e -> is e k p

let level_fails (s : [u8]) (k : u8) (p : usize) : bool =
  match read_json_level s 0 with
  | Ok _ -> false
  | Err e -> level_is e k p

let doc (buf : borrowed inout mutable [u8]) : i32
  requires len buf = 64
=
  let want : [u8; 27] = [
    0x7B; 0x22; 0x78; 0x78; 0x22; 0x3A; 0x2D; 0x35; 0x2C; 0x22;
    0x79; 0x22; 0x3A; 0x32; 0x30; 0x30; 0x2C; 0x22; 0x6F; 0x6B;
    0x22; 0x3A; 0x74; 0x72; 0x75; 0x65; 0x7D ] in
  let other : [u8; 45] = [
    0x20; 0x7B; 0x0A; 0x20; 0x22; 0x6F; 0x6B; 0x22; 0x20; 0x3A;
    0x20; 0x66; 0x61; 0x6C; 0x73; 0x65; 0x20; 0x2C; 0x20; 0x22;
    0x79; 0x22; 0x3A; 0x37; 0x2C; 0x09; 0x22; 0x78; 0x78; 0x22;
    0x3A; 0x20; 0x32; 0x31; 0x34; 0x37; 0x34; 0x38; 0x33; 0x36;
    0x34; 0x37; 0x20; 0x7D; 0x20 ] in
  let fl : [u8; 20] = [
    0x7B; 0x22; 0x62; 0x22; 0x3A; 0x74; 0x72; 0x75; 0x65; 0x2C;
    0x22; 0x61; 0x22; 0x3A; 0x66; 0x61; 0x6C; 0x73; 0x65; 0x7D ] in
  let flm : [u8; 10] = [
    0x7B; 0x22; 0x61; 0x22; 0x3A; 0x74; 0x72; 0x75; 0x65; 0x7D ] in
  let lv : [u8; 37] = [
    0x7B; 0x22; 0x74; 0x6F; 0x74; 0x61; 0x6C; 0x22; 0x3A; 0x31;
    0x38; 0x34; 0x34; 0x36; 0x37; 0x34; 0x34; 0x30; 0x37; 0x33;
    0x37; 0x30; 0x39; 0x35; 0x35; 0x31; 0x36; 0x31; 0x35; 0x2C;
    0x22; 0x6E; 0x22; 0x3A; 0x32; 0x30; 0x7D ] in
  let lz : [u8; 17] = [
    0x7B; 0x22; 0x74; 0x6F; 0x74; 0x61; 0x6C; 0x22; 0x3A; 0x31;
    0x2C; 0x22; 0x6E; 0x22; 0x3A; 0x30; 0x7D ] in
  let lo : [u8; 36] = [
    0x7B; 0x22; 0x74; 0x6F; 0x74; 0x61; 0x6C; 0x22; 0x3A; 0x31;
    0x38; 0x34; 0x34; 0x36; 0x37; 0x34; 0x34; 0x30; 0x37; 0x33;
    0x37; 0x30; 0x39; 0x35; 0x35; 0x31; 0x36; 0x31; 0x36; 0x2C;
    0x22; 0x6E; 0x22; 0x3A; 0x31; 0x7D ] in
  let dup : [u8; 31] = [
    0x7B; 0x22; 0x78; 0x78; 0x22; 0x3A; 0x31; 0x2C; 0x22; 0x78;
    0x78; 0x22; 0x3A; 0x32; 0x2C; 0x22; 0x79; 0x22; 0x3A; 0x31;
    0x2C; 0x22; 0x6F; 0x6B; 0x22; 0x3A; 0x74; 0x72; 0x75; 0x65;
    0x7D ] in
  let miss : [u8; 14] = [
    0x7B; 0x22; 0x78; 0x78; 0x22; 0x3A; 0x31; 0x2C; 0x22; 0x79;
    0x22; 0x3A; 0x31; 0x7D ] in
  let big : [u8; 26] = [
    0x7B; 0x22; 0x78; 0x78; 0x22; 0x3A; 0x31; 0x2C; 0x22; 0x79;
    0x22; 0x3A; 0x32; 0x35; 0x36; 0x2C; 0x22; 0x6F; 0x6B; 0x22;
    0x3A; 0x74; 0x72; 0x75; 0x65; 0x7D ] in
  let unk : [u8; 8] = [
    0x7B; 0x22; 0x7A; 0x7A; 0x22; 0x3A; 0x31; 0x7D ] in
  let badlit : [u8; 23] = [
    0x7B; 0x22; 0x78; 0x78; 0x22; 0x3A; 0x31; 0x2C; 0x22; 0x79;
    0x22; 0x3A; 0x31; 0x2C; 0x22; 0x6F; 0x6B; 0x22; 0x3A; 0x74;
    0x72; 0x75; 0x7D ] in
  let frac : [u8; 26] = [
    0x7B; 0x22; 0x78; 0x78; 0x22; 0x3A; 0x31; 0x2E; 0x35; 0x2C;
    0x22; 0x79; 0x22; 0x3A; 0x31; 0x2C; 0x22; 0x6F; 0x6B; 0x22;
    0x3A; 0x74; 0x72; 0x75; 0x65; 0x7D ] in
  let neg : [u8; 34] = [
    0x7B; 0x22; 0x78; 0x78; 0x22; 0x3A; 0x2D; 0x32; 0x31; 0x34;
    0x37; 0x34; 0x38; 0x33; 0x36; 0x34; 0x39; 0x2C; 0x22; 0x79;
    0x22; 0x3A; 0x31; 0x2C; 0x22; 0x6F; 0x6B; 0x22; 0x3A; 0x74;
    0x72; 0x75; 0x65; 0x7D ] in
  let ulow : [u8; 25] = [
    0x7B; 0x22; 0x78; 0x78; 0x22; 0x3A; 0x31; 0x2C; 0x22; 0x79;
    0x22; 0x3A; 0x2D; 0x31; 0x2C; 0x22; 0x6F; 0x6B; 0x22; 0x3A;
    0x74; 0x72; 0x75; 0x65; 0x7D ] in
  for k in 0 .. 64 do buf.[k] <- 0x20 done;
  let p = { x = -5; y = 200; ok = true } in
  let e = write_json_point buf 0 p in
  let bad : mutable i32 = 0 in
  if e <> 27 then 1
  else (
    for k in 0 .. 27 do
      if bad = 0 && buf.[k] <> want.[k] then bad <- 100 + k
    done;
    if bad <> 0 then bad
    else
      (match read_json_point buf 0 with
       | Err _ -> 2
       | Ok r ->
           if r.value.x <> -5 || r.value.y <> 200 || r.value.ok = false || r.stop <> 27 then 3
           else
             (match read_json_point other 0 with
              | Err _ -> 4
              | Ok q ->
                  if q.value.x <> 2147483647 || q.value.y <> 7 || q.value.ok then 5
                  else
                    (match read_json_flags fl 0 with
                     | Err _ -> 6
                     | Ok f ->
                         if f.value.a || f.value.b = false then 7
                         else
                           (match read_json_flags flm 0 with
                            | Ok _ -> 8
                            | Err g ->
                                if flag_is g 4 10 = false then 9
                                else
                                  (match read_json_level lv 0 with
                                   | Err _ -> 10
                                   | Ok l ->
                                       if l.value.n <> 20 || l.value.total <> 18446744073709551615 then 11
                                       else if level_fails lz 5 15 = false then 12
                                       else if level_fails lo 5 9 = false then 13
                                       else if fails dup 3 8 = false then 14
                                       else if fails miss 4 14 = false then 15
                                       else if fails big 5 12 = false then 16
                                       else if fails unk 2 1 = false then 17
                                       else if fails badlit 1 19 = false then 18
                                       else if fails frac 5 6 = false then 19
                                       else if fails neg 5 6 = false then 20
                                       else if fails ulow 5 12 = false then 21
                                       else 0))))))

let main () : i32 = with_arena 64 (let (m) => doc m.mem)
