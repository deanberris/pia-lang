(* Runs the code @derive(json) makes for fixed-array fields (ADR 0045,
   step 5), linked by pia_binary: an array writes as `[...]`, reads back,
   and too few or too many values is Length at the place it shows. It
   exits 0 when all is as expected, and otherwise with the number of the
   first check that is not. *)
import Pia.Core.Order.Ops
import Pia.Core.Option.Optional as O
import Pia.Text.Json.Spec.Grammar
import Pia.Text.Json.Lex.Lexer
import Pia.Text.Json.Read.Reader
import Pia.Text.Json.Write.Writer
import Pia.Text.Json.Derive.Derive as Json

let pix = type { rgb : [u8; 3]; flags : [bool; 2]; n : u8 } @derive(json)

(* Whether e is the error of kind k at p: 1 Syntax, 2 Unknown,
   3 Duplicate, 4 Missing, 5 Range, 6 Length. *)
let is (e : pix_json_error) (k : u8) (p : usize) : bool =
  match e with
  | Syntax_pix q -> k = 1 && q = p | Unknown_pix q -> k = 2 && q = p
  | Duplicate_pix q -> k = 3 && q = p | Missing_pix q -> k = 4 && q = p
  | Range_pix q -> k = 5 && q = p | Length_pix q -> k = 6 && q = p

let fails (s : [u8]) (k : u8) (p : usize) : bool =
  match read_json_pix s 0 with | Ok _ -> false | Err e -> is e k p

let doc (buf : borrowed inout mutable [u8]) : i32
  requires len buf = 64
=
  let want : [u8; 45] = [
    0x7B; 0x22; 0x72; 0x67; 0x62; 0x22; 0x3A; 0x5B; 0x31; 0x2C;
    0x32; 0x30; 0x2C; 0x32; 0x35; 0x35; 0x5D; 0x2C; 0x22; 0x66;
    0x6C; 0x61; 0x67; 0x73; 0x22; 0x3A; 0x5B; 0x74; 0x72; 0x75;
    0x65; 0x2C; 0x66; 0x61; 0x6C; 0x73; 0x65; 0x5D; 0x2C; 0x22;
    0x6E; 0x22; 0x3A; 0x37; 0x7D ] in
  let other : [u8; 63] = [
    0x7B; 0x20; 0x22; 0x6E; 0x22; 0x20; 0x3A; 0x20; 0x30; 0x2C;
    0x20; 0x22; 0x66; 0x6C; 0x61; 0x67; 0x73; 0x22; 0x20; 0x3A;
    0x20; 0x5B; 0x20; 0x66; 0x61; 0x6C; 0x73; 0x65; 0x20; 0x2C;
    0x20; 0x74; 0x72; 0x75; 0x65; 0x20; 0x5D; 0x20; 0x2C; 0x20;
    0x22; 0x72; 0x67; 0x62; 0x22; 0x20; 0x3A; 0x20; 0x5B; 0x20;
    0x30; 0x20; 0x2C; 0x20; 0x30; 0x20; 0x2C; 0x20; 0x39; 0x20;
    0x5D; 0x20; 0x7D ] in
  let few : [u8; 39] = [
    0x7B; 0x22; 0x72; 0x67; 0x62; 0x22; 0x3A; 0x5B; 0x31; 0x2C;
    0x32; 0x5D; 0x2C; 0x22; 0x66; 0x6C; 0x61; 0x67; 0x73; 0x22;
    0x3A; 0x5B; 0x74; 0x72; 0x75; 0x65; 0x2C; 0x74; 0x72; 0x75;
    0x65; 0x5D; 0x2C; 0x22; 0x6E; 0x22; 0x3A; 0x30; 0x7D ] in
  let many : [u8; 43] = [
    0x7B; 0x22; 0x72; 0x67; 0x62; 0x22; 0x3A; 0x5B; 0x31; 0x2C;
    0x32; 0x2C; 0x33; 0x2C; 0x34; 0x5D; 0x2C; 0x22; 0x66; 0x6C;
    0x61; 0x67; 0x73; 0x22; 0x3A; 0x5B; 0x74; 0x72; 0x75; 0x65;
    0x2C; 0x74; 0x72; 0x75; 0x65; 0x5D; 0x2C; 0x22; 0x6E; 0x22;
    0x3A; 0x30; 0x7D ] in
  let empty : [u8; 36] = [
    0x7B; 0x22; 0x72; 0x67; 0x62; 0x22; 0x3A; 0x5B; 0x5D; 0x2C;
    0x22; 0x66; 0x6C; 0x61; 0x67; 0x73; 0x22; 0x3A; 0x5B; 0x74;
    0x72; 0x75; 0x65; 0x2C; 0x74; 0x72; 0x75; 0x65; 0x5D; 0x2C;
    0x22; 0x6E; 0x22; 0x3A; 0x30; 0x7D ] in
  let big : [u8; 43] = [
    0x7B; 0x22; 0x72; 0x67; 0x62; 0x22; 0x3A; 0x5B; 0x31; 0x2C;
    0x32; 0x2C; 0x32; 0x35; 0x36; 0x5D; 0x2C; 0x22; 0x66; 0x6C;
    0x61; 0x67; 0x73; 0x22; 0x3A; 0x5B; 0x74; 0x72; 0x75; 0x65;
    0x2C; 0x74; 0x72; 0x75; 0x65; 0x5D; 0x2C; 0x22; 0x6E; 0x22;
    0x3A; 0x30; 0x7D ] in
  let notarr : [u8; 35] = [
    0x7B; 0x22; 0x72; 0x67; 0x62; 0x22; 0x3A; 0x31; 0x2C; 0x22;
    0x66; 0x6C; 0x61; 0x67; 0x73; 0x22; 0x3A; 0x5B; 0x74; 0x72;
    0x75; 0x65; 0x2C; 0x74; 0x72; 0x75; 0x65; 0x5D; 0x2C; 0x22;
    0x6E; 0x22; 0x3A; 0x30; 0x7D ] in
  for k in 0 .. 64 do buf.[k] <- 0x20 done;
  let c : [u8; 3] = [1; 20; 255] in
  let f : [bool; 2] = [true; false] in
  let p = { rgb = c; flags = f; n = 7 } in
  let e = write_json_pix buf 0 p in
  let bad : mutable i32 = 0 in
  if e <> 45 then 1
  else (
    for k in 0 .. 45 do
      if bad = 0 && buf.[k] <> want.[k] then bad <- 100 + k
    done;
    if bad <> 0 then bad
    else
      (match read_json_pix buf 0 with
       | Err _ -> 2
       | Ok r ->
           if r.value.rgb.[0] <> 1 || r.value.rgb.[1] <> 20 || r.value.rgb.[2] <> 255
              || r.value.flags.[0] = false || r.value.flags.[1] || r.value.n <> 7 then 3
           else
             (match read_json_pix other 0 with
              | Err _ -> 4
              | Ok q ->
                  if q.value.rgb.[2] <> 9 || q.value.flags.[1] = false || q.value.flags.[0] then 5
                  else if fails few 6 12 = false then 6
                  else if fails many 6 14 = false then 7
                  else if fails empty 6 9 = false then 8
                  else if fails big 5 12 = false then 9
                  else if fails notarr 1 7 = false then 10
                  else 0)))

let main () : i32 = with_arena 64 (let (m) => doc m.mem)
