(* Runs Pia.Sys.Fs's compiled code, linked by pia_binary, in the test's
   temporary directory: 0 when a file written and read back holds the
   bytes written, and a missing file is a NoEntry; otherwise the number
   of the first step that went wrong. *)
import Pia.Sys.Fs.Fs as F
import Pia.Sys.Posix.Posix as P

(* Writes five bytes to path, then reads them back. *)
let round_trip (path : [u8]) : result i32 F.errno
  requires len path >= 1 && path.[len path - 1] = 0
= let data : [u8; 5] = [1; 2; 3; 250; 5] in
  let w = F.create path 420? in
  let wrote = F.write_all w data in
  let shut = F.close w in
  wrote?;
  shut?;
  let r = F.open_read path? in
  let back : mutable [u8; 8] = [0; 0; 0; 0; 0; 0; 0; 0] in
  let got = F.read_some r back in
  let shut' = F.close r in
  let n = got? in
  shut'?;
  if n = 5 && back.[0] = 1 && back.[3] = 250 && back.[4] = 5 then Ok 0 else Ok 2

let main () : i32 =
  (* "fs.tmp" and "no.tmp", each ending in a NUL. *)
  let path : [u8; 7] = [0x66; 0x73; 0x2E; 0x74; 0x6D; 0x70; 0x00] in
  let none : [u8; 7] = [0x6E; 0x6F; 0x2E; 0x74; 0x6D; 0x70; 0x00] in
  let code = (match round_trip path with | Ok c -> c | Err e -> 1) in
  let gone = P.unlink path in
  if code <> 0 then code
  else if gone <> 0 then 3
  else
    (match F.open_read none with
     | Ok f -> (match F.close f with | Ok -> 4 | Err e' -> 4)
     | Err e' -> (match e' with | NoEntry -> 0 | _ -> 5))
