(* Runs @derive(json_dom) from C (json_shape_run_test.c): a point read
   from a parsed document, and one written as a document and read back. *)
module JsonShapeRun : Run

import Pia.Text.Json.Spec.Grammar
import Pia.Text.Json.Lex.Lexer
import Pia.Text.Json.Read.Reader
import Pia.Text.Json.Write.Writer
import Pia.Text.Json.Derive.Derive as Json
import Pia.Mem.Alloc.Allocators
import Pia.Text.Json.Dom.Document
import Pia.Text.Json.Shape.Shapes

interface Run @abi(c) = sig
  let read_point : (s : [u8]) -> (cells : borrowed mutable [Pia.Text.Json.Dom.json]) -> (mems : borrowed mutable [Pia.Text.Json.Dom.member]) -> i64
  let round_trip : (x : i32) -> (y : u8) -> (ok : bool) -> (text : borrowed inout mutable [u8]) -> (cells : borrowed mutable [Pia.Text.Json.Dom.json]) -> (mems : borrowed mutable [Pia.Text.Json.Dom.member]) -> i64
end

let point = type { x : i32 @json(name = "xx"); y : u8; ok : bool } @derive(json, json_dom)

(* x * 1000 + y * 10 + ok, of a point. *)
let code (p : point) : i64 = p.x * 1000 + p.y * 10 + (if p.ok then 1 else 0)

(* The point s denotes, as its code, or -1 if s is no document and -2 if
   it is one that is not a point. *)
let read_point (s : [u8]) (cells : borrowed mutable [Pia.Text.Json.Dom.json]) (mems : borrowed mutable [Pia.Text.Json.Dom.member]) : i64 =
  let vs : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.json = { mem = cells; used = 0 } in
  let ms : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.member = { mem = mems; used = 0 } in
  match Pia.Text.Json.Dom.parse s 4 vs ms with
  | Err _ -> -1
  | Ok v -> if check_json_point s v then code (from_dom_json_point s v) else -2

(* The point (x, y, ok) as a document over text, read back, as its code;
   -1 if to_dom made none. *)
let round_trip (x : i32) (y : u8) (ok : bool) (text : borrowed inout mutable [u8]) (cells : borrowed mutable [Pia.Text.Json.Dom.json]) (mems : borrowed mutable [Pia.Text.Json.Dom.member]) : i64 =
  let vs : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.json = { mem = cells; used = 0 } in
  let ms : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.member = { mem = mems; used = 0 } in
  match to_dom_json_point { x = x; y = y; ok = ok } text vs ms with
  | Err _ -> -1
  | Ok v -> code (from_dom_json_point text v)
