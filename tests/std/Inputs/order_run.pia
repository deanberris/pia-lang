(* Runs Pia.Core.Order's compiled code on examples, linked by pia_binary.
   It exits 0 when every result is what C++ gives, and otherwise with the
   number of the first wrong one. *)
import Pia.Core.Order.Ops

(* swap and exchange on a buffer of 1, 2, 3, 4: 0 when right. *)
let swaps (xs : borrowed inout mutable [u8]) (ys : [u8]) : i32
  requires len xs = 4
= xs.[0] <- 1; xs.[1] <- 2; xs.[2] <- 3; xs.[3] <- 4;
  if Pia.Core.Order.lexicographical_compare xs ys = false then 4
  else if Pia.Core.Order.lexicographical_compare ys xs then 5
  else (
    Pia.Core.Order.swap xs 0 3;
    if xs.[0] <> 4 || xs.[3] <> 1 then 7
    else (
      let was = Pia.Core.Order.exchange xs 1 9 in
      if was <> 2 || xs.[1] <> 9 then 8
      else if Pia.Core.Order.lexicographical_compare xs ys then 9
      else 0))

let main () : i32 =
  let ys : [u8; 3] = [1; 2; 4] in
  let a : i32 = -5 in
  let b : i32 = 7 in
  let lo : u16 = 10 in
  let hi : u16 = 20 in
  let v : u16 = 25 in
  if Pia.Core.Order.min a b <> -5 then 1
  else if Pia.Core.Order.max a b <> 7 then 2
  else if Pia.Core.Order.clamp v lo hi <> 20 then 3
  else if Pia.Core.Order.less a b = false then 6
  else with_arena 4 (let (m) => swaps m.mem ys)
