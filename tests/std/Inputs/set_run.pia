(* Runs Pia.Core.Algo.Set's and Pia.Core.Algo.SetUnion's compiled code on
   two sets in arenas, linked by pia_binary: 0 when every result is what
   C++'s set operations give, and otherwise the number of the first wrong
   one. *)
import Pia.Fn.Laws
import Pia.Core.Order.Ops
import Pia.Core.Algo.BinarySearch.BinarySearch as B
import Pia.Core.Algo.Set.Set as S
import Pia.Core.Algo.SetUnion.SetUnion as U

let checks (xs : borrowed inout mutable [u8]) (ys : borrowed inout mutable [u8]) (dst : borrowed inout mutable [u8]) : i32
  requires len xs = 4 && len ys = 3 && len dst = 7
= xs.[0] <- 1; xs.[1] <- 3; xs.[2] <- 5; xs.[3] <- 7;
  ys.[0] <- 3; ys.[1] <- 4; ys.[2] <- 7;
  if S.includes xs ys (let (a : u8) (b : u8) : bool => a < b) then 1
  else (
    let n = S.set_intersection dst xs ys (let (a : u8) (b : u8) : bool => a < b) in
    if n <> 2 || dst.[0] <> 3 || dst.[1] <> 7 then 2
    else (
      let m = S.set_difference dst xs ys (let (a : u8) (b : u8) : bool => a < b) in
      if m <> 2 || dst.[0] <> 1 || dst.[1] <> 5 then 3
      else (
        let u = U.set_union dst xs ys (let (a : u8) (b : u8) : bool => a < b) in
        if u <> 5 || dst.[0] <> 1 || dst.[1] <> 3 || dst.[2] <> 4 || dst.[3] <> 5 || dst.[4] <> 7 then 4
        else (
          let d = U.set_symmetric_difference dst xs ys (let (a : u8) (b : u8) : bool => a < b) in
          if d <> 3 || dst.[0] <> 1 || dst.[1] <> 4 || dst.[2] <> 5 then 5
          else 0))))

let main () : i32 =
  with_arena 4 (let (a) => with_arena 3 (let (b) => with_arena 7 (let (c) => checks a.mem b.mem c.mem)))
