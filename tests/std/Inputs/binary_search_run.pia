(* Runs Pia.Core.Algo.BinarySearch's compiled code on a sorted buffer in
   an arena, linked by pia_binary: 0 when every result is what C++'s
   binary search family gives, and otherwise the number of the first
   wrong one. *)
import Pia.Fn.Laws
import Pia.Core.Order.Ops
import Pia.Core.Algo.BinarySearch.BinarySearch as B

let checks (xs : borrowed inout mutable [u8]) : i32
  requires len xs = 6
= xs.[0] <- 1; xs.[1] <- 3; xs.[2] <- 3; xs.[3] <- 3; xs.[4] <- 7; xs.[5] <- 9;
  if B.lower_bound xs 3 (let (a : u8) (b : u8) : bool => a < b) <> 1 then 1
  else if B.upper_bound xs 3 (let (a : u8) (b : u8) : bool => a < b) <> 4 then 2
  else if B.lower_bound xs 10 (let (a : u8) (b : u8) : bool => a < b) <> 6 then 3
  else if B.binary_search xs 5 (let (a : u8) (b : u8) : bool => a < b) then 4
  else if B.binary_search xs 7 (let (a : u8) (b : u8) : bool => a < b) = false then 5
  else (
    let r = B.equal_range xs 3 (let (a : u8) (b : u8) : bool => a < b) in
    if r.first <> 1 || r.last <> 4 then 6
    else if B.lower_bound xs 0 <> 0 || B.upper_bound xs 9 <> 6 then 7
    else 0)

let main () : i32 = with_arena 6 (let (m) => checks m.mem)
