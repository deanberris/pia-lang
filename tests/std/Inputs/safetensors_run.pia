(* Runs Pia.Format.Safetensors' compiled code, linked by pia_binary: 0
   when tiny.safetensors parses to the tensors it holds, find and f32_word
   read them, every truncation of it is an error, a buffer too small for it
   is refused, and each malformed input below is refused with its problem;
   otherwise the number of the first wrong check. Generated by
   tests/std/Inputs/safetensors_gen.py. *)
import Pia.Text.Json.Spec.Grammar as Spec
