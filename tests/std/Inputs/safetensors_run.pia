(* Runs Pia.Format.Safetensors' compiled code, called by
   safetensors_run_main.c with two tensor buffers, of 8 and 3 records,
   since a Pia function cannot make a local buffer of records yet: 0 when
   tiny.safetensors parses to the tensors it holds, find and f32_word read
   them, every truncation of it is an error, a buffer too small for it is
   refused, and each malformed input below is refused with its problem;
   otherwise the number of the first wrong check. Generated by
   tests/std/Inputs/safetensors_gen.py. *)
module SafetensorsRun : Run

import Pia.Text.Json.Spec.Grammar as Spec
import Pia.Text.Json.Read.Reader as J
import Pia.Format.Safetensors.Safetensors as T

(* What safetensors_run_main.c calls, by its C name. *)
interface Run @abi(c) = sig
  let safetensors_run : (ts : borrowed inout mutable [T.tensor]) -> (few : borrowed inout mutable [T.tensor]) -> i32
end

let tiny : [u8; 329] = [16; 1; 0; 0; 0; 0; 0; 0; 123; 34; 95; 95; 109; 101; 116; 97; 100; 97; 116; 97; 95; 95; 34; 58; 123; 34; 110; 97; 109; 101; 34; 58; 34; 116; 105; 110; 121; 34; 44; 34; 102; 111; 114; 109; 97; 116; 34; 58; 34; 112; 116; 34; 125; 44; 34; 97; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 70; 51; 50; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 50; 44; 51; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 50; 52; 93; 125; 44; 34; 98; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 73; 51; 50; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 50; 52; 44; 52; 48; 93; 125; 44; 34; 99; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 66; 70; 49; 54; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 49; 44; 50; 44; 49; 44; 50; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 52; 48; 44; 52; 56; 93; 125; 44; 34; 115; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 52; 56; 44; 52; 57; 93; 125; 125; 0; 0; 128; 63; 0; 0; 0; 64; 0; 0; 64; 64; 0; 0; 128; 64; 0; 0; 160; 64; 0; 0; 192; 64; 255; 255; 255; 255; 0; 0; 0; 0; 1; 0; 0; 0; 2; 0; 0; 0; 128; 63; 0; 64; 64; 64; 128; 64; 7]
(* fewer than 8 bytes: Short *)
let bad_short : [u8; 5] = [16; 0; 0; 0; 0]
(* a header past the end: Short *)
let bad_past : [u8; 10] = [64; 0; 0; 0; 0; 0; 0; 0; 123; 125]
(* a header that is not an object: Syntax *)
let bad_array : [u8; 16] = [8; 0; 0; 0; 0; 0; 0; 0; 91; 49; 44; 50; 93; 32; 32; 32]
(* bytes after the object: Syntax *)
let bad_trail : [u8; 12] = [4; 0; 0; 0; 0; 0; 0; 0; 123; 125; 32; 120]
(* an end past the data: BadOffsets *)
let bad_beyond : [u8; 66] = [56; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 52; 93; 125; 125; 32; 32; 32; 0; 0]
(* an end before its begin: BadOffsets *)
let bad_reversed : [u8; 68] = [56; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 52; 44; 48; 93; 125; 125; 32; 32; 32; 0; 0; 0; 0]
(* a tensor overlapping the one before: BadOffsets *)
let bad_overlap : [u8; 126] = [112; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 52; 93; 125; 44; 34; 117; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 50; 44; 54; 93; 125; 125; 32; 32; 32; 32; 32; 32; 32; 0; 0; 0; 0; 0; 0]
(* tensors out of the order of their data: BadOffsets *)
let bad_order : [u8; 124] = [112; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 50; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 50; 44; 52; 93; 125; 44; 34; 117; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 50; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 50; 93; 125; 125; 32; 32; 32; 32; 32; 32; 32; 0; 0; 0; 0]
(* data no tensor holds: BadOffsets *)
let bad_gap : [u8; 70] = [56; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 52; 93; 125; 125; 32; 32; 32; 0; 0; 0; 0; 0; 0]
(* a shape that does not fill its bytes: BadSize *)
let bad_size : [u8; 68] = [56; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 70; 51; 50; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 50; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 52; 93; 125; 125; 32; 32; 0; 0; 0; 0]
(* an unknown dtype: BadDtype *)
let bad_dtype : [u8; 68] = [56; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 81; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 52; 93; 125; 125; 32; 32; 32; 0; 0; 0; 0]
(* five dimensions: BadShape *)
let bad_rank : [u8; 73] = [64; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 49; 44; 49; 44; 49; 44; 49; 44; 49; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 49; 93; 125; 125; 32; 32; 32; 0]
(* an element count past the largest u64: TooLarge *)
let bad_huge : [u8; 89] = [80; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 50; 57; 52; 57; 54; 55; 50; 57; 54; 44; 52; 50; 57; 52; 57; 54; 55; 50; 57; 54; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 49; 93; 125; 125; 32; 32; 32; 32; 32; 32; 32; 0]
(* a byte length past the largest u64: TooLarge *)
let bad_wide : [u8; 81] = [72; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 70; 54; 52; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 52; 54; 49; 49; 54; 56; 54; 48; 49; 56; 52; 50; 55; 51; 56; 55; 57; 48; 52; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 49; 93; 125; 125; 0]
(* a member given twice: BadMember *)
let bad_twice : [u8; 81] = [72; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 49; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 49; 93; 125; 125; 32; 32; 32; 32; 32; 32; 0]
(* no shape: BadMember *)
let bad_missing : [u8; 57] = [48; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 49; 93; 125; 125; 32; 32; 32; 32; 32; 32; 32; 0]
(* an unknown member: BadMember *)
let bad_extra : [u8; 73] = [64; 0; 0; 0; 0; 0; 0; 0; 123; 34; 116; 34; 58; 123; 34; 100; 116; 121; 112; 101; 34; 58; 34; 85; 56; 34; 44; 34; 115; 104; 97; 112; 101; 34; 58; 91; 49; 93; 44; 34; 100; 97; 116; 97; 95; 111; 102; 102; 115; 101; 116; 115; 34; 58; 91; 48; 44; 49; 93; 44; 34; 120; 34; 58; 49; 125; 125; 32; 32; 32; 32; 32; 0]

(* The empty header with no data is a file of no tensors. *)
let empty : [u8; 16] = [8; 0; 0; 0; 0; 0; 0; 0; 123; 125; 32; 32; 32; 32; 32; 32]

let w_a : [u8; 1] = [97]
let w_c : [u8; 1] = [99]
let w_z : [u8; 1] = [122]

(* The problem parse finds in s, as a number: 0 when it parses. *)
let code (s : [u8]) (ts : borrowed inout mutable [T.tensor]) : int{0..9}
= match T.parse s ts with
  | Ok _ -> 0
  | Err e ->
      (match e.problem with
       | Short -> 1 | Syntax -> 2 | BadMember -> 3 | BadDtype -> 4 | BadShape -> 5
       | TooLarge -> 6 | BadSize -> 7 | BadOffsets -> 8 | TooMany -> 9)

(* Every proper prefix of s is refused. *)
let prefixes_refused (s : [u8]) (ts : borrowed inout mutable [T.tensor]) : bool
= let ok : mutable bool = true in
  for n in 0 .. len s do
    if code s.[0 .. n] ts = 0 then ok <- false else ()
  done;
  ok

(* Each element of tensor a, F32 [2, 3] holding 1.0 to 6.0, as its bits. *)
let check_words (f : [u8]) (t : T.tensor) : i32
= match t.dtype with
  | F32 ->
      if t.start > t.stop || t.stop > len f || t.stop - t.start <> 24 || t.count <> 6 then 14
      else if T.f32_word f t 0 <> 0x3F80'0000 then 15
      else if T.f32_word f t 1 <> 0x4000'0000 then 16
      else if T.f32_word f t 5 <> 0x40C0'0000 then 17
      else 0
  | _ -> 18

let check_tiny (f : [u8]) (ts : borrowed inout mutable [T.tensor]) : i32
= match T.parse f ts with
  | Err _ -> 1
  | Ok l ->
      if l.count <> 4 || len ts < 4 then 2
      else (
        let a = ts.[0] in
        let b = ts.[1] in
        let c = ts.[2] in
        let s = ts.[3] in
        if l.data <> 280 then 2
        else if l.meta_start <> 24 || l.meta_stop <> 53 then 3
        else if a.rank <> 2 || a.d0 <> 2 || a.d1 <> 3 || a.d2 <> 1 || a.count <> 6 then 4
        else if a.start <> 280 || a.stop <> 280 + 24 then 5
        else if b.rank <> 1 || b.d0 <> 4 || b.count <> 4 || b.start <> 280 + 24 || b.stop <> 280 + 40 then 6
        else if c.rank <> 4 || c.d1 <> 2 || c.d3 <> 2 || c.count <> 4 || c.stop <> 280 + 48 then 7
        else if s.rank <> 0 || s.count <> 1 || s.stop <> len f then 8
        else (
          match T.find f ts l.count w_c with
          | Missing -> 9
          | Found k ->
              if k <> 2 then 10
              else (
                match T.find f ts l.count w_z with
                | Found _ -> 11
                | Missing ->
                    (match T.find f ts l.count w_a with
                     | Missing -> 12
                     | Found ka -> if ka <> 0 then 13 else check_words f ts.[ka]))))

let safetensors_run (ts : borrowed inout mutable [T.tensor]) (few : borrowed inout mutable [T.tensor]) : i32
= let r = check_tiny tiny ts in
  if r <> 0 then r
  else if prefixes_refused tiny ts = false then 20
  else if code tiny few <> (if len few < 4 then 9 else 0) then 21
  else (
  if code empty ts <> 0 then 29
  else if code bad_short ts <> 1 then 30
  else if code bad_past ts <> 1 then 31
  else if code bad_array ts <> 2 then 32
  else if code bad_trail ts <> 2 then 33
  else if code bad_beyond ts <> 8 then 34
  else if code bad_reversed ts <> 8 then 35
  else if code bad_overlap ts <> 8 then 36
  else if code bad_order ts <> 8 then 37
  else if code bad_gap ts <> 8 then 38
  else if code bad_size ts <> 7 then 39
  else if code bad_dtype ts <> 4 then 40
  else if code bad_rank ts <> 5 then 41
  else if code bad_huge ts <> 6 then 42
  else if code bad_wide ts <> 6 then 43
  else if code bad_twice ts <> 3 then 44
  else if code bad_missing ts <> 3 then 45
  else if code bad_extra ts <> 3 then 46
  else 0)
