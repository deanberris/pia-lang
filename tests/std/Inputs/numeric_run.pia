(* Runs Pia.Core.Algo.Numeric's compiled code on buffers in an arena,
   linked by pia_binary: 0 when every result is what C++'s <numeric>
   gives, and otherwise the number of the first wrong one. *)
import Pia.Core.Algo.Numeric.Numeric as N

let plus_wrap (a : u8) (b : u8) : u8 @overflow(wrap) = a + b
let minus_wrap (a : u8) (b : u8) : u8 @overflow(wrap) = a - b
let times_wrap (a : u8) (b : u8) : u8 @overflow(wrap) = a * b

let checks (xs : borrowed inout mutable [u8]) (ys : borrowed inout mutable [u8]) : i32
  requires len xs = 4 && len ys = 4
= N.iota xs 1;
  if xs.[0] <> 1 || xs.[1] <> 2 || xs.[2] <> 3 || xs.[3] <> 4 then 1
  else if N.accumulate xs 0 plus_wrap <> 10 then 2
  else if N.reduce xs 250 plus_wrap <> 4 then 3
  else if N.inner_product xs xs 0 plus_wrap times_wrap <> 30 then 4
  else (
    N.partial_sum ys xs plus_wrap;
    if ys.[0] <> 1 || ys.[1] <> 3 || ys.[2] <> 6 || ys.[3] <> 10 then 5
    else (
      N.exclusive_scan ys xs 0 plus_wrap;
      if ys.[0] <> 0 || ys.[1] <> 1 || ys.[2] <> 3 || ys.[3] <> 6 then 6
      else (
        N.inclusive_scan ys xs plus_wrap 100;
        if ys.[0] <> 101 || ys.[3] <> 110 then 7
        else (
          N.adjacent_difference ys xs minus_wrap;
          if ys.[0] <> 1 || ys.[1] <> 1 || ys.[3] <> 1 then 8
          else 0))))

let main () : i32 =
  with_arena 4 (let (m) => with_arena 4 (let (n) => checks m.mem n.mem))
