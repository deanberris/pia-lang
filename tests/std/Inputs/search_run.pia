(* Runs Pia.Core.Algo.Search's compiled code, instantiated here at u8 and
   i32, on examples, linked by pia_binary. It exits 0 when every result is
   what C++'s <algorithm> gives, and otherwise with the number of the
   first wrong one. *)
import Pia.Core.Order.Ops
import Pia.Core.Algo.Search.Search as S

let main () : i32 =
  let xs : [u8; 6] = [3; 1; 4; 1; 5; 9] in
  let same5 : [u8; 3] = [5; 5; 5] in
  let pat : [u8; 2] = [1; 5] in
  let pre : [u8; 2] = [3; 1] in
  let suf : [u8; 2] = [5; 9] in
  let ys : [i32; 5] = [2; -7; 9; -7; 9] in
  let sorted : [i32; 4] = [-3; 0; 0; 8] in
  if S.find xs 1 <> 1 then 1
  else if S.find xs 7 <> 6 then 2
  else if S.count xs 1 <> 2 then 3
  else if S.contains xs 9 = false then 4
  else if S.search xs pat <> 3 then 5
  else if S.starts_with xs pre = false then 6
  else if S.ends_with xs suf = false then 7
  else if S.mismatch xs pre <> 2 then 8
  else if S.adjacent_find same5 <> 0 then 9
  else if S.min_element ys <> 1 then 10
  else if S.max_element ys <> 2 then 11
  else if (S.minmax_element ys).lowest <> 1 then 12
  else if (S.minmax_element ys).highest <> 4 then 13
  else if S.is_sorted_until ys <> 2 then 14
  else if S.is_sorted sorted = false then 15
  else if S.min_element same5 <> 0 then 16
  else if S.max_element same5 <> 0 then 17
  else if S.equal pre pre = false then 18
  else 0
