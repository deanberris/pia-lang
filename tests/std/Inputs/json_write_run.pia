(* Runs Pia.Text.Json.Write's compiled code, linked by pia_binary: it
   writes a small document and checks its bytes, then reads it back with
   Pia.Text.Json.Lex. It exits 0 when every byte and token is the
   expected one, and otherwise with the number of the first wrong one. *)
import Pia.Text.Json.Spec.Grammar as Spec
import Pia.Text.Json.Lex.Lexer as Lex
import Pia.Text.Json.Write.Writer as Write

(* A number for each kind: kinds have no `=` in code without @derive(eq). *)
let code (k : Spec.kind) : u8 =
  match k with
  | LBrace -> 1 | RBrace -> 2 | LBracket -> 3 | RBracket -> 4 | Colon -> 5
  | Comma -> 6 | True -> 7 | False -> 8 | Null -> 9 | Number -> 10
  | String -> 11 | End -> 12

(* The token at pos has kind k and lies from start to stop. *)
let is (s : [u8]) (pos : usize) (k : Spec.kind) (start : usize) (stop : usize) : bool
  requires pos <= len s
= match Lex.next s pos with
  | Ok t -> code t.kind = code k && t.start = start && t.stop = stop
  | Err _ -> false

(* Each write checks its room at run time, so the document below needs
   no proof of where each token ends. A write without room leaves the
   position as it was, which the byte check then reports. *)
let punct (buf : borrowed inout mutable [u8]) (p : usize) (b : u8) : usize =
  if p < len buf then
    (if b = 0x7B then Write.write_lbrace buf p else if b = 0x7D then Write.write_rbrace buf p
     else if b = 0x5B then Write.write_lbracket buf p else if b = 0x5D then Write.write_rbracket buf p
     else if b = 0x3A then Write.write_colon buf p else Write.write_comma buf p)
  else p

let str (buf : borrowed inout mutable [u8]) (p : usize) (src : [u8]) : usize =
  if len src <= 1000000000000 && Write.utf8_valid src && p <= len buf && len buf - p >= Write.string_size src then Write.write_string buf p src else p

let u8v (buf : borrowed inout mutable [u8]) (p : usize) (v : u8) : usize =
  if p <= len buf && len buf - p >= 3 then Write.write_u8 buf p v else p

let i8v (buf : borrowed inout mutable [u8]) (p : usize) (v : i8) : usize =
  if p <= len buf && len buf - p >= 4 then Write.write_i8 buf p v else p

let u64v (buf : borrowed inout mutable [u8]) (p : usize) (v : u64) : usize =
  if p <= len buf && len buf - p >= 20 then Write.write_u64 buf p v else p

let lit (buf : borrowed inout mutable [u8]) (p : usize) (which : u8) : usize =
  if p <= len buf && len buf - p >= 5 then
    (if which = 0 then Write.write_null buf p else Write.write_bool buf p (which = 1))
  else p

(* The document, written into buf. *)
let doc (buf : borrowed inout mutable [u8]) : i32
  requires len buf = 74
=
  (* The key "k\"é", with a quote and a two-byte scalar value, and the
     value "\t\u0001": a tab and a control character. *)
  let key : [u8; 4] = [0x6B; 0x22; 0xC3; 0xA9] in
  let ctl : [u8; 2] = [0x09; 0x01] in
  (* {"k\"é":[0,-128,255,18446744073709551615,true,null],"c":"\t\u0001"} *)
  let want : [u8; 74] = [
    0x7B; 0x22; 0x6B; 0x5C; 0x22; 0xC3; 0xA9; 0x22; 0x3A; 0x5B;
    0x30; 0x2C; 0x2D; 0x31; 0x32; 0x38; 0x2C; 0x32; 0x35; 0x35;
    0x2C; 0x31; 0x38; 0x34; 0x34; 0x36; 0x37; 0x34; 0x34; 0x30;
    0x37; 0x33; 0x37; 0x30; 0x39; 0x35; 0x35; 0x31; 0x36; 0x31;
    0x35; 0x2C; 0x74; 0x72; 0x75; 0x65; 0x2C; 0x6E; 0x75; 0x6C;
    0x6C; 0x5D; 0x2C; 0x22; 0x63; 0x22; 0x3A; 0x22; 0x5C; 0x74;
    0x5C; 0x75; 0x30; 0x30; 0x30; 0x31; 0x22; 0x7D; 0x20; 0x20;
    0x20; 0x20; 0x20; 0x20 ] in
  let c : [u8; 1] = [0x63] in
  for k in 0 .. 74 do buf.[k] <- 0x20 done;
  if Write.string_size key <> 7 then 100
  else if Write.string_size ctl <> 10 then 101
  else if Write.string_size c <> 3 then 114
  else (
    let p0 = punct buf 0 0x7B in
    let p1 = str buf p0 key in
    let p2 = punct buf p1 0x3A in
    let p3 = punct buf p2 0x5B in
    let p4 = u8v buf p3 0 in
    let p5 = punct buf p4 0x2C in
    let p6 = i8v buf p5 (-128) in
    let p7 = punct buf p6 0x2C in
    let p8 = u8v buf p7 255 in
    let p9 = punct buf p8 0x2C in
    let p10 = u64v buf p9 18446744073709551615 in
    let p11 = punct buf p10 0x2C in
    let p12 = lit buf p11 1 in
    let p13 = punct buf p12 0x2C in
    let p14 = lit buf p13 0 in
    let p15 = punct buf p14 0x5D in
    let p16 = punct buf p15 0x2C in
    let p17 = str buf p16 c in
    let p18 = punct buf p17 0x3A in
    let p19 = str buf p18 ctl in
    let p20 = punct buf p19 0x7D in
    if p20 <> 68 then 102
    else (
      let bad : mutable i32 = 0 in
      for k in 0 .. 74 do
        if bad = 0 && buf.[k] <> want.[k] then bad <- 1 + k
      done;
      if bad <> 0 then bad
      else if is buf 0 Spec.LBrace 0 1 = false then 103
      else if is buf 1 Spec.String 1 8 = false then 104
      else if is buf 8 Spec.Colon 8 9 = false then 105
      else if is buf 10 Spec.Number 10 11 = false then 106
      else if is buf 12 Spec.Number 12 16 = false then 107
      else if is buf 21 Spec.Number 21 41 = false then 108
      else if is buf 42 Spec.True 42 46 = false then 109
      else if is buf 47 Spec.Null 47 51 = false then 110
      else if is buf 57 Spec.String 57 67 = false then 111
      else if is buf 67 Spec.RBrace 67 68 = false then 112
      else if is buf 68 Spec.End 74 74 = false then 113
      else 0))

let main () : i32 = with_arena 74 (let (m) => doc m.mem)
