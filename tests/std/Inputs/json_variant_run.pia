(* Runs the code @derive(json) makes for variants (ADR 0045, step 5),
   linked by pia_binary. Untagged, each constructor is told apart by its
   JSON; with a tag, the tag names it, first when writing and anywhere when
   reading. It exits 0 when every value and error is the expected one, and
   otherwise with the number of the first that is not. *)
import Pia.Core.Order.Ops
import Pia.Core.Option.Optional as O
import Pia.Text.Json.Spec.Grammar
import Pia.Text.Json.Lex.Lexer
import Pia.Text.Json.Read.Reader
import Pia.Text.Json.Write.Writer

let shape = type
  | Circle of { r : u16 @json(name = "radius") }
  | Rect of { w : u16; h : u16 }
  | Level of int{0..9}
  | Flag of bool
  | Empty
  @derive(json)

let event = type
  | Click @json(name = "click") of { x : u16; y : u16; button : O.option u8 }
  | Key of { code : u8 }
  | Quit
  @derive(json) @json(tag = "kind")

(* A number for each constructor, and its payload's first number. *)
let sc (v : shape) : u32 =
  match v with
  | Circle c -> (let r : u32 = c.r in 100 + r)
  | Rect x -> (let w : u32 = x.w in let h : u32 = x.h in 200 + w * 10 + h)
  | Level l -> (let lv : u32 = l in 300 + lv)
  | Flag b -> (if b then 401 else 400) | Empty -> 500

let ec (v : event) : u32 =
  match v with
  | Click c ->
      (let x : u32 = c.x in let y : u32 = c.y in
       let b : u32 = (match c.button with | Some bv -> bv | None -> 0) in
       100 + x * 10 + y + 1000 * b)
  | Key k -> (let kv : u32 = k.code in 200 + kv)
  | Quit -> 300

(* 1 Syntax, 2 Unknown, 3 Duplicate, 4 Missing, 5 Range, and where. *)
let shape_err (e : shape_json_error) (k : u8) (p : usize) : bool =
  match e with
  | Syntax_shape q -> k = 1 && q = p | Unknown_shape q -> k = 2 && q = p
  | Duplicate_shape q -> k = 3 && q = p | Missing_shape q -> k = 4 && q = p
  | Range_shape q -> k = 5 && q = p

let event_err (e : event_json_error) (k : u8) (p : usize) : bool =
  match e with
  | Syntax_event q -> k = 1 && q = p | Unknown_event q -> k = 2 && q = p
  | Duplicate_event q -> k = 3 && q = p | Missing_event q -> k = 4 && q = p
  | Range_event q -> k = 5 && q = p

let shape_is (s : [u8]) (want : u32) : bool =
  match read_json_shape s 0 with | Ok r -> sc r.value = want | Err _ -> false
let shape_fails (s : [u8]) (k : u8) (p : usize) : bool =
  match read_json_shape s 0 with | Ok _ -> false | Err e -> shape_err e k p
let event_is (s : [u8]) (want : u32) : bool =
  match read_json_event s 0 with | Ok r -> ec r.value = want | Err _ -> false
let event_fails (s : [u8]) (k : u8) (p : usize) : bool =
  match read_json_event s 0 with | Ok _ -> false | Err e -> event_err e k p

(* v written into buf is want, byte for byte, and reads back as v. *)
let same (buf : [u8]) (n : usize) (want : [u8]) : bool =
  if n <> len want || n > len buf then false
  else (
    let ok : mutable bool = true in
    for k in 0 .. n do if buf.[k] <> want.[k] then ok <- false done;
    ok)

let doc (buf : borrowed inout mutable [u8]) : i32
  requires len buf = 64
=
  let wc : [u8; 12] = [
    0x7B; 0x22; 0x72; 0x61; 0x64; 0x69; 0x75; 0x73; 0x22; 0x3A;
    0x33; 0x7D ] in
  let wk : [u8; 23] = [
    0x7B; 0x22; 0x6B; 0x69; 0x6E; 0x64; 0x22; 0x3A; 0x22; 0x4B;
    0x65; 0x79; 0x22; 0x2C; 0x22; 0x63; 0x6F; 0x64; 0x65; 0x22;
    0x3A; 0x37; 0x7D ] in
  let wq : [u8; 15] = [
    0x7B; 0x22; 0x6B; 0x69; 0x6E; 0x64; 0x22; 0x3A; 0x22; 0x51;
    0x75; 0x69; 0x74; 0x22; 0x7D ] in
  let c1 : [u8; 12] = [
    0x7B; 0x22; 0x72; 0x61; 0x64; 0x69; 0x75; 0x73; 0x22; 0x3A;
    0x33; 0x7D ] in
  let r1 : [u8; 13] = [
    0x7B; 0x22; 0x68; 0x22; 0x3A; 0x31; 0x2C; 0x22; 0x77; 0x22;
    0x3A; 0x32; 0x7D ] in
  let l1 : [u8; 1] = [
    0x35 ] in
  let f1 : [u8; 4] = [
    0x74; 0x72; 0x75; 0x65 ] in
  let e1 : [u8; 4] = [
    0x6E; 0x75; 0x6C; 0x6C ] in
  let bad1 : [u8; 18] = [
    0x7B; 0x22; 0x72; 0x61; 0x64; 0x69; 0x75; 0x73; 0x22; 0x3A;
    0x31; 0x2C; 0x22; 0x77; 0x22; 0x3A; 0x32; 0x7D ] in
  let big : [u8; 2] = [
    0x31; 0x30 ] in
  let str : [u8; 3] = [
    0x22; 0x78; 0x22 ] in
  let unk : [u8; 7] = [
    0x7B; 0x22; 0x71; 0x22; 0x3A; 0x31; 0x7D ] in
  let dup : [u8; 23] = [
    0x7B; 0x22; 0x72; 0x61; 0x64; 0x69; 0x75; 0x73; 0x22; 0x3A;
    0x31; 0x2C; 0x22; 0x72; 0x61; 0x64; 0x69; 0x75; 0x73; 0x22;
    0x3A; 0x32; 0x7D ] in
  let t1 : [u8; 28] = [
    0x7B; 0x22; 0x6B; 0x69; 0x6E; 0x64; 0x22; 0x3A; 0x22; 0x63;
    0x6C; 0x69; 0x63; 0x6B; 0x22; 0x2C; 0x22; 0x78; 0x22; 0x3A;
    0x31; 0x2C; 0x22; 0x79; 0x22; 0x3A; 0x32; 0x7D ] in
  let t2 : [u8; 39] = [
    0x7B; 0x22; 0x78; 0x22; 0x3A; 0x31; 0x2C; 0x22; 0x79; 0x22;
    0x3A; 0x32; 0x2C; 0x22; 0x62; 0x75; 0x74; 0x74; 0x6F; 0x6E;
    0x22; 0x3A; 0x33; 0x2C; 0x22; 0x6B; 0x69; 0x6E; 0x64; 0x22;
    0x3A; 0x22; 0x63; 0x6C; 0x69; 0x63; 0x6B; 0x22; 0x7D ] in
  let t3 : [u8; 15] = [
    0x7B; 0x22; 0x6B; 0x69; 0x6E; 0x64; 0x22; 0x3A; 0x22; 0x51;
    0x75; 0x69; 0x74; 0x22; 0x7D ] in
  let t4 : [u8; 15] = [
    0x7B; 0x22; 0x6B; 0x69; 0x6E; 0x64; 0x22; 0x3A; 0x22; 0x6E;
    0x6F; 0x70; 0x65; 0x22; 0x7D ] in
  let t5 : [u8; 10] = [
    0x7B; 0x22; 0x63; 0x6F; 0x64; 0x65; 0x22; 0x3A; 0x31; 0x7D ] in
  let t6 : [u8; 29] = [
    0x7B; 0x22; 0x6B; 0x69; 0x6E; 0x64; 0x22; 0x3A; 0x22; 0x4B;
    0x65; 0x79; 0x22; 0x2C; 0x22; 0x63; 0x6F; 0x64; 0x65; 0x22;
    0x3A; 0x31; 0x2C; 0x22; 0x78; 0x22; 0x3A; 0x32; 0x7D ] in
  for k in 0 .. 64 do buf.[k] <- 0x20 done;
  let n1 = write_json_shape buf 0 (Circle { r = 3 }) in
  if same buf n1 wc = false then 1
  else (
    let n2 = write_json_event buf 0 (Key { code = 7 }) in
    if same buf n2 wk = false then 2
    else (
      let n3 = write_json_event buf 0 Quit in
      if same buf n3 wq = false then 3
      else if shape_is c1 103 = false then 4
      else if shape_is r1 221 = false then 5
      else if shape_is l1 305 = false then 6
      else if shape_is f1 401 = false then 7
      else if shape_is e1 500 = false then 8
      else if shape_fails bad1 4 18 = false then 9
      else if shape_fails big 5 0 = false then 10
      else if shape_fails str 1 0 = false then 11
      else if shape_fails unk 2 1 = false then 12
      else if shape_fails dup 3 12 = false then 13
      else if event_is t1 112 = false then 14
      else if event_is t2 3112 = false then 15
      else if event_is t3 300 = false then 16
      else if event_fails t4 2 8 = false then 17
      else if event_fails t5 4 10 = false then 18
      else if event_fails t6 2 27 = false then 19
      else 0))

let main () : i32 = with_arena 64 (let (m) => doc m.mem)
