(* Runs a route from C (json_shape_route_run_test.c): two points and an
   option of one, read straight from its text by @derive(json) and from
   a parsed document by @derive(json_dom), and written both ways and read
   back. It is apart from json_shape_run.pia, whose proof it pushed past a
   build executor's memory. *)
module JsonShapeRouteRun : Run

import Pia.Core.Order.Ops
import Pia.Core.Option.Optional as O
import Pia.Text.Json.Spec.Grammar
import Pia.Text.Json.Lex.Lexer
import Pia.Text.Json.Read.Reader
import Pia.Text.Json.Write.Writer
import Pia.Text.Json.Derive.Derive as Json
import Pia.Mem.Alloc.Allocators
import Pia.Text.Json.Dom.Document
import Pia.Text.Json.Shape.Shapes

interface Run @abi(c) = sig
  let read_route : (s : [u8]) -> i64
  let round_trip_route : (x : i32) -> (has_last : bool) -> (text : borrowed inout mutable [u8]) -> i64
  let read_route_dom : (s : [u8]) -> (cells : borrowed mutable [Pia.Text.Json.Dom.json]) -> (mems : borrowed mutable [Pia.Text.Json.Dom.member]) -> i64
  let round_trip_route_dom : (x : i32) -> (has_last : bool) -> (text : borrowed inout mutable [u8]) -> (cells : borrowed mutable [Pia.Text.Json.Dom.json]) -> (mems : borrowed mutable [Pia.Text.Json.Dom.member]) -> i64
end

let point = type { x : i32 @json(name = "xx"); y : u8; ok : bool } @derive(json, json_dom)

(* x * 1000 + y * 10 + ok, of a point. *)
let code (p : point) : i64 = p.x * 1000 + p.y * 10 + (if p.ok then 1 else 0)

let route = type { a : point; b : point; last : O.option point } @derive(json, json_dom)

(* A route's code: its points' codes, the first once and the second twice,
   and its last point's three times, or nothing when it has none. *)
let route_code (r : route) : i64 =
  let l : i64 = match r.last with | Some p -> code p * 3 | None -> 0 in
  code r.a + code r.b * 2 + l

(* The route s is, as its code; -3 when a point's number is out of
   range, -4 when a point is not an object, and -1 for any other error.
   A route's errors are its own and its points'. *)
let read_route (s : [u8]) : i64 =
  match Json.read<route> s with
  | Ok r -> route_code r
  | Err e ->
    (match e with
     | Range_point _ -> -3
     | Syntax_point _ -> -4
     | _ -> -1)

(* The route through (x, 1, true) and (-x, 2, false), last at (0, 3,
   true) when has_last, written into text and read back, as its code; -1
   if text has no room or the text does not read back. *)
let round_trip_route (x : i32) (has_last : bool) (text : borrowed inout mutable [u8]) : i64 =
  let nx : i32 = if x = -2147483648 then 0 else 0 - x in
  let last : O.option point = if has_last then Some { x = 0; y = 3; ok = true } else None in
  let r : route = { a = { x = x; y = 1; ok = true }; b = { x = nx; y = 2; ok = false }; last = last } in
  if len text < json_room_route then -1
  else
    (let n = write_json_route text 0 r in
     match Json.read<route> text.[0 .. n] with
     | Ok b -> route_code b
     | Err _ -> -1)

(* The route s denotes as a document, as its code; -1 if s is no
   document and -2 if it is one that is not a route. *)
let read_route_dom (s : [u8]) (cells : borrowed mutable [Pia.Text.Json.Dom.json]) (mems : borrowed mutable [Pia.Text.Json.Dom.member]) : i64 =
  let vs : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.json = { mem = cells; used = 0 } in
  let ms : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.member = { mem = mems; used = 0 } in
  match Pia.Text.Json.Dom.parse s 4 vs ms with
  | Err _ -> -1
  | Ok v -> if check_json_route s v then route_code (from_dom_json_route s v) else -2

(* round_trip_route's route as a document over text, read back, as its
   code; -1 if to_dom made none. *)
let round_trip_route_dom (x : i32) (has_last : bool) (text : borrowed inout mutable [u8]) (cells : borrowed mutable [Pia.Text.Json.Dom.json]) (mems : borrowed mutable [Pia.Text.Json.Dom.member]) : i64 =
  let vs : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.json = { mem = cells; used = 0 } in
  let ms : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.member = { mem = mems; used = 0 } in
  let nx : i32 = if x = -2147483648 then 0 else 0 - x in
  let last : O.option point = if has_last then Some { x = 0; y = 3; ok = true } else None in
  match to_dom_json_route { a = { x = x; y = 1; ok = true }; b = { x = nx; y = 2; ok = false }; last = last } text vs ms with
  | Err _ -> -1
  | Ok v -> route_code (from_dom_json_route text v)
