(* Runs @derive(json_dom) on a tagged variant from C
   (json_shape_tagged_run_test.c): an event, read from a parsed document
   by its "kind" member and written as one with to_dom. A module of its
   own, as json_shape_variant_run.pia is, so that no proof grows past a
   build executor's memory. *)
module JsonShapeTaggedRun : Run

import Pia.Core.Order.Ops
import Pia.Core.Option.Optional as O
import Pia.Text.Json.Spec.Grammar
import Pia.Text.Json.Lex.Lexer
import Pia.Text.Json.Read.Reader
import Pia.Text.Json.Write.Writer
import Pia.Text.Json.Derive.Derive as Json
import Pia.Mem.Alloc.Allocators
import Pia.Text.Json.Dom.Document
import Pia.Text.Json.Shape.Shapes

interface Run @abi(c) = sig
  let read_event_dom : (s : [u8]) -> (cells : borrowed mutable [Pia.Text.Json.Dom.json]) -> (mems : borrowed mutable [Pia.Text.Json.Dom.member]) -> i64
  let round_trip_event_dom : (k : int{0..3}) -> (text : borrowed inout mutable [u8]) -> (cells : borrowed mutable [Pia.Text.Json.Dom.json]) -> (mems : borrowed mutable [Pia.Text.Json.Dom.member]) -> i64
end

let press = type { x : u16; y : u16 } @derive(json, json_dom)

let keypress = type { code : u8; repeat : O.option bool } @derive(json, json_dom)

let event = type
  | Click @json(name = "click") of press
  | Key of keypress
  | Quit
  @derive(json, json_dom) @json(tag = "kind")

(* An event's code: 0 to quit, 100000 + x * 100 + y for a click, and
   for a key 1000 + its code * 10, plus 1 if it repeats and 2 if it says
   it does not. *)
let event_code (e : event) : i64 =
  match e with
  | Quit -> 0
  | Click p -> (let x : i64 = p.x in let y : i64 = p.y in 100000 + x * 100 + y)
  | Key k ->
    (let c : i64 = k.code in
     1000 + c * 10 + (match k.repeat with | Some b -> if b then 1 else 2 | None -> 0))

(* The event s denotes as a document, as its code; -1 if s is no
   document and -2 if it is one that is not an event. *)
let read_event_dom (s : [u8]) (cells : borrowed mutable [Pia.Text.Json.Dom.json]) (mems : borrowed mutable [Pia.Text.Json.Dom.member]) : i64 =
  let vs : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.json = { mem = cells; used = 0 } in
  let ms : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.member = { mem = mems; used = 0 } in
  match Pia.Text.Json.Dom.parse s 4 vs ms with
  | Err _ -> -1
  | Ok v -> if check_json_event s v then event_code (from_dom_json_event s v) else -2

(* The k-th event, Quit, a click at (3, 4), key 9, or key 9 repeating,
   as a document over text, read back, as its code; -1 if to_dom made
   none. *)
let round_trip_event_dom (k : int{0..3}) (text : borrowed inout mutable [u8]) (cells : borrowed mutable [Pia.Text.Json.Dom.json]) (mems : borrowed mutable [Pia.Text.Json.Dom.member]) : i64 =
  let vs : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.json = { mem = cells; used = 0 } in
  let ms : mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.member = { mem = mems; used = 0 } in
  let e : event =
    if k = 0 then Quit else if k = 1 then Click { x = 3; y = 4 }
    else if k = 2 then Key { code = 9; repeat = None } else Key { code = 9; repeat = Some true } in
  match to_dom_json_event e text vs ms with
  | Err _ -> -1
  | Ok v -> event_code (from_dom_json_event text v)
