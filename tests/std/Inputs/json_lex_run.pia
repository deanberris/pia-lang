(* Runs Pia.Text.Json.Lex's compiled code on examples, linked by
   pia_binary. It exits 0 when every token and error is the expected one,
   and otherwise with the number of the first wrong one. *)
import Pia.Text.Json.Spec.Grammar as Spec
import Pia.Text.Json.Lex.Lexer as Lex

(* A number for each kind: kinds have no `=` in code without @derive(eq). *)
let code (k : Spec.kind) : u8 =
  match k with
  | LBrace -> 1 | RBrace -> 2 | LBracket -> 3 | RBracket -> 4 | Colon -> 5
  | Comma -> 6 | True -> 7 | False -> 8 | Null -> 9 | Number -> 10
  | String -> 11 | End -> 12

(* The token at pos has kind k and lies from start to stop. *)
let is (s : [u8]) (pos : usize) (k : Spec.kind) (start : usize) (stop : usize) : bool
  requires pos <= len s
= match Lex.next s pos with
  | Ok t -> code t.kind = code k && t.start = start && t.stop = stop
  | Err _ -> false

(* The token at pos is an error of the given kind, at p:
   0 Unexpected, 1 BadLiteral, 2 BadNumber, 3 BadString. *)
let fails (s : [u8]) (pos : usize) (what : u8) (p : usize) : bool
  requires pos <= len s
= match Lex.next s pos with
  | Ok _ -> false
  | Err e ->
      (match e with
       | Unexpected q -> what = 0 && q = p
       | BadLiteral q -> what = 1 && q = p
       | BadNumber q -> what = 2 && q = p
       | BadString q -> what = 3 && q = p)

let main () : i32 =
  (* { "a" : [ -1.5e+3 , true , null , false ] } *)
  let doc : [u8; 37] = [
    0x7B; 0x20; 0x22; 0x61; 0x22; 0x20; 0x3A; 0x0A; 0x5B; 0x2D;
    0x31; 0x2E; 0x35; 0x65; 0x2B; 0x33; 0x2C; 0x74; 0x72; 0x75;
    0x65; 0x2C; 0x6E; 0x75; 0x6C; 0x6C; 0x2C; 0x66; 0x61; 0x6C;
    0x73; 0x65; 0x5D; 0x09; 0x7D; 0x0D; 0x20 ] in
  (* "é" then "é" in UTF-8, then a pair of surrogates for U+1F600. *)
  let esc : [u8; 25] = [
    0x22; 0x5C; 0x75; 0x30; 0x30; 0x65; 0x39; 0x22; 0x22; 0xC3;
    0xA9; 0x22; 0x22; 0x5C; 0x75; 0x44; 0x38; 0x33; 0x44; 0x5C;
    0x75; 0x44; 0x45; 0x30; 0x30 ] in
  let esc_end : [u8; 26] = [
    0x22; 0x5C; 0x75; 0x30; 0x30; 0x65; 0x39; 0x22; 0x22; 0xC3;
    0xA9; 0x22; 0x22; 0x5C; 0x75; 0x44; 0x38; 0x33; 0x44; 0x5C;
    0x75; 0x44; 0x45; 0x30; 0x30; 0x22 ] in
  (* Bad inputs: 01, 1., -, a lone low surrogate, a raw tab in a string,
     an overlong UTF-8 encoding, tru, and @. *)
  let zero_one : [u8; 2] = [0x30; 0x31] in
  let point : [u8; 2] = [0x31; 0x2E] in
  let minus : [u8; 1] = [0x2D] in
  let low : [u8; 8] = [0x22; 0x5C; 0x75; 0x44; 0x43; 0x30; 0x30; 0x22] in
  let tab : [u8; 3] = [0x22; 0x09; 0x22] in
  let overlong : [u8; 4] = [0x22; 0xC0; 0xAF; 0x22] in
  let tru : [u8; 4] = [0x20; 0x74; 0x72; 0x75] in
  let at : [u8; 2] = [0x0A; 0x40] in
  let blank : [u8; 3] = [0x20; 0x09; 0x0A] in
  if is doc 0 Spec.LBrace 0 1 = false then 1
  else if is doc 1 Spec.String 2 5 = false then 2
  else if is doc 5 Spec.Colon 6 7 = false then 3
  else if is doc 7 Spec.LBracket 8 9 = false then 4
  else if is doc 9 Spec.Number 9 16 = false then 5
  else if is doc 16 Spec.Comma 16 17 = false then 6
  else if is doc 17 Spec.True 17 21 = false then 7
  else if is doc 22 Spec.Null 22 26 = false then 8
  else if is doc 27 Spec.False 27 32 = false then 9
  else if is doc 32 Spec.RBracket 32 33 = false then 10
  else if is doc 33 Spec.RBrace 34 35 = false then 11
  else if is doc 35 Spec.End 37 37 = false then 12
  else if is esc 0 Spec.String 0 8 = false then 13
  else if is esc 8 Spec.String 8 12 = false then 14
  else if fails esc 12 3 12 = false then 15
  else if is esc_end 12 Spec.String 12 26 = false then 16
  else if is zero_one 0 Spec.Number 0 1 = false then 17
  else if is zero_one 1 Spec.Number 1 2 = false then 18
  else if fails point 0 2 2 = false then 19
  else if fails minus 0 2 1 = false then 20
  else if fails low 0 3 1 = false then 21
  else if fails tab 0 3 1 = false then 22
  else if fails overlong 0 3 1 = false then 23
  else if fails tru 0 1 1 = false then 24
  else if fails at 0 0 1 = false then 25
  else if is blank 0 Spec.End 3 3 = false then 26
  else 0
