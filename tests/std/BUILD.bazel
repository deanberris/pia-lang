load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tests/lit:lit.bzl", "lit_tests")
load("//tools/piac:pia.bzl", "pia_binary")
load("//tools/piac:targets.bzl", "PIA_TARGETS")

# The library's tests (ADR 0040, section 11): for each module, a lit test of
# its goal counts and interfaces, an importer that proves its edge cases
# from the interface alone, and a program that runs its compiled code.
lit_tests(
    name = "std_tests",
    srcs = glob(["*.pia"]),
    data = [
        "Inputs/hof_overloads.pia",
        "//lib/Pia/Core:Bit.pia",
        "//lib/Pia/Core:Int.pia",
        "//lib/Pia/Core:Option.pia",
        "//lib/Pia/Core:Order.pia",
        "//lib/Pia/Core:Result.pia",
        "//lib/Pia/Core/Algo:BinarySearch.pia",
        "//lib/Pia/Core/Algo:Heap.pia",
        "//lib/Pia/Core/Algo:Merge.pia",
        "//lib/Pia/Core/Algo:Modify.pia",
        "//lib/Pia/Core/Algo:Numeric.pia",
        "//lib/Pia/Core/Algo:PartialSort.pia",
        "//lib/Pia/Core/Algo:Partition.pia",
        "//lib/Pia/Core/Algo:Permutation.pia",
        "//lib/Pia/Core/Algo:Remove.pia",
        "//lib/Pia/Core/Algo:Sort.pia",
        "//lib/Pia/Core/Algo:Search.pia",
        "//lib/Pia:Fn.pia",
        "//lib/Pia/Text/Json:Lex.pia",
        "//lib/Pia/Text/Json:Spec.pia",
    ],
    tools = ["//tools/piac"],
)

pia_binary(
    name = "bit_run",
    src = "Inputs/bit_run.pia",
    target_compatible_with = PIA_TARGETS,
    deps = ["//lib/Pia/Core:bit"],
)

sh_test(
    name = "bit_run_test",
    srcs = ["bit_run_test.sh"],
    args = ["$(rootpath :bit_run)"],
    data = [":bit_run"],
    target_compatible_with = PIA_TARGETS,
)

