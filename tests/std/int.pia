(* Pia.Core.Int (ADR 0040): every goal of the module is proved, including
   each overload's interface contract against its own definition, and its
   interfaces are what importers see.
// RUN: piac --verify %S/../../lib/Pia/Core/Int.pia | FileCheck %s
// RUN: piac --emit=interface -o %t %S/../../lib/Pia/Core/Int.pia
// RUN: FileCheck --check-prefix=OPS %s < %t/Pia.Core.Int.Ops.piai
// RUN: FileCheck --check-prefix=DIV %s < %t/Pia.Core.Int.Div.piai
*)

(* The preconditions that rule out C++'s undefined cases are met where
   each overload's own is checked against its interface's, at each width
   (u64 may be spelled usize in an overload's symbol).
// CHECK-NOT: failed
// CHECK-DAG: proved: the precondition of 'quot_rem(i8, i8)' holds
// CHECK-DAG: proved: the precondition of 'quot_rem({{i64|isize}}, {{i64|isize}})' holds
// CHECK-DAG: proved: the precondition of 'div_sat({{u64|usize}}, {{u64|usize}})' holds
// CHECK: 513 proved, 0 failed, 0 skipped
*)

(* Four functions at each unsigned width, five at each signed width, and
   saturate_cast to each type.
// OPS:       {{^}}module Pia.Core.Int{{$}}
// OPS-NEXT:  {{^}}interface Ops = sig{{$}}
// OPS-NEXT:  {{^}}  let spec euclid : (a : u64) -> (b : u64) -> u64{{$}}
// OPS-NEXT:  {{^}}  let gcd : (a : u8) -> (b : u8) -> u8 ensures
// OPS:       {{^}}  let abs : (x : i8) -> u8 ensures x >= 0 ==> result = x ensures x < 0 ==> result = 0 - x{{$}}
// OPS:       {{^}}  let mul_sat : (a : i64) -> (b : i64) -> i64 ensures a * b > max i64 ==> result = max i64
// OPS:       {{^}}  let saturate_cast_u8 : (x : i64) -> u8 ensures
// OPS:       {{^}}  let saturate_cast_i64 : (y : u64) -> i64 ensures
// OPS-NEXT:  {{^}}end{{$}}
// OPS-NEXT:  {{^}}let spec euclid (a : u64) (b : u64) : u64 @fuel(2) decreases b{{$}}
// OPS-NEXT:  {{^}}= if b = 0 then a else euclid b (a % b){{$}}

// DIV:       {{^}}interface Div = sig{{$}}
// DIV-NEXT:  {{^}}  let spec divides : (d : i64) -> (n : i64) -> bool{{$}}
// DIV-NEXT:  {{^}}  let quot_rem_i8 = type { quot : i8; rem : i8 }{{$}}
// DIV-NEXT:  {{^}}  let quot_rem : (n : i8) -> (d : i8) -> quot_rem_i8 requires d <> 0 && (n <> min i8 || d <> -1) ensures
*)
