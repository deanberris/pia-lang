load("@rules_python//python:defs.bzl", "py_test")

# Every Pia example in the README and the user documentation, run through
# piac and compared with the output the page shows (see the script's
# docstring for the markers).
DOCS = [
    "//:README.md",
    "//docs:index.md",
    "//docs:getting-started.md",
    "//docs:demo.md",
    "//docs:tour.md",
    "//docs:idioms.md",
    "//docs:verification.md",
    "//docs:repl.md",
    "//docs:repl-debugging.md",
    "//docs:status.md",
    "//docs:streams.pia.md",
    "//docs:sediment.pia.md",
    "//docs:basins.pia.md",
    "//docs:theories.md",
]

py_test(
    name = "doc_examples_test",
    srcs = ["doc_examples_test.py"],
    args = [
        "$(rootpath //tools/piac)",
        "--pia",
        "$(rootpath //tools/pia)",
    ] + ["$(rootpath %s)" % d for d in DOCS],
    data = DOCS + [
        "//examples/edges:edges.pia",
        "//examples/edges:edges_buggy.pia",
        "//src/irgen:Target.pia",
        "//tools/pia",
        "//tools/piac",
    ],
    main = "doc_examples_test.py",
    # It proves every example with pia_object's deterministic limits, which
    # takes about four minutes on the iMac: past the 300 s of a medium test
    # under a loaded `bazel test //...`.
    size = "large",
)

# The case studies (docs/cases): famous bugs recreated in Pia, each failing
# with a counterexample, and their fixes proved. A separate target so the
# pages are checked in parallel with the rest of the docs.
CASES = [
    "//docs:cases/index.md",
    "//docs:cases/heartbleed.pia.md",
    "//docs:cases/binary-search.pia.md",
    "//docs:cases/cloudbleed.pia.md",
    "//docs:cases/crowdstrike.pia.md",
    "//docs:cases/rust-str-repeat.pia.md",
    "//docs:cases/rust-vecdeque.pia.md",
    "//docs:cases/libwebp.pia.md",
    "//docs:cases/bun-readfile.pia.md",
    "//docs:cases/zlib-gzip-extra.pia.md",
    "//docs:cases/giflib-background.pia.md",
]

py_test(
    name = "case_studies_test",
    # Each page runs piac on its broken and fixed versions; under load on
    # the iMac the whole set has taken 200 s, past a medium test's 300 s
    # margin for comfort.
    size = "large",
    srcs = ["doc_examples_test.py"],
    args = ["$(rootpath //tools/piac)"] + ["$(rootpath %s)" % d for d in CASES],
    data = CASES + ["//tools/piac"],
    main = "doc_examples_test.py",
)

# The agent skills (skills/): every command and example in them is run
# against piac and pia, so the instructions an agent follows cannot drift
# from what the tools really do.
SKILLS = [
    "//skills:README.md",
    "//skills:pia-contracts/SKILL.md",
    "//skills:pia-fast-proofs/SKILL.md",
    "//skills:pia-idioms/SKILL.md",
    "//skills:pia-language/SKILL.md",
    "//skills:pia-mcp/SKILL.md",
    "//skills:pia-porting/SKILL.md",
    "//skills:pia-proof-debugging/SKILL.md",
    "//skills:pia-repl/SKILL.md",
    "//skills:piac-build/SKILL.md",
    "//skills:piac-verify/SKILL.md",
]

py_test(
    name = "skills_test",
    size = "medium",
    srcs = ["doc_examples_test.py"],
    args = [
        "$(rootpath //tools/piac)",
        "--pia",
        "$(rootpath //tools/pia)",
    ] + ["$(rootpath %s)" % s for s in SKILLS],
    data = SKILLS + [
        "//tools/pia",
        "//tools/piac",
    ],
    main = "doc_examples_test.py",
)
