(* Load buffering: each thread loads one location and then stores the
   other. RC11 forbids both loads reading the other thread's store, even
   relaxed, since all of po ∪ rf must be acyclic. Pia's model asks the
   program to say where it needs that (Dean, 2026-11-24): only a load that
   acquires, or a relaxed load written @ordered, is ordered before what
   follows it, so relaxed load buffering is allowed, as Armv8 allows it
   for ldr and str, and values out of thin air are ruled out where the
   loads are @ordered.
// RUN: not piac --verify %s | FileCheck %s
*)

litmus "lb_rlx"
  [ thread [ load "relaxed" "x" "r1"; store "relaxed" "y" 1 ]
  ; thread [ load "relaxed" "y" "r2"; store "relaxed" "x" 1 ] ]
  "allowed" [ is "r1" 1; is "r2" 1 ]

litmus "lb_ordered"
  [ thread [ load_ordered "relaxed" "x" "r1"; store "relaxed" "y" 1 ]
  ; thread [ load_ordered "relaxed" "y" "r2"; store "relaxed" "x" 1 ] ]
  "forbidden" [ is "r1" 1; is "r2" 1 ]

litmus "lb_acq"
  [ thread [ load "acquire" "x" "r1"; store "relaxed" "y" 1 ]
  ; thread [ load "acquire" "y" "r2"; store "relaxed" "x" 1 ] ]
  "forbidden" [ is "r1" 1; is "r2" 1 ]

(* Out of thin air: each thread stores what it read. With @ordered loads,
   42 cannot appear. *)
litmus "oota_ordered"
  [ thread [ load_ordered "relaxed" "x" "r1"; store_from "relaxed" "y" "r1" ]
  ; thread [ load_ordered "relaxed" "y" "r2"; store_from "relaxed" "x" "r2" ] ]
  "forbidden" [ is "r1" 42; is "r2" 42 ]

(* Without them the model allows it, since nothing the program asked for
   orders the loads; neither target produces it, since both keep a store
   after the load it depends on. *)
litmus "oota_rlx"
  [ thread [ load "relaxed" "x" "r1"; store_from "relaxed" "y" "r1" ]
  ; thread [ load "relaxed" "y" "r2"; store_from "relaxed" "x" "r2" ] ]
  "allowed" [ is "r1" 42; is "r2" 42 ]

litmus "lb_acq_rel"
  [ thread [ load "acquire" "x" "r1"; store "release" "y" 1 ]
  ; thread [ load "acquire" "y" "r2"; store "release" "x" 1 ] ]
  "forbidden" [ is "r1" 1; is "r2" 1 ]

litmus "lb_one_read"
  [ thread [ load "relaxed" "x" "r1"; store "relaxed" "y" 1 ]
  ; thread [ load "relaxed" "y" "r2"; store "relaxed" "x" 1 ] ]
  "allowed" [ is "r1" 1; is "r2" 0 ]

(* Expected report, in order.
// CHECK: lb.pia:12:1: failed: no RC11 execution of 'lb_rlx' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 1
// CHECK: lb.pia:12:1: proved: no x86-TSO execution of 'lb_rlx' ends with the outcome [smt]
// CHECK: lb.pia:12:1: failed: no Armv8 execution of 'lb_rlx' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 1
// CHECK: lb.pia:17:1: proved: no RC11 execution of 'lb_ordered' ends with the outcome [smt]
// CHECK: lb.pia:17:1: proved: no x86-TSO execution of 'lb_ordered' ends with the outcome [smt]
// CHECK: lb.pia:17:1: proved: no Armv8 execution of 'lb_ordered' ends with the outcome [smt]
// CHECK: lb.pia:22:1: proved: no RC11 execution of 'lb_acq' ends with the outcome [smt]
// CHECK: lb.pia:22:1: proved: no x86-TSO execution of 'lb_acq' ends with the outcome [smt]
// CHECK: lb.pia:22:1: proved: no Armv8 execution of 'lb_acq' ends with the outcome [smt]
// CHECK: lb.pia:29:1: proved: no RC11 execution of 'oota_ordered' ends with the outcome [smt]
// CHECK: lb.pia:29:1: proved: no x86-TSO execution of 'oota_ordered' ends with the outcome [smt]
// CHECK: lb.pia:29:1: proved: no Armv8 execution of 'oota_ordered' ends with the outcome [smt]
// CHECK: lb.pia:37:1: failed: no RC11 execution of 'oota_rlx' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 42, r2 = 42
// CHECK: lb.pia:37:1: proved: no x86-TSO execution of 'oota_rlx' ends with the outcome [smt]
// CHECK: lb.pia:37:1: proved: no Armv8 execution of 'oota_rlx' ends with the outcome [smt]
// CHECK: lb.pia:42:1: proved: no RC11 execution of 'lb_acq_rel' ends with the outcome [smt]
// CHECK: lb.pia:42:1: proved: no x86-TSO execution of 'lb_acq_rel' ends with the outcome [smt]
// CHECK: lb.pia:42:1: proved: no Armv8 execution of 'lb_acq_rel' ends with the outcome [smt]
// CHECK: lb.pia:47:1: failed: no RC11 execution of 'lb_one_read' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: lb.pia:47:1: failed: no x86-TSO execution of 'lb_one_read' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: lb.pia:47:1: failed: no Armv8 execution of 'lb_one_read' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: 15 proved, 6 failed, 0 skipped
*)
