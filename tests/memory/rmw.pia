(* Read-modify-writes: each is atomic, so two increments never both read
   the same value, and a release sequence carries a release store's
   synchronisation through the read-modify-writes that read it.
// RUN: not piac --verify %s | FileCheck %s
*)

litmus "inc_inc"
  [ thread [ fetch_add "relaxed" "x" 1 "r1" ]
  ; thread [ fetch_add "relaxed" "x" 1 "r2" ] ]
  "forbidden" [ is "r1" 0; is "r2" 0 ]

litmus "inc_inc_final"
  [ thread [ fetch_add "relaxed" "x" 1 "r1" ]
  ; thread [ fetch_add "relaxed" "x" 1 "r2" ] ]
  "forbidden" [ final "x" 1 ]

litmus "swap_swap"
  [ thread [ swap "relaxed" "x" 1 "r1" ]
  ; thread [ swap "relaxed" "x" 2 "r2" ] ]
  "forbidden" [ is "r1" 0; is "r2" 0 ]

litmus "release_rmw"
  [ thread [ write "data" 1; store "release" "x" 1 ]
  ; thread [ fetch_add "relaxed" "x" 1 "r0" ]
  ; thread [ load "acquire" "x" "r1"; read "data" "r2" ] ]
  "forbidden" [ is "r1" 2; is "r2" 0 ]

(* A later relaxed store of the same thread does not continue a release
   sequence, as in C++20 (P0982R1, Dean, 2026-11-24): Armv8 does not order
   a stlr before a later str to the same location for other threads. *)
litmus "release_po"
  [ thread [ store "relaxed" "data" 1; store "release" "x" 1; store "relaxed" "x" 2 ]
  ; thread [ load "acquire" "x" "r1"; load "relaxed" "data" "r2" ] ]
  "allowed" [ is "r1" 2; is "r2" 0 ]

litmus "release_broken"
  [ thread [ store "relaxed" "data" 1; store "release" "x" 1 ]
  ; thread [ store "relaxed" "x" 2 ]
  ; thread [ load "acquire" "x" "r1"; load "relaxed" "data" "r2" ] ]
  "allowed" [ is "r1" 2; is "r2" 0 ]

(* Expected report, in order.
// CHECK: rmw.pia:7:1: proved: no RC11 execution of 'inc_inc' ends with the outcome [smt]
// CHECK: rmw.pia:7:1: proved: no x86-TSO execution of 'inc_inc' ends with the outcome [smt]
// CHECK: rmw.pia:7:1: proved: no Armv8 execution of 'inc_inc' ends with the outcome [smt]
// CHECK: rmw.pia:12:1: proved: no RC11 execution of 'inc_inc_final' ends with the outcome [smt]
// CHECK: rmw.pia:12:1: proved: no x86-TSO execution of 'inc_inc_final' ends with the outcome [smt]
// CHECK: rmw.pia:12:1: proved: no Armv8 execution of 'inc_inc_final' ends with the outcome [smt]
// CHECK: rmw.pia:17:1: proved: no RC11 execution of 'swap_swap' ends with the outcome [smt]
// CHECK: rmw.pia:17:1: proved: no x86-TSO execution of 'swap_swap' ends with the outcome [smt]
// CHECK: rmw.pia:17:1: proved: no Armv8 execution of 'swap_swap' ends with the outcome [smt]
// CHECK: rmw.pia:22:1: proved: no RC11 execution of 'release_rmw' ends with the outcome [smt]
// CHECK: rmw.pia:22:1: proved: no x86-TSO execution of 'release_rmw' ends with the outcome [smt]
// CHECK: rmw.pia:22:1: proved: no Armv8 execution of 'release_rmw' ends with the outcome [smt]
// CHECK: rmw.pia:31:1: failed: no RC11 execution of 'release_po' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 2, r2 = 0
// CHECK: rmw.pia:31:1: proved: no x86-TSO execution of 'release_po' ends with the outcome [smt]
// CHECK: rmw.pia:31:1: failed: no Armv8 execution of 'release_po' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 2, r2 = 0
// CHECK: rmw.pia:36:1: failed: no RC11 execution of 'release_broken' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 2, r2 = 0
// CHECK: rmw.pia:36:1: failed: no x86-TSO execution of 'release_broken' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 2, r2 = 0
// CHECK: rmw.pia:36:1: failed: no Armv8 execution of 'release_broken' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 2, r2 = 0
// CHECK: 13 proved, 5 failed, 0 skipped
*)
