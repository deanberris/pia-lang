(* Message passing (ADR 0052, section 4): a thread writes data and then a
   flag, and another reads the flag and then the data. Reading the flag
   set and the old data is forbidden only when the flag's store releases
   and its load acquires, or fences do it for them. A forbidden outcome is
   proved; an allowed one fails, with a witness execution as the
   counterexample. Each test is also run against x86-TSO and Armv8 for the
   instructions each target compiles it to (section 5): where RC11 forbids
   the outcome, so must the hardware.
// RUN: not piac --verify %s | FileCheck %s
*)

litmus "mp_rel_acq"
  [ thread [ store "relaxed" "data" 1; store "release" "flag" 1 ]
  ; thread [ load "acquire" "flag" "r1"; load "relaxed" "data" "r2" ] ]
  "forbidden" [ is "r1" 1; is "r2" 0 ]

litmus "mp_sc"
  [ thread [ store "seq_cst" "data" 1; store "seq_cst" "flag" 1 ]
  ; thread [ load "seq_cst" "flag" "r1"; load "seq_cst" "data" "r2" ] ]
  "forbidden" [ is "r1" 1; is "r2" 0 ]

litmus "mp_rlx"
  [ thread [ store "relaxed" "data" 1; store "relaxed" "flag" 1 ]
  ; thread [ load "relaxed" "flag" "r1"; load "relaxed" "data" "r2" ] ]
  "allowed" [ is "r1" 1; is "r2" 0 ]

litmus "mp_rel_rlx"
  [ thread [ store "relaxed" "data" 1; store "release" "flag" 1 ]
  ; thread [ load "relaxed" "flag" "r1"; load "relaxed" "data" "r2" ] ]
  "allowed" [ is "r1" 1; is "r2" 0 ]

litmus "mp_rlx_acq"
  [ thread [ store "relaxed" "data" 1; store "relaxed" "flag" 1 ]
  ; thread [ load "acquire" "flag" "r1"; load "relaxed" "data" "r2" ] ]
  "allowed" [ is "r1" 1; is "r2" 0 ]

litmus "mp_fences"
  [ thread [ store "relaxed" "data" 1; barrier "release"; store "relaxed" "flag" 1 ]
  ; thread [ load "relaxed" "flag" "r1"; barrier "acquire"; load "relaxed" "data" "r2" ] ]
  "forbidden" [ is "r1" 1; is "r2" 0 ]

litmus "mp_fence_acq"
  [ thread [ store "relaxed" "data" 1; barrier "release"; store "relaxed" "flag" 1 ]
  ; thread [ load "acquire" "flag" "r1"; load "relaxed" "data" "r2" ] ]
  "forbidden" [ is "r1" 1; is "r2" 0 ]

litmus "mp_plain_data"
  [ thread [ write "data" 1; store "release" "flag" 1 ]
  ; thread [ load "acquire" "flag" "r1"; read "data" "r2" ] ]
  "forbidden" [ is "r1" 1; is "r2" 0 ]

(* Expected report, in order.
// CHECK: mp.pia:12:1: proved: no RC11 execution of 'mp_rel_acq' ends with the outcome [smt]
// CHECK: mp.pia:12:1: proved: no x86-TSO execution of 'mp_rel_acq' ends with the outcome [smt]
// CHECK: mp.pia:12:1: proved: no Armv8 execution of 'mp_rel_acq' ends with the outcome [smt]
// CHECK: mp.pia:17:1: proved: no RC11 execution of 'mp_sc' ends with the outcome [smt]
// CHECK: mp.pia:17:1: proved: no x86-TSO execution of 'mp_sc' ends with the outcome [smt]
// CHECK: mp.pia:17:1: proved: no Armv8 execution of 'mp_sc' ends with the outcome [smt]
// CHECK: mp.pia:22:1: failed: no RC11 execution of 'mp_rlx' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: mp.pia:22:1: proved: no x86-TSO execution of 'mp_rlx' ends with the outcome [smt]
// CHECK: mp.pia:22:1: failed: no Armv8 execution of 'mp_rlx' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: mp.pia:27:1: failed: no RC11 execution of 'mp_rel_rlx' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: mp.pia:27:1: proved: no x86-TSO execution of 'mp_rel_rlx' ends with the outcome [smt]
// CHECK: mp.pia:27:1: failed: no Armv8 execution of 'mp_rel_rlx' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: mp.pia:32:1: failed: no RC11 execution of 'mp_rlx_acq' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: mp.pia:32:1: proved: no x86-TSO execution of 'mp_rlx_acq' ends with the outcome [smt]
// CHECK: mp.pia:32:1: failed: no Armv8 execution of 'mp_rlx_acq' ends with the outcome
// CHECK-NEXT: counterexample: r1 = 1, r2 = 0
// CHECK: mp.pia:37:1: proved: no RC11 execution of 'mp_fences' ends with the outcome [smt]
// CHECK: mp.pia:37:1: proved: no x86-TSO execution of 'mp_fences' ends with the outcome [smt]
// CHECK: mp.pia:37:1: proved: no Armv8 execution of 'mp_fences' ends with the outcome [smt]
// CHECK: mp.pia:42:1: proved: no RC11 execution of 'mp_fence_acq' ends with the outcome [smt]
// CHECK: mp.pia:42:1: proved: no x86-TSO execution of 'mp_fence_acq' ends with the outcome [smt]
// CHECK: mp.pia:42:1: proved: no Armv8 execution of 'mp_fence_acq' ends with the outcome [smt]
// CHECK: mp.pia:47:1: proved: no RC11 execution of 'mp_plain_data' ends with the outcome [smt]
// CHECK: mp.pia:47:1: proved: no x86-TSO execution of 'mp_plain_data' ends with the outcome [smt]
// CHECK: mp.pia:47:1: proved: no Armv8 execution of 'mp_plain_data' ends with the outcome [smt]
// CHECK: 18 proved, 6 failed, 0 skipped
*)
