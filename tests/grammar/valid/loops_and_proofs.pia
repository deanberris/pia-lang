(* Loops with invariants and termination measures, assertions, exists. *)
let rec gcd (a : u32) (b : u32) : u32
  decreases b
= if b = 0 then a else gcd b (a mod b)

let find (xs : borrowed in [i32]) (x : i32) : usize
  ensures result < len xs ==> xs.[result] = x
=
  let i : mutable usize = 0 in
  while i < len xs && xs.[i] <> x
    invariant forall (j in 0..i). xs.[j] <> x
    decreases len xs - i
  do
    i <- i + 1
  done;
  assert i <= len xs;
  i

let has_zero (xs : [i32]) : bool
  ensures result = exists (i in 0..len xs). xs.[i] = 0
= any (let (x) => x = 0) xs
