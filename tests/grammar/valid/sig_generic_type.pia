(* An interface shows a generic type as it is defined (ADR 0039). *)
module Opt : Ops

interface Ops = sig
  let option = let (t : type) => type | None | Some of t
  let pair = let (a : type) (b : type) => type { fst : a; snd : b }
  let get : (o : option u8) -> (d : u8) -> u8
end

(* A concept and a generic function over it, exported with their
   definitions. *)
interface Generic = sig
  let meta Before : concept
  let smaller : (t : type where Before t) -> (a : t) -> (b : t) -> t
end
