(* Bit operators bind tighter than comparisons and looser than `*`:
   `<<` `>>` 5.5, `^` 6.4, `&` 6.5, and prefix `~` like `-`. Bitwise `|`
   is left out of this shared corpus (grammar/pia.lark explains why). *)
let low_nibble (x : u8) : u8 = x & 15

let is_even (x : u32) : bool = x & 1 = 0

let shift_sum (x : u16) (a : u16) : u16 = x << 8 + a   (* x << (8 + a) *)

let flip (x : u8) (m : u8) : u8 = x ^ m & ~m

let half (x : i32) : i32 = x >> 1

let doubled (n : u32) : bool = 0 .. n << 1 = 0 .. n   (* 0 .. (n << 1) *)

let meta operator ( <+> ) : prec 6.5 left = let (a) (b) => `( add $a $b )
