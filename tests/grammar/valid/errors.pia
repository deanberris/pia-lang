(* `?` and `handle` (ADR 0028). *)
let load (path : u8) : result u8 load_error =
  let f = open_read path? in
  let bytes = read_all f? in
  decode bytes? + 1
handle
| NoEntry -> Err (Missing path)
| OutOfMemory -> Err TooBig

let local (x : u8) : u8 = (let y = h x? in y handle | E -> 0)

let each (n : u8) : unit =
  for i in 0..n do
    step i?
  handle
  | E -> ()
  done

let wrap (path : u8) : result u8 app_error =
  let f = open_read path? in
  Ok f
handle
| NoEntry as e -> Err (Wrapped e)
| PngError p -> Err (BadImage p)
| e -> Err (Other e)

(* `defer` runs cleanup at every exit from the rest of the sequence. *)
let read (path : u8) : result u8 load_error =
  let f = open_read path? in
  defer close f;
  read_all f?

let both (x : u8) : unit = note 0; defer note 1; defer note 2; note x
