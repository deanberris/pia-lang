        (None)
      )
      (Attrs)
    )
    (Contracts
      (Requires
        (Binary "&&"
          (Binary "="
            (Apply
              (Field "in_w"
                (Name "Lip")
              )
              (Name "a")
            )
            (IntLit "512")
          )
          (Binary "&&"
            (Binary "="
              (Apply
