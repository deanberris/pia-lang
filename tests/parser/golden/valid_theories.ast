          (Apply
            (Field "in_w"
              (Name "Lip")
            )
            (Apply
              (Field "seq"
                (Name "Lip")
              )
              (Apply
                (Field "residual"
                  (Name "Lip")
                )
                (Name "a")
              )
              (Name "b")
            )
          )
          (IntLit "512")
        )
      )
      (Ensures
        (Binary "="
          (Apply
            (Field "out_w"
              (Name "Lip")
            )
            (Apply
              (Field "seq"
                (Name "Lip")
              )
              (Apply
                (Field "residual"
                  (Name "Lip")
                )
                (Name "a")
              )
              (Name "b")
            )
          )
          (IntLit "10")
        )
      )
      (Ensures
        (Binary "<="
          (Apply
            (Field "lip"
              (Name "Lip")
            )
            (Apply
              (Field "seq"
                (Name "Lip")
              )
              (Apply
                (Field "residual"
                  (Name "Lip")
                )
                (Name "a")
              )
              (Name "b")
            )
          )
          (FloatLit "3.0")
        )
      )
    )
    (Unit)
