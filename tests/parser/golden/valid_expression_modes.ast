(Program
  (LetItem "mix"
    (Params
      (Param "a"
        (Annot
          (Modifiers)
          (TypeName "u8")
          (None)
        )
      )
      (Param "b"
        (Annot
          (Modifiers)
          (TypeName "u8")
          (None)
        )
      )
    )
    (RetAnnot
      (Annot
        (Modifiers)
        (TypeName "u8")
        (None)
      )
      (Attrs)
    )
    (Contracts)
    (Binary "^"
      (Apply
        (Name "#overflow" [prelude])
        (Name "wrap")
        (Binary "+"
          (Name "a")
          (Name "b")
        )
      )
      (Apply
        (Name "#overflow" [prelude])
        (Name "saturate")
        (Binary "-"
          (Name "a")
          (Name "b")
        )
      )
    )
  )
  (LetItem "bump"
    (Params
      (Param "c"
        (Annot
          (Modifiers "borrowed")
          (TypeApp
            (TypeName "atomic")
            (TypeName "u32")
          )
          (None)
        )
      )
    )
    (RetAnnot
      (Annot
        (Modifiers)
        (TypeName "u32")
        (None)
      )
      (Attrs)
    )
    (Contracts)
    (Apply
      (Name "#overflow" [prelude])
      (Name "wrap")
      (Apply
        (Name "atomic_add")
        (Name "relaxed")
        (Name "c")
        (IntLit "1")
      )
    )
  )
)
