(* Facts that belong in types (ADR 0037): constant bounds on one value.
// RUN: piac --check %s 2>&1 | FileCheck %s
// RUN: piac --check --no-lint %s 2>&1 | FileCheck --allow-empty --check-prefix=OFF %s
// RUN: piac --check --no-lint=range_requires %s 2>&1 | FileCheck --check-prefix=SOME %s
*)

let f (x : u8) : u8
  requires x < 100
= x + 1

let g (a : u8) (b : u8) : u8
  requires a < 100 && b <= 9
= a

(* Only the constant part moves; the relation stays a contract. *)
let j (x : u16) (y : u16) : u16
  requires x < 10 &&
           y < x
= y

(* A one-sided bound on a 64-bit type stays a contract until ranges can
   leave a side open. *)
let h (w : usize) (n : usize) : usize
  requires w >= 3 && w + w + w <= n
= w

let r (x : u8) : u8
  requires x >= 0
= x

let lo4 (x : u8) : u8
  ensures result < 16
= x & 15

let first (xs : [u8]) : u8
  requires len xs > 0 && forall (k in 0..len xs). xs.[k] < 16
= xs.[0]

(* The comparison happens at x's type once x is a range. *)
let k (x : u8) : bool
  requires x < 10
= x + 1 > 3

(* Narrower storage changes the C signature. *)
let wide (x : u32) : u32
  requires x <= 1000
= x

(* Wrapping arithmetic at a range type would wrap at the range. *)
let w (x : u8) : u8 @overflow(wrap)
  requires x < 100
= x + 1

let q (x : u8) : u8 @allow(range_requires)
  requires x < 100
= x

(* Expected lints, in order.
// OFF-NOT: warning
// SOME-NOT: [range_requires]
// SOME: types.pia:28:3: warning: this precondition only restates the type of 'x'; remove it [redundant_bound]
// CHECK: types.pia:8:3: warning: this precondition only bounds 'x' by constants; say it in the type instead, (x : int{0..99}), so the fact travels with the value and intervals can use it [range_requires]
// CHECK-NEXT:   requires x < 100
// CHECK-NEXT:   ^
// CHECK-NEXT: fix: Move the bound into the type: (x : int{0..99})
// CHECK: types.pia:12:3: warning: this precondition only bounds 'a' and 'b' by constants; say it in the types instead, (a : int{0..99}) and (b : int{0..9}), so the fact travels with the value and intervals can use it [range_requires]
// CHECK: types.pia:17:12: warning: this part of the precondition bounds 'x' by constants; say it in the type instead, (x : int{0..9}), so the fact travels with the value and intervals can use it; note: 'x' is then stored as u8, not u16, which changes the C signature [range_requires]
// CHECK-NOT: types.pia:24
// CHECK: types.pia:28:3: warning: this precondition only restates the type of 'x'; remove it [redundant_bound]
// CHECK: fix: Remove the bound the type already states
// CHECK: types.pia:32:3: warning: this postcondition only bounds the result by constants; say it in the type instead, the return type int{0..15}, so the fact travels with the value and intervals can use it [range_ensures]
// CHECK: types.pia:36:26: warning: this part of the precondition bounds the elements of 'xs' by constants; say it in the type instead, (xs : [int{0..15}]), so the fact travels with the value and intervals can use it without a quantifier [range_requires]
// CHECK: types.pia:41:3: warning: this precondition only bounds 'x' by constants; say it in the type instead, (x : int{0..9}), so the fact travels with the value and intervals can use it; note: arithmetic on 'x' that no wider type is expected for, such as in a comparison or an unannotated 'let', then happens at int{0..9}, and may need a type [range_requires]
// CHECK: types.pia:46:3: warning: this precondition only bounds 'x' by constants; say it in the type instead, (x : int{0..1000}), so the fact travels with the value and intervals can use it; note: 'x' is then stored as u16, not u32, which changes the C signature [range_requires]
// CHECK-NOT: warning
*)
