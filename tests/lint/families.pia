(* Functions that want to be one definition (ADR 0036): the same body at
   other types wants a generic function and a concept, the same body with
   other constants wants a parameter or a metaprogram, and hand-written
   field-by-field equality wants @derive(eq).
// RUN: piac --check %s 2>&1 | FileCheck %s
*)

let max_u8 (a : u8) (b : u8) : u8 = if a > b then a else b
let max_u16 (a : u16) (b : u16) : u16 = if a > b then a else b

let cap_low (a : u8) : u8 = if a > 10 then 10 else a + 1
let cap_high (a : u8) : u8 = if a > 20 then 20 else a + 1

let copy_max (a : u8) (b : u8) : u8 = if a > b then a else b

let pixel = type { r : u8; g : u8 }
let same (p : pixel) (q : pixel) : bool = p.r = q.r && p.g = q.g

(* Not every field: not an equality. *)
let same_red (p : pixel) (q : pixel) : bool = p.r = q.r

let point = type { x : u8; y : u8 } @derive(eq)

(* Small bodies are not worth a family. *)
let id8 (a : u8) : u8 = a
let id16 (a : u16) : u16 = a

(* Expected lints, in order.
// CHECK: families.pia:9:5: warning: 'max_u16' has the same body as 'max_u8' (line 8) at other types; write it once as a generic function, '(t : type where C t)', where the concept C names what the body uses, and its laws are proved once per type instead of once per copy [generic_candidate]
// CHECK: families.pia:12:5: warning: 'cap_high' differs from 'cap_low' (line 11) only in its constants; take them as parameters (range-typed, so callers keep the facts), or generate the family with a metaprogram so there is one definition to read and prove [metaprogram_candidate]
// CHECK: families.pia:14:5: warning: 'copy_max' is a copy of 'max_u8' (line 8); call 'max_u8' instead [duplicate_function]
// CHECK: families.pia:17:5: warning: 'same' compares every field of 'pixel'; write '@derive(eq)' on the type and use '=', so the equality and its postcondition stay in step with the fields [derivable_eq]
// CHECK-NOT: warning
*)
