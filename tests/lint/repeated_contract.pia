(* `repeated_contract` (ADR 0077): a definition that states exactly the
   contract it would take from its interface.
// RUN: piac --check %s 2>&1 | FileCheck %s
*)
module Counting : Counter

interface Counter = sig
  let count_to : (n : u32) -> u32
    requires n < 1000
    ensures result = n
  let clamp_to : (x : u8) -> (hi : u8) -> u8
    ensures result <= hi
  let twice : (x : u8) -> u16
    ensures result = 2 * x
end

(* The same contract, with the parameter renamed: flagged. *)
let count_to (m : u32) : u32
  requires m < 1000
  ensures result = m
= m

(* A stronger contract than the interface's: kept. *)
let clamp_to (x : u8) (hi : u8) : u8
  ensures result <= hi
  ensures x <= hi ==> result = x
= if x > hi then hi else x

(* Opted out. *)
let twice (x : u8) : u16 @allow(repeated_contract)
  ensures result = 2 * x
= x + x

(* Expected warnings.
// CHECK: repeated_contract.pia:19:3: warning: 'count_to' repeats the contract of the interface that lists it, which it takes when it states none; remove it [repeated_contract]
// CHECK-NOT: [repeated_contract]
*)
