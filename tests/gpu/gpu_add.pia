(* The step 1 kernel, c = a + b over 1024 i32, run on the GPU from Pia
   through Pia.Gpu (ADR 0068, step 2; ADR 0070, step 5). Embeds the
   .metallib directly via @embed and exposes its C symbol for dispatch_test.c. *)
module GpuAdd : GpuAddOps

import Pia.Gpu.Gpu as G

let add_metallib : [u8] @embed(file = "add_metallib.metallib", symbol = "pia_test_add_metallib")

interface GpuAddOps @abi(c) = sig
  (** 0 when c holds a + b, else 1 + the Gpu.error, in its order. *)
  let gpu_add : (a : [i32]) -> (b : [i32]) -> (c : out mutable [i32]) -> i32
    requires len a = 1024 && len b = 1024 && len c = 1024
end

let run (a : [i32]) (b : [i32]) (c : out mutable [i32]) : result unit G.error
  requires len a = 1024 && len b = 1024 && len c = 1024
=
  let d = G.device_open? in
  defer G.device_close d;
  let lib = G.library_load d add_metallib? in
  defer G.library_free lib;
  let ba = G.buffer_new_i32 d 1024? in
  defer G.buffer_free_i32 ba;
  let bb = G.buffer_new_i32 d 1024? in
  defer G.buffer_free_i32 bb;
  let bc = G.buffer_new_i32 d 1024? in
  defer G.buffer_free_i32 bc;
  G.write_i32 ba a;
  G.write_i32 bb b;
  let name : [u8; 3] = [97; 100; 100] in
  let k = G.kernel_get lib name? in
  let bufs : [u64; 3] = [G.raw_of ba; G.raw_of bb; G.raw_of bc] in
  G.dispatch d k bufs 1024 64 10000?;
  G.read_i32 bc c;
  Ok ()

let gpu_add (a : [i32]) (b : [i32]) (c : out mutable [i32]) : i32
=
  match run a b c with
  | Ok -> 0
  | Err e ->
    (match e with
     | Gpu_unavailable -> 1
     | Gpu_out_of_memory -> 2
     | Gpu_fault -> 3
     | Gpu_timeout -> 4)
