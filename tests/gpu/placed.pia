(* Spreads placed on the GPU (ADR 0068, step 3). The same body runs as a
   spread on the CPU and, with @place(gpu), as a Metal kernel that piac
   compiles and embeds; placed_test.c checks that both give the same
   cells. The body reads 16-bit buffers, writes a 32-bit one, takes a
   scalar, reads a neighbour and calls a function, which is inlined. *)
module Placed : PlacedOps

interface PlacedOps @abi(c) = sig
  let mix_cpu : (a : [u16]) -> (b : [u16]) -> (k : u8) -> (c : out mutable [u32]) -> unit
    requires len a = len c && len b = len c
  (** 0 when c holds the same cells as mix_cpu, else 1 + the Gpu.error, in
      its order. *)
  let mix_gpu : (a : [u16]) -> (b : [u16]) -> (k : u8) -> (c : out mutable [u32]) -> i32
    requires len a = len c && len b = len c
end

let mix (x : u32) (y : u32) (k : u8) : u32
  requires x < 65536 && y < 65536
= x * 3 + y + k

let mix_cpu (a : [u16]) (b : [u16]) (k : u8) (c : out mutable [u32]) : unit
  requires len a = len c && len b = len c
= spread i in 0 .. len c do
    let x : u32 = a.[i] in
    let y : u32 = if i > 0 then b.[i - 1] else b.[i] in
    c.[i] <- mix x y k
  done

let mix_run (a : [u16]) (b : [u16]) (k : u8) (c : out mutable [u32]) : result unit gpu_error
  requires len a = len c && len b = len c
= spread i in 0 .. len c @place(gpu) do
    let x : u32 = a.[i] in
    let y : u32 = if i > 0 then b.[i - 1] else b.[i] in
    c.[i] <- mix x y k
  done

let mix_gpu (a : [u16]) (b : [u16]) (k : u8) (c : out mutable [u32]) : i32
  requires len a = len c && len b = len c
=
  match mix_run a b k c with
  | Ok -> 0
  | Err e ->
    (match e with
     | Gpu_unavailable -> 1
     | Gpu_out_of_memory -> 2
     | Gpu_fault -> 3
     | Gpu_timeout -> 4)
