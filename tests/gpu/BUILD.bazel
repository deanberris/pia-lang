load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/gpu:metal.bzl", "metal_library")
load("//tools/piac:pia.bzl", "pia_binary", "pia_library")

# The GPU toolchain end to end (ADR 0068, step 1): a hand-written gpu.module
# through piac --emit=spirv, spirv-val, SPIRV-Cross and the Metal compiler.

genrule(
    name = "add_spv",
    srcs = ["add.mlir"],
    outs = ["add.spv"],
    cmd = "$(location //tools/piac) --emit=spirv -o $@ $(location add.mlir)",
    tools = ["//tools/piac"],
)

sh_test(
    name = "spirv_val_test",
    srcs = ["spirv_val_test.sh"],
    args = [
        "$(rootpath @spirv_tools//:spirv-val)",
        "$(rootpath :add_spv)",
    ],
    data = [
        ":add_spv",
        "@spirv_tools//:spirv-val",
    ],
)

genrule(
    name = "add_msl",
    srcs = [":add_spv"],
    outs = ["add.metal"],
    cmd = "$(location @spirv_cross//:spirv-cross) $(location :add_spv) --msl --msl-version 20100 --output $@",
    tools = ["@spirv_cross//:spirv-cross"],
)

sh_test(
    name = "msl_test",
    srcs = ["msl_test.sh"],
    args = ["$(rootpath :add_msl)"],
    data = [":add_msl"],
)

# The .metallib, built at build time and embedded directly via `@embed`
# (ADR 0068, ADR 0070 step 5; macOS with Xcode's Metal toolchain).
metal_library(
    name = "add_metallib",
    src = ":add_msl",
)

pia_binary(
    name = "embed_test_bin",
    src = "embed_test.pia",
    embeds = [":add_metallib"],
    tags = ["requires-metal"],
    target_compatible_with = ["@platforms//os:macos"],
)

sh_test(
    name = "embed_test",
    srcs = ["embed_test.sh"],
    args = ["$(rootpath :embed_test_bin)"],
    data = [":embed_test_bin"],
    tags = ["requires-metal"],
    target_compatible_with = ["@platforms//os:macos"],
)

# The kernel on the GPU (ADR 0068, step 2): through the Metal shim's C API,
# and from Pia through Pia.Gpu, using the `@embed`-ed .metallib from `gpu_add`.
# It needs a Mac with a GPU and the Metal toolchain.
pia_library(
    name = "gpu_add",
    src = "gpu_add.pia",
    embeds = [":add_metallib"],
    tags = ["requires-metal"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["//lib/Pia:gpu"],
)

cc_test(
    name = "dispatch_test",
    srcs = [
        "dispatch_test.c",
        ":gpu_add",
        "//lib/Pia:gpu",
    ],
    tags = [
        "requires-gpu",
        "requires-metal",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//src/runtime/metal",
    ],
)

# A spread placed on the GPU (ADR 0068, step 3): piac outlines the body,
# compiles it with Xcode's Metal toolchain (so outside the sandbox) and
# embeds it; placed_test.c runs it against the same spread on the CPU.
pia_library(
    name = "placed",
    src = "placed.pia",
    tags = [
        "no-sandbox",
        "requires-metal",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

cc_test(
    name = "placed_test",
    srcs = [
        "placed_test.c",
        ":placed",
    ],
    tags = [
        "requires-gpu",
        "requires-metal",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//src/runtime/metal",
        "@llvm-project//mlir:mlir_async_runtime",
    ],
)
