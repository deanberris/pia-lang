(* Migration rule box-states (ADR 0046, a theory of a box's state, piac
   0.0.0+790): before it, a `box C` was full by its type, so a signature
   said nothing of its state; since, every contract states it, and piac
   rejects one that does not. `piac migrate` adds what the old program
   assumed, `requires full b` for a box taken and `ensures full b` or
   `ensures full result` for one handed back, and the result proves.
// RUN: cp %s %t/old.pia
// RUN: not piac migrate --check %t/old.pia | FileCheck %s
// RUN: not piac --emit=mlir --no-lint %t/old.pia 2>&1 | FileCheck %s --check-prefix=REJECTED
// RUN: piac migrate %t/old.pia
// RUN: piac migrate --check %t/old.pia | FileCheck %s --allow-empty --check-prefix=NONE
// RUN: piac --verify --no-lint %t/old.pia | FileCheck %s --check-prefix=PROVED
// RUN: piac migrate --from=0.0.0+790 --check %s | FileCheck %s --allow-empty --check-prefix=NONE
*)

let box = let (@unsized t : type) (r : region) => type { slot : borrowed(r) mutable [t]; state : int }

let meta Shape (t : type) : concept = sig
  let area : (s : t) -> u32
end

let square = type { side : u8 }
let area (s : square) : u32 = s.side

let size (x : box Shape) : u32 = area x

let make (b : box square) : box Shape
  requires len b.slot = 1 && b.state = 1
= widen b

let swap (x : inout mutable box Shape) (y : box Shape) : unit
= x <- y

let stated (x : box Shape) : u32
  requires full x
= area x

(* Expected: one rewrite for each of size, make and swap; stated already
   states its box's state.
// CHECK: old.pia:25:1: [box-states] 'size' states no state for a box over a concept, which ADR 0046 requires of every contract; before, a box was full by its type. Add 'requires full x' (piac migrate rewrites it)
// CHECK: old.pia:27:1: [box-states] 'make' states no state for a box over a concept, which ADR 0046 requires of every contract; before, a box was full by its type. Add 'ensures full result' (piac migrate rewrites it)
// CHECK: old.pia:31:1: [box-states] 'swap' states no state for a box over a concept, which ADR 0046 requires of every contract; before, a box was full by its type. Add 'requires full x', 'requires full y', 'ensures full x' (piac migrate rewrites it)
// CHECK-NOT: box-states
// REJECTED: error: 'size' takes the box 'x' and states no state for it
// NONE-NOT: {{.}}
// PROVED: 0 failed
*)
