(* A concept's laws and requirement contracts at a type of its module are
   proved once, by that module (ADR 0039, step 6), so an importer does not
   prove them again: Algo.Order proves Before at u8, met by its own
   `before`, and this file proves only its own goals.
// RUN: piac --emit=interface -o %t %S/Inputs/order.pia
// RUN: piac --verify --iface-path=%t %s | FileCheck %s
*)
import Algo.Order.Ord

let least (a : u8) (b : u8) : u8
  ensures result <= a && result <= b
= Algo.Order.smaller<u8> a b

(* Only this file's goal is proved: no law or requirement contract of
   Before at u8, which would be reported at the import. The import line
   still notes the instance of the imported generic.
// CHECK-NOT: certified.pia:8:1: {{.*}}the postcondition holds
// CHECK: certified.pia:11:3: proved: the postcondition holds
// CHECK-NOT: certified.pia:8:1: {{.*}}the postcondition holds
// CHECK: 2 proved, 0 failed, 0 skipped
*)
