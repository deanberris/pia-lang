(* A module whose closed error set has one open case, `Cxx of box
   Exception` (ADR 0046, the cache-line amendment, step 2): it raises a
   not_found through the box, and an importer may box errors of its own
   types in the same case. *)
module Raise : Errors

interface Errors = sig
  let meta Exception : concept
  let not_found = type { id : u16 }
  let io_error = type | Closed | Cxx of box Exception
  let fail : (nf : borrowed mutable [not_found]) -> (x : u8) -> result u8 io_error
    requires len nf = 1
    ensures (match result with | Ok v -> v = x | Err _ -> true)
end

let box = let (@unsized t : type) (r : region) => type { slot : borrowed(r) mutable [t]; state : int }

let meta Exception (t : type) : concept = sig
  let code : (e : t) -> u32 ensures result > 0
end

let not_found = type { id : u16 }
let code (e : not_found) : u32 ensures result > 0 = 400 + e.id

let io_error = type | Closed | Cxx of box Exception

let fail (nf : borrowed mutable [not_found]) (x : u8) : result u8 io_error
  requires len nf = 1
  ensures (match result with | Ok v -> v = x | Err _ -> true)
= if x = 0 then Err Closed
  else if x = 1 then
    (let b : box not_found = { slot = nf; state = 1 } in
     Err (Cxx (widen b)))
  else Ok x
