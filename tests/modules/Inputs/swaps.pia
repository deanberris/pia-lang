(* A module whose interface states the postconditions of functions that
   write their parameters (ADR 0039, step 3): a buffer passed inout, and a
   scalar passed inout, which the caller gets back. *)
module Bufs.Swap : Swaps

interface Swaps = sig
  let swap : (xs : borrowed inout mutable [u8]) -> (i : usize) -> (j : usize) -> unit
    requires i < len xs && j < len xs
    ensures xs.[i] = old (xs.[j]) && xs.[j] = old (xs.[i])
    ensures forall (k in 0..len xs). k <> i && k <> j ==> xs.[k] = old (xs.[k])
  let exchange : (xs : borrowed inout mutable [u8]) -> (i : usize) -> (v : u8) -> u8
    requires i < len xs
    ensures result = old (xs.[i]) && xs.[i] = v
  let bump : (n : inout mutable u8) -> unit
    requires n < 255
    ensures n = old n + 1
end

(* The definitions promise more than the interface states, which is
   allowed: the interface's contract is proved from a call. *)
let swap (xs : borrowed inout mutable [u8]) (i : usize) (j : usize) : unit
= let a = xs.[i] in
  let b = xs.[j] in
  xs.[i] <- b;
  xs.[j] <- a

let exchange (xs : borrowed inout mutable [u8]) (i : usize) (v : u8) : u8
  requires i < len xs
  ensures result = old (xs.[i]) && xs.[i] = v
  ensures forall (k in 0..len xs). k <> i ==> xs.[k] = old (xs.[k])
= let a = xs.[i] in
  xs.[i] <- v;
  a

let bump (n : inout mutable u8) : unit @allow(range_requires)
= n <- n + 1
