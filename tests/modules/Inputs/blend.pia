(* Imports Image.Pixels and is compiled on its own (ADR 0039): its build
   reads only Image.Pixels's interface artifacts, and its object file calls
   Image.Pixels's link symbols. *)
module Blend : C

import Image.Pixels.Ops

interface C @abi(c) = sig
  let blend : (x : u8) -> (y : u8) -> u8
    ensures result <= x || result <= y
  let grey : (v : u8) -> u8
    requires v <= 200
end

let blend (x : u8) (y : u8) : u8
  ensures result <= x || result <= y
= Image.Pixels.mix x y

let grey (v : u8) : u8
  requires v <= 200
= Image.Pixels.luma v v v
