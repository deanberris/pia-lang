(* A lemma exported in an interface (#305): proved here, once. *)
module Calc.Sums : Facts

interface Facts = sig
  let spec dbl : (x : int) -> int
  let lemma dbl_mono : (a : int) -> (b : int) -> unit
    requires a <= b
    ensures dbl a <= dbl b
  let spec tri : (n : u8) -> int
  let lemma tri_ge : (n : u8) -> unit
    ensures tri n >= n
end

let spec dbl (x : int) : int = x + x

let lemma dbl_mono (a : int) (b : int) : unit
= ()

(* Proved by induction, so the interface's contract follows only from a
   call of the lemma, not from tri's definition unfolded a few times. *)
let spec tri (n : u8) : int
  decreases n
= if n = 0 then 0 else n + tri (n - 1)

let lemma tri_ge (n : u8) : unit
  decreases n
= if n > 0 then tri_ge (n - 1)
