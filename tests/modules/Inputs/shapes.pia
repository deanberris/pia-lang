(* A module that shows its types (ADR 0039, step 3): a variant, a record,
   and two generic types, used by the functions it exports. It also exports
   two values: `limit` shows its definition, which importers' proofs may
   use, and `home` does not, so importers link to it. *)
module Geo.Shapes : Shapes

interface Shapes = sig
  let side = type | Left | Right | On
  let point = type { x : i32; y : i32 }
  let maybe = let (t : type) => type | Nothing | Just of t
  let pair = let (t : type) => type { first : t; second : t }
  let side_of : (p : point) -> side
    ensures p.x < 0 ==> result = Left
    ensures p.x > 0 ==> result = Right
    ensures p.x = 0 ==> result = On
  let first_or : (m : maybe u8) -> (d : u8) -> u8
    ensures (match m with | Just v -> result = v | Nothing -> result = d)
  let swap : (p : pair u8) -> pair u8
    ensures result.first = p.second && result.second = p.first
  let limit : i32 = 100
  let home : side
end

let side = type | Left | Right | On
let point = type { x : i32; y : i32 }
let maybe = let (t : type) => type | Nothing | Just of t
let pair = let (t : type) => type { first : t; second : t }

let side_of (p : point) : side
= if p.x < 0 then Left else if p.x > 0 then Right else On

let first_or (m : maybe u8) (d : u8) : u8
= match m with
  | Just v -> v
  | Nothing -> d

let swap (p : pair u8) : pair u8
= { first = p.second; second = p.first }

let limit : i32 = 100

let home : side = On
