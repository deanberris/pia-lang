load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tests/lit:lit.bzl", "lit_tests")
load("//tools/piac:pia.bzl", "pia_binary", "pia_library")
load("//tools/piac:targets.bzl", "PIA_TARGETS")

# Modules across files (ADR 0039, step 2): interface artifacts, imports
# resolved through --iface-path, and link symbols.
lit_tests(
    name = "modules_tests",
    srcs = glob(["*.pia"]),
    data = glob(["Inputs/*.pia"]),
    tools = ["//tools/piac"],
)

# Separate compilation end to end, on each target: Blend imports
# Image.Pixels, each is proved and compiled on its own, and a C harness
# calls Blend's entry point, which calls into Image.Pixels.
pia_library(
    name = "pixels",
    src = "Inputs/pixels.pia",
    target_compatible_with = PIA_TARGETS,
)

pia_library(
    name = "blend",
    src = "Inputs/blend.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [":pixels"],
)

cc_test(
    name = "blend_test",
    srcs = [
        "blend_test.c",
        ":blend",
    ],
    target_compatible_with = PIA_TARGETS,
)

# A Pia `main` that imports a module, linked with pia_binary.
pia_binary(
    name = "grey",
    src = "Inputs/grey.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [":pixels"],
)

sh_test(
    name = "grey_test",
    srcs = ["grey_test.sh"],
    args = ["$(rootpath :grey)"],
    data = [":grey"],
    target_compatible_with = PIA_TARGETS,
)

# Records and variants passed between separately compiled modules.
pia_library(
    name = "shapes",
    src = "Inputs/shapes.pia",
    target_compatible_with = PIA_TARGETS,
)

pia_binary(
    name = "shapes_run",
    src = "Inputs/shapes_run.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [":shapes"],
)

sh_test(
    name = "shapes_run_test",
    srcs = ["shapes_run_test.sh"],
    args = ["$(rootpath :shapes_run)"],
    data = [":shapes_run"],
    target_compatible_with = PIA_TARGETS,
)
