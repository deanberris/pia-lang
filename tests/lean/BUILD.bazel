load("//tests/lit:lit.bzl", "lit_tests")
load("//tools/lean:lean.bzl", "lean_check_test", "pia_lean_proof")

# Lemmas proved in Lean (ADR 0061). sums_proof runs Lean on Proofs.lean
# against the statements of sums.pia and writes the receipts that the lit
# tests pass to piac: sums.pia is proved with them, and sums_stale.pia,
# whose `sum` has changed since, is not.
pia_lean_proof(
    name = "sums_proof",
    src = "sums.pia",
    proofs = "Proofs.lean",
)

# native_proof proves native_trusted.pia's lemma with `native_decide`, which
# only a `@trusted` file may use; native_untrusted.pia is the same lemma in
# a file that is not, and fails with the same receipt.
pia_lean_proof(
    name = "native_proof",
    src = "native_trusted.pia",
    proofs = "Native.lean",
)

# bytes_proof proves bytes.pia's lemmas over machine integers, each an
# `Int` with its range as a hypothesis (ADR 0061, step 3).
pia_lean_proof(
    name = "bytes_proof",
    src = "bytes.pia",
    proofs = "Bytes.lean",
)

# slices_proof proves slices.pia's lemma, by induction over a slice's
# prefix, which Z3 cannot do.
pia_lean_proof(
    name = "slices_proof",
    src = "slices.pia",
    proofs = "Slices.lean",
)

# variants_proof proves variants.pia's lemmas over variant types, by
# cases on the constructor.
pia_lean_proof(
    name = "variants_proof",
    src = "variants.pia",
    proofs = "Variants.lean",
)

# reals_proof proves reals.pia's lemma over reals and its theory's Lean
# model with Mathlib, whose exp meets the theory's axioms.
pia_lean_proof(
    name = "reals_proof",
    src = "reals.pia",
    mathlib = "@mathlib//:oleans",
    proofs = "Reals.lean",
)

lit_tests(
    name = "lean_tests",
    srcs = glob(["*.pia"]),
    data = [
        ":bytes_proof",
        ":native_proof",
        ":reals_proof",
        ":slices_proof",
        ":variants_proof",
        ":sums_proof",
    ],
    tools = [
        "//tools/pia-cert",
        "//tools/piac",
    ],
)

# The verifier's call rule, modelled in Lean: sound for code that runs,
# sound for erased calls only with the termination goals, modular, and
# incomplete where a contract is weaker than its body (ADR 0076).
lean_check_test(
    name = "call_rule_test",
    src = "CallRule.lean",
)
