load("//tests/lit:lit.bzl", "lit_tests")
load("//tools/lean:lean.bzl", "pia_lean_proof")

# Lemmas proved in Lean (ADR 0061). sums_proof runs Lean on Proofs.lean
# against the statements of sums.pia and writes the receipts that the lit
# tests pass to piac: sums.pia is proved with them, and sums_stale.pia,
# whose `sum` has changed since, is not.
pia_lean_proof(
    name = "sums_proof",
    src = "sums.pia",
    proofs = "Proofs.lean",
)

# native_proof proves native_trusted.pia's lemma with `native_decide`, which
# only a `@trusted` file may use; native_untrusted.pia is the same lemma in
# a file that is not, and fails with the same receipt.
pia_lean_proof(
    name = "native_proof",
    src = "native_trusted.pia",
    proofs = "Native.lean",
)

lit_tests(
    name = "lean_tests",
    srcs = glob(["*.pia"]),
    data = [
        ":native_proof",
        ":sums_proof",
    ],
    tools = [
        "//tools/pia-cert",
        "//tools/piac",
    ],
)
