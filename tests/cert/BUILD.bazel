load("@rules_cc//cc:defs.bzl", "cc_test")

# The certificate format and the link check (src/cert, ADR 0073), on
# certificates made in memory, for the cases piac cannot be made to write:
# old formats, and objects for another ABI version or target.
cc_test(
    name = "certificate_test",
    srcs = ["certificate_test.cpp"],
    deps = [
        "//src/cert",
        "@googletest//:gtest_main",
    ],
)

# Advisories (src/cert/Advisory.h, ADR 0073): the file format, version
# order, and which certificates an advisory revokes, with a test advisory
# against a fake engine.
cc_test(
    name = "advisory_test",
    srcs = ["advisory_test.cpp"],
    deps = [
        "//src/cert",
        "@googletest//:gtest_main",
    ],
)
