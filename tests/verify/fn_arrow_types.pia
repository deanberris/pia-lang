(* Distinct arrow types (ADR 0071, amendment of 2026-11-28): `type` over an
   arrow makes a new type whose contract is its arrow's, so `option op` is
   a nullable reference with a contract. `op f` checks f against the arrow
   and stores it; an `op` is called like a function, through the arrow's
   contract alone.
// RUN: not piac --verify %s | FileCheck %s
*)

let option = let (t : type) => type | None | Some of t

let succ (x : u8) : u8 requires x < 255 ensures result = x + 1 = x + 1
let twice (x : u8) : u8 requires x < 128 ensures result = x * 2 = x * 2

let op = type (x : u8) -> u8 requires x < 100 ensures result > x

let handlers = type { on_key : op; on_tick : option op }

let run (h : option op) (y : u8) : u8 requires y < 100 ensures result >= y =
  match h with
  | Some f -> f y
  | None -> y

let key (h : handlers) (y : u8) : u8 requires y < 100 ensures result > y = h.on_key y

let make () : handlers = { on_key = op succ; on_tick = Some (op succ) }

(* twice 0 is 0, not more than 0. *)
let bad () : op = op twice

let mixed (f : op) (g : op) (y : u8) : u8 requires y < 50 =
  let a = f y in if a < 100 then g a else a

