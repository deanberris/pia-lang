(* `@target(m)` functions (ADR 0049, section 3). Such a function is
   compiled only for the target whose model is m, and its proofs see m's
   values as well as the theory's axioms. So it can prove what no
   target-generic function can, such as the exact page size, and it can
   meet a target-generic function's precondition with them.
// RUN: piac --verify %s > %t/arm.txt
// RUN: FileCheck %s --check-prefix=BOTH < %t/arm.txt
// RUN: grep -E 'target_items.pia:(2[6-8]|4[1-3]):[0-9]+: proved' %t/arm.txt
// RUN: not grep -E 'target_items.pia:(2[2-4]|3[1-9]):' %t/arm.txt
// RUN: piac --verify --target=x86_64-unknown-linux-gnu --cpu=x86-64-v3 %s > %t/x86.txt
// RUN: FileCheck %s --check-prefix=BOTH < %t/x86.txt
// RUN: grep -E 'target_items.pia:(2[2-4]|3[1-9]):[0-9]+: proved' %t/x86.txt
// RUN: not grep -E 'target_items.pia:(2[6-8]|4[1-3]):' %t/x86.txt
*)

(* Target-generic: proved from the axioms alone, on every target. *)
let take_page (n : usize) : usize
  requires n <= Target.page_size
  ensures result = n
= n

let lemma pages_x86 : unit @target(x86_64_linux)
  ensures Target.page_size = 4096 && Target.cache_line = 64
= ()

let lemma pages_arm : unit @target(arm64_macos)
  ensures Target.page_size = 16384 && Target.cache_line = 128
= ()

(* The count of 4 KiB pages that hold `bytes`. *)
let huge_page_count (bytes : usize) : usize @target(x86_64_linux)
  requires bytes <= 1000000
  ensures result * Target.page_size >= bytes
= (bytes + 4095) / 4096

(* A whole page meets take_page's precondition, from the model's value. *)
let whole_page (x : u8) : usize @target(x86_64_linux)
  ensures result = 4096
= take_page 4096

let whole_page_arm (x : u8) : usize @target(arm64_macos)
  ensures result = 16384
= take_page 16384

(* Only the functions for the target being compiled are proved, which the
   greps above check by line, and all of their goals prove.
// BOTH: 0 failed, 0 skipped
*)
