(* A block goes back only to the pool that handed it out (ADR 0041, step 4).
   The owner is spec-only, so the check is a proof goal and costs nothing
   at run time.
// RUN: not piac --verify %s | FileCheck %s
*)

let pool = type { top : usize; id : int }
let block = type { i : u16; owner : int } @linear

let take (p : borrowed inout mutable pool) : block
  ensures result.owner = p.id && p.id = old p.id
= { i = 0; owner = p.id }

let give (p : borrowed inout mutable pool) (b : moved block) : unit
  requires b.owner = p.id
  ensures p.id = old p.id
= match b with
  | { i } -> p.top <- p.top

(* Right: each block back to its own pool. *)
let own (p : borrowed inout mutable pool) (q : borrowed inout mutable pool) : unit
  requires p.id <> q.id
= let a = take p in
  let b = take q in
  give p a;
  give q b

(* Wrong, each way round: a block from one pool goes back to the other.
   They are two functions because a failed goal is assumed after it, and
   `give q a` failing would make `p.id = q.id`, which proves anything. *)
let swapped (p : borrowed inout mutable pool) (q : borrowed inout mutable pool) : unit
  requires p.id <> q.id
= let a = take p in
  give q a

let swapped_back (p : borrowed inout mutable pool) (q : borrowed inout mutable pool) : unit
  requires p.id <> q.id
= let b = take q in
  give p b

(* Expected report, in order.
// CHECK: pool_owner_errors.pia:11:3: proved: the postcondition holds [smt]
// CHECK: pool_owner_errors.pia:16:3: proved: the postcondition holds [smt]
// CHECK: pool_owner_errors.pia:25:3: proved: the precondition of 'give' holds [smt]
// CHECK: pool_owner_errors.pia:26:3: proved: the precondition of 'give' holds [smt]
// CHECK: pool_owner_errors.pia:34:3: failed: the precondition of 'give' holds
// CHECK-NEXT: counterexample: p.top = {{-?[0-9]+}}, p.id = {{-?[0-9]+}}, q.top = {{-?[0-9]+}}, q.id = {{-?[0-9]+}}
// CHECK: pool_owner_errors.pia:39:3: failed: the precondition of 'give' holds
// CHECK-NEXT: counterexample: p.top = {{-?[0-9]+}}, p.id = {{-?[0-9]+}}, q.top = {{-?[0-9]+}}, q.id = {{-?[0-9]+}}
// CHECK: 4 proved, 2 failed, 0 skipped
*)
