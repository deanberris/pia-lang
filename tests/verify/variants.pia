(* Variants and match (#54, docs/stdlib.md group 3). A variant is a tag and
   its payloads, so the verifier knows which constructor built a value.
// RUN: not piac --verify %s | FileCheck %s
*)

let shape = type | Circle of u16 | Square of u16 | Empty

(* Each arm sees its payload with its own type. *)
let area (s : shape) : u64 =
  match s with
  | Circle r -> 3 * r * r
  | Square w -> w * w
  | Empty -> 0

let opt = type | None | Some of u32

let is_some (o : opt) : bool =
  match o with
  | Some _ -> true
  | _ -> false

(* The constructor is known, so the match picks its arm. *)
let roundtrip (x : u32) : u32
  ensures result = x
= match Some x with
  | Some y -> y
  | None -> 0

(* A payload is still checked where it goes: u32 does not fit in u8. *)
let narrow (o : opt) : u8 =
  match o with
  | Some x -> x
  | None -> 0

(* `abort` in an arm the contract rules out, and one it does not. *)
let unwrap_known (x : u32) : u32 =
  match Some x with
  | Some y -> y
  | None -> abort ()

let unwrap (o : opt) : u32 =
  match o with
  | Some y -> y
  | None -> abort ()

(* A mutable local carried through the arms. *)
let count (a : opt) (b : opt) : u8 =
  let n : mutable u8 = 0 in
  (match a with | Some _ -> n <- n + 1 | None -> ());
  (match b with | Some _ -> n <- n + 1 | None -> ());
  n
