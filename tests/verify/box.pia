(* `box t` (ADR 0046, step 1): an owning box of one `t`, in a slot its
   allocator lent from the region `r` (ADR 0042). Whether it holds a
   value is spec-only state, `state : int`, which codegen erases: `get`,
   `set` and `release` require a full box, `release` leaves it empty, and
   `fill` requires an empty one. So a use after `release` is a failed
   goal, not a run-time check (tests/verify/box_errors.pia). This bump
   allocator frees with its region, so a box needs no `free` of its own
   here; it lives in Pia.Mem.Box once interfaces carry regions.
// RUN: piac --verify %s | FileCheck %s
*)

let oom = type | OutOfMemory
let bump = let (t : type) (r : region) => type { mem : borrowed(r) mutable [t]; used : usize }

let alloc (t : type) (r : region) (m : inout mutable bump t r) (n : usize) : result (borrowed(r) out mutable [t]) oom
  requires m.used <= len m.mem
  ensures m.used <= len m.mem && len m.mem = old (len m.mem)
  ensures (match result with
           | Ok b -> len b = n
           | Err _ -> true)
= if n <= len m.mem - m.used then
    (let start = m.used in
     m.used <- start + n;
     Ok m.mem.[start .. start + n])
  else Err OutOfMemory

(* A box: one slot from the region, and whether it holds a value, which
   only the verifier sees. *)
let box = let (t : type) (r : region) => type { slot : borrowed(r) mutable [t]; state : int }

let spec ok (t : type) (b : box t) : bool = len b.slot = 1 && (b.state = 0 || b.state = 1)
let spec full (t : type) (b : box t) : bool = b.state = 1

let make (t : type) (r : region) (m : inout mutable bump t r) (v : t) : result (box t r) oom
  requires m.used <= len m.mem
  ensures m.used <= len m.mem && len m.mem = old (len m.mem)
  ensures (match result with
           | Ok b -> ok b && full b && b.slot.[0] = v
           | Err _ -> true)
= let s = alloc m 1? in
  s.[0] <- v;
  Ok { slot = s; state = 1 }

let get (t : type) (r : region) (b : borrowed box t r) : t
  requires ok b && full b
  ensures result = b.slot.[0]
= b.slot.[0]

let set (t : type) (r : region) (b : inout mutable box t r) (v : t) : unit
  requires ok b && full b
  ensures ok b && full b && b.slot.[0] = v
= (let s = b.slot in s.[0] <- v)

let release (t : type) (r : region) (b : inout mutable box t r) : t
  requires ok b && full b
  ensures ok b && full b = false && result = old (b.slot.[0])
= (let v = b.slot.[0] in b.state <- 0; v)

let fill (t : type) (r : region) (b : inout mutable box t r) (v : t) : unit
  requires ok b && full b = false
  ensures ok b && full b && b.slot.[0] = v
= (let s = b.slot in s.[0] <- v; b.state <- 1)

let demo (storage : borrowed mutable [u16]) : result u16 oom =
  let m : mutable bump u16 = { mem = storage; used = 0 } in
  let b : mutable box u16 = make m 7? in
  set b 9;
  let x = release b in
  fill b (x + 1);
  Ok (get b)

