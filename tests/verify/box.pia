// CHECK: box.pia:67:3: proved: the precondition of 'set<u16>' holds [smt]
// CHECK: box.pia:68:11: proved: the precondition of 'release<u16>' holds [smt]
// CHECK: box.pia:69:13: proved: '+' does not overflow u16 [smt]
// CHECK: box.pia:69:3: proved: the precondition of 'fill<u16>' holds [smt]
// CHECK: box.pia:70:7: proved: the precondition of 'get<u16>' holds [smt]
// CHECK: box.pia:40:11: proved: the precondition of 'alloc<u16>' holds [smt]
