(* Function values, step 1 (ADR 0044): a typed lambda passed to a
   higher-order function. The call goes to a specialisation of `find` at
   the lambda, and the lambda is a pure function whose body the caller
   knows, so `find`'s contract, which names `p`, means `x > 3` at the call.
// RUN: piac --verify %s | FileCheck %s
*)

let find (xs : [u8]) (p : u8 -> bool) : usize
  ensures result <= len xs
  ensures result < len xs ==> p xs.[result]
  ensures forall (k in 0 .. result). p xs.[k] = false
= let i : mutable usize = 0 in
  while i < len xs && p xs.[i] = false
    invariant i <= len xs
    invariant forall (k in 0 .. i). p xs.[k] = false
    decreases len xs - i
  do i <- i + 1 done;
  i

let first_big (xs : [u8]) : usize
  ensures result < len xs ==> xs.[result] > 3
  ensures forall (k in 0 .. result). xs.[k] <= 3
= find xs (let (x : u8) => x > 3)

(* A lambda with its result type and contracts. *)
let first_even (xs : [u8]) : usize
  ensures result < len xs ==> xs.[result] % 2 = 0
= find xs (let (x : u8) : bool ensures result <==> x % 2 = 0 => x % 2 = 0)

(* A lambda bound by `let` and applied. *)
let square (x : u8) : u16 =
  let sq = let (v : u8) : u16 ensures result = v * v => v * v in
  sq x

