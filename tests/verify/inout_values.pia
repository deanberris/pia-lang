(* `inout` scalars and records: the callee hands back the parameter's
   final value after its result, and the caller's variable is rebound to
   it, so the caller sees the write and the callee's postcondition about
   it. `old` reads a parameter's value on entry.
// RUN: not piac --verify %s | FileCheck %s
*)

let r = type { v : u8 }

let inc (m : borrowed inout mutable r) : unit
  requires m.v < 9
  ensures m.v = old m.v + 1
= m.v <- m.v + 1

let after (y : u8) : u8
  requires y < 5
  ensures result = y + 1
= let m : mutable r = { v = y } in inc m; m.v

let step (x : inout mutable u8) : unit
  requires x < 200
  ensures x = old x + 1
= x <- x + 1

let twice (y : u8) : u8
  requires y < 100
  ensures result = y + 2
= let x : mutable u8 = y in step x; step x; x

(* On one branch only. *)
let maybe (y : u8) (c : bool) : u8
  requires y < 100
  ensures (c ==> result = y + 1) && (c = false ==> result = y)
= let x : mutable u8 = y in (if c then step x else ()); x

(* `old x` is 0 here, so this postcondition is false. *)
let wrong (x : inout mutable u8) : unit
  requires x = 0
  ensures old x = 1
= x <- 1

(* Expected report, in order.
// CHECK: inout_values.pia:13:14: proved: '+' does not overflow u8 [smt]
// CHECK: inout_values.pia:12:3: proved: the postcondition holds [smt]
// CHECK: inout_values.pia:18:36: proved: the precondition of 'inc' holds [smt]
// CHECK: inout_values.pia:17:3: proved: the postcondition holds [smt]
// CHECK: inout_values.pia:23:10: proved: '+' does not overflow u8 [smt]
// CHECK: inout_values.pia:22:3: proved: the postcondition holds [smt]
// CHECK: inout_values.pia:28:29: proved: the precondition of 'step' holds [smt]
// CHECK: inout_values.pia:28:37: proved: the precondition of 'step' holds [smt]
// CHECK: inout_values.pia:27:3: proved: the postcondition holds [smt]
// CHECK: inout_values.pia:34:40: proved: the precondition of 'step' holds [smt]
// CHECK: inout_values.pia:33:3: proved: the postcondition holds [smt]
// CHECK: inout_values.pia:39:3: failed: the postcondition holds
// CHECK-NEXT: counterexample: x = {{-?[0-9]+}}
// CHECK: 11 proved, 1 failed, 0 skipped
*)
