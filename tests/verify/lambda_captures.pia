(* Captures (ADR 0044, section 6): a lambda lists what it captures, each
   copied (a bare name), borrowed or referenced (`inout`). Its type is a
   record of them that meets `Function` through its `apply`. At the call
   the lambda unfolds with the captured values, so the caller proves the
   result.
// RUN: piac --verify %s | FileCheck %s
*)

let find (xs : [u8]) (p : u8 -> bool) : usize
  ensures result <= len xs
  ensures result < len xs ==> p xs.[result]
= let i : mutable usize = 0 in
  while i < len xs && p xs.[i] = false
    invariant i <= len xs
    decreases len xs - i
  do i <- i + 1 done;
  i

(* Two scalars, copied. *)
let first_between (xs : [u8]) (lo : u8) (hi : u8) : usize
  ensures result < len xs ==> lo <= xs.[result] && xs.[result] <= hi
= find xs (let [lo, hi] (x : u8) => lo <= x && x <= hi)

(* A copy: the lambda sees `lim` as it was when it was made. *)
let later (x : u8) : bool
  ensures result <==> x < 10
= let lim : mutable u8 = 10 in
  let below = let [lim] (y : u8) : bool => y < lim in
  lim <- 20;
  below x

(* A lambda that captures meets `Function` too. *)
let count (t : type) (f : type where Function f t bool) (xs : [t]) (p : f) : usize
  ensures result <= len xs
= let n : mutable usize = 0 in
  for i in 0 .. len xs
    invariant n <= i
  do if p xs.[i] then n <- n + 1 else () done;
  n

(* A borrowed slice: the lambda reads `keys` without copying it. A loan
   lasts until the lambda's last use, so `keys` may be written after it.
   A lambda that reads a buffer is not a pure function of scalars, so its
   callers know only the arrow's contract (here, none). *)
let count_keys (xs : [u8]) (keys : borrowed inout mutable [u8]) : usize
  requires len keys > 0
  ensures result <= len xs
= let is_key = let [borrowed keys] (x : u8) : bool => len keys > 0 && x = keys.[0] in
  let n = count xs is_key in
  keys.[0] <- 7;
  n

let count_above (xs : [u8]) (lim : u8) : usize
  ensures result <= len xs
= count xs (let [lim] (x : u8) : bool => x > lim)

(* A borrowed scalar: the same value as a copy, but `lim` cannot change
   while the lambda is live. *)
let under (xs : [u8]) (lim : u8) : usize
  ensures result < len xs ==> xs.[result] < lim
= find xs (let [borrowed lim] (x : u8) => x < lim)

(* Referenced captures: the lambda writes `total`, and the enclosing code
   sees the writes after the lambda's last use. *)
let tally (x : u8) : u8
  requires x < 100
  ensures result = x + 2
= let total : mutable u8 = 0 in
  let put = let [inout total] (y : u8) : unit => total <- total +| y in
  put x;
  put 2;
  total

(* `for_each` takes an effectful function, written `inout` before its
   arrow, and a lambda with a referenced capture counts in it. *)
let for_each (xs : [u8]) (f : inout u8 -> unit) : unit =
  for i in 0 .. len xs do f xs.[i] done

let count_small (xs : [u8]) : usize =
  let n : mutable usize = 0 in
  for_each xs (let [inout n] (x : u8) : unit =>
    if x < 10 && n < 65535 then n <- n + 1 else ());
  n

(* A pure lambda may go to an effectful arrow. *)
let check_all (xs : [u8]) : unit =
  for_each xs (let (x : u8) : unit => ())

