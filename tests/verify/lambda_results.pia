(* Partial application, lambdas as results and moved captures (ADR 0044,
   step 7). `below lim` with an argument left is a lambda that captures
   `lim`; a function whose result is written as a function type returns
   the closure its body makes, which callers apply; and a lambda may own
   what it captures, `[moved t]`.
// RUN: piac --verify %s | FileCheck %s
*)

let find (xs : [u8]) (p : u8 -> bool) : usize
  ensures result <= len xs
  ensures result < len xs ==> p xs.[result]
= let i : mutable usize = 0 in
  while i < len xs && p xs.[i] = false
    invariant i <= len xs
    decreases len xs - i
  do i <- i + 1 done;
  i

let below (lim : u8) (x : u8) : bool = (x < lim)

(* Partial application as an argument and as a value. *)
let first_small (xs : [u8]) (lim : u8) : usize
  ensures result < len xs ==> xs.[result] < lim
= find xs (below lim)

let first_tiny (xs : [u8]) : usize
  ensures result < len xs ==> xs.[result] < 4
= find xs (below 4)

let check (x : u8) : bool
  ensures result <==> x < 9
= let small = below 9 in small x

(* Lambdas as results. *)
let adder (n : u8) : u8 -> u8 = let [n] (x : u8) : u8 => x +| n

let five (x : u8) : u8
  requires x < 100
  ensures result = x + 5
= let add5 = adder 5 in add5 x

let compose (f : u8 -> u8) (g : u8 -> u8) : u8 -> u8 = let [f, g] (x : u8) : u8 => f (g x)

let twice_inc (x : u8) : u8
  requires x < 100
  ensures result = x + 2
= let h = compose (let (a : u8) : u8 => a +| 1) (let (b : u8) : u8 => b +| 1) in h x

(* Moved captures: the closure owns the value. *)
let token = type { id : u8 }
let drop (t : moved token) : unit = match t with | { id } -> ()
let make (x : u8) : token = { id = x }

let owner (x : u8) : u8
  ensures result = x
= let t = make x in
  let get = let [moved t] (y : u8) : u8 => t.id in
  get 0

