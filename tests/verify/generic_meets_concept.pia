(* A generic function meets a concept's requirement at the type arguments
   its parameters deduce (ADR 0034): `alloc` over `bump t r` meets
   Allocator's `alloc` for `bump u16` and `u16`, at t = u16, and its
   contract is checked against the requirement's at that instance. So an
   allocator generic over what it holds serves a vector generic over its
   allocator.
// RUN: piac --verify %s | FileCheck %s
*)

let oom = type | OutOfMemory

let meta Allocator (a : type) (t : type) (r : region) : concept = sig
  let alloc : (m : inout mutable a) -> (n : usize) -> result (borrowed(r) out mutable [t]) oom
    ensures (match result with | Ok b -> len b = n | Err _ -> true)
end

let bump = let (t : type) (r : region) => type { mem : borrowed(r) mutable [t]; used : usize }

let alloc (t : type) (r : region) (m : inout mutable bump t r) (n : usize) : result (borrowed(r) out mutable [t]) oom
  ensures (match result with | Ok b -> len b = n | Err _ -> true)
= if m.used <= len m.mem && n <= len m.mem - m.used then
    (let start = m.used in
     m.used <- start + n;
     Ok m.mem.[start .. start + n])
  else Err OutOfMemory

let vec = let (t : type) (a : type) (r : region) => type { alloc : a; buf : borrowed(r) mutable [t]; len : usize }

let push (t : type) (r : region) (a : type where Allocator a t r) (v : inout mutable vec t a r) (x : t) : result unit oom
  requires v.len <= len v.buf
  ensures v.len <= len v.buf
  ensures (match result with
           | Ok () -> v.len = old v.len + 1 && v.buf.[old v.len] = x
           | Err _ -> v.len = old v.len)
= if v.len = len v.buf then
    (let cap = len v.buf in
     if cap > 1000000 then Err OutOfMemory
     else
       (let nb = alloc v.alloc (2 * cap + 1)? in
        let old_buf = v.buf in
        for i in 0 .. v.len do nb.[i] <- old_buf.[i] done;
        nb.[v.len] <- x;
        v.buf <- nb;
        v.len <- v.len + 1;
        Ok ()))
  else
    (let b = v.buf in
     b.[v.len] <- x;
     v.len <- v.len + 1;
     Ok ())

(* The same bump serves vectors of u16 and of u32. *)
let two (small : borrowed mutable [u16]) (wide : borrowed mutable [u32]) : result usize oom =
  let ms : bump u16 = { mem = small; used = 0 } in
  let vs : mutable vec u16 (bump u16) = { alloc = ms; buf = small.[0 .. 0]; len = 0 } in
  let mw : bump u32 = { mem = wide; used = 0 } in
  let vw : mutable vec u32 (bump u32) = { alloc = mw; buf = wide.[0 .. 0]; len = 0 } in
  push vs 700?;
  push vw 70000?;
  push vw 90000?;
  Ok (vs.len + vw.len)

