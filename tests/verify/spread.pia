(* spread (ADR 0060): every access to a buffer the body writes is a goal
   that the iteration owns the cell, `c = i` by default and `owner.[c] = i`
   under @owns. Reads of buffers nobody writes are free. A shifted write
   fails: iteration i writes the cell iteration i + 1 owns.
// RUN: not piac --verify %s | FileCheck %s
*)

let copy (xs : [u32]) (ys : out mutable [u32]) : unit
  requires len ys = len xs
= spread i in 0 .. len xs do ys.[i] <- xs.[i] done

(* A stencil reads its neighbours in a buffer no iteration writes. *)
let smooth (xs : [u32]) (ys : out mutable [u32]) : unit
  requires len ys = len xs && len xs >= 2
= spread i in 1 .. len xs - 1 do
    let s : u64 = xs.[i - 1] in
    let t : u64 = s + xs.[i] + xs.[i + 1] in
    ys.[i] <- (if t / 3 < 4294967295 then t / 3 else 4294967295)
  done

(* Reading its own cell of a written buffer is fine. *)
let bump (v : borrowed inout mutable [u32]) : unit
= spread i in 0 .. len v do
    if v.[i] < 4294967295 then v.[i] <- v.[i] + 1 else ()
  done

(* Basins: iteration b owns the cells labelled b. *)
let clear_basins (label : [usize]) (v : borrowed inout mutable [u32]) (nb : usize) : unit
  requires len label = len v
= spread b in 0 .. nb @owns(v, label) do
    for c in 0 .. len v do
      if label.[c] = b then v.[c] <- 0 else ()
    done
  done

(* Writing the next cell: iterations i and i + 1 would both write it. *)
let shifted (xs : [u32]) (ys : out mutable [u32]) : unit
  requires len ys = len xs && len xs > 0
= spread i in 0 .. len xs - 1 do ys.[i + 1] <- xs.[i] done

(* Reading a neighbour of a written buffer races with its owner's write. *)
let blur (v : borrowed inout mutable [u32]) : unit
  requires len v >= 2
= spread i in 1 .. len v do v.[i] <- v.[i - 1] done

(* A basin writing a cell without checking its label. *)
let unchecked (label : [usize]) (v : borrowed inout mutable [u32]) (nb : usize) : unit
  requires len label = len v && len v > 0
= spread b in 0 .. nb @owns(v, label) do v.[0] <- 1 done

