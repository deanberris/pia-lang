(* A vector that stores its allocator (ADR 0041, ADR 0042 step 2). The
   bump and the vector share the region `r`: the bump's memory and the
   vector's buffer both borrow from it, not from each other, so `push`
   can allocate from `v.alloc` and keep the buffer in `v` without `v`
   borrowing from itself. Regions are erased: `vec u16` in `demo` is
   `vec u16 r` for whatever lends `storage`.
// RUN: piac --verify %s | FileCheck %s
*)

let oom = type | OutOfMemory
let bump = let (t : type) (r : region) => type { mem : borrowed(r) mutable [t]; used : usize }

let alloc (t : type) (r : region) (m : inout mutable bump t r) (n : usize) : result (borrowed(r) out mutable [t]) oom
  requires m.used <= len m.mem
  ensures m.used <= len m.mem && len m.mem = old (len m.mem)
  ensures (match result with
           | Ok b -> len b = n
           | Err _ -> true)
= if n <= len m.mem - m.used then
    (let start = m.used in
     m.used <- start + n;
     Ok m.mem.[start .. start + n])
  else Err OutOfMemory

let vec = let (t : type) (r : region) => type { alloc : bump t r; buf : borrowed(r) mutable [t]; len : usize }

let push (t : type) (r : region) (v : inout mutable vec t r) (x : t) : result unit oom
  requires v.alloc.used <= len v.alloc.mem && v.len <= len v.buf
  ensures v.alloc.used <= len v.alloc.mem && v.len <= len v.buf
  ensures (match result with
           | Ok () -> v.len = old v.len + 1 && v.buf.[old v.len] = x
           | Err _ -> v.len = old v.len)
  ensures forall (i in 0 .. old v.len). v.buf.[i] = old (v.buf.[i])
= if v.len = len v.buf then
    (let cap = len v.buf in
     if cap > 1000000 then Err OutOfMemory
     else
       (let nb = alloc v.alloc (2 * cap + 1)? in
        let old_buf = v.buf in
        for i in 0 .. v.len
          invariant forall (j in 0 .. i). nb.[j] = old_buf.[j]
        do nb.[i] <- old_buf.[i] done;
        nb.[v.len] <- x;
        v.buf <- nb;
        v.len <- v.len + 1;
        Ok ()))
  else
    (let b = v.buf in
     b.[v.len] <- x;
     v.len <- v.len + 1;
     Ok ())

let demo (storage : borrowed mutable [u16]) : result u16 oom =
  let v : mutable vec u16 = { alloc = { mem = storage; used = 0 }; buf = storage.[0 .. 0]; len = 0 } in
  push v 700?;
  push v 900?;
  let b = v.buf in
  Ok (b.[0] + b.[1])

