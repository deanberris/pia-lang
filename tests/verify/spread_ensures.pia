(* A spread's `ensures` (ADR 0060) is proved at the end of one iteration,
   with every cell another iteration owns forgotten, and holds for every
   iteration after the loop. A function with `@owns(buf, owner, b)`
   touches only the cells of buf with owner.[c] = b, so a spread may pass
   it the buffer, with one goal per call: its b is the iteration.
// RUN: not piac --verify %s | FileCheck %s
*)

(* Inside a quantifier an element of a [usize] needs a spec function to
   keep its range (#330). *)
let spec at (xs : [usize]) (k : usize) : usize
  requires k < len xs
= xs.[k]

let copy (xs : [u32]) (ys : out mutable [u32]) : unit
  requires len ys = len xs
  ensures forall (k in 0 .. len ys). ys.[k] = xs.[k]
= spread i in 0 .. len xs
    ensures ys.[i] = xs.[i]
  do ys.[i] <- xs.[i] done

(** Clears the cells of basin b, and only those. *)
let clear_basin (label : [usize]) (v : borrowed inout mutable [u32]) (b : usize) : unit @owns(v, label, b)
  requires len label = len v
  ensures forall (c in 0 .. len v). at label c = b ==> v.[c] = 0
= for c in 0 .. len v
    invariant forall (d in 0 .. c). at label d = b ==> v.[d] = 0
  do
    if label.[c] = b then v.[c] <- 0 else ()
  done

(* Every basin cleared at once, by calls with a footprint. *)
let clear (label : [usize]) (v : borrowed inout mutable [u32]) (nb : usize) : unit
  requires len label = len v
  requires forall (c in 0 .. len v). at label c < nb
  ensures forall (c in 0 .. len v). v.[c] = 0
= spread b in 0 .. nb @owns(v, label)
    ensures forall (c in 0 .. len v). at label c = b ==> v.[c] = 0
  do clear_basin label v b done

(* An ensures about another iteration's cell fails: that iteration may
   have written it. *)
let peek (xs : [u32]) (ys : out mutable [u32]) : unit
  requires len ys = len xs && len xs > 1
= spread i in 0 .. len xs
    ensures ys.[0] = xs.[0]
  do ys.[i] <- xs.[i] done

(* A footprint the body does not keep: it writes cell 0 whatever its
   owner. *)
let sloppy (label : [usize]) (v : borrowed inout mutable [u32]) (b : usize) : unit @owns(v, label, b)
  requires len label = len v && len v > 0
= v.[0] <- 1

(* A call for the next basin, whose cells another iteration owns. *)
let off_by_one (label : [usize]) (v : borrowed inout mutable [u32]) (nb : usize) : unit
  requires len label = len v
= spread b in 0 .. nb @owns(v, label) do clear_basin label v (b + 1) done

(* Expected report, in order.
// CHECK: spread_ensures.pia:13:3: proved: the index is within bounds [smt]
// CHECK: spread_ensures.pia:20:6: proved: the iteration owns the cell it writes in 'ys' (c = i) [smt]
// CHECK: spread_ensures.pia:20:16: proved: the index is within bounds [smt]
// CHECK: spread_ensures.pia:20:6: proved: the index is within bounds [smt]
// CHECK: spread_ensures.pia:19:5: proved: the spread's postcondition holds for an iteration, whatever the others write [smt]
// CHECK: spread_ensures.pia:17:3: proved: the postcondition holds [smt]
// CHECK: spread_ensures.pia:27:5: proved: the loop invariant holds on entry [smt]
// CHECK: spread_ensures.pia:29:8: proved: the index is within bounds [smt]
// CHECK: spread_ensures.pia:29:27: proved: the iteration owns the cell it writes in 'v' (label.[c] = b) [smt]
// CHECK: spread_ensures.pia:29:27: proved: the index is within bounds [smt]
// CHECK: spread_ensures.pia:27:5: proved: the loop invariant holds after each iteration [smt]
// CHECK: spread_ensures.pia:25:3: proved: the postcondition holds [smt]
// CHECK: spread_ensures.pia:39:26: proved: the call touches only the cells the iteration owns in 'v' (its 'b' is 'b') [smt]
// CHECK: spread_ensures.pia:39:6: proved: the precondition of 'clear_basin' holds [smt]
// CHECK: spread_ensures.pia:38:5: proved: the spread's postcondition holds for an iteration, whatever the others write [smt]
// CHECK: spread_ensures.pia:36:3: proved: the postcondition holds [smt]
// CHECK: spread_ensures.pia:47:6: proved: the iteration owns the cell it writes in 'ys' (c = i) [smt]
// CHECK: spread_ensures.pia:47:16: proved: the index is within bounds [smt]
// CHECK: spread_ensures.pia:47:6: proved: the index is within bounds [smt]
// CHECK: spread_ensures.pia:46:5: failed: the spread's postcondition holds for an iteration, whatever the others write
// CHECK-NEXT: counterexample: len xs = {{-?[0-9]+}}, len ys = {{-?[0-9]+}}
// CHECK: spread_ensures.pia:53:3: failed: the iteration owns the cell it writes in 'v' (label.[c] = b)
// CHECK-NEXT: counterexample: len label = {{-?[0-9]+}}, len v = {{-?[0-9]+}}, b = {{-?[0-9]+}}
// CHECK: spread_ensures.pia:53:3: proved: the index is within bounds [smt]
// CHECK: spread_ensures.pia:58:65: failed: the call touches only the cells the iteration owns in 'v' (its 'b' is 'b')
// CHECK-NEXT: counterexample: len label = {{-?[0-9]+}}, len v = {{-?[0-9]+}}, nb = {{-?[0-9]+}}
// CHECK: spread_ensures.pia:58:65: proved: '+' does not overflow usize [smt]
// CHECK: spread_ensures.pia:58:42: proved: the precondition of 'clear_basin' holds [smt]
// CHECK: 22 proved, 3 failed, 0 skipped
*)
