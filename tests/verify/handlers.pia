(* `?` passes an error on, and `handle` takes it (#84, ADR 0028). Each arm
   is proved once for every `?` that can reach it, knowing only what holds
   there: an arm for the second call's errors may use what the first call
   bound and what its postcondition says, and an arm for the first call's
   errors cannot see what the second call binds.
// RUN: piac --verify %s | FileCheck %s
*)

let open_error = type | NoEntry | Denied
let parse_error = type | Empty | TooLong of u8
let app_error = type | Missing | Unreadable of u8 | Bad of u16

let open_file (x : u8) : result u16 open_error
  ensures (match result with | Ok v -> v = x | Err _ -> true)
= if x = 0 then Err NoEntry else Ok x

let parse (v : u16) : result u16 parse_error
  ensures (match result with | Ok w -> w > v | Err _ -> true)
= if v > 1000 then Err (TooLong 1) else Ok (v + 1)

(* The arms for parse's errors know x' = x, from open_file's
   postcondition at the second `?`. *)
let load (x : u8) : result u16 app_error
  ensures (match result with | Ok w -> w > x | Err _ -> true)
=
  let x' = open_file x? in
  let x'' = parse x'? in
  Ok x''
handle
| NoEntry -> Err Missing
| Denied -> Err (Unreadable x)
| TooLong n -> (assert x' = x; Err (Unreadable n))
| Empty -> Err (Bad x')

(* With no handler, `?` returns the error to the caller. *)
let check (x : u8) : result unit open_error
= if x = 0 then Err Denied else Ok ()

let opened (x : u8) : result u16 open_error
  ensures (match result with | Ok w -> w = x && x > 0 | Err _ -> true)
= check x?;
  let v = open_file x? in
  assert v = x;
  Ok v

(* `p as e` and a catch-all both bind the whole error. *)
let rank (e : open_error) : u16
  ensures result = 300
= match e with | NoEntry -> 300 | Denied -> 300

let code (x : u8) : u16
  ensures result = x || result = 300
= open_file x?
handle
| NoEntry as e -> rank e
| e -> rank e

(* A handled scope inside an expression, and in a loop body. *)
let count (n : u8) : u8
  ensures result <= n
=
  let c : mutable u8 = 0 in
  for i in 0..n invariant c <= i do
    (check i?; c <- c + 1)
  handle
  | Denied -> ()
  | NoEntry -> ()
  done;
  c

(* Expected report, in order.
// CHECK: 0 failed, 0 skipped
*)
