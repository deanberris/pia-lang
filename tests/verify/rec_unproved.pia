(* Until the verifier encodes recursive types (ADR 0047, step 2), every
   goal of a function that takes, makes or returns a recursive value is
   unproved, with that reason. An unproved goal is a compile error, so
   such a function needs --allow-unproved, which names it. A function
   without recursive values is proved as before.
// RUN: not piac --verify %s 2>&1 | FileCheck %s
// RUN: piac --verify --allow-unproved=bump --allow-unproved=checked %s 2>&1 | FileCheck %s --check-prefix=ALLOW
// RUN: not piac --verify --allow-unproved=bump %s 2>&1 | FileCheck %s --check-prefix=ONE
*)

let box = let (t : type) => type { slot : [t] }
let rec tree = type
  | Leaf
  | Node of { left : box tree; key : u32; right : box tree }

(* No goals, so nothing is unproved. *)
let key (t : tree) : u32 =
  match t with
  | Leaf -> 0
  | Node n -> n.key

(*
// CHECK: rec_unproved.pia:[[@LINE+5]]:21: skipped: '+' does not overflow u32 [recursive types are not verified yet (ADR 0047, step 2)]
*)
let bump (t : tree) : u32 =
  match t with
  | Leaf -> 0
  | Node n -> n.key + 1

(*
// CHECK: rec_unproved.pia:[[@LINE+3]]:3: skipped: the postcondition holds [recursive types are not verified yet (ADR 0047, step 2)]
*)
let checked (t : tree) : u32
  ensures (match t with | Leaf -> result = 0 | Node _ -> result = 1)
= match t with | Leaf -> 0 | Node _ -> 1

(*
// CHECK: rec_unproved.pia:[[@LINE+2]]:39: proved: '+' does not overflow u16 [intervals]
*)
let plain (a : u8) (b : u8) : u16 = a + b

(*
// CHECK: 1 proved, 0 failed, 2 skipped
// CHECK: piac: error: 2 obligations not proved
// ALLOW: 1 proved, 0 failed, 2 skipped
// ALLOW-NOT: error
// ONE: piac: error: 1 obligation not proved
*)
