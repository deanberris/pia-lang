(* Collectives in a spread (ADR 0086): a stencil over time steps whose
   iterations read their neighbours after a halo_exchange, an all_reduce
   that every iteration sees, and what one contribution says about the
   result. Reading a neighbour without an exchange races with its owner,
   and the sum of u64 contributions could overflow.
// RUN: not piac --verify %s | FileCheck %s
*)

let relax (a : borrowed inout mutable [u32]) (b : borrowed inout mutable [u32]) (steps : u32) : unit
  requires len b = len a && len a <= 1000000
= let n = len a in
  spread i in 0 .. n do
    for t in 0 .. steps do
      halo_exchange a;
      let l = if i > 0 then a.[i - 1] else a.[i] in
      let r = if i + 1 < n then a.[i + 1] else a.[i] in
      b.[i] <- l / 2 + r / 2;
      halo_exchange b;
      a.[i] <- b.[i]
    done
  done

let share (xs : [u32]) (ys : out mutable [u64]) : unit
  requires len ys = len xs && len xs <= 4294967296
= spread i in 0 .. len xs do
    let total = all_reduce add xs.[i] in
    ys.[i] <- total - xs.[i]
  done

let below_max (xs : [u32]) (ys : out mutable [u32]) : unit
  requires len ys = len xs
= spread i in 0 .. len xs do
    let m = all_reduce max xs.[i] in
    ys.[i] <- m - xs.[i]
  done

(* Without the exchange, a.[i - 1] is a cell its owner may be writing. *)
let unexchanged (a : borrowed inout mutable [u32]) : unit
  requires len a >= 2
= spread i in 1 .. len a do
    let s = all_reduce min a.[i] in
    a.[i] <- a.[i - 1] - s
  done

(* 2^64 - 1 is a u64, so two iterations' sum may not fit. *)
let wide (xs : [u64]) (ys : out mutable [u64]) : unit
  requires len ys = len xs
= spread i in 0 .. len xs do ys.[i] <- all_reduce add xs.[i] done

