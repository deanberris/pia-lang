(* A top-level function passed as a function argument (ADR 0044). With no
   contract on the arrow it is called directly; with one, a wrapper that
   has the arrow's contract calls it, and the function's own contract must
   meet the arrow's.
// RUN: not piac --verify %s | FileCheck %s
*)

let count (xs : [u8]) (p : u8 -> bool) : usize
  ensures result <= len xs
= let n : mutable usize = 0 in
  for i in 0 .. len xs
    invariant n <= i
  do if p xs.[i] then n <- n + 1 else () done;
  n

let is_digit (c : u8) : bool = (48 <= c && c <= 57)

let digits (xs : [u8]) : usize
  ensures result <= len xs
= count xs is_digit

let bump (x : u8) (f : (y : u8) -> u8 requires y < 200 ensures result > y) : u8
  requires x < 100
  ensures result > x
= f x

let succ (n : u8) : u8
  requires n < 255
  ensures result = n + 1
= n + 1

let next (x : u8) : u8
  requires x < 100
  ensures result > x
= bump x succ

(* `same`'s contract does not give the arrow's `ensures`.
*)
let same (n : u8) : u8
  ensures result = n
= n

let stuck (x : u8) : u8 requires x < 100 =
  bump x same

