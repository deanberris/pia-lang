(* Function objects (ADR 0044, section 4): any record or variant whose
   module defines `apply` for it is a function. `g x` calls `apply g x`,
   and a function object can be passed where a function is expected, with
   its fields as state the lambda forms will capture later (step 3).
   `Function`, the standard concept, comes with the language, and a
   generic written with it is proved once (ADR 0043).
// RUN: not piac --verify %s | FileCheck %s
*)

let below = type { lim : u8 }

let apply (g : below) (x : u8) : bool = (x < g.lim)

(* Application syntax. *)
let is_small (x : u8) : bool
  ensures result <==> x < 10
= let b : below = { lim = 10 } in
  b x

(* Passed for an arrow parameter: the specialisation keeps the object as
   a parameter of its own type and applies it through `apply`, whose body
   the caller knows. *)
let find (xs : [u8]) (p : u8 -> bool) : usize
  ensures result <= len xs
  ensures result < len xs ==> p xs.[result]
= let i : mutable usize = 0 in
  while i < len xs && p xs.[i] = false
    invariant i <= len xs
    decreases len xs - i
  do i <- i + 1 done;
  i

let first_below (xs : [u8]) (lim : u8) : usize
  ensures result < len xs ==> xs.[result] < lim
= let b : below = { lim = lim } in
  find xs b

(* The constraint written out: `f` meets `Function f t bool`. *)
let count (t : type) (f : type where Function f t bool) (xs : [t]) (p : f) : usize
  ensures result <= len xs
= let n : mutable usize = 0 in
  for i in 0 .. len xs
    invariant n <= i
  do if p xs.[i] then n <- n + 1 else () done;
  n

let small (xs : [u8]) : usize
  ensures result <= len xs
= let b : below = { lim = 10 } in
  count xs b

(* An arrow with a contract: the object's `apply` must meet it. *)
let step = type { by : u8 }

let apply (g : step) (x : u8) : u8
  requires x < 200 && g.by < 50
= x + g.by

let bump (x : u8) (f : (y : u8) -> u8 requires y < 200 ensures result >= y) : u8
  requires x < 100
  ensures result >= x
= f x

(* `step`'s `apply` needs `g.by < 50`, which the arrow does not give.
*)
let up (x : u8) (s : step) : u8 requires x < 100 =
  bump x s

