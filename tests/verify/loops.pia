(* Loops are cut at their invariants (docs/verifier.md, "Loops"). An
   invariant is proved on entry and after each iteration, the goals in the
   body are proved for any iteration where it holds, and after the loop the
   invariant is all that is known. A measure proves that a while loop or a
   recursive function ends.
// RUN: not piac --verify %s | FileCheck %s
*)

(* The invariant bounds `s`, so the sum cannot overflow. *)
let sum_to (n : u16) : u32 =
  let s : mutable u32 = 0 in
  for i in 0..n invariant s <= i * 65535 do s <- s + i done;
  s

(* Without one, `s` could be anything before an iteration. *)
let sum_unbounded (n : u16) : u32 =
  let s : mutable u32 = 0 in
  for i in 0..n do s <- s + i done;
  s

(* After the loop, the invariant and the false condition are what is known. *)
let find (xs : borrowed in [i32]) (x : i32) : usize
  ensures result <= len xs
=
  let i : mutable usize = 0 in
  while i < len xs && xs.[i] <> x
    invariant i <= len xs
    decreases len xs - i
  do
    i <- i + 1
  done;
  i

(* A loop that writes a buffer: the invariant says what it wrote so far. *)
let zero (dst : out mutable [u8; 8]) : unit
  ensures forall (k in 0..8). dst.[k] = 0
=
  for i in 0..8
    invariant forall (k in 0..i). dst.[k] = 0
  do dst.[i] <- 0 done

(* A step of two visits even indices only. *)
let evens (n : usize) : usize =
  let c : mutable usize = 0 in
  for i in 0..n step 2 invariant c <= i do c <- c + 1 done;
  c

(* An invariant that is false on entry, and one that a step breaks. *)
let wrong_entry (n : u8) : unit =
  let s : mutable u8 = 1 in
  for i in 0..n invariant s = 0 do s <- 0 done

let wrong_step (n : u8) : unit =
  let s : mutable u16 = 0 in
  for i in 0..n invariant s <= i do s <- s + 2 done

(* A measure that does not go down. *)
let spin (n : u8) : u8 =
  let k : mutable u8 = n in
  while k > 0 decreases k do k <- k done;
  k

(* A while loop that writes a buffer, and a nested loop. *)
let copy (src : [u8; 4]) (dst : out mutable [u8; 4]) : unit
  ensures forall (k in 0..4). dst.[k] = src.[k]
=
  let i : mutable usize = 0 in
  while i < 4
    invariant i <= 4 && (forall (k in 0..i). dst.[k] = src.[k])
    decreases 4 - i
  do dst.[i] <- src.[i]; i <- i + 1 done

let total (n : u8) (m : u8) : u32 =
  let s : mutable u32 = 0 in
  for i in 0..n invariant s <= i * 255 do
    let t : mutable u32 = 0 in
    for j in 0..m invariant t <= j do t <- t + 1 done;
    s <- s + t
  done;
  s

(* Recursion ends when each recursive call makes the measure smaller. *)
let rec gcd (a : u32) (b : u32) : u32
  decreases b
= if b = 0 then a else gcd b (a mod b)

