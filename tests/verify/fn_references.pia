(* A local of a function type holds a reference to a top-level function
   (ADR 0071). The function is checked once against the arrow's contract,
   and a call through the reference sees only the arrow's contract.
// RUN: not piac --verify %s | FileCheck %s
*)

let succ (x : u8) : u8 requires x < 255 ensures result = x + 1 = (x + 1)
let twice (x : u8) : u8 requires x < 100 ensures result = x + x = (x + x)
let half (x : u8) : u8 = x / 2

(* The arrow promises less than 'succ' gives, and asks more than it needs. *)
let grow (y : u8) : u8 requires y < 10 ensures result > y =
  let h : (x : u8) -> u8 requires x < 100 ensures result > x = succ in
  h y

(* An arrow with no contract refers to a function with none. *)
let quarter (x : u8) : u8 =
  let g : u8 -> u8 = half in
  g (g x)

(* 'twice' needs x < 100, so it does not meet an arrow that allows x < 200. *)
let wide (y : u8) : u8 requires y < 200 =
  let h : (x : u8) -> u8 requires x < 200 = twice in
  h y

(* A call through 'h' knows only 'result > x', not that it is 'x + 1'. *)
let exact (y : u8) : u8 requires y < 10 ensures result = y + 1 =
  let h : (x : u8) -> u8 requires x < 100 ensures result > x = succ in
  h y


(* A reference can be copied, and the copy refers to the same function. *)
let copied (y : u8) : u8 requires y < 10 ensures result > y =
  let h : (x : u8) -> u8 requires x < 100 ensures result > x = succ in
  let k : (x : u8) -> u8 requires x < 50 ensures result > x = h in
  k y

