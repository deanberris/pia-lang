(* A spec function may say which cells it reads (ADR 0060, section 3):
   `reads xs.[lo .. hi]`. piac writes the frame lemma rsum'frame and proves
   it by induction on rsum's own measure, and the verifier then knows that
   a write outside the footprint leaves the call's value alone, after a
   store and after a spread forgets the cells other iterations own.
   A footprint may also be the cells an owner array gives to a value,
   `reads xs.[c] where label.[c] = b`, the shape a sum over one basin
   needs. A footprint that misses a cell the function reads fails in the
   frame lemma.
// RUN: not piac --verify --no-lint %s | FileCheck %s
*)

let spec rsum (xs : [u32]) (lo : usize) (hi : usize) : u64 @fuel(4)
  requires lo <= hi && hi <= len xs && hi - lo <= 4294967296
  reads xs.[lo .. hi]
  ensures result <= 4294967296 * (hi - lo)
  decreases hi - lo
= if lo = hi then 0 else rsum xs lo (hi - 1) + xs.[hi - 1]

(* Writing outside [lo, hi) keeps the sum, with no lemma by hand. *)
let poke (xs : borrowed inout mutable [u32]) (lo : usize) (hi : usize) : unit
  requires lo <= hi && hi < len xs && hi - lo <= 4294967296
  ensures rsum xs lo hi = old (rsum xs lo hi)
= xs.[hi] <- 7

(* Blocks of four cells: each iteration zeroes its own block, and its sum
   over the block is 0 whatever the other iterations write. *)
let zero_blocks (xs : borrowed inout mutable [u32]) (owner : [usize]) (nb : usize) : unit
  requires len owner = len xs && len xs = 4 * nb && nb <= 1000
  requires forall (c in 0 .. len xs). owner.[c] = c / 4
= spread b in 0 .. nb @owns(xs, owner)
    ensures rsum xs (4 * b) (4 * b + 4) = 0
  do
    xs.[4 * b] <- 0; xs.[4 * b + 1] <- 0; xs.[4 * b + 2] <- 0; xs.[4 * b + 3] <- 0;
    assert rsum xs (4 * b) (4 * b + 4) = 0
  done

(* The footprint leaves out the last cell, which tsum reads. *)
let spec tsum (xs : [u32]) (lo : usize) (hi : usize) : u64
  requires lo < hi && hi <= len xs && hi - lo <= 4294967296
  reads xs.[lo .. hi - 1]
  ensures result <= 4294967296 * (hi - lo)
  decreases hi - lo
= if lo + 1 = hi then xs.[lo] else tsum xs lo (hi - 1) + xs.[hi - 1]

(* The cells of basin b: a write in another basin keeps its sum. *)
let spec bsum (xs : [u32]) (label : [usize]) (b : usize) (n : usize) : u64
  requires n <= len xs && len label = len xs && n <= 4294967296
  reads xs.[c] where label.[c] = b
  ensures result <= 4294967296 * n
  decreases n
= if n = 0 then 0 else bsum xs label b (n - 1) + (if label.[n - 1] = b then xs.[n - 1] else 0)

let poke_basin (xs : borrowed inout mutable [u32]) (label : [usize]) (b : usize) (i : usize) : unit
  requires len label = len xs && len xs <= 4294967296 && i < len xs && label.[i] <> b
  ensures bsum xs label b (len xs) = old (bsum xs label b (len xs))
= xs.[i] <- 7

(* A write in basin b itself does not keep it: no frame applies. *)
let poke_own (xs : borrowed inout mutable [u32]) (label : [usize]) (b : usize) (i : usize) : unit
  requires len label = len xs && len xs <= 4294967296 && i < len xs && label.[i] = b
  ensures bsum xs label b (len xs) = old (bsum xs label b (len xs))
= xs.[i] <- 7

