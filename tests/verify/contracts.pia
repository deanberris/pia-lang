(* Contracts: preconditions are assumed, postconditions and assertions are
   goals, and calls use the callee's contract.
// RUN: not piac --verify %s | FileCheck %s
*)

let safe_div (a : u32) (b : u32) : u32
  requires b <> 0
  ensures result <= a
= a / b

(* A call proves the callee's precondition and assumes its postcondition:
   `twice_unchecked` fails at both calls, and `twice` proves. *)
let inc (x : u8) : u8
  requires x < 255
  ensures result = x + 1
= x + 1

let twice_unchecked (x : u8) : u8 = inc (inc x)

let twice (x : u8) : u8
  requires x < 200
= inc (inc x)

(* `old` reads the value on entry; the second postcondition is false. *)
let swap (xs : borrowed inout mutable [u8; 2]) : unit
  ensures xs.[0] = old (xs.[1]) && xs.[1] = old (xs.[0])
  ensures xs.[0] = old (xs.[0])
= let t = xs.[0] in xs.[0] <- xs.[1]; xs.[1] <- t

(* Quantified preconditions are assumed. The second postcondition is false
   for xs = [0; 9]. *)
let small (xs : [u8]) : bool
  requires forall (i in 0..len xs). xs.[i] < 10
  ensures len xs > 0 ==> xs.[0] < 10
  ensures len xs > 1 ==> xs.[1] < 9
= true

(* An existential postcondition. *)
let pick (xs : [i32; 4]) (k : usize) : i32
  requires k < 4
  ensures exists (i in 0..4). xs.[i] = result
= xs.[k]

(* Arithmetic in contracts is exact: `a + b` here cannot overflow. *)
let avg (a : u8) (b : u8) : u8
  ensures 2 * result <= a + b
= (a +| b) / 2

