(* Bit operators (#48, docs/stdlib.md group 2): exact results, the shift
   amount goal, and intervals that keep masks and shifts off the solver.
// RUN: not piac --verify %s | FileCheck %s
*)

(* A mask keeps the result in the mask's range, by intervals. *)
let low_nibble (x : u8) : int{0..15} = x & 15

(* Unlike C, `&` binds tighter than `=`. *)
let is_even (x : u32) : bool
  ensures result <==> x % 2 = 0
= x & 1 = 0

(* `|` and `^` of two u8 values are u8 values. *)
let merge (a : u8) (b : u8) : u8 = (a | b) ^ (a & b)

(* `~` flips every bit of a u8: 255 - x. *)
let invert (x : u8) : u8
  ensures result = 255 - x
= ~x

(* On a signed type it is -1 - x. *)
let invert_i (x : i32) : i32
  ensures result = -1 - x
= ~x

(* A shift by a constant below the width needs no proof. *)
let times8 (x : u8) : u16 = x << 3

(* A shift left is a product: in proof mode no bit may be lost. *)
(* `|` is bitwise only inside brackets, so the body is in parentheses. *)
let pack (hi : u8) (lo : u8) : u16
  ensures result = 256 * hi + lo
= ((hi << 8) | lo)

(* The amount is a goal: here it can reach 8, which a u8 cannot shift by. *)
let too_far (x : u8) (n : int{0..8}) : u8 @overflow(wrap) = x << n

(* And a lossy shift left fails its overflow goal. *)
let lossy (x : u8) : u8 = x << 1

(* Arithmetic shift right rounds toward negative infinity. *)
let floor_half (x : i32) : i32
  ensures 2 * result <= x && x < 2 * result + 2
= x >> 1

(* Wrapping shifts drop the high bits, as in C. *)
let rotl8 (x : u8) (n : u8) : u8 @overflow(wrap)
  requires n < 8
= ((x << n) | (x >> ((8 - n) % 8)))
