(* A generic higher-order function (ADR 0044): the specialisation at the
   lambda keeps `find`'s type parameter, so it is then called like any
   generic function, here at t = u8.
// RUN: piac --verify %s | FileCheck %s
*)

let find (t : type) (xs : [t]) (p : t -> bool) : usize
  ensures result <= len xs
  ensures result < len xs ==> p xs.[result]
= let i : mutable usize = 0 in
  while i < len xs && p xs.[i] = false
    invariant i <= len xs
    decreases len xs - i
  do i <- i + 1 done;
  i

let first_big (xs : [u8]) : usize
  ensures result < len xs ==> xs.[result] > 3
= find xs (let (x : u8) => x > 3)

let is_odd (x : i32) : bool = (x % 2 <> 0)

let first_odd (xs : [i32]) : usize
  ensures result < len xs ==> xs.[result] % 2 <> 0
= find xs is_odd

