// CHECK: box_errors.pia:61:29: proved: the precondition of 'make<u16>' holds [smt]
// CHECK: box_errors.pia:62:11: proved: the precondition of 'release<u16>' holds [smt]
// CHECK: box_errors.pia:63:7: failed: the precondition of 'get<u16>' holds
// CHECK-NEXT: counterexample: len storage = {{-?[0-9]+}}
// CHECK: box_errors.pia:63:13: proved: '+' does not overflow u16 [smt]
// CHECK: box_errors.pia:68:29: proved: the precondition of 'make<u16>' holds [smt]
// CHECK: box_errors.pia:69:3: failed: the precondition of 'fill<u16>' holds
// CHECK-NEXT: counterexample: len storage = {{-?[0-9]+}}
// CHECK: box_errors.pia:70:7: proved: the precondition of 'get<u16>' holds [smt]
// CHECK: box_errors.pia:34:11: proved: the precondition of 'alloc<u16>' holds [smt]
// CHECK: box_errors.pia:35:3: proved: the index is within bounds [smt]
