(* The pool of pool.pia, refining the allocator theory (ADR 0041, step 3).
   The pool keeps a spec-only `heap : Alloc.heap`, which codegen erases,
   and proves once, here, that its free stack matches it: a slot is live
   in the heap exactly when `pos` marks it live. Its contracts then state
   what users need with the theory's functions, `Alloc.live` and
   `Alloc.take`, and `reuse` proves from the axioms, with no quantifier
   over the pool's arrays. The coupling invariant lives in the spec `ok`.
// RUN: piac --verify %s | FileCheck %s
*)

let oom = type | OutOfMemory
let blk = type int{0..63}

let theory Alloc = sig
  let sort heap
  let spec none : heap
  let spec live : (h : heap) -> (b : blk) -> bool
  let spec take : (h : heap) -> (b : blk) -> heap
  let spec give : (h : heap) -> (b : blk) -> heap

  let axiom none_live (b : blk) ensures live none b = false
  let axiom take_live (h : heap) (b : blk) (c : blk)
    ensures live (take h b) c = (c = b || live h c)
  let axiom give_live (h : heap) (b : blk) (c : blk)
    ensures live (give h b) c = (c <> b && live h c)
end

\ The live blocks are bits of a u64.
let model bits : Alloc = struct
  let sort heap = u64
  let spec none : u64 = 0
  let spec live (h : u64) (b : blk) : bool = ((h >> b) & 1) = 1
  let spec take (h : u64) (b : blk) : u64 = (h | (1 << b))
  let spec give (h : u64) (b : blk) : u64 = h & ~(1 << b)
end

(* `id` and `owner` are spec-only too (ADR 0041, step 4): a block goes back
   only to the pool that handed it out, and that costs nothing at run time. *)
let pool = type { cap : usize; free : [u16]; pos : [u16]; top : usize; heap : Alloc.heap; id : int }
let block = type { i : blk; owner : int } @linear

(* The pool's own representation differs from pool.pia's: `free` holds
   every slot, `pos` is its inverse, and the slots at `top` and above are
   the live ones. The coupling invariant says the heap agrees. *)
let spec ok (p : pool) : bool =
  p.cap <= 64 && len p.free = p.cap && len p.pos = p.cap && p.top <= p.cap
  && (forall (j in 0 .. p.cap). p.free.[j] < p.cap && p.pos.[p.free.[j]] = j)
  && (forall (s : blk). s < p.cap ==> p.pos.[s] < p.cap && p.free.[p.pos.[s]] = s
                                       && Alloc.live p.heap s = (p.pos.[s] >= p.top))

(* Hands out a block that was not live, and the heap takes it. *)
let take_slot (p : borrowed inout mutable pool) : result block oom
  requires ok p
  ensures ok p && p.cap = old p.cap && p.id = old p.id
  ensures (match result with
           | Ok b -> b.i < p.cap && b.owner = p.id && Alloc.live (old p.heap) b.i = false
                     && p.heap = Alloc.take (old p.heap) b.i
           | Err _ -> p.heap = old p.heap)
= if p.top = 0 then Err OutOfMemory
  else
    (let j = p.top - 1 in
     let s = p.free.[j] in
     p.top <- j;
     p.heap <- Alloc.take p.heap s;
     Ok { i = s; owner = p.id })

(* Takes back a live block, and the heap gives it: the block swaps places
   with the slot at `top`, which is the lowest live one. *)
let give_slot (p : borrowed inout mutable pool) (b : moved block) : unit
  requires ok p && b.owner = p.id && b.i < p.cap && Alloc.live p.heap b.i
  ensures ok p && p.cap = old p.cap && p.id = old p.id
  ensures p.heap = Alloc.give (old p.heap) b.i
= match b with
  | { i } ->
    let t = p.top in
    let k = p.pos.[i] in
    let u = p.free.[t] in
    p.free.[t] <- i;
    p.free.[k] <- u;
    p.pos.[u] <- k;
    p.pos.[i] <- t;
    p.top <- t + 1;
    p.heap <- Alloc.give p.heap i

(* docs/stdlib.md, "The second test": take a, give it back, take b, which
   may be a's slot. The heap says a is dead after the give and b is live
   after the take, from the axioms alone. *)
let reuse (p : borrowed inout mutable pool) : result unit oom
  requires ok p
= let h0 : Alloc.heap = p.heap in
  let a = take_slot p? in
  let i = a.i in
  assert Alloc.live p.heap i;
  give_slot p a;
  assert Alloc.live p.heap i = false;
  let b = take_slot p? in
  assert Alloc.live p.heap b.i && Alloc.live h0 b.i = false;
  give_slot p b;
  Ok ()

(* Two pools: each block goes back to its own. Giving a to q instead is
   refused, since its owner is p (tests/verify/pool_owner_errors.pia). *)
let two (p : borrowed inout mutable pool) (q : borrowed inout mutable pool) : result unit oom
  requires ok p && ok q && p.id <> q.id
= let a = take_slot p? in
  match take_slot q with
  | Ok b -> (give_slot q b; give_slot p a; Ok ())
  | Err e -> (give_slot p a; Err e)
