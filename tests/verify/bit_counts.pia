(* The bit builtins clz, ctz, popcount, bswap, rotl and rotr (ADR 0023
   group 2, ADR 0040): exact results on the storage bits of an unsigned
   operand, result types that bound the counts by intervals, and the
   rotation amount goal.
// RUN: not piac --verify %s | FileCheck %s
*)

(* A count is in [0, w] by its type, so this needs no proof. *)
let bits_set (x : u64) : int{0..64} = popcount x

(* Zero has no bits set, and only zero. *)
let empty (x : u32) : bool
  ensures result <==> x = 0
= (popcount x = 0)

(* C++'s bit_width: the number of bits needed to hold x. *)
let width (x : u32) : int{0..32}
  ensures result = 0 <==> x = 0
  ensures x > 0 ==> x < 1u64 << result
= 32 - clz x

(* A u16 below 2^15 has its top bit clear. *)
let top_clear (x : u16) : unit
  requires x < 32768
  ensures clz x >= 1
= ()

(* ctz finds the lowest set bit. *)
let lowest (x : u8) : unit
  requires x > 0
  ensures ctz x < 8 && (x >> ctz x) & 1 = 1
= ()

(* Swapping the bytes twice gives the value back. *)
let swap_twice (x : u32) : unit
  ensures bswap (bswap x) = x
= ()

(* Rotating right undoes rotating left. *)
let round_trip (x : u32) (n : int{0..31}) : unit
  ensures rotr (rotl x n) n = x
= ()

(* A rotation keeps every bit. *)
let rotate_keeps (x : u16) (n : int{0..15}) : unit
  ensures popcount (rotl x n) = popcount x
= ()

(* popcount is each bit added up, at the narrowest and the widest width,
   whatever the encoding counts with. *)
let pop_bits8 (x : u8) : unit
  ensures popcount x = ((x >> 0) & 1) + ((x >> 1) & 1) + ((x >> 2) & 1) + ((x >> 3) & 1) + ((x >> 4) & 1) + ((x >> 5) & 1) + ((x >> 6) & 1) + ((x >> 7) & 1)
= ()

let pop_bits64 (x : u64) : unit
  ensures popcount x =
    ((x >> 0) & 1) + ((x >> 1) & 1) + ((x >> 2) & 1) + ((x >> 3) & 1) + ((x >> 4) & 1) + ((x >> 5) & 1) + ((x >> 6) & 1) + ((x >> 7) & 1) + ((x >> 8) & 1) + ((x >> 9) & 1) + ((x >> 10) & 1) + ((x >> 11) & 1) + ((x >> 12) & 1) + ((x >> 13) & 1) + ((x >> 14) & 1) + ((x >> 15) & 1) + ((x >> 16) & 1) + ((x >> 17) & 1) + ((x >> 18) & 1) + ((x >> 19) & 1) + ((x >> 20) & 1) + ((x >> 21) & 1) + ((x >> 22) & 1) + ((x >> 23) & 1) + ((x >> 24) & 1) + ((x >> 25) & 1) + ((x >> 26) & 1) + ((x >> 27) & 1) + ((x >> 28) & 1) + ((x >> 29) & 1) + ((x >> 30) & 1) + ((x >> 31) & 1) + ((x >> 32) & 1) + ((x >> 33) & 1) + ((x >> 34) & 1) + ((x >> 35) & 1) + ((x >> 36) & 1) + ((x >> 37) & 1) + ((x >> 38) & 1) + ((x >> 39) & 1) + ((x >> 40) & 1) + ((x >> 41) & 1) + ((x >> 42) & 1) + ((x >> 43) & 1) + ((x >> 44) & 1) + ((x >> 45) & 1) + ((x >> 46) & 1) + ((x >> 47) & 1) + ((x >> 48) & 1) + ((x >> 49) & 1) + ((x >> 50) & 1) + ((x >> 51) & 1) + ((x >> 52) & 1) + ((x >> 53) & 1) + ((x >> 54) & 1) + ((x >> 55) & 1) + ((x >> 56) & 1) + ((x >> 57) & 1) + ((x >> 58) & 1) + ((x >> 59) & 1) + ((x >> 60) & 1) + ((x >> 61) & 1) + ((x >> 62) & 1) + ((x >> 63) & 1)
= ()

(* Refuted: 255 has all eight bits set. *)
let wrong (x : u8) : unit
  ensures popcount x < 8
= ()

(* The amount is a goal: a u8 can be 32 or more. *)
let too_far (x : u32) (n : u8) : u32 = rotl x n

