(* A mutable function reference (ADR 0071) can be rebound with `<-`. Each
   function bound to it is checked against the arrow's contract where it
   is bound, and a call through it is indirect and sees only that
   contract, whichever function it holds.
// RUN: not piac --verify %s | FileCheck %s
*)

let succ (x : u8) : u8 requires x < 255 ensures result = x + 1 = (x + 1)
let twice (x : u8) : u8 requires x < 128 ensures result = x + x = (x + x)
let keep (x : u8) : u8 ensures result = x = x

(* Each of succ, twice and keep gives at least its argument. *)
let pick (op : u8) (y : u8) : u8 requires y < 100 ensures result >= y =
  let h : mutable ((x : u8) -> u8) requires x < 100 ensures result >= x = keep in
  if op = 1 then h <- succ else if op = 2 then h <- twice else ();
  h y

(* Rebound in a loop, the reference still keeps v from shrinking. *)
let grow (n : u8) (y : u8) : u8 ensures result >= y =
  let h : mutable ((x : u8) -> u8) requires x < 100 ensures result >= x = succ in
  let v : mutable u8 = y in
  for i in 0 .. n
    invariant v >= y
  do
    if v < 100 then v <- h v else ();
    if i % 2 = 0 then h <- twice else h <- succ
  done;
  v

(* twice 0 is 0, so twice does not meet an arrow that promises more. *)
let strict (y : u8) : u8 requires y < 100 =
  let h : mutable ((x : u8) -> u8) requires x < 100 ensures result > x = succ in
  h <- twice;
  h y

(* A call through 'h' knows only 'result >= x', not which function ran. *)
let exact (y : u8) : u8 requires y < 100 ensures result = y + 1 =
  let h : mutable ((x : u8) -> u8) requires x < 100 ensures result >= x = succ in
  h y

