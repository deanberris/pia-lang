(* Function references stored in records and buffers (ADR 0071): a field
   of an arrow type holds a top-level function checked against the arrow
   where it is stored, and a call through the field sees only the arrow's
   contract. Copying the field of another record of the same type needs
   no check.
// RUN: not piac --verify %s | FileCheck %s
*)

let succ (x : u8) : u8 requires x < 255 ensures result = x + 1 = x + 1
let twice (x : u8) : u8 requires x < 100 ensures result = x * 2 = x * 2
let add3 (x : u8) : u8 requires x < 200 ensures result = x + 3 = x + 3

let op = type {
  f : (x : u8) -> u8 requires x < 50 ensures result > x;
  bias : u8
}

let make (b : u8) : op = { f = succ; bias = b }

(* The call's precondition is the field's, and so is all it knows. *)
let run (o : op) (y : u8) : u8 requires y < 50 ensures result > y = o.f y

let swap (o : op) : op = let p : mutable op = o in p.f <- add3; p

(* twice 0 is 0, not more than 0. *)
let bad (o : op) : op = let p : mutable op = o in p.f <- twice; p

let copy (o : op) (b : u8) : op = { f = o.f; bias = b }

(* A buffer of records is a buffer per field, the functions among them. *)
let sum (ops : [op; 4]) (y : u8) : u16 requires y < 50 =
  let t : mutable u16 = 0 in
  for i in 0..4 invariant t <= i * 255 do
    t <- t + ops.[i].f y
  done;
  t

let fill (ops : inout [op; 4]) : unit = ops.[2].f <- add3


