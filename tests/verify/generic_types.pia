// CHECK: generic_types.pia:18:3: failed: the postcondition holds
// CHECK-NEXT: counterexample: v = {{-?[0-9]+}}
// CHECK: generic_types.pia:23:14: proved: '-' does not overflow u8 [intervals]
// CHECK: generic_types.pia:23:50: proved: '+' does not overflow u8 [smt]
// CHECK: generic_types.pia:38:3: proved: the postcondition holds [smt]
// CHECK: 4 proved, 1 failed, 0 skipped
*)
