(* A vector of boxes, `vec (box u16)` (ADR 0046's priority, ADR 0048 step 4).
   `box t r` is `@linear`, so each element owns its slot: a write through
   one element's box leaves every other's alone, with no apartness
   invariant to write. The vector's buffer is one buffer per field, the
   slots a buffer of slices and the spec-only states a buffer the verifier
   sees and codegen erases. `push` moves a full box in, `set_at` writes
   through an element's box, and `get_at` reads one. `grow` moves every
   box into a larger buffer: reading an element as a value moves it out
   and leaves it empty (ADR 0048, section 6), so each box is in one buffer
   only.
// RUN: not piac --verify %s | FileCheck %s
*)

let oom = type | OutOfMemory
let bump = let (t : type) (r : region) => type { mem : borrowed(r) mutable [t]; used : usize }

let alloc (t : type) (r : region) (m : inout mutable bump t r) (n : usize) : result (borrowed(r) out mutable [t]) oom
  requires m.used <= len m.mem
  ensures m.used <= len m.mem && len m.mem = old (len m.mem)
  ensures (match result with
           | Ok b -> len b = n
           | Err _ -> true)
= if n <= len m.mem - m.used then
    (let start = m.used in
     m.used <- start + n;
     Ok m.mem.[start .. start + n])
  else Err OutOfMemory

let box = let (t : type) (r : region) => type { slot : borrowed(r) mutable [t]; state : int } @linear

let spec ok (t : type) (b : box t) : bool = len b.slot = 1 && (b.state = 0 || b.state = 1)
let spec full (t : type) (b : box t) : bool = b.state = 1

let make (t : type) (r : region) (m : inout mutable bump t r) (v : t) : result (box t r) oom
  requires m.used <= len m.mem
  ensures m.used <= len m.mem && len m.mem = old (len m.mem)
  ensures (match result with
           | Ok b -> ok b && full b && b.slot.[0] = v
           | Err _ -> true)
= let s = alloc m 1? in
  s.[0] <- v;
  Ok { slot = s; state = 1 }

let vec = let (t : type) (r : region) (s : region) => type { buf : borrowed(s) mutable [box t r]; len : usize }

let spec good (t : type) (v : vec t) : bool =
  v.len <= len v.buf && forall (i in 0 .. v.len). ok v.buf.[i] && full v.buf.[i]

let push (t : type) (r : region) (s : region) (v : inout mutable vec t r s) (b : moved box t r) : unit
  requires good v && v.len < len v.buf && ok b && full b
  ensures good v && v.len = old v.len + 1 && len v.buf = old (len v.buf)
  ensures v.buf.[old v.len].slot.[0] = old (b.slot.[0])
  ensures forall (j in 0 .. old v.len). v.buf.[j].slot.[0] = old (v.buf.[j].slot.[0])
= (let n = v.len in v.buf.[n] <- b; v.len <- n + 1)

let get_at (t : type) (r : region) (s : region) (v : borrowed vec t r s) (i : usize) : t
  requires good v && i < v.len
  ensures result = v.buf.[i].slot.[0]
= v.buf.[i].slot.[0]

let set_at (t : type) (r : region) (s : region) (v : inout mutable vec t r s) (i : usize) (x : t) : unit
  requires good v && i < v.len
  ensures good v && v.len = old v.len && len v.buf = old (len v.buf)
  ensures v.buf.[i].slot.[0] = x
  ensures forall (j in 0 .. v.len). j <> i ==> v.buf.[j].slot.[0] = old (v.buf.[j].slot.[0])
= (v.buf.[i].slot.[0] <- x)

let demo (slots : borrowed mutable [u16]) (cells : borrowed mutable [box u16]) : result u16 oom
  requires len cells >= 2
  ensures (match result with
           | Ok x -> x = 17
           | Err _ -> true)
= let m : mutable bump u16 = { mem = slots; used = 0 } in
  let v : mutable vec u16 = { buf = cells; len = 0 } in
  push v (make m 7?);
  push v (make m 8?);
  set_at v 0 9;
  Ok (get_at v 0 + get_at v 1)

(* Wrong: the box may be empty, so it cannot be pushed. The vector is
   empty, so `good v` holds without a quantifier for the solver to model. *)
let empty_push (r : region) (s : region) (v : inout mutable vec u16 r s) (b : moved box u16 r) : unit
  requires v.len = 0 && len v.buf > 0 && ok b
= push v b

(* Moves every box into a larger buffer from m. *)
let grow (t : type) (r : region) (s : region) (m : inout mutable bump (box t r) s) (v : inout mutable vec t r s) : result unit oom
  requires good v && m.used <= len m.mem && len v.buf < 1000000
  ensures m.used <= len m.mem && len m.mem = old (len m.mem)
  ensures good v && v.len = old v.len
  ensures forall (j in 0 .. v.len). v.buf.[j].slot.[0] = old (v.buf.[j].slot.[0])
  ensures (match result with
           | Ok () -> v.len < len v.buf
           | Err _ -> true)
= let nb = alloc m (2 * len v.buf + 1)? in
  let old_buf = v.buf in
  for i in 0 .. v.len
    invariant len nb = 2 * len old_buf + 1 && v.len <= len old_buf
    invariant forall (j in 0 .. i). ok nb.[j] && full nb.[j] && nb.[j].slot.[0] = old (v.buf.[j].slot.[0])
    invariant forall (j in i .. v.len). ok old_buf.[j] && full old_buf.[j] && old_buf.[j].slot.[0] = old (v.buf.[j].slot.[0])
  do nb.[i] <- old_buf.[i] done;
  v.buf <- nb;
  Ok ()

(* Growing keeps each box's contents. *)
let grow_get (r : region) (s : region) (m : inout mutable bump (box u16 r) s) (v : inout mutable vec u16 r s) : result u16 oom
  requires good v && v.len > 0 && m.used <= len m.mem && len v.buf < 1000000
  ensures (match result with
           | Ok x -> x = old (v.buf.[0].slot.[0])
           | Err _ -> true)
= grow m v?;
  Ok (get_at v 0)

(* Wrong: the box moved out of xs.[0] leaves that element empty, so
   writing through it is out of bounds. *)
let stale (xs : inout [box u16]) (ys : inout [box u16]) : unit
  requires len xs > 0 && len ys > 0 && len xs.[0].slot = 1
= ys.[0] <- xs.[0];
  xs.[0].slot.[0] <- 1

