(* `min t` and `max t` need an integer type, and a bound is a literal, so
   it must fit where it goes (ADR 0058).
// RUN: not piac --emit=mlir %s 2>&1 | FileCheck %s
*)

let pixel = type { r : u8; g : u8; b : u8 }

(* CHECK: type_bound_errors.pia:[[@LINE+2]]:29: error: 65535 does not fit in u8
*)
let too_big (x : u8) : u8 = max u16

(* CHECK: type_bound_errors.pia:[[@LINE+2]]:35: error: 'max bool' needs an integer type, and 'bool' is not one
*)
let not_int (x : u8) : bool = max bool

(* CHECK: type_bound_errors.pia:[[@LINE+2]]:32: error: 'min pixel' needs an integer type, and 'pixel' is not one
*)
let record (x : u8) : u8 = min pixel

(* A local's name is never a bound: `max` here is the local.
// CHECK: type_bound_errors.pia:[[@LINE+2]]:29: error: 'max' is not a function
*)
let local (max : u8) : u8 = max u8
