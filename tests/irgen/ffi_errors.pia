(* Foreign functions (#55): a call without a contract needs `unsafe`.
// RUN: not piac --emit=mlir %s 2>&1 | FileCheck %s
*)

let point = type { x : i32 }

let raw (x : i32) : i32 = extern "raw_c"
let clamp (x : i32) : i32 ensures result >= 0 = extern "clamp_c"

(* CHECK: ffi_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: 'raw' is a foreign function without a contract, so only 'unsafe raw ...' can call it; or give its declaration a 'requires' or 'ensures', even 'ensures true'
*)
let plain (x : i32) : i32 = raw x

(* CHECK: ffi_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: 'unsafe' marks a call of a foreign function without a contract, and 'clamp' is not one; call it without 'unsafe'
*)
let needless (x : i32) : i32 = unsafe clamp x

(* CHECK: ffi_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: a foreign function takes integers, bools and buffers of integers for now, but 'p' has type point
*)
let by_record (p : point) : i32 ensures true = extern "by_record"

(* CHECK: ffi_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: 'extern "symbol"' is only a function's whole body
*)
let inside (x : i32) : i32 = extern "f" + 1

(* A C variadic function's extra arguments are promoted by C, so a type
   narrower than an int is an error, not a silent widening (ADR 0051).
// CHECK: ffi_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: 'b' is a variadic argument of a C function, which C promotes to int, so it must be an integer of 32 bits or more, or a buffer: give it the type the function reads, such as i32 or u32, instead of u16
*)
let narrow (n : i32) (b : u16) : i32 @variadic(1) ensures true = extern "narrow_va"

(* CHECK: ffi_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: @variadic(3) names more parameters than the declaration has
*)
let too_many (n : i32) : i32 @variadic(3) ensures true = extern "many_va"

(* CHECK: ffi_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: @variadic is only for a foreign declaration, '= extern "symbol"'
*)
let not_foreign (n : i32) : i32 @variadic(1) = n
