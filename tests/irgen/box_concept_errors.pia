(* What a box over a concept refuses (ADR 0046, sections 3 and 4): a
   value whose type does not meet the concept, a @linear value, and a call
   of a requirement with two values of the concept's type, which two boxes
   may hold of different types. widen refuses a value that borrows too,
   but no `box t` of such a type can be made yet: a buffer cannot hold a
   slice.
// RUN: not piac --emit=mlir --no-lint %s 2>&1 | FileCheck %s
*)
let box = let (@unsized t : type) (r : region) => type { slot : borrowed(r) mutable [t]; state : int }

let meta Shape (t : type) : concept = sig
  let area : (s : t) -> u32
  let same : (a : t) -> (b : t) -> bool
end

let square = type { side : u8 }
let area (s : square) : u32 = s.side
let same (a : square) (b : square) : bool = a.side = b.side

(* No area: a triangle does not meet Shape. *)
let triangle = type { base : u8 }

let token = type { id : u8 } @linear
let area (s : token) : u32 = s.id
let same (a : token) (b : token) : bool = a.id = b.id

let unmet (b : box triangle) : box Shape
  requires b.state = 1
(* CHECK: box_concept_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: {{.*}}triangle{{.*}}Shape
*)
= widen b

let hidden (b : box token) : box Shape
  requires b.state = 1
(* CHECK: box_concept_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: a value of the @linear type token cannot be boxed as a concept: the box would hide the obligation to release it (ADR 0046)
*)
= widen b

let compare (x : box Shape) (y : box Shape) : bool =
(* CHECK: box_concept_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: 'same' cannot be called through a box over 'Shape': it takes 2 values of the concept's type, and two boxes may hold values of different types (ADR 0046, section 4)
*)
  same x y
