(* A local array's storage is on the stack, so nothing holding it outlives
   its `let` for now; a literal of computed elements needs a local of its
   own; and an array that is not `mutable` cannot be written.
// RUN: not piac --verify %s 2>&1 | FileCheck %s
*)

(* CHECK: local_array_errors.pia:[[@LINE+3]]:31: error: this value is borrowed from 'a', so it cannot outlive 'a', whose scope ends here
*)
let make (x : u8) : [u8; 2] =
  let a : [u8; 2] = [x; x] in a

(* CHECK: local_array_errors.pia:[[@LINE+2]]:34: error: an array literal with computed elements needs storage of its own: bind it to a local first, as in 'let a : [u8; 2] = [x; y] in ...'
*)
let inline (x : u8) : [u8; 2] = [x; x]

(* CHECK: local_array_errors.pia:[[@LINE+3]]:29: error: an array literal for [u8; 3] needs 3 elements, found 2
*)
let short (x : u8) : u8 =
  let a : mutable [u8; 3] = [x; x] in a.[0]

(* CHECK: local_array_errors.pia:[[@LINE+3]]:32: error: cannot write to 'a': declare the local 'mutable'
*)
let frozen (x : u8) : u8 =
  let a : [u8; 2] = [x; x] in (a.[0] <- 1; a.[1])
