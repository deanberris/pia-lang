(* `int` and `real` are spec-only (ADR 0036): spec functions, lemmas,
   contracts and quantifiers compute with them, and code may not. Code may
   hold them as spec-only state, in a parameter, local or record field,
   which codegen erases (ADR 0041), but not in a buffer.
// RUN: not piac --emit=mlir %s 2>&1 | FileCheck %s
*)

let summary = type { width : usize; lip : real }

(* CHECK: spec_only_errors.pia:[[@LINE+2]]:11: error: the parameter 'xs' has type [summary], whose buffer elements hold the spec-only type real; spec-only state can be a parameter, a local or a record field, but not an element of a buffer (ADR 0041)
*)
let many (xs : [summary]) : usize = len xs

(* CHECK: spec_only_errors.pia:[[@LINE+2]]:{{[0-9]+}}: error: this expression has the spec-only type real; int and real can be used only in spec functions, lemmas, contracts and quantifiers, not in code (ADR 0036); code can only store it in a spec-only place, such as a field, local or parameter of that type (ADR 0041)
*)
let branch (f : summary) : bool = f.lip > 0.5


(* CHECK: spec_only_errors.pia:[[@LINE+2]]:32: error: this expression has the spec-only type real; int and real can be used only in spec functions, lemmas, contracts and quantifiers, not in code (ADR 0036); code can only store it in a spec-only place, such as a field, local or parameter of that type (ADR 0041)
*)
let positive (x : u8) : bool = real x > 0.5

(* CHECK: spec_only_errors.pia:[[@LINE+2]]:37: error: this expression has the spec-only type real; int and real can be used only in spec functions, lemmas, contracts and quantifiers, not in code (ADR 0036); code can only store it in a spec-only place, such as a field, local or parameter of that type (ADR 0041)
*)
let literal (x : u8) : u8 = let y = 1.5 in x

(* CHECK: spec_only_errors.pia:[[@LINE+2]]:36: error: '+' needs operands of one type, found u8 and real; convert an integer with 'real x'
*)
let spec mixed (x : u8) : real = x + 0.5

(* CHECK: spec_only_errors.pia:[[@LINE+2]]:38: error: '/' is not defined on int; convert to real with 'real x' to divide
*)
let spec int_div (n : int) : int = n / 2

(* CHECK: spec_only_errors.pia:[[@LINE+2]]:39: error: '%' is not defined on real; int and real have + - * and comparisons, and real also has /
*)
let spec modulo (x : real) : real = x % 2.0

(* CHECK: spec_only_errors.pia:[[@LINE+2]]:36: error: '1.5f32': floating-point types are not supported yet; a literal with a decimal point is a spec-only real, with no suffix
*)
let spec float (x : real) : real = 1.5f32

(* CHECK: spec_only_errors.pia:[[@LINE+2]]:42: error: 'int' converts an integer, not real
*)
let spec truncate (x : real) : int = int x
