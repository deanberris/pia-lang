(* What @collective and the protocol check of collectives (ADR 0086)
   reject: a collective under a condition on the loop variable, outside a
   spread, a value that crosses a collective, a write of a published
   buffer, a for range that depends on the iteration, a while loop, an
   argument a collective does not gather that depends on the iteration,
   and collectives that gather a parameter that is not a slice or take
   one they could write.
// RUN: not piac --emit=mlir --no-lint %s 2>&1 | FileCheck %s
*)

let exchange (b : [u32]) : unit @collective = ()

let total (xs : [u32]) (k : u32) : u32 @collective(xs) = k

let first_only (a : borrowed inout mutable [u32]) : unit
= spread i in 0 .. len a do
    if i = 0 then exchange a else ();
    a.[i] <- 0
  done

let outside (a : [u32]) : unit = exchange a

let crossing (a : borrowed inout mutable [u32]) : unit
= spread i in 0 .. len a do
    let x = a.[i] in
    exchange a;
    a.[i] <- x
  done

let write_published (a : borrowed inout mutable [u32]) : unit
= spread i in 0 .. len a do
    exchange a;
    a.[i] <- 0
  done

let ragged (a : borrowed inout mutable [u32]) (k : [u32]) : unit
  requires len k = len a
= spread i in 0 .. len a do
    for t in 0 .. k.[i] do
      exchange a
    done
  done

let looping (a : borrowed inout mutable [u32]) (go : bool) : unit
= spread i in 0 .. len a do
    while go do exchange a done
  done

let varying (xs : [u32]) (ys : out mutable [u32]) : unit
  requires len ys = len xs
= spread i in 0 .. len xs do ys.[i] <- total xs.[i] xs.[i] done

let scalar (x : u32) : u32 @collective(x) = x

let writer (xs : [u32]) (ys : out mutable [u32]) : unit @collective(xs) = ()

(*
// CHECK: error
*)
