(* The derive builtins (ADR 0045, step 3) say what went wrong, and an
   attribute on a field or a constructor that no derive reads is an error,
   not silently ignored.
// RUN: not piac --dump-expanded %s 2>&1 | FileCheck %s
*)

let point = type { x : u8 }
let choice = type | Yes | No

(* CHECK: derive_builtin_errors.pia:[[@LINE+3]]:1: error: the metaprogram 'missing' failed: 'field_type': there is no field 'z'
*)
let meta missing () : list = [ `( let m : $(field_type point "z") = 1 ) ]
missing ()

(* CHECK: derive_builtin_errors.pia:[[@LINE+3]]:1: error: the metaprogram 'not_record' failed: 'field_attrs' needs a record type
*)
let meta not_record () : list = [ `( let n : u8 = $(length (field_attrs choice "Yes")) ) ]
not_record ()

(* CHECK: derive_builtin_errors.pia:[[@LINE+3]]:1: error: the metaprogram 'not_variant' failed: 'variants' needs a variant type
*)
let meta not_variant () : list = [ `( let v : u8 = $(length (variants point)) ) ]
not_variant ()

(* CHECK: derive_builtin_errors.pia:[[@LINE+3]]:1: error: the metaprogram 'no_ctor' failed: 'ctor_attrs': there is no constructor 'Maybe'
*)
let meta no_ctor () : list = [ `( let c : u8 = $(length (ctor_attrs choice "Maybe")) ) ]
no_ctor ()

(* CHECK: derive_builtin_errors.pia:[[@LINE+3]]:1: error: the metaprogram 'not_text' failed: 'bytes' needs text as a string, found an integer
*)
let meta not_text () : list = [ `( let b : u8 = $(length (bytes 5)) ) ]
not_text ()

(* No derive of the type reads @json.
// CHECK: derive_builtin_errors.pia:[[@LINE+3]]:27: error: the attribute @json on 'x' is read by no derive of 'pixel'; add @derive(json) to the type, or remove it
// CHECK: derive_builtin_errors.pia:[[@LINE+4]]:9: error: the attribute @json on 'Red' is read by no derive of 'hue'; add @derive(json) to the type, or remove it
*)
let pixel = type { x : u8 @json(name = "x") } @derive(eq)
let hue = type
  | Red @json(name = "r") | Green

(* A record payload's fields too: their attributes are for the variant's
   derives.
// CHECK: derive_builtin_errors.pia:[[@LINE+3]]:23: error: the attribute @json on 'r' is read by no derive of 'wheel'; add @derive(json) to the type, or remove it
*)
let wheel = type
  | Spoke of { r : u8 @json(name = "radius") }
  | Hub
