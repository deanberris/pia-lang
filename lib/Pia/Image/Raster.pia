(* Pia.Image.Raster: the dimensions of an image and the indices into its
   samples (ADR 0054, step 1). An image is `w * h * c` bytes, row by row,
   with the c channel samples of a pixel side by side, so the sample k of
   pixel (x, y) is at `(y * w + x) * c + k`. Widths and heights are
   1 to 65535, as in GIF, and an image has 1 to 4 channels.

   `index` is proved to lie below `size`, and `row_start` to begin a row
   of a rectangle whose samples all lie below it, so a caller that holds
   a slice of `size` bytes indexes it without another bound check.

   The products are of 16-bit values, so the verifier keeps them at its
   68-bit width (docs/verifier.md), but Z3 cannot bit-blast a chain of
   them within its timeout (#45). The monotonicity of a product is
   proved once, by induction, with Z3's int-blasting bit-vector solver
   (`bv.solver 2`), and `index` and `row_start` use it as a lemma. *)
module Pia.Image.Raster : Raster

interface Raster = sig
  let dims = type { w : int{1..65535}; h : int{1..65535}; c : int{1..4} }
  let rect = type { x0 : u16; y0 : u16; rw : int{1..65535}; rh : int{1..65535} }
  let spec size : (w : int{1..65535}) -> (h : int{1..65535}) -> (c : int{1..4}) -> usize
  let spec inside : (d : dims) -> (r : rect) -> bool
  let index : (d : dims) -> (x : u16) -> (y : u16) -> (k : int{0..3}) -> usize
    requires x < d.w && y < d.h && k < d.c
    ensures result < size d.w d.h d.c
    ensures result = (y * d.w + x) * d.c + k
  let contains : (d : dims) -> (r : rect) -> bool
    ensures result <==> inside d r
  let row_start : (d : dims) -> (r : rect) -> (j : u16) -> usize
    requires inside d r && j < r.rh
    ensures result = ((r.y0 + j) * d.w + r.x0) * d.c
    ensures result + r.rw * d.c <= size d.w d.h d.c
end

(** The dimensions of an image: width, height and channels per pixel. *)
let dims = type { w : int{1..65535}; h : int{1..65535}; c : int{1..4} }

(** A rectangle: its top left corner and its width and height. *)
let rect = type { x0 : u16; y0 : u16; rw : int{1..65535}; rh : int{1..65535} }

(** The number of samples of a w by h image with c channels. *)
let spec size (w : int{1..65535}) (h : int{1..65535}) (c : int{1..4}) : usize = w * h * c

(** r lies inside an image of dimensions d. *)
let spec inside (d : dims) (r : rect) : bool =
  (let xe : u32 = r.x0 + r.rw in let ye : u32 = r.y0 + r.rh in xe <= d.w && ye <= d.h)

let lemma distrib (y : u16) (w : u16) : unit
  ensures (y + 1) * w = y * w + w
= ()

let lemma mul_mono (a : u16) (b : u16) (w : u16) : unit @solver(tactic = "(using-params smt :bv.solver 2)")
  requires a <= b
  ensures a * w <= b * w
  decreases b - a
= if a < b then (
    let b' : u16 = b - 1 in
    mul_mono a b' w;
    distrib b' w)

(* A row of n samples from x, in row y of h rows of w, ends by h * w. *)
let lemma row_end (w : u16) (h : u16) (x : u16) (n : u16) (y : u16) : unit @solver(tactic = "(using-params smt :bv.solver 2)")
  requires x + n <= w && y < h
  ensures y * w + x + n <= h * w
= let y1 : u16 = y + 1 in
  mul_mono y1 h w;
  distrib y w

(* Pixel x of row y, in h rows of w, lies below h * w. *)
let lemma row_lt (w : u16) (h : u16) (x : u16) (y : u16) : unit @solver(tactic = "(using-params smt :bv.solver 2)")
  requires x < w && y < h
  ensures y * w + x < h * w
= let y1 : u16 = y + 1 in
  mul_mono y1 h w;
  distrib y w

let lemma scale_lt (a : u64) (n : u64) (c : int{1..4}) (k : int{0..3}) : unit
  requires a < n && n <= 4294836225 && k < c
  ensures a * c + k < n * c
= ()

let lemma scale_le (a : u64) (n : u64) (c : int{1..4}) : unit
  requires a <= n && n <= 4294836225
  ensures a * c <= n * c
= ()

(** The index of sample k of pixel (x, y). *)
let index (d : dims) (x : u16) (y : u16) (k : int{0..3}) : usize
  requires x < d.w && y < d.h && k < d.c
  ensures result < size d.w d.h d.c
  ensures result = (y * d.w + x) * d.c + k
= let row : usize = y * d.w + x in
  let wh : usize = d.h * d.w in
  row_lt d.w d.h x y;
  scale_lt row wh d.c k;
  row * d.c + k

(** r lies inside an image of dimensions d. *)
let contains (d : dims) (r : rect) : bool
  ensures result <==> inside d r
= let xe : u32 = r.x0 + r.rw in
  let ye : u32 = r.y0 + r.rh in
  xe <= d.w && ye <= d.h

(** The index of the first sample of row j of r: the row's samples are
    the r.rw * d.c from there. *)
let row_start (d : dims) (r : rect) (j : u16) : usize
  requires inside d r && j < r.rh
  ensures result = ((r.y0 + j) * d.w + r.x0) * d.c
  ensures result + r.rw * d.c <= size d.w d.h d.c
= let y : u16 = r.y0 + j in
  let row : usize = y * d.w + r.x0 in
  let wh : usize = d.h * d.w in
  row_end d.w d.h r.x0 r.rw y;
  let e : usize = row + r.rw in
  scale_le e wh d.c;
  row * d.c
