load("//tools/piac:pia.bzl", "pia_library")
load("//tools/piac:targets.bzl", "PIA_TARGETS")

# Pia.Image.Gif (ADR 0054, step 2): GIF, proved against GIF89a written as
# spec functions. Spec holds the meaning (here, the LZW dictionary), and Lzw
# is the decoder proved against it. Each module is proved and compiled on
# its own, and importers build against its interface artifacts.

package(default_visibility = ["//visibility:public"])

# Its tests read the source, to prove it and to write its interfaces.
exports_files([
    "Decode.pia",
    "Encode.pia",
    "Lzw.pia",
    "LzwEncode.pia",
    "Quantise.pia",
    "Spec.pia",
])

# The LZW dictionary as spec functions: tests/std/gif_lzw.pia checks its
# goals and its interface.
pia_library(
    name = "spec",
    src = "Spec.pia",
    target_compatible_with = PIA_TARGETS,
)

# The LZW decoder: tests/std/gif_lzw.pia checks its goals;
# tests/std/gif_lzw_edges.pia and :gif_lzw_run test it through its
# interface.
pia_library(
    name = "lzw",
    src = "Lzw.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":spec",
        "//lib/Pia/Image:bits",
    ],
)

# The container: tests/std/gif_decode.pia checks its goals;
# tests/std/gif_decode_edges.pia and :gif_decode_run test it through its
# interface.
pia_library(
    name = "decode",
    src = "Decode.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":lzw",
        ":spec",
        "//lib/Pia/Image:bits",
        "//lib/Pia/Image:raster",
    ],
)

# The LZW encoder and the sub-block writer: tests/std/gif_encode.pia checks
# its goals; :gif_encode_run tests it through the container.
pia_library(
    name = "lzw_encode",
    src = "LzwEncode.pia",
    target_compatible_with = PIA_TARGETS,
    deps = ["//lib/Pia/Image:bits"],
)

# The animated GIF encoder: tests/std/gif_encode.pia checks its goals;
# tests/std/gif_encode_edges.pia and :gif_encode_run test it through its
# interface.
pia_library(
    name = "encode",
    src = "Encode.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":decode",
        ":lzw",
        ":lzw_encode",
        ":spec",
        "//lib/Pia/Image:bits",
        "//lib/Pia/Image:raster",
    ],
)

# RGB to a palette and an index raster, and RGB animations:
# tests/std/gif_quantise.pia checks its goals; tests/std/gif_quantise_edges.pia
# and :gif_quantise_run test it through its interface.
pia_library(
    name = "quantise",
    src = "Quantise.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":decode",
        ":encode",
        ":lzw",
        ":lzw_encode",
        ":spec",
        "//lib/Pia/Image:bits",
        "//lib/Pia/Image:raster",
    ],
)
