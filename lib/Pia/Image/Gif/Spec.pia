(* Pia.Image.Gif.Spec: what a GIF means, as spec functions (ADR 0054,
   step 2). This part is the LZW dictionary of GIF89a's appendix F.

   The dictionary is the one a decoder builds: entry k, for k from clear + 2
   up, is a prefix entry and one more byte, its suffix. The roots, the
   entries below clear = 2^min_code_size, are one byte each, their own
   value; clear and clear + 1 (end of information) are codes, not entries.
   A decoder keeps the dictionary in a table of 12288 bytes, which is what
   these specs read: the prefix of entry k as a little-endian u16 at bytes
   2k and 2k + 1, and its suffix at byte 8192 + k.

   `elen t clear k` is the length of entry k's string and `sym t clear k d`
   is its byte d, both by following the prefix chain down to a root. Each
   is total: a prefix that does not decrease ends the chain, so neither
   depends on the table being well formed. `table_ok` is what a decoder
   keeps true of the entries it has added: each one's prefix is an
   earlier entry or a root, and its suffix is a root's value.

   The second part is the block grammar of GIF89a (sections 17 to 27):
   the header and logical screen descriptor, colour tables, the
   sub-block chains that carry extensions and image data, image
   descriptors, the trailer, and the interlaced row order. A GIF is
   `header_ok`, then from `first_block` a sequence of blocks that is
   `blocks_ok` up to its trailer. Each block-level spec returns 0 where
   the grammar stops accepting, which is never a real position: a block
   always ends after it starts. *)
module Pia.Image.Gif.Spec : Lzw, Blocks

interface Lzw = sig
  let spec pre : (t : [u8]) -> (k : usize) -> u16
  let spec suf : (t : [u8]) -> (k : usize) -> u8
  let spec elen : (t : [u8]) -> (clear : usize) -> (k : usize) -> usize
  let spec sym : (t : [u8]) -> (clear : usize) -> (k : usize) -> (d : usize) -> usize
  let spec entry_ok : (t : [u8]) -> (clear : int{4..256}) -> (k : usize) -> bool
  let spec table_ok : (t : [u8]) -> (clear : int{4..256}) -> (nx : usize) -> bool
  let spec valid : (clear : int{4..256}) -> (nx : usize) -> (k : usize) -> bool
end

interface Blocks = sig
  let spec u16le : (s : [u8]) -> (i : usize) -> u16
  let spec header_ok : (s : [u8]) -> bool
  let spec ctab_len : (packed : u8) -> int{0..768}
  let spec first_block : (s : [u8]) -> usize
  let spec chain_end : (s : [u8]) -> (p : usize) -> usize
  let spec block_end : (s : [u8]) -> (p : usize) -> usize
  let spec blocks_ok : (s : [u8]) -> (p : usize) -> bool
  let spec frames_from : (s : [u8]) -> (p : usize) -> usize
  let spec pass_rows : (h : int{1..65535}) -> (k : int{0..3}) -> usize
  let spec row_of : (h : int{1..65535}) -> (r : usize) -> usize
  let spec rank_of : (h : int{1..65535}) -> (y : usize) -> usize
end

(** The prefix of entry k. *)
let spec pre (t : [u8]) (k : usize) : u16
  requires len t = 12288 && k < 4096
= let lo : u16 = t.[2 * k] in
  let hi : u16 = t.[2 * k + 1] in
  (lo | (hi << 8))

(** The suffix of entry k: the last byte of its string. *)
let spec suf (t : [u8]) (k : usize) : u8
  requires len t = 12288 && k < 4096
= t.[8192 + k]

(** The length of entry k's string. *)
let spec elen (t : [u8]) (clear : usize) (k : usize) : usize
  requires len t = 12288 && k < 4096
  ensures 1 <= result && result <= k + 1
  decreases k
= if k < clear then 1
  else if pre t k < k then 1 + elen t clear (pre t k)
  else 1

(** Byte d of entry k's string. *)
let spec sym (t : [u8]) (clear : usize) (k : usize) (d : usize) : usize
  requires len t = 12288 && k < 4096 && d < elen t clear k
  decreases k
= if d + 1 = elen t clear k then (if k < clear then k else suf t k)
  else sym t clear (pre t k) d

(** Entry k extends an earlier entry or a root by a root's value. *)
let spec entry_ok (t : [u8]) (clear : int{4..256}) (k : usize) : bool
  requires len t = 12288 && k < 4096
= pre t k < k && (pre t k < clear || clear + 2u16 <= pre t k) && suf t k < clear

(** Every entry added below nx is well formed. *)
let spec table_ok (t : [u8]) (clear : int{4..256}) (nx : usize) : bool
  requires len t = 12288 && nx <= 4096
= forall (k in 0 .. nx). clear + 2u16 <= k ==> entry_ok t clear k

(** k names a string when the next free entry is nx: a root, or an entry
    already added. *)
let spec valid (clear : int{4..256}) (nx : usize) (k : usize) : bool =
  k < clear || (clear + 2u16 <= k && k < nx)

(** The little-endian u16 at s.[i]. *)
let spec u16le (s : [u8]) (i : usize) : u16
  requires i < len s && 1 < len s - i
= let lo : u16 = s.[i] in
  let hi : u16 = s.[i + 1] in
  (lo | (hi << 8))

(** The signature and version, GIF87a or GIF89a, and a whole logical
    screen descriptor. *)
let spec header_ok (s : [u8]) : bool =
  if len s < 13 then false
  else s.[0] = 0x47 && s.[1] = 0x49 && s.[2] = 0x46 && s.[3] = 0x38
  && (s.[4] = 0x37 || s.[4] = 0x39) && s.[5] = 0x61

(** The bytes of the colour table a packed field announces: 3 * 2^(n+1)
    for its low three bits n, when its top bit is set. *)
let spec ctab_len (packed : u8) : int{0..768} =
  if (packed & 0x80) = 0 then 0
  else (let n : u16 = packed & 7 in let two : u16 = 2 in let v : int{6..768} = 3 * (two << n) in v)

(** Where the blocks start: after the header, the screen descriptor and
    the global colour table. *)
let spec first_block (s : [u8]) : usize
  requires len s >= 13
= 13 + ctab_len s.[10]

(** The end of the sub-block chain at p, after its zero-length
    terminator, or 0 when the chain does not end inside s. *)
let spec chain_end (s : [u8]) (p : usize) : usize
  ensures result = 0 || (p < result && result <= len s)
  decreases len s - p
= if p >= len s then 0
  else if s.[p] = 0 then p + 1
  else if len s - p <= s.[p] then 0
  else chain_end s (p + 1 + s.[p])

(** The end of the extension or image block at p, or 0. *)
let spec block_end (s : [u8]) (p : usize) : usize
  requires p < len s
  ensures result = 0 || (p < result && result <= len s)
= if s.[p] = 0x21 then (if len s - p < 2 then 0 else chain_end s (p + 2))
  else if s.[p] = 0x2C then (
    if len s - p < 11 then 0
    else if len s - p <= 10 + ctab_len s.[p + 9] then 0
    else chain_end s (p + 11 + ctab_len s.[p + 9]))
  else 0

(** From p, blocks up to and including a trailer. *)
let spec blocks_ok (s : [u8]) (p : usize) : bool
  decreases len s - p
= if p >= len s then false
  else if s.[p] = 0x3B then true
  else if block_end s p = 0 then false
  else blocks_ok s (block_end s p)

(** The number of images among the blocks from p to the trailer. *)
let spec frames_from (s : [u8]) (p : usize) : usize
  ensures result <= len s - p || p >= len s
  decreases len s - p
= if p >= len s then 0
  else if s.[p] = 0x3B then 0
  else if block_end s p = 0 then 0
  else (if s.[p] = 0x2C then 1 else 0) + frames_from s (block_end s p)

(** The number of rows in interlace pass k of an image h rows high:
    rows 0, 8, 16 ...; then 4, 12 ...; then 2, 6 ...; then 1, 3 .... *)
let spec pass_rows (h : int{1..65535}) (k : int{0..3}) : usize =
  if k = 0 then (h + 7) / 8
  else if k = 1 then (h + 3) / 8
  else if k = 2 then (h + 1) / 4
  else h / 2

(** The image row that the r-th row of interlaced data fills. *)
let spec row_of (h : int{1..65535}) (r : usize) : usize
  requires r < h
= let a = pass_rows h 0 in
  let b = pass_rows h 1 in
  let c = pass_rows h 2 in
  if r < a then 8 * r
  else if r < a + b then 8 * (r - a) + 4
  else if r < a + b + c then 4 * (r - a - b) + 2
  else 2 * (r - a - b - c) + 1

(** The rank in interlaced data of image row y: row_of's inverse. *)
let spec rank_of (h : int{1..65535}) (y : usize) : usize
  requires y < h
= let a = pass_rows h 0 in
  let b = pass_rows h 1 in
  let c = pass_rows h 2 in
  if y % 8 = 0 then y / 8
  else if y % 8 = 4 then a + y / 8
  else if y % 4 = 2 then a + b + y / 4
  else a + b + c + y / 2
