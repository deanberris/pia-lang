(* Pia.Image.Gif.Quantise: an RGB raster to a palette of at most 256
   colours and an index raster (ADR 0054, step 4), proved total, with every
   index below the palette's size. It makes no claim about how good the
   colours look.

   `quantise` first tries the input's own colours: when it has at most
   maxc of them, the palette is exactly those colours and each pixel's
   index names its own colour, which `check_exact` proves of the result
   before it is returned (the `exact` flag). Otherwise it is median cut:
   boxes in colour space, each split at the median of its longest side
   until there are maxc boxes or no box can be split, each shrunk to the
   pixels it holds, and each pixel indexed by the box that holds it, with
   the box's centre as its colour. The boxes (6 bytes each) and a 256-bin
   histogram of u32 counts live in buffers the caller lends.

   `encode_rgb_animation` quantises every frame of an animation to one
   shared palette and writes it with Pia.Image.Gif.Encode. *)
module Pia.Image.Gif.Quantise : Quantise

import Pia.Image.Bits.Bits as B
import Pia.Image.Raster.Raster as R
import Pia.Image.Gif.Spec.Lzw as S
import Pia.Image.Gif.Spec.Blocks as G
import Pia.Image.Gif.Lzw.Lzw as L
import Pia.Image.Gif.Decode.Decode as D
import Pia.Image.Gif.LzwEncode.LzwEncode as E
import Pia.Image.Gif.Encode.Encode as X

interface Quantise = sig
  let quant = type { k : int{1..256}; exact : bool }
  let rgb_error = type | RgbFull of usize | RgbFailed of usize
  let spec pix_is : (rgb : [u8]) -> (pal : [u8]) -> (i : usize) -> (c : usize) -> bool
  let quantise : (rgb : [u8]) -> (maxc : int{1..256}) -> (pal : borrowed inout mutable [u8]) -> (idx : borrowed inout mutable [u8]) -> (bx : borrowed inout mutable [u8]) -> (hist : borrowed inout mutable [u8]) -> quant
    requires len rgb = 3 * len idx && len idx <= 4294967295
    requires len pal = 768 && len bx = 1536 && len hist = 1024
    ensures result.k <= maxc
    ensures forall (i in 0 .. len idx). idx.[i] < result.k
    ensures result.exact ==> (forall (i in 0 .. len idx). pix_is rgb pal i idx.[i])
  let encode_rgb_animation : (w : int{1..65535}) -> (h : int{1..65535}) -> (rgb : [u8]) -> (nf : u16) -> (delay : u16) -> (loops : u16) -> (dst : borrowed inout mutable [u8]) -> (idx : borrowed inout mutable [u8]) -> (pal : borrowed inout mutable [u8]) -> (bx : borrowed inout mutable [u8]) -> (hist : borrowed inout mutable [u8]) -> (rect : borrowed inout mutable [u8]) -> (lz : borrowed inout mutable [u8]) -> (hash : borrowed inout mutable [u8]) -> result usize rgb_error
    requires len rgb = 3 * len idx && len idx <= 4294967295
    requires len pal = 768 && len bx = 1536 && len hist = 1024
    requires len rect = R.size w h 1 && len lz = 3 * len rect + 5 && len hash = 40960
    ensures (match result with
      | Ok n -> n <= len dst && n <= 800 + X.anim_bound (X.frame_bound (R.size w h 1)) nf
                && (if G.header_ok dst then
                      G.blocks_ok dst (G.first_block dst) && G.frames_from dst (G.first_block dst) = nf
                      && G.u16le dst 6 = w && G.u16le dst 8 = h
                    else false)
      | Err _ -> true)
    ensures (match result with
      | Ok n -> true
      | Err e -> (match e with
        | RgbFull p -> len dst < 800 + X.anim_bound (X.frame_bound (R.size w h 1)) nf
        | _ -> true))
end

(** The palette size, and whether each pixel has its own colour exactly. *)
let quant = type { k : int{1..256}; exact : bool }

(** RgbFull: dst ends at the offset, which a dst of the size bound never
    does. RgbFailed: any other error of encode_animation, at the offset. *)
let rgb_error = type | RgbFull of usize | RgbFailed of usize

let find_colour (pal : [u8]) (k : int{0..256}) (r : u8) (g : u8) (b : u8) : int{0..256}
  requires len pal = 768
  ensures result <= k
  ensures result < k ==> pal.[3 * result] = r && pal.[3 * result + 1] = g && pal.[3 * result + 2] = b
  ensures result = k ==> (forall (c in 0 .. k). (pal.[3 * c] = r && pal.[3 * c + 1] = g && pal.[3 * c + 2] = b) = false)
= let c : mutable int{0..256} = 0 in
  let found : mutable bool = false in
  while found = false && c < k
    invariant c <= k
    invariant found ==> c < k && pal.[3 * c] = r && pal.[3 * c + 1] = g && pal.[3 * c + 2] = b
    invariant found = false ==> (forall (e in 0 .. c). (pal.[3 * e] = r && pal.[3 * e + 1] = g && pal.[3 * e + 2] = b) = false)
    decreases k - c + (if found then 0 else 1)
  do
    if pal.[3 * c] = r && pal.[3 * c + 1] = g && pal.[3 * c + 2] = b then found <- true
    else c <- c + 1
  done;
  c

let spec pix_is (rgb : [u8]) (pal : [u8]) (i : usize) (c : usize) : bool
  requires 3 * i + 2 < len rgb && c < 256 && len pal = 768
= pal.[3 * c] = rgb.[3 * i] && pal.[3 * c + 1] = rgb.[3 * i + 1] && pal.[3 * c + 2] = rgb.[3 * i + 2]

let check_exact (rgb : [u8]) (pal : [u8]) (idx : [u8]) (k : int{1..256}) : bool
  requires len rgb = 3 * len idx && len pal = 768
  ensures result ==> (forall (i in 0 .. len idx). idx.[i] < k && pix_is rgb pal i idx.[i])
= let ok : mutable bool = true in
  let i : mutable usize = 0 in
  while ok && i < len idx
    invariant i <= len idx
    invariant ok ==> (forall (j in 0 .. i). idx.[j] < k && pix_is rgb pal j idx.[j])
    decreases len idx - i + (if ok then 1 else 0)
  do
    let c : usize = idx.[i] in
    if c < k && pal.[3 * c] = rgb.[3 * i] && pal.[3 * c + 1] = rgb.[3 * i + 1] && pal.[3 * c + 2] = rgb.[3 * i + 2]
    then i <- i + 1 else ok <- false
  done;
  ok

let put_colour (pal : borrowed inout mutable [u8]) (k : int{0..255}) (r : u8) (g : u8) (b : u8) : unit
  requires len pal = 768
  ensures pal.[3 * k] = r && pal.[3 * k + 1] = g && pal.[3 * k + 2] = b
  ensures forall (j in 0 .. 3 * k). pal.[j] = old (pal.[j])
= pal.[3 * k] <- r;
  pal.[3 * k + 1] <- g;
  pal.[3 * k + 2] <- b

let exact (rgb : [u8]) (maxc : int{1..256}) (pal : borrowed inout mutable [u8]) (idx : borrowed inout mutable [u8]) : int{0..256}
  requires len rgb = 3 * len idx && len pal = 768
  ensures result <= maxc
= let k : mutable int{0..256} = 0 in
  let ok : mutable bool = true in
  let i : mutable usize = 0 in
  while ok && i < len idx
    invariant i <= len idx && k <= maxc
    decreases len idx - i + (if ok then 1 else 0)
  do
    let r = rgb.[3 * i] in
    let g = rgb.[3 * i + 1] in
    let b = rgb.[3 * i + 2] in
    let c = find_colour pal k r g b in
    if c < k then (let cb : u8 = c in idx.[i] <- cb; i <- i + 1)
    else if k = maxc then ok <- false
    else (
      put_colour pal k r g b;
      let cb : u8 = k in
      idx.[i] <- cb;
      k <- k + 1;
      i <- i + 1)
  done;
  if ok = false then 0
  else if k = 0 then (pal.[0] <- 0; pal.[1] <- 0; pal.[2] <- 0; 1)
  else k

(* Box j of bx: bytes 6j .. 6j + 5 are rmin, rmax, gmin, gmax, bmin, bmax. *)
let inside (bx : [u8]) (j : int{0..255}) (r : u8) (g : u8) (b : u8) : bool
  requires len bx = 1536
= let o : usize = 6 * j in
  bx.[o] <= r && r <= bx.[o + 1] && bx.[o + 2] <= g && g <= bx.[o + 3] && bx.[o + 4] <= b && b <= bx.[o + 5]

(* The tight bounds of the pixels inside box j, written to box d, or false
   when there are none. *)
let shrink (rgb : [u8]) (n : usize) (bx : borrowed inout mutable [u8]) (j : int{0..255}) (d : int{0..255}) : bool
  requires len bx = 1536 && 3 * n <= len rgb
= let lo : mutable u8 = 255 in let hi : mutable u8 = 0 in
  let glo : mutable u8 = 255 in let ghi : mutable u8 = 0 in
  let blo : mutable u8 = 255 in let bhi : mutable u8 = 0 in
  let any : mutable bool = false in
  for i in 0 .. n do
    let r = rgb.[3 * i] in
    let g = rgb.[3 * i + 1] in
    let b = rgb.[3 * i + 2] in
    if inside bx j r g b then (
      any <- true;
      (if r < lo then lo <- r else ()); (if r > hi then hi <- r else ());
      (if g < glo then glo <- g else ()); (if g > ghi then ghi <- g else ());
      (if b < blo then blo <- b else ()); (if b > bhi then bhi <- b else ()))
    else ()
  done;
  (if any then (
     let o : usize = 6 * d in
     bx.[o] <- lo; bx.[o + 1] <- hi; bx.[o + 2] <- glo; bx.[o + 3] <- ghi; bx.[o + 4] <- blo; bx.[o + 5] <- bhi)
   else ());
  any

(* The u32 count c of hist, little endian. *)
let count_at (hist : [u8]) (c : u8) : u32
  requires len hist = 1024
= let o : usize = 4 * c in
  let b0 : u32 = hist.[o] in let b1 : u32 = hist.[o + 1] in
  let b2 : u32 = hist.[o + 2] in let b3 : u32 = hist.[o + 3] in
  (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

let set_count (hist : borrowed inout mutable [u8]) (c : u8) (v : u32) : unit
  requires len hist = 1024
= let o : usize = 4 * c in
  let b0 : u8 = v & 0xFF in let b1 : u8 = (v >> 8) & 0xFF in
  let b2 : u8 = (v >> 16) & 0xFF in let b3 : u8 = v >> 24 in
  hist.[o] <- b0; hist.[o + 1] <- b1; hist.[o + 2] <- b2; hist.[o + 3] <- b3

(* The value t in [lo, hi) at or below which half the pixels of box j lie
   along axis a (0 red, 1 green, 2 blue). *)
let median (rgb : [u8]) (n : int{0..4294967295}) (bx : [u8]) (j : int{0..255}) (a : int{0..2}) (lo : u8) (hi : u8) (hist : borrowed inout mutable [u8]) : u8
  requires len bx = 1536 && 3 * n <= len rgb && len hist = 1024 && lo < hi
  ensures lo <= result && result < hi
= for c in 0 .. 1024 do hist.[c] <- 0 done;
  let total : mutable u32 = 0 in
  for i in 0 .. n
    invariant total <= i
  do
    let r = rgb.[3 * i] in
    let g = rgb.[3 * i + 1] in
    let b = rgb.[3 * i + 2] in
    if inside bx j r g b then (
      let v : u8 = (if a = 0 then r else if a = 1 then g else b) in
      let c = count_at hist v in
      (if c < 4294967295 then set_count hist v (c + 1) else ());
      total <- total + 1)
    else ()
  done;
  let tt : u64 = total in
  let half : u64 = (tt + 1) / 2 in
  let acc : mutable u64 = 0 in
  let t : mutable u8 = lo in
  let found : mutable bool = false in
  let v : mutable u16 = lo in
  while found = false && v < hi
    invariant lo <= v && v <= hi && lo <= t && t < hi
    decreases hi - v + (if found then 0 else 1)
  do
    let vb : u8 = v in
    acc <- acc +| count_at hist vb;
    if acc >= half then (t <- vb; found <- true) else v <- v + 1
  done;
  if found then t else hi - 1

(* Median cut into at most maxc boxes, each pixel indexed by its box, and
   each box's centre its colour. *)
let median_cut (rgb : [u8]) (n : int{0..4294967295}) (maxc : int{1..256}) (pal : borrowed inout mutable [u8]) (idx : borrowed inout mutable [u8]) (bx : borrowed inout mutable [u8]) (hist : borrowed inout mutable [u8]) : int{1..256}
  requires len rgb = 3 * len idx && n = len idx && len pal = 768 && len bx = 1536 && len hist = 1024
  ensures result <= maxc
  ensures forall (i in 0 .. len idx). idx.[i] < result
= bx.[0] <- 0; bx.[1] <- 255; bx.[2] <- 0; bx.[3] <- 255; bx.[4] <- 0; bx.[5] <- 255;
  let any = shrink rgb n bx 0 0 in
  let k : mutable u16 = 1 in
  let mx : u16 = maxc in
  let go : mutable bool = true in
  while go && k < mx
    invariant 1 <= k && k <= mx
    decreases mx - k + (if go then 1 else 0)
  do
    (* The box with the longest side, and that side's axis. *)
    let best : mutable int{0..255} = 0 in
    let side : mutable u8 = 0 in
    let axis : mutable int{0..2} = 0 in
    for j in 0 .. k do
      let jj : int{0..255} = j in
      let o : usize = 6 * jj in
      let dr : u8 = bx.[o + 1] -| bx.[o] in
      let dg : u8 = bx.[o + 3] -| bx.[o + 2] in
      let db : u8 = bx.[o + 5] -| bx.[o + 4] in
      (if dr > side then (side <- dr; best <- jj; axis <- 0) else ());
      (if dg > side then (side <- dg; best <- jj; axis <- 1) else ());
      (if db > side then (side <- db; best <- jj; axis <- 2) else ())
    done;
    if side = 0 then go <- false
    else (
      let o : usize = 6 * best in
      let lo = bx.[o + 2 * axis] in
      let hi = bx.[o + 2 * axis + 1] in
      if lo >= hi then go <- false
      else (
        let t = median rgb n bx best axis lo hi hist in
        let kb : int{0..255} = k in
        let ok' : usize = 6 * kb in
        for c in 0 .. 6 do bx.[ok' + c] <- bx.[o + c] done;
        bx.[o + 2 * axis + 1] <- t;
        bx.[ok' + 2 * axis] <- t + 1;
        let a1 = shrink rgb n bx best best in
        let a2 = shrink rgb n bx kb kb in
        k <- k + 1))
  done;
  (* Each box's centre is its colour. *)
  for c in 0 .. k do
    let cc : int{0..255} = c in
    let o : usize = 6 * cc in
    let r : u8 = (let a : u16 = bx.[o] in let b : u16 = bx.[o + 1] in (a + b) / 2) in
    let g : u8 = (let a : u16 = bx.[o + 2] in let b : u16 = bx.[o + 3] in (a + b) / 2) in
    let b' : u8 = (let a : u16 = bx.[o + 4] in let b : u16 = bx.[o + 5] in (a + b) / 2) in
    pal.[3 * cc] <- r; pal.[3 * cc + 1] <- g; pal.[3 * cc + 2] <- b'
  done;
  (* Each pixel is indexed by the first box that holds it. *)
  let kk : int{1..256} = k in
  for i in 0 .. len idx
    invariant forall (j in 0 .. i). idx.[j] < kk
  do
    let r = rgb.[3 * i] in
    let g = rgb.[3 * i + 1] in
    let b = rgb.[3 * i + 2] in
    let c : mutable int{0..255} = 0 in
    let found : mutable bool = false in
    let j : mutable u16 = 0 in
    while found = false && j < k
      invariant c < k
      decreases k - j + (if found then 0 else 1)
    do
      let jj : int{0..255} = j in
      if inside bx jj r g b then (c <- jj; found <- true) else j <- j + 1
    done;
    let cb : u8 = c in
    idx.[i] <- cb
  done;
  kk

(** The palette and index raster of rgb, with at most maxc colours. *)
let quantise (rgb : [u8]) (maxc : int{1..256}) (pal : borrowed inout mutable [u8]) (idx : borrowed inout mutable [u8]) (bx : borrowed inout mutable [u8]) (hist : borrowed inout mutable [u8]) : quant
  requires len rgb = 3 * len idx && len idx <= 4294967295
  requires len pal = 768 && len bx = 1536 && len hist = 1024
  ensures result.k <= maxc
  ensures forall (i in 0 .. len idx). idx.[i] < result.k
  ensures result.exact ==> (forall (i in 0 .. len idx). pix_is rgb pal i idx.[i])
= let e = exact rgb maxc pal idx in
  if e > 0 && check_exact rgb pal idx e then { k = e; exact = true }
  else (
    let n : int{0..4294967295} = len idx in
    let k = median_cut rgb n maxc pal idx bx hist in
    { k = k; exact = false })

(* The bits b of the smallest palette of 2^b colours, b from 1 to 8, that
   holds k. *)
let bits_for (k : int{1..256}) : int{1..8}
= if k <= 2 then 1 else if k <= 4 then 2 else if k <= 8 then 3 else if k <= 16 then 4
  else if k <= 32 then 5 else if k <= 64 then 6 else if k <= 128 then 7 else 8

(** Quantises the nf frames of rgb (each w * h * 3 bytes, one after
    another) to one shared palette of at most 256 colours, and writes them
    as an animated GIF with Pia.Image.Gif.Encode.encode_animation. idx gets
    the index rasters; the other buffers are scratch. *)
let encode_rgb_animation (w : int{1..65535}) (h : int{1..65535}) (rgb : [u8]) (nf : u16) (delay : u16) (loops : u16) (dst : borrowed inout mutable [u8]) (idx : borrowed inout mutable [u8]) (pal : borrowed inout mutable [u8]) (bx : borrowed inout mutable [u8]) (hist : borrowed inout mutable [u8]) (rect : borrowed inout mutable [u8]) (lz : borrowed inout mutable [u8]) (hash : borrowed inout mutable [u8]) : result usize rgb_error
  requires len rgb = 3 * len idx && len idx <= 4294967295
  requires len pal = 768 && len bx = 1536 && len hist = 1024
  requires len rect = R.size w h 1 && len lz = 3 * len rect + 5 && len hash = 40960
  ensures (match result with
    | Ok n -> n <= len dst && n <= 800 + X.anim_bound (X.frame_bound (R.size w h 1)) nf
              && (if G.header_ok dst then
                    G.blocks_ok dst (G.first_block dst) && G.frames_from dst (G.first_block dst) = nf
                    && G.u16le dst 6 = w && G.u16le dst 8 = h
                  else false)
    | Err _ -> true)
  ensures (match result with
    | Ok n -> true
    | Err e -> (match e with
      | RgbFull p -> len dst < 800 + X.anim_bound (X.frame_bound (R.size w h 1)) nf
      | _ -> true))
= let q = quantise rgb 256 pal idx bx hist in
  let b = bits_for q.k in
  let one : usize = 1 in
  let np : usize = 3 * (one << b) in
  let kk : usize = q.k in
  for j in 3 * kk .. np do pal.[j] <- 0 done;
  match X.encode_animation w h (pal.[0 .. np]) idx nf delay loops dst rect lz hash with
  | Ok n -> Ok n
  | Err e -> (match e with
      | DstFull p -> Err (RgbFull p)
      | BadPalette p -> Err (RgbFailed p)
      | IndexTooLarge p -> Err (RgbFailed p)
      | ShortFrames p -> Err (RgbFailed p)
      | NotParsed p -> Err (RgbFailed p))
