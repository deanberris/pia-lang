(* Pia.Math: floating-point functions written and proved in Pia (#487).

   `sqrt` is IEEE 754's square root, which the standard requires to be
   correctly rounded. Its body is an integer algorithm over the float's
   bits, proved to give the correctly rounded result, so no float axiom
   and no libm is involved. `@lower` gives it its machine form, MLIR's
   `math.sqrt`, one instruction (`fsqrt` on arm64, `sqrtss` on x86-64),
   and a call of it is a `pia_lib.call` whose rule is substituted at the
   call (ADR 0078). Until ADR 0065's refinement goal is built, the
   lowering is a trusted item in `--trust-report`; `sqrt_soft` is the
   same function without it, so a test can run both and compare them
   with C (tests/std/math_test.c).

   The contract is over the bits: a NaN in, or a negative number, gives a
   NaN; zeros and infinity are their own roots; and for a positive finite
   x the result is the float nearest its square root (`rounded32`,
   `rounded64`). The NaN's payload is not specified, since targets
   differ: arm64 gives 0x7fc00000 and x86-64 0xffc00000. `sqrt` and
   `sqrt_soft` are overloaded on f32 and f64, as C++'s std::sqrt is; the
   f64 contract is over unbounded integers, since its significand squared
   needs 106 bits. *)
@trusted

module Pia.Math : Sqrt

interface Sqrt = sig
  let spec mant32 : (b : u32) -> u64
  let spec ex32 : (b : u32) -> u32
  let spec sq : (x : u64) -> u64
  let spec shift32 : (b : u32) -> (r : u32) -> u64
  let spec rounded32 : (b : u32) -> (r : u32) -> bool
  let spec nan32 : (b : u32) -> bool
  let sqrt_soft : (x : f32) -> f32
    ensures to_bits x = 0 || to_bits x = 2147483648 || to_bits x = 2139095040
            ==> to_bits result = to_bits x
    ensures nan32 (to_bits x) || to_bits x > 2147483648 ==> nan32 (to_bits result)
    ensures 0 < to_bits x && to_bits x < 2139095040
            ==> rounded32 (to_bits x) (to_bits result)
  let sqrt : (x : f32) -> f32
    ensures to_bits x = 0 || to_bits x = 2147483648 || to_bits x = 2139095040
            ==> to_bits result = to_bits x
    ensures nan32 (to_bits x) || to_bits x > 2147483648 ==> nan32 (to_bits result)
    ensures 0 < to_bits x && to_bits x < 2139095040
            ==> rounded32 (to_bits x) (to_bits result)
  let spec mant64 : (b : u64) -> u64
  let spec ex64 : (b : u64) -> u64
  let spec sqi : (x : int) -> int
  let spec shift64 : (b : u64) -> (r : u64) -> u64
  let spec top64 : (b : u64) -> (r : u64) -> u64
  let spec rounded64 : (b : u64) -> (r : u64) -> bool
  let spec nan64 : (b : u64) -> bool
  let sqrt_soft : (x : f64) -> f64
    ensures to_bits x = 0 || to_bits x = 9223372036854775808 || to_bits x = 9218868437227405312
            ==> to_bits result = to_bits x
    ensures nan64 (to_bits x) || to_bits x > 9223372036854775808 ==> nan64 (to_bits result)
    ensures 0 < to_bits x && to_bits x < 9218868437227405312
            ==> rounded64 (to_bits x) (to_bits result)
  let sqrt : (x : f64) -> f64
    ensures to_bits x = 0 || to_bits x = 9223372036854775808 || to_bits x = 9218868437227405312
            ==> to_bits result = to_bits x
    ensures nan64 (to_bits x) || to_bits x > 9223372036854775808 ==> nan64 (to_bits result)
    ensures 0 < to_bits x && to_bits x < 9218868437227405312
            ==> rounded64 (to_bits x) (to_bits result)
end

(* The significand of a positive finite f32 with bits b, its implicit bit
   included, and its exponent field, 1 for a subnormal, so that b's value
   is mant32 b * 2^(ex32 b - 150). *)
let spec mant32 (b : u32) : u64 =
  if b >> 23 = 0 then b & 8388607 else (b & 8388607) + 8388608
let spec ex32 (b : u32) : u32 = if b >> 23 = 0 then 1 else b >> 23

(* x squared. It is opaque, so that a goal compares squares as values and
   the solver does not multiply 25-bit numbers; `squared` reveals it. *)
let spec sq (x : u64) : u64 @opaque
  requires x < 4294967296
= x * x

let lemma squared (x : u64) : unit
  requires x < 4294967296
  ensures sq x = x * x
  with sq
= ()

(* The shift that scales b's significand to units of half r's last place,
   squared: with it, b's value over r's last place squared, times four, is
   mant32 b << shift32 b r. *)
let spec shift32 (b : u32) (r : u32) : u64 =
  if ex32 b + 152 >= 2 * (r >> 23) then ex32 b + 152 - 2 * (r >> 23) else 64

(* r is the f32 nearest the square root of the positive finite f32 b: r is
   a positive normal float, and b, in units of half r's last place,
   squared, is between (2 m - 1)^2 and (2 m + 1)^2, where m is r's
   significand. So the root is within half a last place of r, which is what
   rounding to nearest means; a tie cannot happen, since the root of an
   even number of such units is never an odd one. Just above a power of
   two the float below is half as far away, so the lower bound there is a
   quarter of a last place, and (4 m - 1)^2 with m = 2^23 is
   1125899839733761. A sweep against C's sqrtf checks the statement itself
   (tests/std/math_test.c). *)
let spec rounded32 (b : u32) (r : u32) : bool =
  if r >> 23 >= 1 && r < 2139095040 && shift32 b r < 50 then
    if mant32 b <= 4611686018427387903 >> shift32 b r then
      (if mant32 r = 8388608 then 1125899839733761 <= 4 * (mant32 b << shift32 b r)
       else sq (2 * mant32 r - 1) <= mant32 b << shift32 b r) &&
      mant32 b << shift32 b r <= sq (2 * mant32 r + 1)
    else false
  else false

(* A NaN: every exponent bit set and a nonzero fraction. *)
let spec nan32 (b : u32) : bool = b & 2139095040 = 2139095040 && b & 8388607 <> 0
let spec nan64 (b : u64) : bool =
  b & 9218868437227405312 = 9218868437227405312 && b & 4503599627370495 <> 0

(* The significand of the root, in half units: n is in [2^48, 2^50), and the
   result r has (2 r - 1)^2 <= n <= (2 r + 1)^2. The integer root lo, with
   lo^2 <= n < (lo + 1)^2, is found by bisection, and r is lo rounded up to
   even, halved. n is short of (2^25 - 1)^2, so r is short of 2^24 and the
   result needs no carry into the exponent. The bounds stay contracts, as
   in sqrt_pos32: in a range type every product and shift in the body would
   be typed by the range. *)
let root32 (n : u64) : u64 @allow(range_requires, range_ensures)
  requires n >= 281474976710656 && n <= 1125899839733760
  ensures 8388608 <= result && result < 16777216
  ensures sq (2 * result - 1) <= n
  ensures result = 8388608 ==> 1125899839733761 <= 4 * n
  ensures n <= sq (2 * result + 1)
= let lo : mutable u64 = 16777216 in
  let hi : mutable u64 = 33554432 in
  while hi - lo > 1
    invariant 16777216 <= lo && lo < hi && hi <= 33554432
    invariant lo * lo <= n && n < hi * hi
    decreases hi - lo
  do
    let mid = lo + (hi - lo) / 2 in
    let msq = mid * mid in
    if msq <= n then lo <- mid else hi <- mid
  done;
  assert n < (lo + 1) * (lo + 1);
  let r = (lo + 1) / 2 in
  assert 2 * r = lo || 2 * r = lo + 1;
  squared (2 * r - 1);
  squared (2 * r + 1);
  r

(* The root of a positive finite f32's bits. Its significand m is shifted
   left by d, which has the parity of its exponent so that the root's
   exponent is whole, until n = m << d is in [2^48, 2^50); a subnormal
   shifts further. The root's exponent field is then (e + 152 - d) / 2. *)
let sqrt_pos32 (b : u32) : u32 @allow(range_requires)
  requires 0 < b && b < 2139095040
  ensures rounded32 b result
= let m : u64 = if b >> 23 = 0 then b & 8388607 else (b & 8388607) + 8388608 in
  let e : u32 = if b >> 23 = 0 then 1 else b >> 23 in
  let d : mutable u64 = if e % 2 = 0 then 26 else 25 in
  let n : mutable u64 = m << d in
  while n < 281474976710656
    invariant 25 <= d && d < 50 && d % 2 = e % 2
    invariant n = m << d && n < 1125899906842624
    decreases 50 - d
  do
    n <- n * 4;
    d <- d + 2
  done;
  let s = root32 n in
  let ey : u32 = (e + 152 - d) / 2 in
  let w : u32 = ((ey << 23) | (s - 8388608)) in
  w

(* IEEE 754 square root of an f32, rounded to nearest, in Pia. Both
   definitions take the interface's contract (ADR 0077). *)
let sqrt_soft (x : f32) : f32
= let b = to_bits x in
  if b = 0 || b = 2147483648 || b = 2139095040 then x
  else if b > 2139095040 then from_bits 2143289344
  else from_bits (sqrt_pos32 b)

(* The same function, compiled to the hardware instruction. *)
let sqrt (x : f32) : f32
  @lower("$result = math.sqrt $x : f32")
= sqrt_soft x

let spec mant64 (b : u64) : u64 =
  if b >> 52 = 0 then b & 4503599627370495 else (b & 4503599627370495) + 4503599627370496
let spec ex64 (b : u64) : u64 = if b >> 52 = 0 then 1 else b >> 52

(* x squared over unbounded integers, since an f64's significand squared
   needs 106 bits. It is opaque, as `sq` is, and the lemmas below reveal
   it. *)
let spec sqi (x : int) : int @opaque = x * x

let lemma sq_steps (x : int) : unit
  ensures sqi (2 * x) = 4 * sqi x
  ensures sqi (2 * x + 1) = 4 * sqi x + 4 * x + 1
  ensures sqi (x + 1) = sqi x + 2 * x + 1
  with sqi
= ()

let lemma sq_is (x : u64) : unit
  requires x < 4294967296
  ensures sqi (int x) = int (x * x)
  with sqi
= ()

(* m * 4^i, opaque so that loop goals see it as one value. *)
let spec scaled (m : int) (i : u64) : int @opaque
  requires i <= 27
= m * int (1 << (2 * i))

let lemma scaled_step (m : int) (i : u64) : unit
  requires i < 27
  ensures scaled m (i + 1) = 4 * scaled m i
  with scaled
= ()

let lemma scaled_ends (m : int) : unit
  ensures scaled m 0 = m
  ensures scaled m 27 = m * 18014398509481984
  with scaled
= ()

let lemma scaled_le (m : int) (i : u64) : unit
  requires 0 <= m && m < 18014398509481984 && i <= 27
  ensures scaled m i < 324518553658426726783156020576256
  with scaled
= ()

(* Bounds on a root, from bounds on its square. *)
let lemma root_low (x : int) : unit
  requires 0 <= x && 81129638414606681695789005144064 < sqi (x + 1)
  ensures x >= 9007199254740992
  with sqi
= ()

let lemma root_top (x : int) : unit
  requires 0 <= x && sqi x <= 324518553658426690754359001612288
  ensures x <= 18014398509481982
  with sqi
= ()

let lemma root_bound (x : int) : unit
  requires 0 <= x && sqi x < 324518553658426726783156020576256
  ensures x < 18014398509481984
  with sqi
= ()

(* The shift that scales b's significand to units of half r's last place,
   squared. *)
let spec shift64 (b : u64) (r : u64) : u64 =
  if ex64 b + 1077 >= 2 * (r >> 52) then ex64 b + 1077 - 2 * (r >> 52) else 0

(* b's significand in those units, over 2^54: it fits in 64 bits. *)
let spec top64 (b : u64) (r : u64) : u64 =
  if shift64 b r >= 54 && shift64 b r < 118 then
    if mant64 b <= 18446744073709551615 >> (shift64 b r - 54) then
      mant64 b << (shift64 b r - 54)
    else 0
  else 0

(* rounded32 for f64: r is the f64 nearest the square root of the positive
   finite f64 b. The quarter-ulp bound at a power of two is (4 m - 1)^2
   with m = 2^52. *)
let spec rounded64 (b : u64) (r : u64) : bool =
  if r >> 52 >= 1 && r < 9218868437227405312 && shift64 b r >= 54 && shift64 b r < 118 then
    if mant64 b <= 18446744073709551615 >> (shift64 b r - 54) then
      (if mant64 r = 4503599627370496
       then 324518553658426690754359001612289 <= 4 * (int (top64 b r) * 18014398509481984)
       else sqi (2 * int (mant64 r) - 1) <= int (top64 b r) * 18014398509481984) &&
      int (top64 b r) * 18014398509481984 <= sqi (2 * int (mant64 r) + 1)
    else false
  else false

(* The integer root of m < 2^54, by bisection, with what is left over at
   most twice the root. *)
let root27 (m : u64) : u64
  requires m >= 4503599627370496 && m < 18014398509481984
  ensures result >= 67108864 && result < 134217728
  ensures result * result <= m && m - result * result <= 2 * result
= let lo : mutable u64 = 67108864 in
  let hi : mutable u64 = 134217728 in
  while hi - lo > 1
    invariant 67108864 <= lo && lo < hi && hi <= 134217728
    invariant lo * lo <= m && m < hi * hi
    decreases hi - lo
  do
    let mid = lo + (hi - lo) / 2 in
    let msq = mid * mid in
    if msq <= m then lo <- mid else hi <- mid
  done;
  assert m < (lo + 1) * (lo + 1);
  lo

(* One step of the digit-by-digit root: with the digit 1 or the digit 0,
   what is left plus the root squared is four times what it was. *)
let lemma digit (left : int) (r : int) (total : int) (up : bool) (nl : int) (nr : int) : unit
  requires left + sqi r = total
  requires up ==> nl = 4 * left - 4 * r - 1 && nr = 2 * r + 1
  requires up = false ==> nl = 4 * left && nr = 2 * r
  ensures nl + sqi nr = 4 * total
  with sqi
= ()

(* From the root of m, the root of m * 4^27, two bits at a time: the bits
   below m's are zeros, and what is left over stays below 2^56. *)
let extend (m : u64) (r0 : u64) : u64
  requires m >= 4503599627370496 && m < 18014398509481984
  requires r0 < 134217728 && r0 * r0 <= m && m - r0 * r0 <= 2 * r0
  ensures 9007199254740992 <= result && result < 18014398509481984
  ensures sqi (int result) <= int m * 18014398509481984
  ensures int m * 18014398509481984 < sqi (int result + 1)
= let r : mutable u64 = r0 in
  let left : mutable u64 = m - r0 * r0 in
  sq_is r0;
  scaled_ends (int m);
  for i in 0 .. 27
    invariant left <= 2 * r
    invariant int left + sqi (int r) = scaled (int m) i
  do
    sq_steps (int r);
    scaled_step (int m) i;
    scaled_le (int m) i;
    root_bound (int r);
    let t = 4 * r + 1 in
    let w = 4 * left in
    let up = w >= t in
    let nl : u64 = if up then w - t else w in
    let nr : u64 = if up then 2 * r + 1 else 2 * r in
    assert int w = 4 * int left && int t = 4 * int r + 1;
    assert int (2 * r + 1) = 2 * int r + 1 && int (2 * r) = 2 * int r;
    assert up ==> nl = w - t && int (w - t) = int w - int t && nr = 2 * r + 1;
    assert up = false ==> nl = w && nr = 2 * r;
    assert up ==> int nl = 4 * int left - 4 * int r - 1 && int nr = 2 * int r + 1;
    assert up = false ==> int nl = 4 * int left && int nr = 2 * int r;
    digit (int left) (int r) (scaled (int m) i) up (int nl) (int nr);
    left <- nl;
    r <- nr
  done;
  sq_steps (int r);
  root_bound (int r);
  root_low (int r);
  r

(* s = (r + 1) / 2 as integers. *)
let lemma halves (r : u64) (s : u64) : unit
  requires r < 18014398509481984 && (2 * s = r || 2 * s = r + 1)
  ensures 2 * int s = int r || 2 * int s = int r + 1
= ()

(* r rounded to the nearest unit of two. *)
let lemma rounding (n : int) (r : int) (s : int) : unit
  requires r >= 9007199254740992 && sqi r <= n && n < sqi (r + 1)
  requires 2 * s = r || 2 * s = r + 1
  ensures sqi (2 * s - 1) <= n
  ensures n <= sqi (2 * s + 1)
  ensures s = 4503599627370496 ==> 324518553658426690754359001612289 <= 4 * n
  with sqi
= ()

(* The root of a positive finite f64's bits, as sqrt_pos32: m is shifted
   left by d - 54, d of the other parity than the exponent field, since
   the bias, 1075, is odd, until it is in [2^52, 2^54); its root to 27
   bits is extended by 27 more, digit by digit, to the root of
   m << d, and rounded. The asserts lead the solver through the bits of
   the result; each is cheap where their conjunction is not. *)
let sqrt_pos64 (b : u64) : u64
  requires 0 < b && b < 9218868437227405312
  ensures rounded64 b result
= let m : u64 = if b >> 52 = 0 then b & 4503599627370495 else (b & 4503599627370495) + 4503599627370496 in
  let e : u64 = if b >> 52 = 0 then 1 else b >> 52 in
  let d : mutable u64 = if e % 2 = 0 then 55 else 54 in
  let big : mutable u64 = m << (d - 54) in
  while big < 4503599627370496
    invariant 54 <= d && d < 108 && (d + e) % 2 = 1
    invariant big = m << (d - 54) && big < 18014398509481984
    invariant big % 2 = 0 || big < 9007199254740992
    decreases 108 - d
  do
    big <- big * 4;
    d <- d + 2
  done;
  let r = extend big (root27 big) in
  let s = (r + 1) / 2 in
  assert big <= 18014398509481982;
  assert int big * 18014398509481984 <= 324518553658426690754359001612288;
  root_top (int r);
  assert r <= 18014398509481982;
  assert 2 * s = r || 2 * s = r + 1;
  assert int r >= 9007199254740992;
  assert sqi (int r) <= int big * 18014398509481984;
  assert int big * 18014398509481984 < sqi (int r + 1);
  halves r s;
  rounding (int big * 18014398509481984) (int r) (int s);
  let ey : u64 = (e + 1077 - d) / 2 in
  let w : u64 = ((ey << 52) | (s - 4503599627370496)) in
  assert s >= 4503599627370496 && s < 9007199254740992;
  assert ey >= 1 && ey < 2047;
  assert w >> 52 = ey;
  assert mant64 w = s;
  assert shift64 b w = d;
  assert top64 b w = big;
  assert w >> 52 >= 1 && w < 9218868437227405312;
  assert shift64 b w >= 54 && shift64 b w < 118;
  assert mant64 b <= 18446744073709551615 >> (shift64 b w - 54);
  assert int (top64 b w) = int big && int (mant64 w) = int s;
  assert mant64 w = 4503599627370496 ==>
         324518553658426690754359001612289 <= 4 * (int (top64 b w) * 18014398509481984);
  assert mant64 w <> 4503599627370496 ==>
         sqi (2 * int (mant64 w) - 1) <= int (top64 b w) * 18014398509481984;
  assert int (top64 b w) * 18014398509481984 <= sqi (2 * int (mant64 w) + 1);
  w

(* IEEE 754 square root of an f64, rounded to nearest, in Pia. *)
let sqrt_soft (x : f64) : f64
= let b = to_bits x in
  if b = 0 || b = 9223372036854775808 || b = 9218868437227405312 then x
  else if b > 9218868437227405312 then from_bits 9221120237041090560
  else from_bits (sqrt_pos64 b)

let sqrt (x : f64) : f64
  @lower("$result = math.sqrt $x : f64")
= sqrt_soft x
