load("//tools/piac:pia.bzl", "pia_library")
load("//tools/piac:targets.bzl", "PIA_TARGETS")

# Pia.Core: the parts of the C++23 standard library that need no allocation
# (ADR 0040, docs/cpp-std.md). Each module is proved and compiled on its own,
# and importers build against its interface artifacts.

package(default_visibility = ["//visibility:public"])

# Its tests read the source, to prove it and to write its interfaces.
exports_files([
    "Ascii.pia",
    "Bit.pia",
    "Int.pia",
    "Option.pia",
    "Order.pia",
    "Result.pia",
    "Utf8.pia",
])

# <bit>: tests/std/bit.pia checks its goals; tests/std/bit_edges.pia and
# :bit_run test it through its interface.
pia_library(
    name = "bit",
    src = "Bit.pia",
    target_compatible_with = PIA_TARGETS,
)

# <numeric>'s gcd and midpoint, <cstdlib>'s abs and div, and C++26's
# saturating arithmetic: tests/std/int.pia checks its goals;
# tests/std/int_edges.pia and :int_run test it through its interface.
pia_library(
    name = "int",
    src = "Int.pia",
    target_compatible_with = PIA_TARGETS,
)

# <compare>, the comparison concepts, swap and exchange, and min, max,
# clamp and lexicographical_compare: tests/std/order.pia checks its goals;
# tests/std/order_edges.pia and :order_run test it through its interface.
pia_library(
    name = "order",
    src = "Order.pia",
    target_compatible_with = PIA_TARGETS,
)

# <optional>, exported as a generic type and generic functions:
# tests/std/option.pia checks its goals; tests/std/option_edges.pia tests it
# through its interface.
pia_library(
    name = "option",
    src = "Option.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [":order"],
)

# <expected> on the language's result type: tests/std/result.pia checks its
# goals; tests/std/result_edges.pia and :result_run test it through its
# interface.
pia_library(
    name = "result",
    src = "Result.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [":order"],
)

# <cctype> for ASCII bytes: tests/std/ascii.pia checks its goals;
# tests/std/ascii_edges.pia and :ascii_run test it through its interface.
pia_library(
    name = "ascii",
    src = "Ascii.pia",
    target_compatible_with = PIA_TARGETS,
)

# UTF-8: sequence_length, decode, encode and valid, with both round trips
# proved: tests/std/utf8.pia checks its goals; tests/std/utf8_edges.pia
# and :utf8_run test it through its interface.
pia_library(
    name = "utf8",
    src = "Utf8.pia",
    target_compatible_with = PIA_TARGETS,
)
