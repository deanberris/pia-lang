(* Pia.Core.Order: C++'s <compare>, the comparison concepts of
   <concepts>, <utility>'s swap and exchange, and <algorithm>'s min, max,
   clamp and lexicographical_compare (ADR 0040, docs/cpp-std.md).

   The concepts Eq and Ord, with their laws, and the generic functions
   over them are defined and proved here. Interfaces cannot list concepts
   or generic functions yet (ADR 0039, step 3), so what other modules can
   import is the instances for each integer type, stamped out by the
   metaprograms below from the generic functions, and each proved:

   - Eq: `same`, reflexive, symmetric and transitive.
   - Ord: Eq and `less`, a strict weak order: irreflexive, transitive,
     with incomparability transitive, and `less a b` never `same a b`.
     `less` is asymmetric by contract, which is what generic code can use
     (laws are proved for each type but are not facts in generic bodies).
   - compare, the three-way comparison, giving an `ordering`.
   - min, max and clamp, with C++'s ties: min and max return the first
     argument when the two are equivalent, and clamp requires lo not after
     hi.
   - swap and exchange of a slice's elements: Pia has no references to
     scalars, so C++'s swap a b is swap of xs.[i] and xs.[j].
   - lexicographical_compare and lexicographical_compare_three_way,
     defined by the spec function `lex_from`, exported for u8. *)
module Pia.Core.Order : Ops, Compare

interface Ops = sig
  (** Eq: equality of integers. *)
  let same : (a : u8) -> (b : u8) -> bool
    ensures result <==> a = b
  (** Ord: the order of integers, a strict weak order. *)
  let less : (a : u8) -> (b : u8) -> bool
    ensures result <==> a < b
  (** C++: std::min. a when the two are equal. *)
  let min : (a : u8) -> (b : u8) -> u8
    ensures b < a ==> result = b
    ensures b >= a ==> result = a
  (** C++: std::max. a when the two are equal. *)
  let max : (a : u8) -> (b : u8) -> u8
    ensures a < b ==> result = b
    ensures a >= b ==> result = a
  (** C++: std::clamp. *)
  let clamp : (v : u8) -> (lo : u8) -> (hi : u8) -> u8
    requires lo <= hi
    ensures v < lo ==> result = lo
    ensures hi < v ==> result = hi
    ensures lo <= v && v <= hi ==> result = v
  (** C++: std::swap, of two elements. The definition ensures they are
      exchanged and nothing else changes; an interface cannot state the
      postcondition of a function with inout parameters yet. *)
  let swap : (xs : borrowed inout mutable [u8]) -> (i : usize) -> (j : usize) -> unit
    requires i < len xs && j < len xs
  (** C++: std::exchange: xs.[i] becomes v, and its old value is returned.
      The postcondition is the definition's, as for swap. *)
  let exchange : (xs : borrowed inout mutable [u8]) -> (i : usize) -> (v : u8) -> u8
    requires i < len xs
  (** C++: std::lexicographical_compare. Its exact definition is the spec function lex_from, which interfaces cannot list yet. *)
  let lexicographical_compare : (xs : [u8]) -> (ys : [u8]) -> bool
    ensures len xs = 0 ==> (result <==> len ys > 0)
    ensures len ys = 0 ==> result = false
  (** Eq: equality of integers. *)
  let same : (a : u16) -> (b : u16) -> bool
    ensures result <==> a = b
  (** Ord: the order of integers, a strict weak order. *)
  let less : (a : u16) -> (b : u16) -> bool
    ensures result <==> a < b
  (** C++: std::min. a when the two are equal. *)
  let min : (a : u16) -> (b : u16) -> u16
    ensures b < a ==> result = b
    ensures b >= a ==> result = a
  (** C++: std::max. a when the two are equal. *)
  let max : (a : u16) -> (b : u16) -> u16
    ensures a < b ==> result = b
    ensures a >= b ==> result = a
  (** C++: std::clamp. *)
  let clamp : (v : u16) -> (lo : u16) -> (hi : u16) -> u16
    requires lo <= hi
    ensures v < lo ==> result = lo
    ensures hi < v ==> result = hi
    ensures lo <= v && v <= hi ==> result = v
  (** C++: std::swap, of two elements. The definition ensures they are
      exchanged and nothing else changes; an interface cannot state the
      postcondition of a function with inout parameters yet. *)
  let swap : (xs : borrowed inout mutable [u16]) -> (i : usize) -> (j : usize) -> unit
    requires i < len xs && j < len xs
  (** C++: std::exchange: xs.[i] becomes v, and its old value is returned.
      The postcondition is the definition's, as for swap. *)
  let exchange : (xs : borrowed inout mutable [u16]) -> (i : usize) -> (v : u16) -> u16
    requires i < len xs
  (** Eq: equality of integers. *)
  let same : (a : u32) -> (b : u32) -> bool
    ensures result <==> a = b
  (** Ord: the order of integers, a strict weak order. *)
  let less : (a : u32) -> (b : u32) -> bool
    ensures result <==> a < b
  (** C++: std::min. a when the two are equal. *)
  let min : (a : u32) -> (b : u32) -> u32
    ensures b < a ==> result = b
    ensures b >= a ==> result = a
  (** C++: std::max. a when the two are equal. *)
  let max : (a : u32) -> (b : u32) -> u32
    ensures a < b ==> result = b
    ensures a >= b ==> result = a
  (** C++: std::clamp. *)
  let clamp : (v : u32) -> (lo : u32) -> (hi : u32) -> u32
    requires lo <= hi
    ensures v < lo ==> result = lo
    ensures hi < v ==> result = hi
    ensures lo <= v && v <= hi ==> result = v
  (** C++: std::swap, of two elements. The definition ensures they are
      exchanged and nothing else changes; an interface cannot state the
      postcondition of a function with inout parameters yet. *)
  let swap : (xs : borrowed inout mutable [u32]) -> (i : usize) -> (j : usize) -> unit
    requires i < len xs && j < len xs
  (** C++: std::exchange: xs.[i] becomes v, and its old value is returned.
      The postcondition is the definition's, as for swap. *)
  let exchange : (xs : borrowed inout mutable [u32]) -> (i : usize) -> (v : u32) -> u32
    requires i < len xs
  (** Eq: equality of integers. *)
  let same : (a : u64) -> (b : u64) -> bool
    ensures result <==> a = b
  (** Ord: the order of integers, a strict weak order. *)
  let less : (a : u64) -> (b : u64) -> bool
    ensures result <==> a < b
  (** C++: std::min. a when the two are equal. *)
  let min : (a : u64) -> (b : u64) -> u64
    ensures b < a ==> result = b
    ensures b >= a ==> result = a
  (** C++: std::max. a when the two are equal. *)
  let max : (a : u64) -> (b : u64) -> u64
    ensures a < b ==> result = b
    ensures a >= b ==> result = a
  (** C++: std::clamp. *)
  let clamp : (v : u64) -> (lo : u64) -> (hi : u64) -> u64
    requires lo <= hi
    ensures v < lo ==> result = lo
    ensures hi < v ==> result = hi
    ensures lo <= v && v <= hi ==> result = v
  (** C++: std::swap, of two elements. The definition ensures they are
      exchanged and nothing else changes; an interface cannot state the
      postcondition of a function with inout parameters yet. *)
  let swap : (xs : borrowed inout mutable [u64]) -> (i : usize) -> (j : usize) -> unit
    requires i < len xs && j < len xs
  (** C++: std::exchange: xs.[i] becomes v, and its old value is returned.
      The postcondition is the definition's, as for swap. *)
  let exchange : (xs : borrowed inout mutable [u64]) -> (i : usize) -> (v : u64) -> u64
    requires i < len xs
  (** Eq: equality of integers. *)
  let same : (a : i8) -> (b : i8) -> bool
    ensures result <==> a = b
  (** Ord: the order of integers, a strict weak order. *)
  let less : (a : i8) -> (b : i8) -> bool
    ensures result <==> a < b
  (** C++: std::min. a when the two are equal. *)
  let min : (a : i8) -> (b : i8) -> i8
    ensures b < a ==> result = b
    ensures b >= a ==> result = a
  (** C++: std::max. a when the two are equal. *)
  let max : (a : i8) -> (b : i8) -> i8
    ensures a < b ==> result = b
    ensures a >= b ==> result = a
  (** C++: std::clamp. *)
  let clamp : (v : i8) -> (lo : i8) -> (hi : i8) -> i8
    requires lo <= hi
    ensures v < lo ==> result = lo
    ensures hi < v ==> result = hi
    ensures lo <= v && v <= hi ==> result = v
  (** C++: std::swap, of two elements. The definition ensures they are
      exchanged and nothing else changes; an interface cannot state the
      postcondition of a function with inout parameters yet. *)
  let swap : (xs : borrowed inout mutable [i8]) -> (i : usize) -> (j : usize) -> unit
    requires i < len xs && j < len xs
  (** C++: std::exchange: xs.[i] becomes v, and its old value is returned.
      The postcondition is the definition's, as for swap. *)
  let exchange : (xs : borrowed inout mutable [i8]) -> (i : usize) -> (v : i8) -> i8
    requires i < len xs
  (** Eq: equality of integers. *)
  let same : (a : i16) -> (b : i16) -> bool
    ensures result <==> a = b
  (** Ord: the order of integers, a strict weak order. *)
  let less : (a : i16) -> (b : i16) -> bool
    ensures result <==> a < b
  (** C++: std::min. a when the two are equal. *)
  let min : (a : i16) -> (b : i16) -> i16
    ensures b < a ==> result = b
    ensures b >= a ==> result = a
  (** C++: std::max. a when the two are equal. *)
  let max : (a : i16) -> (b : i16) -> i16
    ensures a < b ==> result = b
    ensures a >= b ==> result = a
  (** C++: std::clamp. *)
  let clamp : (v : i16) -> (lo : i16) -> (hi : i16) -> i16
    requires lo <= hi
    ensures v < lo ==> result = lo
    ensures hi < v ==> result = hi
    ensures lo <= v && v <= hi ==> result = v
  (** C++: std::swap, of two elements. The definition ensures they are
      exchanged and nothing else changes; an interface cannot state the
