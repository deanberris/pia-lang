  (** C++: std::swap, of two elements. The definition ensures they are
      exchanged and nothing else changes; an interface cannot state the
      postcondition of a function with inout parameters yet. *)
  let swap : (xs : borrowed inout mutable [i64]) -> (i : usize) -> (j : usize) -> unit
    requires i < len xs && j < len xs
  (** C++: std::exchange: xs.[i] becomes v, and its old value is returned.
      The postcondition is the definition's, as for swap. *)
  let exchange : (xs : borrowed inout mutable [i64]) -> (i : usize) -> (v : i64) -> i64
    requires i < len xs
  (** Eq: equality of booleans. *)
  let same : (a : bool) -> (b : bool) -> bool
    ensures result <==> a = b
  (** Ord: false before true. *)
  let less : (a : bool) -> (b : bool) -> bool
    ensures result <==> a = false && b
end

interface Compare = sig
  (** C++: std::strong_ordering. *)
  let ordering = type | Less | Equal | Greater
  (** C++: operator<=>, the three-way comparison. *)
  let compare : (a : u8) -> (b : u8) -> ordering
    ensures result = Less <==> a < b
    ensures result = Equal <==> a = b
    ensures result = Greater <==> b < a
  (** C++: std::lexicographical_compare_three_way. *)
  let lexicographical_compare_three_way : (xs : [u8]) -> (ys : [u8]) -> ordering
    ensures len xs = 0 && len ys = 0 ==> result = Equal
  (** C++: operator<=>, the three-way comparison. *)
  let compare : (a : u16) -> (b : u16) -> ordering
    ensures result = Less <==> a < b
    ensures result = Equal <==> a = b
    ensures result = Greater <==> b < a
  (** C++: operator<=>, the three-way comparison. *)
  let compare : (a : u32) -> (b : u32) -> ordering
    ensures result = Less <==> a < b
    ensures result = Equal <==> a = b
    ensures result = Greater <==> b < a
  (** C++: operator<=>, the three-way comparison. *)
  let compare : (a : u64) -> (b : u64) -> ordering
    ensures result = Less <==> a < b
    ensures result = Equal <==> a = b
    ensures result = Greater <==> b < a
  (** C++: operator<=>, the three-way comparison. *)
  let compare : (a : i8) -> (b : i8) -> ordering
    ensures result = Less <==> a < b
    ensures result = Equal <==> a = b
    ensures result = Greater <==> b < a
  (** C++: operator<=>, the three-way comparison. *)
  let compare : (a : i16) -> (b : i16) -> ordering
    ensures result = Less <==> a < b
    ensures result = Equal <==> a = b
    ensures result = Greater <==> b < a
  (** C++: operator<=>, the three-way comparison. *)
  let compare : (a : i32) -> (b : i32) -> ordering
    ensures result = Less <==> a < b
    ensures result = Equal <==> a = b
    ensures result = Greater <==> b < a
  (** C++: operator<=>, the three-way comparison. *)
  let compare : (a : i64) -> (b : i64) -> ordering
    ensures result = Less <==> a < b
    ensures result = Equal <==> a = b
    ensures result = Greater <==> b < a
end

(** C++: std::equality_comparable, with equality an equivalence. *)
let meta Eq (t : type) : concept = sig
  let same : (a : t) -> (b : t) -> bool
  let lemma reflexive (a : t) ensures same a a
  let lemma symmetric (a : t) (b : t) requires same a b ensures same b a
  let lemma transitive (a : t) (b : t) (c : t)
    requires same a b && same b c
    ensures same a c
end

(** C++: std::strict_weak_order over std::totally_ordered's operator<. *)
let meta Ord (t : type) : concept = sig
  include Eq t
  let less : (a : t) -> (b : t) -> bool
    ensures result ==> less b a = false
  let lemma irreflexive (a : t) ensures less a a = false
  let lemma less_transitive (a : t) (b : t) (c : t)
    requires less a b && less b c
    ensures less a c
  let lemma incomparable_transitive (a : t) (b : t) (c : t)
    requires less a b = false && less b a = false && less b c = false && less c b = false
    ensures less a c = false && less c a = false
  let lemma distinct (a : t) (b : t) requires less a b ensures same a b = false
end

(** C++: std::strong_ordering. *)
let ordering = type | Less | Equal | Greater

(* The generic functions, over any Ord t. *)

let compare (t : type where Ord t) (a : t) (b : t) : ordering
  ensures result = Less <==> less a b
  ensures result = Greater <==> less b a
= if less a b then Less else if less b a then Greater else Equal

let min (t : type where Ord t) (a : t) (b : t) : t
  ensures result = (if less b a then b else a)
= if less b a then b else a

let max (t : type where Ord t) (a : t) (b : t) : t
  ensures result = (if less a b then b else a)
= if less a b then b else a

let clamp (t : type where Ord t) (v : t) (lo : t) (hi : t) : t
  requires less hi lo = false
  ensures result = (if less v lo then lo else if less hi v then hi else v)
= if less v lo then lo else if less hi v then hi else v

let swap (t : type) (xs : borrowed inout mutable [t]) (i : usize) (j : usize) : unit
  requires i < len xs && j < len xs
  ensures xs.[i] = old (xs.[j]) && xs.[j] = old (xs.[i])
  ensures forall (k in 0..len xs). k <> i && k <> j ==> xs.[k] = old (xs.[k])
= let a = xs.[i] in
  let b = xs.[j] in
  xs.[i] <- b;
  xs.[j] <- a

let exchange (t : type) (xs : borrowed inout mutable [t]) (i : usize) (v : t) : t
  requires i < len xs
  ensures result = old (xs.[i]) && xs.[i] = v
  ensures forall (k in 0..len xs). k <> i ==> xs.[k] = old (xs.[k])
= let a = xs.[i] in
  xs.[i] <- v;
  a

(* xs before ys in C++'s lexicographical order, comparing from index i:
   the first comparable pair decides, and a proper prefix comes first. *)
let spec lex_from (t : type where Ord t) (xs : [t]) (ys : [t]) (i : usize) : bool
  requires i <= len xs && i <= len ys
  decreases len xs - i
= if i = len xs then i < len ys
  else if i = len ys then false
  else if less xs.[i] ys.[i] then true
  else if less ys.[i] xs.[i] then false
  else lex_from xs ys (i + 1)

let lex_compare (t : type where Ord t) (xs : [t]) (ys : [t]) : bool
  ensures result = lex_from xs ys 0
= let n : usize = if len xs < len ys then len xs else len ys in
  let i : mutable usize = 0 in
  while i < n && less xs.[i] ys.[i] = false && less ys.[i] xs.[i] = false
    invariant i <= n
    invariant lex_from xs ys 0 = lex_from xs ys i
    decreases n - i
  do i <- i + 1 done;
  if i < n then less xs.[i] ys.[i] else len xs < len ys

let lex_compare_three_way (t : type where Ord t) (xs : [t]) (ys : [t]) : ordering
  ensures result = Less <==> lex_from xs ys 0
  ensures result = Greater ==> lex_from ys xs 0
  ensures result = Equal ==> lex_from xs ys 0 = false && lex_from ys xs 0 = false
= if lex_compare<t> xs ys then Less
  else if lex_compare<t> ys xs then Greater
  else Equal

(* The instances for the integer type `t`. *)
let meta order_family (t : string) : item =
  `( let same ($!a : $t) ($!b : $t) : bool
       ensures $!result <==> $!a = $!b
     = ($!a = $!b)

     let less ($!a : $t) ($!b : $t) : bool
       ensures $!result <==> $!a < $!b
     = ($!a < $!b)

     let compare ($!a : $t) ($!b : $t) : ordering
       ensures $!result = Less <==> $!a < $!b
       ensures $!result = Equal <==> $!a = $!b
       ensures $!result = Greater <==> $!b < $!a
     = compare<$t> $!a $!b

     let min ($!a : $t) ($!b : $t) : $t
       ensures $!b < $!a ==> $!result = $!b
       ensures $!b >= $!a ==> $!result = $!a
     = min<$t> $!a $!b

     let max ($!a : $t) ($!b : $t) : $t
       ensures $!a < $!b ==> $!result = $!b
       ensures $!a >= $!b ==> $!result = $!a
     = max<$t> $!a $!b

     let clamp ($!v : $t) ($!lo : $t) ($!hi : $t) : $t
       requires $!lo <= $!hi
       ensures $!v < $!lo ==> $!result = $!lo
       ensures $!hi < $!v ==> $!result = $!hi
       ensures $!lo <= $!v && $!v <= $!hi ==> $!result = $!v
     = clamp<$t> $!v $!lo $!hi

     let swap ($!xs : borrowed inout mutable [$t]) ($!i : usize) ($!j : usize) : unit
       requires $!i < len $!xs && $!j < len $!xs
       ensures $!xs.[$!i] = old ($!xs.[$!j]) && $!xs.[$!j] = old ($!xs.[$!i])
     = swap<$t> $!xs $!i $!j

     let exchange ($!xs : borrowed inout mutable [$t]) ($!i : usize) ($!v : $t) : $t
       requires $!i < len $!xs
       ensures $!result = old ($!xs.[$!i]) && $!xs.[$!i] = $!v
     = exchange<$t> $!xs $!i $!v
 )

order_family "u8"
order_family "u16"
order_family "u32"
order_family "u64"
order_family "i8"
order_family "i16"
order_family "i32"
order_family "i64"

(* lexicographical_compare is exported for u8 only, memcmp's role and what
   C++ code mostly compares contiguous scalars with: each instance of the
   generic is proved again, at about 9M a type (docs/cpp-std.md). The
   generics have names of their own, lex_compare and
   lex_compare_three_way: a name that also had a generic overload would
   give the one exported function a link symbol with its parameter types,
   which importers, seeing one function, do not use. *)
(** C++: std::lexicographical_compare. *)
let lexicographical_compare (xs : [u8]) (ys : [u8]) : bool
  ensures len xs = 0 ==> (result <==> len ys > 0)
  ensures len ys = 0 ==> result = false
= lex_compare<u8> xs ys

(** C++: std::lexicographical_compare_three_way. *)
let lexicographical_compare_three_way (xs : [u8]) (ys : [u8]) : ordering
  ensures len xs = 0 && len ys = 0 ==> result = Equal
= lex_compare_three_way<u8> xs ys

(** Eq: equality of booleans. *)
let same (a : bool) (b : bool) : bool
  ensures result <==> a = b
= (a = b)

(** Ord: false before true. *)
let less (a : bool) (b : bool) : bool
  ensures result <==> a = false && b
= (a = false && b)

(* bool meets Ord too; its laws are proved where it is used with it. *)
let bool_min (a : bool) (b : bool) : bool
  ensures result = (a && b)
= min<bool> a b
