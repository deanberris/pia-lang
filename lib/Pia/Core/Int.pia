(* Pia.Core.Int: C++'s integer utilities (ADR 0040, docs/cpp-std.md):
   <numeric>'s gcd and midpoint, <cstdlib>'s abs and div, and C++26's
   saturating arithmetic, for u8 to u64 and i8 to i64. Each contract
   states the C++ meaning exactly. Where C++ leaves a case undefined, Pia
   either rules it out with a `requires` (div, div_sat's divisor) or gives
   the result an unsigned type wide enough to hold it (abs and gcd of the
   minimum signed value).

   What is not here, and why (docs/cpp-std.md):
   - cmp_equal, cmp_less and the rest of <utility>'s safe comparisons:
     Pia compares integers of any two types exactly, so `a < b` between
     an i32 and a u32 already means cmp_less a b.
   - in_range, numeric_limits: a type's bounds are not values that code
     can take from a type argument. A range type states them, and
     `let y : u8 = x` proves x fits.
   - lcm, and a gcd contract that says the result divides both and every
     common divisor divides it: both need nonlinear facts the verifier
     cannot prove at these widths yet, and gcd's exact value would need a
     spec function in the interface, which interfaces cannot list yet. So
     gcd's contract has the cases C++ pins down (gcd 0 0 = 0, gcd a 0 = a,
     gcd 0 b = b), and tests/std/int_run checks its values.
   - saturate_cast<R> takes its target in its name, saturate_cast_u8, since
     the target type cannot be a type argument whose bounds code can use.

   The bodies are written once per signedness by the metaprograms
   `unsigned_family`, `signed_family`, `saturate_unsigned` and
   `saturate_signed`, and stamped out for each width; each instance is
   proved on its own. *)
module Pia.Core.Int : Ops, Div

interface Ops = sig
  (** C++: std::gcd, by Euclid's algorithm. gcd 0 0 = 0. *)
  let gcd : (a : u8) -> (b : u8) -> u8
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 ==> result = a
    ensures a = 0 ==> result = b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : u8) -> (b : u8) -> u8
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : u8) -> (b : u8) -> u8
    ensures a * b <= 255 ==> result = a * b
    ensures a * b > 255 ==> result = 255
  (** C++26: std::div_sat. Unsigned division cannot overflow. *)
  let div_sat : (a : u8) -> (b : u8) -> u8
    requires b <> 0
    ensures result = a / b
  (** C++: std::gcd, by Euclid's algorithm. gcd 0 0 = 0. *)
  let gcd : (a : u16) -> (b : u16) -> u16
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 ==> result = a
    ensures a = 0 ==> result = b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : u16) -> (b : u16) -> u16
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : u16) -> (b : u16) -> u16
    ensures a * b <= 65535 ==> result = a * b
    ensures a * b > 65535 ==> result = 65535
  (** C++26: std::div_sat. Unsigned division cannot overflow. *)
  let div_sat : (a : u16) -> (b : u16) -> u16
    requires b <> 0
    ensures result = a / b
  (** C++: std::gcd, by Euclid's algorithm. gcd 0 0 = 0. *)
  let gcd : (a : u32) -> (b : u32) -> u32
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 ==> result = a
    ensures a = 0 ==> result = b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : u32) -> (b : u32) -> u32
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : u32) -> (b : u32) -> u32
    ensures a * b <= 4294967295 ==> result = a * b
    ensures a * b > 4294967295 ==> result = 4294967295
  (** C++26: std::div_sat. Unsigned division cannot overflow. *)
  let div_sat : (a : u32) -> (b : u32) -> u32
    requires b <> 0
    ensures result = a / b
  (** C++: std::gcd, by Euclid's algorithm. gcd 0 0 = 0. *)
  let gcd : (a : u64) -> (b : u64) -> u64
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 ==> result = a
    ensures a = 0 ==> result = b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : u64) -> (b : u64) -> u64
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : u64) -> (b : u64) -> u64
    ensures a * b <= 18446744073709551615 ==> result = a * b
    ensures a * b > 18446744073709551615 ==> result = 18446744073709551615
  (** C++26: std::div_sat. Unsigned division cannot overflow. *)
  let div_sat : (a : u64) -> (b : u64) -> u64
    requires b <> 0
    ensures result = a / b
  (** C++: std::gcd, of the magnitudes. The result is u8, so gcd of -128 has no overflow, where C++'s is undefined. *)
  let gcd : (a : i8) -> (b : i8) -> u8
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 && a >= 0 ==> result = a
    ensures b = 0 && a < 0 ==> result = 0 - a
    ensures a = 0 && b >= 0 ==> result = b
    ensures a = 0 && b < 0 ==> result = 0 - b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : i8) -> (b : i8) -> i8
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : i8) -> (b : i8) -> i8
    ensures a * b > 127 ==> result = 127
    ensures a * b < -128 ==> result = -128
    ensures -128 <= a * b && a * b <= 127 ==> result = a * b
  (** C++26: std::div_sat. Only -128 / -1 overflows, and gives 127. *)
  let div_sat : (a : i8) -> (b : i8) -> i8
    requires b <> 0
    ensures a = -128 && b = -1 ==> result = 127
    ensures a <> -128 || b <> -1 ==> result = a / b
  (** C++: std::abs, as u8, so abs -128 is defined, where C++'s is undefined. *)
  let abs : (x : i8) -> u8
    ensures x >= 0 ==> result = x
    ensures x < 0 ==> result = 0 - x
  (** C++: std::gcd, of the magnitudes. The result is u16, so gcd of -32768 has no overflow, where C++'s is undefined. *)
  let gcd : (a : i16) -> (b : i16) -> u16
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 && a >= 0 ==> result = a
    ensures b = 0 && a < 0 ==> result = 0 - a
    ensures a = 0 && b >= 0 ==> result = b
    ensures a = 0 && b < 0 ==> result = 0 - b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : i16) -> (b : i16) -> i16
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : i16) -> (b : i16) -> i16
    ensures a * b > 32767 ==> result = 32767
    ensures a * b < -32768 ==> result = -32768
    ensures -32768 <= a * b && a * b <= 32767 ==> result = a * b
  (** C++26: std::div_sat. Only -32768 / -1 overflows, and gives 32767. *)
  let div_sat : (a : i16) -> (b : i16) -> i16
    requires b <> 0
    ensures a = -32768 && b = -1 ==> result = 32767
    ensures a <> -32768 || b <> -1 ==> result = a / b
  (** C++: std::abs, as u16, so abs -32768 is defined, where C++'s is undefined. *)
  let abs : (x : i16) -> u16
    ensures x >= 0 ==> result = x
    ensures x < 0 ==> result = 0 - x
  (** C++: std::gcd, of the magnitudes. The result is u32, so gcd of -2147483648 has no overflow, where C++'s is undefined. *)
  let gcd : (a : i32) -> (b : i32) -> u32
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 && a >= 0 ==> result = a
    ensures b = 0 && a < 0 ==> result = 0 - a
    ensures a = 0 && b >= 0 ==> result = b
    ensures a = 0 && b < 0 ==> result = 0 - b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : i32) -> (b : i32) -> i32
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : i32) -> (b : i32) -> i32
    ensures a * b > 2147483647 ==> result = 2147483647
    ensures a * b < -2147483648 ==> result = -2147483648
    ensures -2147483648 <= a * b && a * b <= 2147483647 ==> result = a * b
  (** C++26: std::div_sat. Only -2147483648 / -1 overflows, and gives 2147483647. *)
  let div_sat : (a : i32) -> (b : i32) -> i32
    requires b <> 0
    ensures a = -2147483648 && b = -1 ==> result = 2147483647
    ensures a <> -2147483648 || b <> -1 ==> result = a / b
  (** C++: std::abs, as u32, so abs -2147483648 is defined, where C++'s is undefined. *)
  let abs : (x : i32) -> u32
    ensures x >= 0 ==> result = x
    ensures x < 0 ==> result = 0 - x
  (** C++: std::gcd, of the magnitudes. The result is u64, so gcd of -9223372036854775808 has no overflow, where C++'s is undefined. *)
  let gcd : (a : i64) -> (b : i64) -> u64
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 && a >= 0 ==> result = a
    ensures b = 0 && a < 0 ==> result = 0 - a
    ensures a = 0 && b >= 0 ==> result = b
    ensures a = 0 && b < 0 ==> result = 0 - b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : i64) -> (b : i64) -> i64
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : i64) -> (b : i64) -> i64
    ensures a * b > 9223372036854775807 ==> result = 9223372036854775807
    ensures a * b < -9223372036854775808 ==> result = -9223372036854775808
    ensures -9223372036854775808 <= a * b && a * b <= 9223372036854775807 ==> result = a * b
  (** C++26: std::div_sat. Only -9223372036854775808 / -1 overflows, and gives 9223372036854775807. *)
  let div_sat : (a : i64) -> (b : i64) -> i64
    requires b <> 0
    ensures a = -9223372036854775808 && b = -1 ==> result = 9223372036854775807
    ensures a <> -9223372036854775808 || b <> -1 ==> result = a / b
  (** C++: std::abs, as u64, so abs -9223372036854775808 is defined, where C++'s is undefined. *)
  let abs : (x : i64) -> u64
    ensures x >= 0 ==> result = x
    ensures x < 0 ==> result = 0 - x
  (** C++26: std::saturate_cast<u8>. *)
  let saturate_cast_u8 : (x : i64) -> u8
    ensures x < 0 ==> result = 0
    ensures x > 255 ==> result = 255
    ensures 0 <= x && x <= 255 ==> result = x
  (** C++26: std::saturate_cast<u8>. *)
  let saturate_cast_u8 : (y : u64) -> u8
    ensures y > 255 ==> result = 255
    ensures 0 <= y && y <= 255 ==> result = y
  (** C++26: std::saturate_cast<u16>. *)
  let saturate_cast_u16 : (x : i64) -> u16
    ensures x < 0 ==> result = 0
    ensures x > 65535 ==> result = 65535
    ensures 0 <= x && x <= 65535 ==> result = x
  (** C++26: std::saturate_cast<u16>. *)
  let saturate_cast_u16 : (y : u64) -> u16
    ensures y > 65535 ==> result = 65535
    ensures 0 <= y && y <= 65535 ==> result = y
  (** C++26: std::saturate_cast<u32>. *)
  let saturate_cast_u32 : (x : i64) -> u32
    ensures x < 0 ==> result = 0
    ensures x > 4294967295 ==> result = 4294967295
    ensures 0 <= x && x <= 4294967295 ==> result = x
  (** C++26: std::saturate_cast<u32>. *)
  let saturate_cast_u32 : (y : u64) -> u32
    ensures y > 4294967295 ==> result = 4294967295
    ensures 0 <= y && y <= 4294967295 ==> result = y
  (** C++26: std::saturate_cast<u64>. *)
  let saturate_cast_u64 : (x : i64) -> u64
    ensures x < 0 ==> result = 0
    ensures x >= 0 ==> result = x
  (** C++26: std::saturate_cast<i8>. *)
  let saturate_cast_i8 : (x : i64) -> i8
    ensures x < -128 ==> result = -128
    ensures x > 127 ==> result = 127
    ensures -128 <= x && x <= 127 ==> result = x
  (** C++26: std::saturate_cast<i8>. *)
  let saturate_cast_i8 : (y : u64) -> i8
    ensures y > 127 ==> result = 127
    ensures y <= 127 ==> result = y
  (** C++26: std::saturate_cast<i16>. *)
  let saturate_cast_i16 : (x : i64) -> i16
    ensures x < -32768 ==> result = -32768
    ensures x > 32767 ==> result = 32767
    ensures -32768 <= x && x <= 32767 ==> result = x
  (** C++26: std::saturate_cast<i16>. *)
  let saturate_cast_i16 : (y : u64) -> i16
    ensures y > 32767 ==> result = 32767
    ensures y <= 32767 ==> result = y
  (** C++26: std::saturate_cast<i32>. *)
  let saturate_cast_i32 : (x : i64) -> i32
    ensures x < -2147483648 ==> result = -2147483648
    ensures x > 2147483647 ==> result = 2147483647
    ensures -2147483648 <= x && x <= 2147483647 ==> result = x
  (** C++26: std::saturate_cast<i32>. *)
  let saturate_cast_i32 : (y : u64) -> i32
    ensures y > 2147483647 ==> result = 2147483647
    ensures y <= 2147483647 ==> result = y
  (** C++26: std::saturate_cast<i64>. *)
  let saturate_cast_i64 : (y : u64) -> i64
    ensures y > 9223372036854775807 ==> result = 9223372036854775807
    ensures y <= 9223372036854775807 ==> result = y
end

interface Div = sig
  (** The quotient and remainder of a i8 division. *)
  let quot_rem_i8 = type { quot : i8; rem : i8 }
  (** C++: std::div (div is Pia's core division, so this is quot_rem).
      Truncating: the quotient rounds towards zero, and the remainder has
      the dividend's sign and is smaller than the divisor. *)
  let quot_rem : (n : i8) -> (d : i8) -> quot_rem_i8
    requires d <> 0 && (n <> -128 || d <> -1)
    ensures result.quot = n / d && result.rem = n % d
    ensures result.quot * d + result.rem = n
    ensures d > 0 ==> 0 - d < result.rem && result.rem < d
    ensures d < 0 ==> d < result.rem && result.rem < 0 - d
    ensures (n >= 0 ==> result.rem >= 0) && (n <= 0 ==> result.rem <= 0)
  (** The quotient and remainder of a i16 division. *)
  let quot_rem_i16 = type { quot : i16; rem : i16 }
  (** C++: std::div (div is Pia's core division, so this is quot_rem).
      Truncating: the quotient rounds towards zero, and the remainder has
      the dividend's sign and is smaller than the divisor. *)
  let quot_rem : (n : i16) -> (d : i16) -> quot_rem_i16
    requires d <> 0 && (n <> -32768 || d <> -1)
    ensures result.quot = n / d && result.rem = n % d
    ensures result.quot * d + result.rem = n
    ensures d > 0 ==> 0 - d < result.rem && result.rem < d
    ensures d < 0 ==> d < result.rem && result.rem < 0 - d
    ensures (n >= 0 ==> result.rem >= 0) && (n <= 0 ==> result.rem <= 0)
  (** The quotient and remainder of a i32 division. *)
  let quot_rem_i32 = type { quot : i32; rem : i32 }
  (** C++: std::div (div is Pia's core division, so this is quot_rem).
      Truncating: the quotient rounds towards zero, and the remainder has
      the dividend's sign and is smaller than the divisor. *)
  let quot_rem : (n : i32) -> (d : i32) -> quot_rem_i32
    requires d <> 0 && (n <> -2147483648 || d <> -1)
    ensures result.quot = n / d && result.rem = n % d
    ensures result.quot * d + result.rem = n
    ensures d > 0 ==> 0 - d < result.rem && result.rem < d
    ensures d < 0 ==> d < result.rem && result.rem < 0 - d
    ensures (n >= 0 ==> result.rem >= 0) && (n <= 0 ==> result.rem <= 0)
  (** The quotient and remainder of a i64 division. *)
  let quot_rem_i64 = type { quot : i64; rem : i64 }
  (** C++: std::div (div is Pia's core division, so this is quot_rem).
      Truncating: the quotient rounds towards zero, and the remainder has
      the dividend's sign and is smaller than the divisor. *)
  let quot_rem : (n : i64) -> (d : i64) -> quot_rem_i64
    requires d <> 0 && (n <> -9223372036854775808 || d <> -1)
    ensures result.quot = n / d && result.rem = n % d
    ensures result.quot * d + result.rem = n
    ensures d > 0 ==> 0 - d < result.rem && result.rem < d
    ensures d < 0 ==> d < result.rem && result.rem < 0 - d
    ensures (n >= 0 ==> result.rem >= 0) && (n <= 0 ==> result.rem <= 0)
end


(* gcd, midpoint, mul_sat and div_sat for the unsigned type `t`. *)
let meta unsigned_family (t : string) (w : int) : item =
  `( let gcd ($!a : $t) ($!b : $t) : $t
       decreases $!b
       ensures $!result = 0 <==> $!a = 0 && $!b = 0
       ensures $!b = 0 ==> $!result = $!a
       ensures $!a = 0 ==> $!result = $!b
     = if $!b = 0 then $!a else gcd $!b ($!a % $!b)

     let midpoint ($!a : $t) ($!b : $t) : $t
       ensures $!a <= $!b ==> 2 * $!result = $!a + $!b || 2 * $!result = $!a + $!b - 1
       ensures $!a > $!b ==> 2 * $!result = $!a + $!b || 2 * $!result = $!a + $!b + 1
     = if $!a <= $!b then $!a + (($!b - $!a) >> 1) else $!a - (($!a - $!b) >> 1)

     let mul_sat ($!a : $t) ($!b : $t) : $t @overflow(saturate)
       ensures $!a * $!b <= (1 << $w) - 1 ==> $!result = $!a * $!b
       ensures $!a * $!b > (1 << $w) - 1 ==> $!result = (1 << $w) - 1
     = $!a * $!b

     let div_sat ($!a : $t) ($!b : $t) : $t
       requires $!b <> 0
       ensures $!result = $!a / $!b
     = $!a / $!b )

unsigned_family "u8" 8
unsigned_family "u16" 16
unsigned_family "u32" 32
unsigned_family "u64" 64

(* gcd, midpoint, mul_sat, div_sat, abs and quot_rem for the signed type
   `t` of `w` bits, whose unsigned type of the same width is `u`. *)
let meta signed_family (t : string) (u : string) (w : int) : item =
  let qr = concat "quot_rem_" t in
  `( let abs ($!x : $t) : $u
       ensures $!x >= 0 ==> $!result = $!x
       ensures $!x < 0 ==> $!result = 0 - $!x
     = if $!x < 0 then (let $!n : $u = 0 - $!x in $!n) else (let $!p : $u = $!x in $!p)

     let gcd ($!a : $t) ($!b : $t) : $u
       ensures $!result = 0 <==> $!a = 0 && $!b = 0
       ensures $!b = 0 && $!a >= 0 ==> $!result = $!a
       ensures $!b = 0 && $!a < 0 ==> $!result = 0 - $!a
       ensures $!a = 0 && $!b >= 0 ==> $!result = $!b
       ensures $!a = 0 && $!b < 0 ==> $!result = 0 - $!b
     = gcd (abs $!a) (abs $!b)

     let midpoint ($!a : $t) ($!b : $t) : $t
       ensures $!a <= $!b ==> 2 * $!result = $!a + $!b || 2 * $!result = $!a + $!b - 1
       ensures $!a > $!b ==> 2 * $!result = $!a + $!b || 2 * $!result = $!a + $!b + 1
     = if $!a <= $!b then (let $!d : $u = $!b - $!a in $!a + ($!d >> 1))
       else (let $!e : $u = $!a - $!b in $!a - ($!e >> 1))

     let mul_sat ($!a : $t) ($!b : $t) : $t @overflow(saturate)
       ensures $!a * $!b > (1 << $(w - 1)) - 1 ==> $!result = (1 << $(w - 1)) - 1
       ensures $!a * $!b < 0 - (1 << $(w - 1)) ==> $!result = 0 - (1 << $(w - 1))
       ensures 0 - (1 << $(w - 1)) <= $!a * $!b && $!a * $!b <= (1 << $(w - 1)) - 1 ==> $!result = $!a * $!b
     = $!a * $!b

     let div_sat ($!a : $t) ($!b : $t) : $t @overflow(saturate)
       requires $!b <> 0
       ensures $!a = 0 - (1 << $(w - 1)) && $!b = -1 ==> $!result = (1 << $(w - 1)) - 1
       ensures $!a <> 0 - (1 << $(w - 1)) || $!b <> -1 ==> $!result = $!a / $!b
     = $!a / $!b

     let $qr = type { quot : $t; rem : $t }

     let quot_rem ($!n : $t) ($!d : $t) : $qr
       requires $!d <> 0 && ($!n <> 0 - (1 << $(w - 1)) || $!d <> -1)
       ensures $!result.quot = $!n / $!d && $!result.rem = $!n % $!d
       ensures $!result.quot * $!d + $!result.rem = $!n
       ensures $!d > 0 ==> 0 - $!d < $!result.rem && $!result.rem < $!d
       ensures $!d < 0 ==> $!d < $!result.rem && $!result.rem < 0 - $!d
       ensures ($!n >= 0 ==> $!result.rem >= 0) && ($!n <= 0 ==> $!result.rem <= 0)
     = { quot = $!n / $!d; rem = $!n % $!d } )

signed_family "i8" "u8" 8
signed_family "i16" "u16" 16
signed_family "i32" "u32" 32
signed_family "i64" "u64" 64

(* saturate_cast to the unsigned type `t` of `w` bits, from i64 and, but
   for u64 itself, from u64. *)
let meta saturate_unsigned (t : string) (w : int) : item =
  let n = concat "saturate_cast_" t in
  `( let $n ($!x : i64) : $t
       ensures $!x < 0 ==> $!result = 0
       ensures $!x > (1 << $w) - 1 ==> $!result = (1 << $w) - 1
       ensures 0 <= $!x && $!x <= (1 << $w) - 1 ==> $!result = $!x
     = let $!z : $t = 0 in
       let $!m : $t = ~$!z in
       if $!x < 0 then 0 else if $!x > $!m then $!m else $!x

     let $n ($!y : u64) : $t
       ensures $!y > (1 << $w) - 1 ==> $!result = (1 << $w) - 1
       ensures $!y <= (1 << $w) - 1 ==> $!result = $!y
     = let $!z : $t = 0 in
       let $!m : $t = ~$!z in
       if $!y > $!m then $!m else $!y )

(* saturate_cast to the signed type `t` of `w` bits, from u64 and, but for
   i64 itself, from i64. *)
let meta saturate_signed (t : string) (w : int) : item =
  let n = concat "saturate_cast_" t in
  `( let $n ($!x : i64) : $t
       ensures $!x < 0 - (1 << $(w - 1)) ==> $!result = 0 - (1 << $(w - 1))
       ensures $!x > (1 << $(w - 1)) - 1 ==> $!result = (1 << $(w - 1)) - 1
       ensures 0 - (1 << $(w - 1)) <= $!x && $!x <= (1 << $(w - 1)) - 1 ==> $!result = $!x
     = let $!h : u64 = (1 << $(w - 1)) - 1 in
       let $!hi : $t = $!h in
       let $!lo : $t = -1 - $!hi in
       if $!x < $!lo then $!lo else if $!x > $!hi then $!hi else $!x

     let $n ($!y : u64) : $t
       ensures $!y > (1 << $(w - 1)) - 1 ==> $!result = (1 << $(w - 1)) - 1
       ensures $!y <= (1 << $(w - 1)) - 1 ==> $!result = $!y
     = let $!h : u64 = (1 << $(w - 1)) - 1 in
       let $!hi : $t = $!h in
       if $!y > $!hi then $!hi else $!y )

saturate_unsigned "u8" 8
saturate_unsigned "u16" 16
saturate_unsigned "u32" 32
saturate_signed "i8" 8
saturate_signed "i16" 16
saturate_signed "i32" 32

(* The widest targets have one source each: the other is the identity. *)
(** C++26: std::saturate_cast<u64>. *)
let saturate_cast_u64 (x : i64) : u64
  ensures x < 0 ==> result = 0
  ensures x >= 0 ==> result = x
= if x < 0 then 0 else x

(** C++26: std::saturate_cast<i64>. *)
let saturate_cast_i64 (y : u64) : i64
  ensures y > 9223372036854775807 ==> result = 9223372036854775807
  ensures y <= 9223372036854775807 ==> result = y
= if y > 9223372036854775807 then 9223372036854775807 else y
