(* Pia.Core.Int: C++'s integer utilities (ADR 0040, docs/cpp-std.md):
   <numeric>'s gcd and midpoint, <cstdlib>'s abs and div, and C++26's
   saturating arithmetic, for u8 to u64 and i8 to i64. Each contract
   states the C++ meaning exactly. Where C++ leaves a case undefined, Pia
   either rules it out with a `requires` (div, div_sat's divisor) or gives
   the result an unsigned type wide enough to hold it (abs and gcd of the
   minimum signed value).

   What is not here, and why (docs/cpp-std.md):
   - cmp_equal, cmp_less and the rest of <utility>'s safe comparisons:
     Pia compares integers of any two types exactly, so `a < b` between
     an i32 and a u32 already means cmp_less a b.
   - in_range, numeric_limits: `min t` and `max t` give a named type's
     bounds (ADR 0057), but not yet a type argument's, which a generic
     body sees only as a stand-in. A range type states them, and
     `let y : u8 = x` proves x fits.
   - lcm, and a gcd contract that says the result divides both and every
     common divisor divides it: both need nonlinear facts the verifier
     cannot prove at these widths yet. gcd's contract states its exact
     value instead, as the spec function `euclid`, which Ops exports; Div
     exports `divides`, which quot_rem's contract uses.
   - saturate_cast<R> takes its target in its name, saturate_cast_u8, since
     the target type cannot be a type argument whose bounds code can use.

   The bodies are written once per signedness by the metaprograms
   `unsigned_family`, `signed_family`, `saturate_unsigned` and
   `saturate_signed`, and stamped out for each width; each instance is
   proved on its own. *)
module Pia.Core.Int : Ops, Div

interface Ops = sig
  (** Euclid's algorithm: gcd's exact value. *)
  let spec euclid : (a : u64) -> (b : u64) -> u64
  (** C++: std::gcd, by Euclid's algorithm. gcd 0 0 = 0. *)
  let gcd : (a : u8) -> (b : u8) -> u8
    ensures result = euclid a b
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 ==> result = a
    ensures a = 0 ==> result = b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : u8) -> (b : u8) -> u8
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : u8) -> (b : u8) -> u8
    ensures a * b <= max u8 ==> result = a * b
    ensures a * b > max u8 ==> result = max u8
  (** C++26: std::div_sat. Unsigned division cannot overflow. *)
  let div_sat : (a : u8) -> (b : u8) -> u8
    requires b <> 0
    ensures result = a / b
  (** C++: std::gcd, by Euclid's algorithm. gcd 0 0 = 0. *)
  let gcd : (a : u16) -> (b : u16) -> u16
    ensures result = euclid a b
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 ==> result = a
    ensures a = 0 ==> result = b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : u16) -> (b : u16) -> u16
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : u16) -> (b : u16) -> u16
    ensures a * b <= max u16 ==> result = a * b
    ensures a * b > max u16 ==> result = max u16
  (** C++26: std::div_sat. Unsigned division cannot overflow. *)
  let div_sat : (a : u16) -> (b : u16) -> u16
    requires b <> 0
    ensures result = a / b
  (** C++: std::gcd, by Euclid's algorithm. gcd 0 0 = 0. *)
  let gcd : (a : u32) -> (b : u32) -> u32
    ensures result = euclid a b
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 ==> result = a
    ensures a = 0 ==> result = b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : u32) -> (b : u32) -> u32
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : u32) -> (b : u32) -> u32
    ensures a * b <= max u32 ==> result = a * b
    ensures a * b > max u32 ==> result = max u32
  (** C++26: std::div_sat. Unsigned division cannot overflow. *)
  let div_sat : (a : u32) -> (b : u32) -> u32
    requires b <> 0
    ensures result = a / b
  (** C++: std::gcd, by Euclid's algorithm. gcd 0 0 = 0. *)
  let gcd : (a : u64) -> (b : u64) -> u64
    ensures result = euclid a b
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 ==> result = a
    ensures a = 0 ==> result = b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : u64) -> (b : u64) -> u64
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : u64) -> (b : u64) -> u64
    ensures a * b <= max u64 ==> result = a * b
    ensures a * b > max u64 ==> result = max u64
  (** C++26: std::div_sat. Unsigned division cannot overflow. *)
  let div_sat : (a : u64) -> (b : u64) -> u64
    requires b <> 0
    ensures result = a / b
  (** C++: std::gcd, of the magnitudes. The result is u8, so gcd of min i8 has no overflow, where C++'s is undefined. *)
  let gcd : (a : i8) -> (b : i8) -> u8
    ensures result = euclid (abs a) (abs b)
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 && a >= 0 ==> result = a
    ensures b = 0 && a < 0 ==> result = 0 - a
    ensures a = 0 && b >= 0 ==> result = b
    ensures a = 0 && b < 0 ==> result = 0 - b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : i8) -> (b : i8) -> i8
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : i8) -> (b : i8) -> i8
    ensures a * b > max i8 ==> result = max i8
    ensures a * b < min i8 ==> result = min i8
    ensures min i8 <= a * b && a * b <= max i8 ==> result = a * b
  (** C++26: std::div_sat. Only min i8 / -1 overflows, and gives max i8. *)
  let div_sat : (a : i8) -> (b : i8) -> i8
    requires b <> 0
    ensures a = min i8 && b = -1 ==> result = max i8
    ensures a <> min i8 || b <> -1 ==> result = a / b
  (** C++: std::abs, as u8, so abs min i8 is defined, where C++'s is undefined. *)
  let abs : (x : i8) -> u8
    ensures x >= 0 ==> result = x
    ensures x < 0 ==> result = 0 - x
  (** C++: std::gcd, of the magnitudes. The result is u16, so gcd of min i16 has no overflow, where C++'s is undefined. *)
  let gcd : (a : i16) -> (b : i16) -> u16
    ensures result = euclid (abs a) (abs b)
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 && a >= 0 ==> result = a
    ensures b = 0 && a < 0 ==> result = 0 - a
    ensures a = 0 && b >= 0 ==> result = b
    ensures a = 0 && b < 0 ==> result = 0 - b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : i16) -> (b : i16) -> i16
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : i16) -> (b : i16) -> i16
    ensures a * b > max i16 ==> result = max i16
    ensures a * b < min i16 ==> result = min i16
    ensures min i16 <= a * b && a * b <= max i16 ==> result = a * b
  (** C++26: std::div_sat. Only min i16 / -1 overflows, and gives max i16. *)
  let div_sat : (a : i16) -> (b : i16) -> i16
    requires b <> 0
    ensures a = min i16 && b = -1 ==> result = max i16
    ensures a <> min i16 || b <> -1 ==> result = a / b
  (** C++: std::abs, as u16, so abs min i16 is defined, where C++'s is undefined. *)
  let abs : (x : i16) -> u16
    ensures x >= 0 ==> result = x
    ensures x < 0 ==> result = 0 - x
  (** C++: std::gcd, of the magnitudes. The result is u32, so gcd of min i32 has no overflow, where C++'s is undefined. *)
  let gcd : (a : i32) -> (b : i32) -> u32
    ensures result = euclid (abs a) (abs b)
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 && a >= 0 ==> result = a
    ensures b = 0 && a < 0 ==> result = 0 - a
    ensures a = 0 && b >= 0 ==> result = b
    ensures a = 0 && b < 0 ==> result = 0 - b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : i32) -> (b : i32) -> i32
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : i32) -> (b : i32) -> i32
    ensures a * b > max i32 ==> result = max i32
    ensures a * b < min i32 ==> result = min i32
    ensures min i32 <= a * b && a * b <= max i32 ==> result = a * b
  (** C++26: std::div_sat. Only min i32 / -1 overflows, and gives max i32. *)
  let div_sat : (a : i32) -> (b : i32) -> i32
    requires b <> 0
    ensures a = min i32 && b = -1 ==> result = max i32
    ensures a <> min i32 || b <> -1 ==> result = a / b
  (** C++: std::abs, as u32, so abs min i32 is defined, where C++'s is undefined. *)
  let abs : (x : i32) -> u32
    ensures x >= 0 ==> result = x
    ensures x < 0 ==> result = 0 - x
  (** C++: std::gcd, of the magnitudes. The result is u64, so gcd of min i64 has no overflow, where C++'s is undefined. *)
  let gcd : (a : i64) -> (b : i64) -> u64
    ensures result = euclid (abs a) (abs b)
    ensures result = 0 <==> a = 0 && b = 0
    ensures b = 0 && a >= 0 ==> result = a
    ensures b = 0 && a < 0 ==> result = 0 - a
    ensures a = 0 && b >= 0 ==> result = b
    ensures a = 0 && b < 0 ==> result = 0 - b
  (** C++: std::midpoint. Rounds towards a, and never overflows. *)
  let midpoint : (a : i64) -> (b : i64) -> i64
    ensures a <= b ==> 2 * result = a + b || 2 * result = a + b - 1
    ensures a > b ==> 2 * result = a + b || 2 * result = a + b + 1
  (** C++26: std::mul_sat. The product, clamped to the type. *)
  let mul_sat : (a : i64) -> (b : i64) -> i64
    ensures a * b > max i64 ==> result = max i64
    ensures a * b < min i64 ==> result = min i64
    ensures min i64 <= a * b && a * b <= max i64 ==> result = a * b
  (** C++26: std::div_sat. Only min i64 / -1 overflows, and gives max i64. *)
  let div_sat : (a : i64) -> (b : i64) -> i64
    requires b <> 0
    ensures a = min i64 && b = -1 ==> result = max i64
    ensures a <> min i64 || b <> -1 ==> result = a / b
  (** C++: std::abs, as u64, so abs min i64 is defined, where C++'s is undefined. *)
  let abs : (x : i64) -> u64
    ensures x >= 0 ==> result = x
    ensures x < 0 ==> result = 0 - x
  (** C++26: std::saturate_cast<u8>. *)
  let saturate_cast_u8 : (x : i64) -> u8
    ensures x < 0 ==> result = 0
    ensures x > max u8 ==> result = max u8
    ensures 0 <= x && x <= max u8 ==> result = x
  (** C++26: std::saturate_cast<u8>. *)
  let saturate_cast_u8 : (y : u64) -> u8
    ensures y > max u8 ==> result = max u8
    ensures 0 <= y && y <= max u8 ==> result = y
  (** C++26: std::saturate_cast<u16>. *)
  let saturate_cast_u16 : (x : i64) -> u16
    ensures x < 0 ==> result = 0
    ensures x > max u16 ==> result = max u16
    ensures 0 <= x && x <= max u16 ==> result = x
  (** C++26: std::saturate_cast<u16>. *)
  let saturate_cast_u16 : (y : u64) -> u16
    ensures y > max u16 ==> result = max u16
    ensures 0 <= y && y <= max u16 ==> result = y
  (** C++26: std::saturate_cast<u32>. *)
  let saturate_cast_u32 : (x : i64) -> u32
    ensures x < 0 ==> result = 0
    ensures x > max u32 ==> result = max u32
    ensures 0 <= x && x <= max u32 ==> result = x
  (** C++26: std::saturate_cast<u32>. *)
  let saturate_cast_u32 : (y : u64) -> u32
    ensures y > max u32 ==> result = max u32
    ensures 0 <= y && y <= max u32 ==> result = y
  (** C++26: std::saturate_cast<u64>. *)
  let saturate_cast_u64 : (x : i64) -> u64
    ensures x < 0 ==> result = 0
    ensures x >= 0 ==> result = x
  (** C++26: std::saturate_cast<i8>. *)
  let saturate_cast_i8 : (x : i64) -> i8
    ensures x < min i8 ==> result = min i8
    ensures x > max i8 ==> result = max i8
    ensures min i8 <= x && x <= max i8 ==> result = x
  (** C++26: std::saturate_cast<i8>. *)
  let saturate_cast_i8 : (y : u64) -> i8
    ensures y > max i8 ==> result = max i8
    ensures y <= max i8 ==> result = y
  (** C++26: std::saturate_cast<i16>. *)
  let saturate_cast_i16 : (x : i64) -> i16
    ensures x < min i16 ==> result = min i16
    ensures x > max i16 ==> result = max i16
    ensures min i16 <= x && x <= max i16 ==> result = x
  (** C++26: std::saturate_cast<i16>. *)
  let saturate_cast_i16 : (y : u64) -> i16
    ensures y > max i16 ==> result = max i16
    ensures y <= max i16 ==> result = y
  (** C++26: std::saturate_cast<i32>. *)
  let saturate_cast_i32 : (x : i64) -> i32
    ensures x < min i32 ==> result = min i32
    ensures x > max i32 ==> result = max i32
    ensures min i32 <= x && x <= max i32 ==> result = x
  (** C++26: std::saturate_cast<i32>. *)
  let saturate_cast_i32 : (y : u64) -> i32
    ensures y > max i32 ==> result = max i32
    ensures y <= max i32 ==> result = y
  (** C++26: std::saturate_cast<i64>. *)
  let saturate_cast_i64 : (y : u64) -> i64
    ensures y > max i64 ==> result = max i64
    ensures y <= max i64 ==> result = y
end

interface Div = sig
  (** d divides n: n is a multiple of d. 0 divides only 0. *)
  let spec divides : (d : i64) -> (n : i64) -> bool
  (** The quotient and remainder of a i8 division. *)
  let quot_rem_i8 = type { quot : i8; rem : i8 }
  (** C++: std::div (div is Pia's core division, so this is quot_rem).
      Truncating: the quotient rounds towards zero, and the remainder has
      the dividend's sign and is smaller than the divisor. *)
  let quot_rem : (n : i8) -> (d : i8) -> quot_rem_i8
    requires d <> 0 && (n <> min i8 || d <> -1)
    ensures result.quot = n / d && result.rem = n % d
    ensures result.quot * d + result.rem = n
    ensures d > 0 ==> 0 - d < result.rem && result.rem < d
    ensures d < 0 ==> d < result.rem && result.rem < 0 - d
    ensures (n >= 0 ==> result.rem >= 0) && (n <= 0 ==> result.rem <= 0)
    ensures result.rem = 0 <==> divides d n
  (** The quotient and remainder of a i16 division. *)
  let quot_rem_i16 = type { quot : i16; rem : i16 }
  (** C++: std::div (div is Pia's core division, so this is quot_rem).
      Truncating: the quotient rounds towards zero, and the remainder has
      the dividend's sign and is smaller than the divisor. *)
  let quot_rem : (n : i16) -> (d : i16) -> quot_rem_i16
    requires d <> 0 && (n <> min i16 || d <> -1)
    ensures result.quot = n / d && result.rem = n % d
    ensures result.quot * d + result.rem = n
    ensures d > 0 ==> 0 - d < result.rem && result.rem < d
    ensures d < 0 ==> d < result.rem && result.rem < 0 - d
    ensures (n >= 0 ==> result.rem >= 0) && (n <= 0 ==> result.rem <= 0)
    ensures result.rem = 0 <==> divides d n
  (** The quotient and remainder of a i32 division. *)
  let quot_rem_i32 = type { quot : i32; rem : i32 }
  (** C++: std::div (div is Pia's core division, so this is quot_rem).
      Truncating: the quotient rounds towards zero, and the remainder has
      the dividend's sign and is smaller than the divisor. *)
  let quot_rem : (n : i32) -> (d : i32) -> quot_rem_i32
    requires d <> 0 && (n <> min i32 || d <> -1)
    ensures result.quot = n / d && result.rem = n % d
    ensures result.quot * d + result.rem = n
    ensures d > 0 ==> 0 - d < result.rem && result.rem < d
    ensures d < 0 ==> d < result.rem && result.rem < 0 - d
    ensures (n >= 0 ==> result.rem >= 0) && (n <= 0 ==> result.rem <= 0)
    ensures result.rem = 0 <==> divides d n
  (** The quotient and remainder of a i64 division. *)
  let quot_rem_i64 = type { quot : i64; rem : i64 }
  (** C++: std::div (div is Pia's core division, so this is quot_rem).
      Truncating: the quotient rounds towards zero, and the remainder has
      the dividend's sign and is smaller than the divisor. *)
  let quot_rem : (n : i64) -> (d : i64) -> quot_rem_i64
    requires d <> 0 && (n <> min i64 || d <> -1)
    ensures result.quot = n / d && result.rem = n % d
    ensures result.quot * d + result.rem = n
    ensures d > 0 ==> 0 - d < result.rem && result.rem < d
    ensures d < 0 ==> d < result.rem && result.rem < 0 - d
    ensures (n >= 0 ==> result.rem >= 0) && (n <= 0 ==> result.rem <= 0)
    ensures result.rem = 0 <==> divides d n
end


(** Euclid's algorithm, at the widest unsigned type. *)
let spec euclid (a : u64) (b : u64) : u64 @fuel(2)
  decreases b
= if b = 0 then a else euclid b (a % b)

(** d divides n. *)
let spec divides (d : i64) (n : i64) : bool
= if d = 0 then n = 0 else if d = -1 then true else n % d = 0

(* gcd, midpoint, mul_sat and div_sat for the unsigned type `t`. *)
let meta unsigned_family (t : string) : item =
  `( let gcd ($!a : $t) ($!b : $t) : $t
       decreases $!b
       ensures $!result = 0 <==> $!a = 0 && $!b = 0
       ensures $!b = 0 ==> $!result = $!a
       ensures $!a = 0 ==> $!result = $!b
       ensures $!result = euclid $!a $!b
     = if $!b = 0 then $!a else gcd $!b ($!a % $!b)

     let midpoint ($!a : $t) ($!b : $t) : $t
       ensures $!a <= $!b ==> 2 * $!result = $!a + $!b || 2 * $!result = $!a + $!b - 1
       ensures $!a > $!b ==> 2 * $!result = $!a + $!b || 2 * $!result = $!a + $!b + 1
     = if $!a <= $!b then $!a + (($!b - $!a) >> 1) else $!a - (($!a - $!b) >> 1)

     let mul_sat ($!a : $t) ($!b : $t) : $t @overflow(saturate)
       ensures $!a * $!b <= max $t ==> $!result = $!a * $!b
       ensures $!a * $!b > max $t ==> $!result = max $t
     = $!a * $!b

     let div_sat ($!a : $t) ($!b : $t) : $t
       requires $!b <> 0
       ensures $!result = $!a / $!b
     = $!a / $!b )

unsigned_family "u8"
unsigned_family "u16"
unsigned_family "u32"
unsigned_family "u64"

(* gcd, midpoint, mul_sat, div_sat, abs and quot_rem for the signed type
   `t`, whose unsigned type of the same width is `u`. *)
let meta signed_family (t : string) (u : string) : item =
  let qr = concat "quot_rem_" t in
  `( let abs ($!x : $t) : $u
       ensures $!x >= 0 ==> $!result = $!x
       ensures $!x < 0 ==> $!result = 0 - $!x
     = if $!x < 0 then (let $!n : $u = 0 - $!x in $!n) else (let $!p : $u = $!x in $!p)

     let gcd ($!a : $t) ($!b : $t) : $u
       ensures $!result = 0 <==> $!a = 0 && $!b = 0
       ensures $!b = 0 && $!a >= 0 ==> $!result = $!a
       ensures $!b = 0 && $!a < 0 ==> $!result = 0 - $!a
       ensures $!a = 0 && $!b >= 0 ==> $!result = $!b
       ensures $!a = 0 && $!b < 0 ==> $!result = 0 - $!b
       ensures $!result = euclid (abs $!a) (abs $!b)
     = gcd (abs $!a) (abs $!b)

     let midpoint ($!a : $t) ($!b : $t) : $t
       ensures $!a <= $!b ==> 2 * $!result = $!a + $!b || 2 * $!result = $!a + $!b - 1
       ensures $!a > $!b ==> 2 * $!result = $!a + $!b || 2 * $!result = $!a + $!b + 1
     = if $!a <= $!b then (let $!d : $u = $!b - $!a in $!a + ($!d >> 1))
       else (let $!e : $u = $!a - $!b in $!a - ($!e >> 1))

     let mul_sat ($!a : $t) ($!b : $t) : $t @overflow(saturate)
       ensures $!a * $!b > max $t ==> $!result = max $t
       ensures $!a * $!b < min $t ==> $!result = min $t
       ensures min $t <= $!a * $!b && $!a * $!b <= max $t ==> $!result = $!a * $!b
     = $!a * $!b

     let div_sat ($!a : $t) ($!b : $t) : $t @overflow(saturate)
       requires $!b <> 0
       ensures $!a = min $t && $!b = -1 ==> $!result = max $t
       ensures $!a <> min $t || $!b <> -1 ==> $!result = $!a / $!b
     = $!a / $!b

     let $qr = type { quot : $t; rem : $t }

     let quot_rem ($!n : $t) ($!d : $t) : $qr
       requires $!d <> 0 && ($!n <> min $t || $!d <> -1)
       ensures $!result.quot = $!n / $!d && $!result.rem = $!n % $!d
       ensures $!result.quot * $!d + $!result.rem = $!n
       ensures $!d > 0 ==> 0 - $!d < $!result.rem && $!result.rem < $!d
       ensures $!d < 0 ==> $!d < $!result.rem && $!result.rem < 0 - $!d
       ensures ($!n >= 0 ==> $!result.rem >= 0) && ($!n <= 0 ==> $!result.rem <= 0)
       ensures $!result.rem = 0 <==> divides $!d $!n
     = { quot = $!n / $!d; rem = $!n % $!d } )

signed_family "i8" "u8"
signed_family "i16" "u16"
signed_family "i32" "u32"
signed_family "i64" "u64"

(* saturate_cast to the unsigned type `t`, from i64 and, but
   for u64 itself, from u64. *)
let meta saturate_unsigned (t : string) : item =
  let n = concat "saturate_cast_" t in
  `( let $n ($!x : i64) : $t
       ensures $!x < 0 ==> $!result = 0
       ensures $!x > max $t ==> $!result = max $t
       ensures 0 <= $!x && $!x <= max $t ==> $!result = $!x
     = if $!x < 0 then 0 else if $!x > max $t then max $t else $!x

     let $n ($!y : u64) : $t
       ensures $!y > max $t ==> $!result = max $t
       ensures $!y <= max $t ==> $!result = $!y
     = if $!y > max $t then max $t else $!y )

(* saturate_cast to the signed type `t`, from u64 and, but for
   i64 itself, from i64. *)
let meta saturate_signed (t : string) : item =
  let n = concat "saturate_cast_" t in
  `( let $n ($!x : i64) : $t
       ensures $!x < min $t ==> $!result = min $t
       ensures $!x > max $t ==> $!result = max $t
       ensures min $t <= $!x && $!x <= max $t ==> $!result = $!x
     = if $!x < min $t then min $t else if $!x > max $t then max $t else $!x

     let $n ($!y : u64) : $t
       ensures $!y > max $t ==> $!result = max $t
       ensures $!y <= max $t ==> $!result = $!y
     = if $!y > max $t then max $t else $!y )

saturate_unsigned "u8"
saturate_unsigned "u16"
saturate_unsigned "u32"
saturate_signed "i8"
saturate_signed "i16"
saturate_signed "i32"

(* The widest targets have one source each: the other is the identity. *)
(** C++26: std::saturate_cast<u64>. *)
let saturate_cast_u64 (x : i64) : u64
  ensures x < 0 ==> result = 0
  ensures x >= 0 ==> result = x
= if x < 0 then 0 else x

(** C++26: std::saturate_cast<i64>. *)
let saturate_cast_i64 (y : u64) : i64
  ensures y > max i64 ==> result = max i64
  ensures y <= max i64 ==> result = y
= if y > max i64 then max i64 else y
