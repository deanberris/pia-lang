(* Pia.Core.Digits: the facts about digit strings that number formatting
   and parsing proofs need (ADR 0040, docs/cpp-std.md). dval is the value
   of a run of digits in a base, read most significant first, and pow is
   a power. The lemmas are proved once, here, and importers call them as
   facts (#305): divmod splits a number into its last digit and the rest,
   prepend splits a run into its first digit and the rest, frame says two
   slices that agree on a run give it the same value, and shift and step
   are the ring steps of moving a digit. put writes one digit and keeps
   the value of the digits after it. *)
module Pia.Core.Digits : Digits

interface Digits = sig
  let lemma divmod32 : (v : u32) -> (b : u32) -> unit
    requires b >= 2
    ensures (v / b) * b + v % b = v && v % b < b
  let lemma divmod64 : (v : u64) -> (b : u64) -> unit
    requires b >= 2
    ensures (v / b) * b + v % b = v && v % b < b
  let spec pow : (b : int) -> (k : usize) -> int
  let spec dval : (xs : [u8]) -> (i : usize) -> (j : usize) -> (b : int) -> int
  let lemma shift : (a : int) -> (p : int) -> (r : int) -> (b : int) -> (x : int) -> unit
    ensures (a * p + r) * b + x = a * (b * p) + (r * b + x)
  let lemma prepend : (xs : [u8]) -> (i : usize) -> (j : usize) -> (b : int) -> unit
    requires i < j && j <= len xs
    ensures dval xs i j b = xs.[i] * pow b (j - i - 1) + dval xs (i + 1) j b
  let lemma frame : (xs : [u8]) -> (ys : [u8]) -> (i : usize) -> (j : usize) -> (b : int) -> unit
    requires i <= j && j <= len xs && j <= len ys
    requires forall (k in 0 .. len xs). i <= k && k < j ==> xs.[k] = ys.[k]
    ensures dval xs i j b = dval ys i j b
  let lemma step : (v : int) -> (q : int) -> (b : int) -> (d : int) -> (pk : int) -> (rest : int) -> unit
    requires v = (q * b + d) * pk + rest
    ensures v = q * (b * pk) + (d * pk + rest)
  let put : (xs : borrowed inout mutable [u8]) -> (p : usize) -> (d : u8) -> (n : usize) -> (b : int) -> unit
    requires p < n && n <= len xs
    ensures xs.[p] = d
    ensures forall (k in 0 .. len xs). k <> p ==> xs.[k] = old (xs.[k])
    ensures dval xs (p + 1) n b = dval (old xs) (p + 1) n b
end

(** v is its quotient by b times b, plus its last digit, which is below b. *)
let lemma divmod32 (v : u32) (b : u32) : unit
= ()
(** The same for u64. *)
let lemma divmod64 (v : u64) (b : u64) : unit
= ()
(** b to the k. *)
let spec pow (b : int) (k : usize) : int
  decreases k
= if k = 0 then 1 else b * pow b (k - 1)

(** The value of the digits xs.[i .. j] (each already a digit value) in
    base b, most significant first: a left fold. *)
let spec dval (xs : [u8]) (i : usize) (j : usize) (b : int) : int
  requires i <= j && j <= len xs
  decreases j - i
= if i = j then 0 else dval xs i (j - 1) b * b + xs.[j - 1]

(** The ring step behind prepend: (a * p + r) * b + x is a * (b * p)
    plus r * b + x. *)
let lemma shift (a : int) (p : int) (r : int) (b : int) (x : int) : unit
= ()

(** Prepending a digit: the value of xs.[i .. j] is its first digit times
    b^(j - i - 1), plus the value of the rest. *)
let lemma prepend (xs : [u8]) (i : usize) (j : usize) (b : int) : unit
  decreases j - i
= if j - i > 1 then (
    prepend xs i (j - 1) b;
    let a : int = xs.[i] in
    let p : int = pow b (j - i - 2) in
    let r : int = dval xs (i + 1) (j - 1) b in
    let x : int = xs.[j - 1] in
    shift a p r b x;
    assert dval xs i (j - 1) b = a * p + r;
    assert dval xs i j b = (a * p + r) * b + x;
    assert dval xs (i + 1) j b = r * b + x;
    assert pow b (j - i - 1) = b * p)
  else (
    assert j = i + 1;
    assert dval xs i j b = xs.[i];
    assert dval xs (i + 1) j b = 0;
    assert pow b (j - i - 1) = 1)

(** Two slices that agree on xs.[i .. j] give it the same value. *)
let lemma frame (xs : [u8]) (ys : [u8]) (i : usize) (j : usize) (b : int) : unit
  decreases j - i
= if i < j then frame xs ys i (j - 1) b

(** The algebra of one step: q' * b + d, times b^k, plus the rest, is
    q' times b^(k + 1), plus d times b^k and the rest. *)
let lemma step (v : int) (q : int) (b : int) (d : int) (pk : int) (rest : int) : unit
= ()

(** xs.[p] becomes d, and the digits after it keep their value. *)
let put (xs : borrowed inout mutable [u8]) (p : usize) (d : u8) (n : usize) (b : int) : unit
= xs.[p] <- d;
  frame (old xs) xs (p + 1) n b

