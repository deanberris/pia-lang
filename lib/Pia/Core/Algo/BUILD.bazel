load("//tools/piac:pia.bzl", "pia_library")

# Pia.Core.Algo: C++'s <algorithm> on slices (ADR 0040), generic over
# Pia.Core.Order's concepts and proved once over them (ADR 0043).

package(default_visibility = ["//visibility:public"])

exports_files(["Search.pia"])

APPLE_SILICON = [
    "@platforms//os:macos",
    "@platforms//cpu:arm64",
]

# The non-modifying sequence algorithms: tests/std/search.pia checks its
# goals; tests/std/search_edges.pia and :search_run test it through its
# interface.
pia_library(
    name = "search",
    src = "Search.pia",
    target_compatible_with = APPLE_SILICON,
    deps = ["//lib/Pia/Core:order"],
)
