load("//tools/piac:pia.bzl", "pia_library")
load("//tools/piac:targets.bzl", "PIA_TARGETS")

# Pia.Core.Algo: C++'s <algorithm> on slices (ADR 0040), generic over
# Pia.Core.Order's concepts and proved once over them (ADR 0043).

package(default_visibility = ["//visibility:public"])

exports_files([
    "Heap.pia",
    "Modify.pia",
    "Permutation.pia",
    "Remove.pia",
    "Sort.pia",
    "Search.pia",
])

# The non-modifying sequence algorithms: tests/std/search.pia checks its
# goals; tests/std/search_edges.pia and :search_run test it through its
# interface.
pia_library(
    name = "search",
    src = "Search.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        "//lib/Pia:fn",
        "//lib/Pia/Core:order",
    ],
)

# The modifying sequence algorithms: tests/std/modify.pia checks its goals;
# tests/std/modify_edges.pia and :modify_run test it through its interface.
pia_library(
    name = "modify",
    src = "Modify.pia",
    target_compatible_with = PIA_TARGETS,
    deps = ["//lib/Pia/Core:order"],
)

# The multiset spec functions sorts are stated with: tests/std/permutation.pia
# checks its goals, and tests/std/permutation_edges.pia uses them.
pia_library(
    name = "permutation",
    src = "Permutation.pia",
    target_compatible_with = PIA_TARGETS,
    deps = ["//lib/Pia/Core:order"],
)

# remove, in its own module so its proof runs in parallel with Modify's:
# tests/std/remove.pia checks its goals, and modify_edges.pia and
# :modify_run use it.
pia_library(
    name = "remove",
    src = "Remove.pia",
    target_compatible_with = PIA_TARGETS,
    deps = ["//lib/Pia/Core:order"],
)

# Sorting with a comparator, sorted and a permutation of the input:
# tests/std/sort.pia checks its goals; tests/std/sort_edges.pia and
# :sort_run test it through its interface.
pia_library(
    name = "sort",
    src = "Sort.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":permutation",
        "//lib/Pia:fn",
        "//lib/Pia/Core:order",
    ],
)

# The heap operations and heap sort, with a comparator: tests/std/heap.pia
# checks its goals; tests/std/heap_edges.pia and :heap_run test it through
# its interface.
pia_library(
    name = "heap",
    src = "Heap.pia",
    target_compatible_with = APPLE_SILICON,
    deps = [
        ":permutation",
        ":sort",
        "//lib/Pia:fn",
        "//lib/Pia/Core:order",
    ],
)
