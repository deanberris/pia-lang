(* Pia.Core.Algo.Remove: <algorithm>'s remove (ADR 0040, phase 1.6), in a
   module of its own since its proof is the costliest of the modifying
   algorithms, so it proves in parallel with Pia.Core.Algo.Modify.

   remove's contract says where each element it keeps goes: to its rank
   among the kept ones, the spec function `kept` of the slice as it was
   (`old xs`). Past the result, the elements are unspecified, as in C++. *)
module Pia.Core.Algo.Remove : Remove

import Pia.Core.Order.Ops

interface Remove = sig
  let spec kept : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (v : t) -> (k : usize) -> usize
  let remove : (t : type where Pia.Core.Order.Eq t) -> (xs : borrowed inout mutable [t]) -> (v : t) -> usize
end

(* How many of xs.[0 .. k] are not the same as v: the rank of each kept
   element after remove. *)
let spec kept (t : type where Pia.Core.Order.Eq t) (xs : [t]) (v : t) (k : usize) : usize
  requires k <= len xs
  decreases k
  ensures result <= k
= if k = 0 then 0
  else if same xs.[k - 1] v then kept xs v (k - 1)
  else kept xs v (k - 1) + 1

(** C++: std::remove: the elements not the same as v move to the front,
    in order, and the result is how many there are; past it, the elements
    are unspecified. *)
let remove (t : type where Pia.Core.Order.Eq t) (xs : borrowed inout mutable [t]) (v : t) : usize
  ensures result = kept (old xs) v (len xs)
  ensures forall (k in 0..len xs). same (old (xs.[k])) v = false ==> xs.[kept (old xs) v k] = old (xs.[k])
= let w : mutable usize = 0 in
  for i in 0..len xs
    invariant w = kept (old xs) v i
    invariant forall (k in 0..i). same (old (xs.[k])) v = false ==> kept (old xs) v k < w
    invariant forall (k in 0..i). same (old (xs.[k])) v = false ==> xs.[kept (old xs) v k] = old (xs.[k])
    invariant forall (k in i..len xs). xs.[k] = old (xs.[k])
  do
    if same xs.[i] v then ()
    else (xs.[w] <- xs.[i]; w <- w + 1)
  done;
  w
