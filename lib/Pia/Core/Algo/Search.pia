(* Pia.Core.Algo.Search: C++'s non-modifying sequence algorithms on
   slices (ADR 0040, docs/cpp-std.md): find, count, contains, equal,
   mismatch, starts_with, ends_with, search, adjacent_find, min_element,
   max_element, minmax_element, is_sorted and is_sorted_until.

   Each is generic over Pia.Core.Order's Eq or Ord and exported as a
   generic function, so an importer instantiates it at its own types. Each
   is proved once, over its type parameter (ADR 0043), and its instances
   are discharged by that proof. A position is a usize index, and len xs
   means not found, where C++ returns the end iterator (ADR 0040, section
   5). Each contract states the C++ result exactly: with quantifiers, or
   with an exported spec function where a quantifier is hard to prove. *)
module Pia.Core.Algo.Search : Search

import Pia.Core.Order.Ops

interface Search = sig
  let spec count_from : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (v : t) -> (i : usize) -> usize
  let spec matches_at : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (p : [t]) -> (i : usize) -> (k : usize) -> bool
  let spec sorted_prefix : (t : type where Pia.Core.Order.Ord t) -> (xs : [t]) -> (k : usize) -> bool
  let spec no_adjacent : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (k : usize) -> bool
  let find : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (v : t) -> usize
  let count : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (v : t) -> usize
  let contains : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (v : t) -> bool
  let mismatch : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (ys : [t]) -> usize
  let equal : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (ys : [t]) -> bool
  let starts_with : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (p : [t]) -> bool
  let ends_with : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (s : [t]) -> bool
  let occurs_at : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (p : [t]) -> (i : usize) -> (k : usize) -> bool
  let search_from : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (p : [t]) -> (i : usize) -> usize
  let search : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> (p : [t]) -> usize
  let adjacent_find : (t : type where Pia.Core.Order.Eq t) -> (xs : [t]) -> usize
  let min_element : (t : type where Pia.Core.Order.Ord t) -> (xs : [t]) -> usize
  let max_element : (t : type where Pia.Core.Order.Ord t) -> (xs : [t]) -> usize
  let extremes = type { lowest : usize; highest : usize }
  let last_max_element : (t : type where Pia.Core.Order.Ord t) -> (xs : [t]) -> usize
  let minmax_element : (t : type where Pia.Core.Order.Ord t) -> (xs : [t]) -> extremes
  let is_sorted_until : (t : type where Pia.Core.Order.Ord t) -> (xs : [t]) -> usize
  let is_sorted : (t : type where Pia.Core.Order.Ord t) -> (xs : [t]) -> bool
  let spec count_where : (t : type) -> (f : type where Function f t bool) -> (xs : [t]) -> (p : f) -> (i : usize) -> usize
  let find : (t : type) -> (f : type where Function f t bool) -> (xs : [t]) -> (p : f) -> usize
  let count : (t : type) -> (f : type where Function f t bool) -> (xs : [t]) -> (p : f) -> usize
  let all : (t : type) -> (f : type where Function f t bool) -> (xs : [t]) -> (p : f) -> bool
  let any : (t : type) -> (f : type where Function f t bool) -> (xs : [t]) -> (p : f) -> bool
  let none : (t : type) -> (f : type where Function f t bool) -> (xs : [t]) -> (p : f) -> bool
  let mismatch : (t : type) -> (xs : [t]) -> (ys : [t]) -> (p : t -> t -> bool) -> usize
  let equal : (t : type) -> (xs : [t]) -> (ys : [t]) -> (p : t -> t -> bool) -> bool
end

(* The number of elements of xs.[i ..] that are the same as v. *)
let spec count_from (t : type where Pia.Core.Order.Eq t) (xs : [t]) (v : t) (i : usize) : usize
  requires i <= len xs
  decreases len xs - i
  ensures result <= len xs - i
= if i = len xs then 0
  else if same xs.[i] v then 1 + count_from xs v (i + 1)
  else count_from xs v (i + 1)

(* Whether p.[k ..] occurs in xs from i + k. *)
let spec matches_at (t : type where Pia.Core.Order.Eq t) (xs : [t]) (p : [t]) (i : usize) (k : usize) : bool
  requires k <= len p && i <= len xs
  decreases len p - k
= if k = len p then true
  else if k >= len xs - i then false
  else same xs.[i + k] p.[k] && matches_at xs p i (k + 1)

(* No element of xs.[1 .. k] is before the one ahead of it. *)
let spec sorted_prefix (t : type where Pia.Core.Order.Ord t) (xs : [t]) (k : usize) : bool
  requires k <= len xs
  decreases k
= if k < 2 then true
  else sorted_prefix xs (k - 1) && less xs.[k - 1] xs.[k - 2] = false

(* No element of xs.[0 .. k - 1] is the same as the one after it. *)
let spec no_adjacent (t : type where Pia.Core.Order.Eq t) (xs : [t]) (k : usize) : bool
  requires k <= len xs
  decreases k
= if k < 2 then true
  else no_adjacent xs (k - 1) && same xs.[k - 2] xs.[k - 1] = false

(** C++: std::find. The first index of an element the same as v, or
    len xs. *)
let find (t : type where Pia.Core.Order.Eq t) (xs : [t]) (v : t) : usize
  ensures result <= len xs
  ensures forall (j in 0..result). same xs.[j] v = false
  ensures result < len xs ==> same xs.[result] v
= let i : mutable usize = 0 in
  while i < len xs && same xs.[i] v = false
    invariant i <= len xs
    invariant forall (j in 0..i). same xs.[j] v = false
    decreases len xs - i
  do i <- i + 1 done;
  i

(** C++: std::count. *)
let count (t : type where Pia.Core.Order.Eq t) (xs : [t]) (v : t) : usize
  ensures result = count_from xs v 0
= let c : mutable usize = 0 in
  let i : mutable usize = 0 in
  while i < len xs
    invariant i <= len xs && c <= i
    invariant c + count_from xs v i = count_from xs v 0
    decreases len xs - i
  do
    (if same xs.[i] v then c <- c + 1 else ());
    i <- i + 1
  done;
  c

(** C++23: std::ranges::contains. *)
let contains (t : type where Pia.Core.Order.Eq t) (xs : [t]) (v : t) : bool
  ensures result <==> (exists (j in 0..len xs). same xs.[j] v)
= (find<t> xs v < len xs)

(** C++: std::mismatch. The first index at which xs and ys differ, or
    the shorter length. *)
let mismatch (t : type where Pia.Core.Order.Eq t) (xs : [t]) (ys : [t]) : usize
  ensures result <= len xs && result <= len ys
  ensures forall (j in 0..result). same xs.[j] ys.[j]
  ensures result < len xs && result < len ys ==> same xs.[result] ys.[result] = false
= let i : mutable usize = 0 in
  while i < len xs && i < len ys && same xs.[i] ys.[i]
    invariant i <= len xs && i <= len ys
    invariant forall (j in 0..i). same xs.[j] ys.[j]
    decreases len xs - i
  do i <- i + 1 done;
  i

(** C++: std::equal of two ranges. *)
let equal (t : type where Pia.Core.Order.Eq t) (xs : [t]) (ys : [t]) : bool
  ensures result <==> len xs = len ys && (forall (j in 0..len xs). same xs.[j] ys.[j])
= (len xs = len ys && mismatch<t> xs ys = len xs)

(** C++23: std::ranges::starts_with. *)
let starts_with (t : type where Pia.Core.Order.Eq t) (xs : [t]) (p : [t]) : bool
  ensures result <==> len p <= len xs && (forall (j in 0..len p). same xs.[j] p.[j])
= (len p <= len xs && mismatch<t> xs p = len p)

(** C++23: std::ranges::ends_with. *)
let ends_with (t : type where Pia.Core.Order.Eq t) (xs : [t]) (s : [t]) : bool
  ensures result <==> len s <= len xs &&
    (forall (j in 0..len s). same xs.[len xs - len s + j] s.[j])
= if len s > len xs then false
  else (mismatch<t> (xs.[len xs - len s .. len xs]) s = len s)

(* Whether p.[k ..] occurs in xs from i + k: matches_at, computed. *)
let occurs_at (t : type where Pia.Core.Order.Eq t) (xs : [t]) (p : [t]) (i : usize) (k : usize) : bool
  requires k <= len p && i <= len xs
  decreases len p - k
  ensures result = matches_at xs p i k
= if k = len p then true
  else if k >= len xs - i then false
  else if same xs.[i + k] p.[k] then occurs_at<t> xs p i (k + 1)
  else false

(** C++: std::search. The first index from which p occurs in xs, or
    len xs; 0 for an empty p. *)
let search (t : type where Pia.Core.Order.Eq t) (xs : [t]) (p : [t]) : usize
  ensures result <= len xs
  ensures forall (j in 0..result). matches_at xs p j 0 = false
  ensures (result < len xs || len p = 0) ==> matches_at xs p result 0
= if len p = 0 then 0 else search_from<t> xs p 0

(* The first index from i from which p occurs in xs, or len xs. *)
let search_from (t : type where Pia.Core.Order.Eq t) (xs : [t]) (p : [t]) (i : usize) : usize
  requires i <= len xs && len p > 0
  decreases len xs - i
  ensures i <= result && result <= len xs
  ensures forall (j in i..result). matches_at xs p j 0 = false
  ensures result < len xs ==> matches_at xs p result 0
= if i = len xs then len xs
  else if occurs_at<t> xs p i 0 then i
  else search_from<t> xs p (i + 1)

(** C++: std::adjacent_find. The first i with xs.[i] the same as
    xs.[i + 1], or len xs. *)
let adjacent_find (t : type where Pia.Core.Order.Eq t) (xs : [t]) : usize
  ensures result <= len xs
  ensures result < len xs ==> result + 1 < len xs && same xs.[result] xs.[result + 1]
  ensures no_adjacent xs (if result < len xs then result + 1 else len xs)
= if len xs < 2 then len xs else (
    let i : mutable usize = 0 in
    while i + 1 < len xs && same xs.[i] xs.[i + 1] = false
      invariant i + 1 <= len xs
      invariant no_adjacent xs (i + 1)
      decreases len xs - i
    do i <- i + 1 done;
    if i + 1 < len xs then i else len xs)

(** C++: std::min_element. The first smallest, or 0 for an empty xs. *)
let min_element (t : type where Pia.Core.Order.Ord t) (xs : [t]) : usize
  ensures len xs = 0 ==> result = 0
  ensures len xs > 0 ==> result < len xs
  ensures len xs > 0 ==> (forall (j in 0..len xs). less xs.[j] xs.[result] = false)
  ensures len xs > 0 ==> (forall (j in 0..result). less xs.[result] xs.[j])
= if len xs = 0 then 0 else (
    let m : mutable usize = 0 in
    let i : mutable usize = 1 in
    while i < len xs
      invariant 1 <= i && i <= len xs && m < i
      invariant forall (j in 0..i). less xs.[j] xs.[m] = false
      invariant forall (j in 0..m). less xs.[m] xs.[j]
      decreases len xs - i
    do
      (if less xs.[i] xs.[m] then m <- i else ());
      i <- i + 1
    done;
    m)

(** C++: std::max_element. The first largest, or 0 for an empty xs. *)
let max_element (t : type where Pia.Core.Order.Ord t) (xs : [t]) : usize
  ensures len xs = 0 ==> result = 0
  ensures len xs > 0 ==> result < len xs
  ensures len xs > 0 ==> (forall (j in 0..len xs). less xs.[result] xs.[j] = false)
  ensures len xs > 0 ==> (forall (j in 0..result). less xs.[j] xs.[result])
= if len xs = 0 then 0 else (
    let m : mutable usize = 0 in
    let i : mutable usize = 1 in
    while i < len xs
      invariant 1 <= i && i <= len xs && m < i
      invariant forall (j in 0..i). less xs.[m] xs.[j] = false
      invariant forall (j in 0..m). less xs.[j] xs.[m]
      decreases len xs - i
    do
      (if less xs.[m] xs.[i] then m <- i else ());
      i <- i + 1
    done;
    m)

(** The positions minmax_element finds. *)
let extremes = type { lowest : usize; highest : usize }

(* The last largest, or 0 for an empty xs: minmax_element's second. *)
let last_max_element (t : type where Pia.Core.Order.Ord t) (xs : [t]) : usize
  ensures len xs = 0 ==> result = 0
  ensures len xs > 0 ==> result < len xs
  ensures len xs > 0 ==> (forall (j in 0..len xs). less xs.[result] xs.[j] = false)
  ensures len xs > 0 ==> (forall (j in result + 1..len xs). less xs.[j] xs.[result])
= if len xs = 0 then 0 else (
    let m : mutable usize = 0 in
    let i : mutable usize = 1 in
    while i < len xs
      invariant 1 <= i && i <= len xs && m < i
      invariant forall (j in 0..i). less xs.[m] xs.[j] = false
      invariant forall (j in m + 1..i). less xs.[j] xs.[m]
      decreases len xs - i
    do
      (if less xs.[i] xs.[m] = false then m <- i else ());
      i <- i + 1
    done;
    m)

(** C++: std::minmax_element. The first smallest and the last largest,
    or 0 and 0 for an empty xs. *)
let minmax_element (t : type where Pia.Core.Order.Ord t) (xs : [t]) : extremes
  ensures len xs = 0 ==> result.lowest = 0 && result.highest = 0
  ensures len xs > 0 ==> result.lowest < len xs && result.highest < len xs
  ensures len xs > 0 ==> (forall (j in 0..len xs). less xs.[j] xs.[result.lowest] = false)
  ensures len xs > 0 ==> (forall (j in 0..result.lowest). less xs.[result.lowest] xs.[j])
  ensures len xs > 0 ==> (forall (j in 0..len xs). less xs.[result.highest] xs.[j] = false)
  ensures len xs > 0 ==> (forall (j in result.highest + 1..len xs). less xs.[j] xs.[result.highest])
= { lowest = min_element<t> xs; highest = last_max_element<t> xs }

(** C++: std::is_sorted_until. The first i with xs.[i] before
    xs.[i - 1], or len xs. *)
let is_sorted_until (t : type where Pia.Core.Order.Ord t) (xs : [t]) : usize
  ensures result <= len xs
  ensures len xs < 2 ==> result = len xs
  ensures sorted_prefix xs result
  ensures result < len xs ==> result >= 1 && less xs.[result] xs.[result - 1]
= if len xs < 2 then len xs else (
    let i : mutable usize = 1 in
    while i < len xs && less xs.[i] xs.[i - 1] = false
      invariant 1 <= i && i <= len xs
      invariant sorted_prefix xs i
      decreases len xs - i
    do i <- i + 1 done;
    i)

(** C++: std::is_sorted. True when no element is before the one ahead of
    it; when false, a pair out of order. *)
let is_sorted (t : type where Pia.Core.Order.Ord t) (xs : [t]) : bool
  ensures result ==> sorted_prefix xs (len xs)
  ensures result = false ==> (exists (i in 1..len xs). less xs.[i] xs.[i - 1])
= (is_sorted_until<t> xs = len xs)

(* The predicate overloads (ADR 0040, section 6): no _if names. find xs p
   is find xs v's overload, chosen by the argument's type (ADR 0044,
   section 4). A unary predicate is a type f meeting Function f t bool,
   so these are proved once, over both type parameters (ADR 0043). *)

(* The number of elements of xs.[i ..] for which p holds. *)
let spec count_where (t : type) (f : type where Function f t bool) (xs : [t]) (p : f) (i : usize) : usize
  requires i <= len xs
  decreases len xs - i
  ensures result <= len xs - i
= if i = len xs then 0
  else if p xs.[i] then 1 + count_where xs p (i + 1)
  else count_where xs p (i + 1)

(** C++: std::find_if. The first index of an element for which p holds,
    or len xs. *)
let find (t : type) (f : type where Function f t bool) (xs : [t]) (p : f) : usize
  ensures result <= len xs
  ensures forall (j in 0..result). p xs.[j] = false
  ensures result < len xs ==> p xs.[result]
= let i : mutable usize = 0 in
  while i < len xs && p xs.[i] = false
    invariant i <= len xs
    invariant forall (j in 0..i). p xs.[j] = false
    decreases len xs - i
  do i <- i + 1 done;
  i

(** C++: std::count_if. *)
let count (t : type) (f : type where Function f t bool) (xs : [t]) (p : f) : usize
  ensures result = count_where xs p 0
= let c : mutable usize = 0 in
  let i : mutable usize = 0 in
  while i < len xs
    invariant i <= len xs && c <= i
    invariant c + count_where xs p i = count_where xs p 0
    decreases len xs - i
  do
    (if p xs.[i] then c <- c + 1 else ());
    i <- i + 1
  done;
  c

(** C++: std::all_of. *)
let all (t : type) (f : type where Function f t bool) (xs : [t]) (p : f) : bool
  ensures result <==> (forall (j in 0..len xs). p xs.[j])
= let i : mutable usize = 0 in
  while i < len xs && p xs.[i]
    invariant i <= len xs
    invariant forall (j in 0..i). p xs.[j]
    decreases len xs - i
  do i <- i + 1 done;
  i = len xs

(** C++: std::any_of. *)
let any (t : type) (f : type where Function f t bool) (xs : [t]) (p : f) : bool
  ensures result <==> (exists (j in 0..len xs). p xs.[j])
= (find xs p < len xs)

(** C++: std::none_of. *)
let none (t : type) (f : type where Function f t bool) (xs : [t]) (p : f) : bool
  ensures result <==> (forall (j in 0..len xs). p xs.[j] = false)
= (find xs p = len xs)

(* The binary predicate overloads. Function takes one argument, so a
   binary predicate is an arrow, t -> t -> bool, and these are proved at
   each specialisation, for the function passed (ADR 0044, section 5).
   adjacent_find with a predicate, and the comparator overloads of
   min_element, max_element, minmax_element, is_sorted_until and
   is_sorted, wait for binary function values proved once (lambdas step
   6): proved at each call, they cost 40M to 100M an importer. *)

(** C++: std::mismatch with a predicate. The first index at which p does
    not hold of xs.[i] and ys.[i], or the shorter length. *)
let mismatch (t : type) (xs : [t]) (ys : [t]) (p : t -> t -> bool) : usize
  ensures result <= len xs && result <= len ys
  ensures forall (j in 0..result). p xs.[j] ys.[j]
  ensures result < len xs && result < len ys ==> p xs.[result] ys.[result] = false
= let i : mutable usize = 0 in
  while i < len xs && i < len ys && p xs.[i] ys.[i]
    invariant i <= len xs && i <= len ys
    invariant forall (j in 0..i). p xs.[j] ys.[j]
    decreases len xs - i
  do i <- i + 1 done;
  i

(** C++: std::equal of two ranges, with a predicate. *)
let equal (t : type) (xs : [t]) (ys : [t]) (p : t -> t -> bool) : bool
  ensures result <==> len xs = len ys && (forall (j in 0..len xs). p xs.[j] ys.[j])
= let i : mutable usize = 0 in
  while len xs = len ys && i < len xs && p xs.[i] ys.[i]
    invariant i <= len xs
    invariant len xs = len ys ==> (forall (j in 0..i). p xs.[j] ys.[j])
    decreases len xs - i
  do i <- i + 1 done;
  len xs = len ys && i = len xs
