(* Pia.Core.Algo.SetUnion: <algorithm>'s set_union and
   set_symmetric_difference (ADR 0040, phase 1.8), on sets as
   Pia.Core.Algo.Set states them, by a strict weak order, proved once
   (ADR 0043, ADR 0044). In their own module because they cost most to
   prove, so they prove in parallel with the rest.

   Each walks both ranges as merge does, into the first `result` places
   of dst, a slice at least as long as both together. set_union writes
   every member of either once, so result is len xs + len ys less the
   members of ys in xs; set_symmetric_difference skips those, so result
   is len xs + len ys less twice them. The output is strictly
   increasing. *)
module Pia.Core.Algo.SetUnion : SetUnion

import Pia.Fn.Laws
import Pia.Core.Order.Ops
import Pia.Core.Algo.BinarySearch.BinarySearch as B
import Pia.Core.Algo.Set.Set as S

interface SetUnion = sig
  let set_union : (t : type) -> (dst : borrowed inout mutable [t]) -> (xs : [t]) -> (ys : [t]) -> (less : (a : t) -> (b : t) -> bool) -> usize
  let set_symmetric_difference : (t : type) -> (dst : borrowed inout mutable [t]) -> (xs : [t]) -> (ys : [t]) -> (less : (a : t) -> (b : t) -> bool) -> usize
end

(** C++: std::set_union with a comparator, into dst.[0 .. result]. *)
let set_union (t : type) (dst : borrowed inout mutable [t]) (xs : [t]) (ys : [t]) (less : (a : t) -> (b : t) -> bool) : usize
  requires Pia.Fn.strict_weak_order less
  requires S.increasing_prefix less xs (len xs) && S.increasing_prefix less ys (len ys)
  requires len dst >= len xs + len ys
  ensures result + S.members ys xs less (len ys) = len xs + len ys
  ensures forall (k in 0 .. result). S.member xs dst.[k] less || S.member ys dst.[k] less
  ensures S.increasing_prefix less dst result
= let i : mutable usize = 0 in
  let j : mutable usize = 0 in
  let c : mutable usize = 0 in
  for s in 0 .. len xs + len ys
    invariant i <= len xs && j <= len ys && c <= i + j && s <= i + j
    invariant c + S.members ys xs less j = i + j
    invariant forall (k in 0 .. c). S.member xs dst.[k] less || S.member ys dst.[k] less
    invariant S.increasing_prefix less dst c
    invariant forall (k in 0 .. c) (a in 0 .. len xs). i <= a ==> less dst.[k] xs.[a]
    invariant forall (k in 0 .. c) (b in 0 .. len ys). j <= b ==> less dst.[k] ys.[b]
    invariant forall (a in 0 .. len xs) (b in 0 .. len ys). a < i && j <= b ==> less xs.[a] ys.[b]
  do
    if i < len xs || j < len ys then (
    if j = len ys || (i < len xs && less xs.[i] ys.[j]) then (
      assert (forall (b in 0 .. len ys). j <= b ==> less xs.[i] ys.[b]);
      dst.[c] <- xs.[i];
      c <- c + 1;
      i <- i + 1)
    else if i = len xs || less ys.[j] xs.[i] then (
      assert (forall (a in 0 .. len xs). i <= a ==> less ys.[j] xs.[a]);
      assert S.member xs ys.[j] less = false;
      dst.[c] <- ys.[j];
      c <- c + 1;
      j <- j + 1)
    else (
      assert S.member xs ys.[j] less;
      assert (forall (b in 0 .. len ys). j < b ==> less xs.[i] ys.[b]);
      assert (forall (a in 0 .. len xs). i < a ==> less ys.[j] xs.[a]);
      dst.[c] <- xs.[i];
      c <- c + 1;
      i <- i + 1;
      j <- j + 1))
  done;
  assert i = len xs && j = len ys;
  c

(** C++: std::set_symmetric_difference with a comparator, into
    dst.[0 .. result]. *)
let set_symmetric_difference (t : type) (dst : borrowed inout mutable [t]) (xs : [t]) (ys : [t]) (less : (a : t) -> (b : t) -> bool) : usize
  requires Pia.Fn.strict_weak_order less
  requires S.increasing_prefix less xs (len xs) && S.increasing_prefix less ys (len ys)
  requires len dst >= len xs + len ys
  ensures result + 2 * S.members ys xs less (len ys) = len xs + len ys
  ensures forall (k in 0 .. result).
    (S.member xs dst.[k] less && S.member ys dst.[k] less = false) ||
    (S.member ys dst.[k] less && S.member xs dst.[k] less = false)
  ensures S.increasing_prefix less dst result
= let i : mutable usize = 0 in
  let j : mutable usize = 0 in
  let c : mutable usize = 0 in
  for s in 0 .. len xs + len ys
    invariant i <= len xs && j <= len ys && c <= i + j && s <= i + j
    invariant c + 2 * S.members ys xs less j = i + j
    invariant forall (k in 0 .. c).
      (S.member xs dst.[k] less && S.member ys dst.[k] less = false) ||
      (S.member ys dst.[k] less && S.member xs dst.[k] less = false)
    invariant S.increasing_prefix less dst c
    invariant forall (k in 0 .. c) (a in 0 .. len xs). i <= a ==> less dst.[k] xs.[a]
    invariant forall (k in 0 .. c) (b in 0 .. len ys). j <= b ==> less dst.[k] ys.[b]
    invariant forall (a in 0 .. len xs) (b in 0 .. len ys). a < i && j <= b ==> less xs.[a] ys.[b]
    invariant forall (a in 0 .. len xs) (b in 0 .. len ys). b < j && i <= a ==> less ys.[b] xs.[a]
  do
    if i < len xs || j < len ys then (
    if j = len ys || (i < len xs && less xs.[i] ys.[j]) then (
      assert (forall (b in 0 .. len ys). j <= b ==> less xs.[i] ys.[b]);
      assert S.member ys xs.[i] less = false;
      dst.[c] <- xs.[i];
      c <- c + 1;
      i <- i + 1)
    else if i = len xs || less ys.[j] xs.[i] then (
      assert (forall (a in 0 .. len xs). i <= a ==> less ys.[j] xs.[a]);
      assert S.member xs ys.[j] less = false;
      dst.[c] <- ys.[j];
      c <- c + 1;
      j <- j + 1)
    else (
      assert S.member xs ys.[j] less;
      assert (forall (b in 0 .. len ys). j < b ==> less xs.[i] ys.[b]);
      assert (forall (a in 0 .. len xs). i < a ==> less ys.[j] xs.[a]);
      i <- i + 1;
      j <- j + 1))
  done;
  assert i = len xs && j = len ys;
  c
