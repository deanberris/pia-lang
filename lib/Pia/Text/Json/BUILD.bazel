load("//tools/piac:pia.bzl", "pia_library")
load("//tools/piac:targets.bzl", "PIA_TARGETS")

# Pia.Text.Json (ADR 0045): JSON, proved against one grammar. Step 1 is the
# grammar of RFC 8259's tokens (Spec) and a tokenizer proved sound against
# it (Lex); step 2 is a writer proved to produce those tokens (Write);
# step 4 is the token readers @derive(json) builds on (Read).
# Each module is proved and compiled on its own, and importers
# build against its interface artifacts.

package(default_visibility = ["//visibility:public"])

# Its tests read the source, to prove it and to write its interfaces.
exports_files([
    "Derive.pia",
    "Dom.pia",
    "Lex.pia",
    "Read.pia",
    "Shape.pia",
    "Spec.pia",
    "Write.pia",
])

# The token grammar as spec functions: tests/std/json_lex.pia checks its
# goals and its interface.
pia_library(
    name = "spec",
    src = "Spec.pia",
    target_compatible_with = PIA_TARGETS,
)

# The tokenizer: tests/std/json_lex.pia checks its goals;
# tests/std/json_lex_edges.pia and :json_lex_run test it through its
# interface.
pia_library(
    name = "lex",
    src = "Lex.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [":spec"],
)

# The writer: tests/std/json_write.pia checks its goals;
# tests/std/json_write_edges.pia and :json_write_run test it through its
# interface.
pia_library(
    name = "write",
    src = "Write.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [":spec"],
)

# The token readers derived JSON readers are built from: tests/std/
# json_read.pia checks its goals; tests/std/json_derive.pia and
# :json_derive_run test them through @derive(json).
pia_library(
    name = "read",
    src = "Read.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":lex",
        ":spec",
    ],
)

# @derive(json), exported with its definitions (ADR 0039): the code it
# writes calls Read and Write, which its importers link.
pia_library(
    name = "derive",
    src = "Derive.pia",
    target_compatible_with = PIA_TARGETS,
)

# The document as a recursive type over its text (ADR 0045, step 6):
# tests/std/json_dom.pia checks its goals, and :json_dom_run_test runs it.
pia_library(
    name = "dom",
    src = "Dom.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":lex",
        ":spec",
        "//lib/Pia/Mem:alloc",
    ],
)

# What @derive(json_dom) builds a type's conformance on, and the derive
# itself (ADR 0045, step 7): tests/std/json_shape.pia checks its goals,
# tests/std/json_shape_derive.pia a derived record's, and
# :json_shape_run_test runs one.
pia_library(
    name = "shape",
    src = "Shape.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":dom",
        ":lex",
        ":spec",
        ":write",
        "//lib/Pia/Mem:alloc",
    ],
)
