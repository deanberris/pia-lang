(* Pia.Text.Json.Dom: the JSON document as a recursive sum type over the
   input (ADR 0045, section 5, step 6; ADR 0047). A document copies no
   text: a number or a string is the span of the input its token was
   read from, quotes and escapes included, so a document is read with
   the text it was parsed from. An array holds its elements and an
   object its members, each in a `vec` of exactly their number, lent by
   an allocator from the document's region `r`.

   - `valid_dom s v` is the document's invariant, a spec function by
     structural recursion: each number and string is a token of its kind
     in `s` (Pia.Text.Json.Spec.token_at), and so is each member's key.
   - `parse s max_depth values members` reads the whole of `s` as one
     document, nested at most `max_depth` deep, with its arrays from
     `values` and its objects from `members`, two bumps over the
     caller's memory. Every allocation is fallible: `OutOfMemory` is in
     its error set, as are `Depth` past the limit, a lex error, and an
     unexpected or trailing token. On success the document is valid.

   Containers are counted before they are read, by a scan of the tokens
   between their brackets, so each takes one allocation of exactly its
   length: no vector grows, and nothing is copied. A container's scan
   reads the tokens once more for each level that holds it, which the
   depth bounds.

   Not here yet: unique keys (a duplicate key is accepted), unescaping a
   string on demand, and a parser in constant stack. `vec` here is a
   fixed-length vector, an indirection by its name until the `Indirect`
   concept over type constructors lands (ADR 0047, section 2). *)
module Pia.Text.Json.Dom : Document

import Pia.Text.Json.Spec.Grammar as Spec
import Pia.Text.Json.Lex.Lexer as Lex
import Pia.Mem.Alloc.Allocators

interface Document = sig
  (** The bytes of the input from start to stop. *)
  let span = type { start : usize; stop : usize }
  (** A container's elements, exactly as many as it has, lent from `r`. *)
  let vec = let (t : type) (r : region) => type { items : borrowed(r) mutable [t] }
  (** A JSON value, over the text it was parsed from. `JNull` is `null`:
      `Null` is already the lexer's token kind. *)
  let rec json = let (r : region) => type
    | JNull
    | Bool of bool
    | Num of span
    | Str of span
    | Arr of vec (json r) r
    | Obj of vec (member r) r
  (** An object's member: its key, a string token, and its value. *)
  let rec member = let (r : region) => type { key : span; value : json r }
  (** What parsing can fail with, and where. *)
  let dom_error = type
    | LexError of Pia.Text.Json.Lex.lex_error
    | Misplaced of usize
    | Depth of usize
    | Trailing of usize
    | NoMemory
  (** The span sp of s is a string token, as a key must be. *)
  let spec key_ok : (s : [u8]) -> (sp : span) -> bool @opaque
  (** Every number, string and key of v is a token of its kind in s. *)
  let spec valid_dom : (s : [u8]) -> (v : json) -> bool @opaque
  (** The whole of s as a document nested at most max_depth deep. *)
  let parse : (s : [u8]) -> (max_depth : int{0..255}) -> (values : inout mutable Pia.Mem.Alloc.bump json) -> (members : inout mutable Pia.Mem.Alloc.bump member) -> result json dom_error
    ensures (match result with | Ok v -> valid_dom s v | Err _ -> true)
end

let span = type { start : usize; stop : usize }

let vec = let (t : type) (r : region) => type { items : borrowed(r) mutable [t] }

let rec json = let (r : region) => type
  | JNull
  | Bool of bool
  | Num of span
  | Str of span
  | Arr of vec (json r) r
  | Obj of vec (member r) r

let rec member = let (r : region) => type { key : span; value : json r }

let dom_error = type
  | LexError of Pia.Text.Json.Lex.lex_error
  | Misplaced of usize
  | Depth of usize
  | Trailing of usize
  | NoMemory

(* Both are opaque (ADR 0063): unfolded, Spec.token_at is a large formula,
   and in every goal of the parser's loops it cost a hundred times what
   the goal needed. The builders below reveal them, one constructor at a
   time. *)
let spec key_ok (s : [u8]) (sp : span) : bool @opaque =
  Pia.Text.Json.Spec.token_at s Pia.Text.Json.Spec.String sp.start sp.stop

let rec spec valid_dom (s : [u8]) (v : json) : bool @opaque
  decreases depth v
= match v with
  | JNull -> true
  | Bool _ -> true
  | Num sp -> Pia.Text.Json.Spec.token_at s Pia.Text.Json.Spec.Number sp.start sp.stop
  | Str sp -> Pia.Text.Json.Spec.token_at s Pia.Text.Json.Spec.String sp.start sp.stop
  | Arr a -> forall (i in 0 .. len a.items). valid_dom s a.items.[i]
  | Obj o ->
    forall (i in 0 .. len o.items). key_ok s o.items.[i].key && valid_dom s o.items.[i].value

(* The next token at or after pos, its lex error as a dom error. *)
let token (s : [u8]) (pos : usize) : result Pia.Text.Json.Lex.token dom_error
  requires pos <= len s
  ensures (match result with
    | Ok t -> pos <= t.start && t.start <= t.stop && t.stop <= len s
              && Pia.Text.Json.Spec.token_at s t.kind t.start t.stop
    | Err _ -> true)
= match Pia.Text.Json.Lex.next s pos with
  | Ok t -> Ok t
  | Err e -> Err (LexError e)

(* A token kind as a number, to compare in code: 0 null, 1 true, 2
   false, 3 a number, 4 a string, 5 `[`, 6 `{`, 7 `]`, 8 `}`, 9 `,`,
   10 `:` and 11 the end. *)
let role (k : Pia.Text.Json.Spec.kind) : int{0..11}
  ensures (result = 3 <==> k = Pia.Text.Json.Spec.Number)
  ensures (result = 4 <==> k = Pia.Text.Json.Spec.String)
= match k with
  | Null -> 0
  | True -> 1
  | False -> 2
  | Number -> 3
  | String -> 4
  | LBracket -> 5
  | LBrace -> 6
  | RBracket -> 7
  | RBrace -> 8
  | Comma -> 9
  | Colon -> 10
  | End -> 11

(* How many values an array holds, or members an object, from pos, just
   after its opening bracket, to its closing one. A value is counted at
   its first token at the container's own level, and a member at its
   colon there. Nested containers are passed over. A lex error is the
   error; a container that does not close is misplaced at its start. *)
let count (s : [u8]) (pos : usize) (object : bool) : result usize dom_error
  requires pos <= len s
  ensures (match result with | Ok n -> n <= len s | Err _ -> true)
= let at : mutable usize = pos in
  let level : mutable usize = 0 in
  let n : mutable usize = 0 in
  let closed : mutable bool = false in
  let why : mutable dom_error = Misplaced pos in
  while closed = false && at < len s
    invariant at <= len s && n <= at && level <= at
    decreases len s - at
  do
    (match token s at with
     | Err e -> (why <- e; at <- len s)
     | Ok t ->
       (let k = role t.kind in
        if t.stop <= at || k = 11 then at <- len s
        else
         (let opens = k = 5 || k = 6 in
          let closes = k = 7 || k = 8 in
          if closes && level = 0 then (closed <- true; at <- len s)
          else
            ((if level = 0 then
                (if object then (if k = 10 then n <- n + 1)
                 else (if k <> 9 then n <- n + 1)));
             (if opens then level <- level + 1
              else if closes && level > 0 then level <- level - 1);
             at <- t.stop))))
  done;
  if closed then Ok n else Err why

(* A value read from pos: the value, and the position after it. *)
let read = let (r : region) => type { value : json r; next : usize }

(* The token after an element: `,` before another, or the closing
   bracket after the last. *)
let after (s : [u8]) (pos : usize) (last : bool) (close : int{0..11}) : result usize dom_error
  requires pos <= len s
  ensures (match result with | Ok p -> pos <= p && p <= len s | Err _ -> true)
= let t = token s pos? in
  let k = role t.kind in
  if (last && k = close) || (last = false && k = 9) then Ok t.stop
  else Err (Misplaced t.start)

(* Each constructor, with what makes it valid: the one place each case of
   valid_dom is unfolded. *)
let leaf (s : [u8]) (v : json) : json
  requires (match v with | JNull -> true | Bool _ -> true | _ -> false)
  ensures valid_dom s result && result = v
  with valid_dom
= v

let num (s : [u8]) (sp : span) : json
  requires Pia.Text.Json.Spec.token_at s Pia.Text.Json.Spec.Number sp.start sp.stop
  ensures valid_dom s result
  with valid_dom
= Num sp

let str (s : [u8]) (sp : span) : json
  requires Pia.Text.Json.Spec.token_at s Pia.Text.Json.Spec.String sp.start sp.stop
  ensures valid_dom s result
  with valid_dom
= Str sp

let arr (s : [u8]) (cells : borrowed mutable [json]) : json
  requires forall (j in 0 .. len cells). valid_dom s cells.[j]
  ensures valid_dom s result
  with valid_dom
= Arr { items = cells }

let obj (s : [u8]) (cells : borrowed mutable [member]) : json
  requires forall (j in 0 .. len cells). key_ok s cells.[j].key
  requires forall (j in 0 .. len cells). valid_dom s cells.[j].value
  ensures valid_dom s result
  with valid_dom
= Obj { items = cells }

(* A member's key and the colon after it, from pos: the key's span, and
   the position after the colon. *)
let keyed = type { key : span; next : usize }

let key_colon (s : [u8]) (pos : usize) : result keyed dom_error
  requires pos <= len s
  ensures (match result with
    | Ok k -> pos <= k.next && k.next <= len s
              && key_ok s k.key
    | Err _ -> true)
  with key_ok
= let key = token s pos? in
  if role key.kind <> 4 then Err (Misplaced key.start)
  else
    (let colon = token s key.stop? in
     if role colon.kind <> 10 then Err (Misplaced colon.start)
     else Ok { key = { start = key.start; stop = key.stop }; next = colon.stop })

let rec value (s : [u8]) (pos : usize) (budget : int{0..255}) (values : inout mutable Pia.Mem.Alloc.bump json) (members : inout mutable Pia.Mem.Alloc.bump member) : result read dom_error
  requires pos <= len s
  ensures (match result with | Ok x -> pos <= x.next && x.next <= len s | Err _ -> true)
  ensures (match result with | Ok x -> valid_dom s x.value | Err _ -> true)
  decreases budget
= let t = token s pos? in
  let k = role t.kind in
  if k = 0 then Ok { value = leaf s JNull; next = t.stop }
  else if k = 1 then Ok { value = leaf s (Bool true); next = t.stop }
  else if k = 2 then Ok { value = leaf s (Bool false); next = t.stop }
  else if k = 3 then
    Ok { value = num s { start = t.start; stop = t.stop }; next = t.stop }
  else if k = 4 then
    Ok { value = str s { start = t.start; stop = t.stop }; next = t.stop }
  else if k = 5 then
    (if budget = 0 then Err (Depth t.start)
     else
       (let n = count s t.stop false? in
        match Pia.Mem.Alloc.alloc values n with
        | Err _ -> Err NoMemory
        | Ok cells ->
        let at : mutable usize = t.stop in
        let failed : mutable bool = false in
        let why : mutable dom_error = NoMemory in
        for i in 0 .. n
          invariant at <= len s && t.stop <= at
          invariant failed || (forall (j in 0 .. i). valid_dom s cells.[j])
        do
          if failed = false then
            (match value s at (budget - 1) values members with
             | Err e -> (failed <- true; why <- e)
             | Ok x ->
               cells.[i] <- x.value;
               (match after s x.next (i + 1 = n) 7 with
                | Err e -> (failed <- true; why <- e)
                | Ok p -> at <- p))
        done;
        if failed then Err why
        else
          (let v = arr s cells in
           if n = 0 then
             (let p = after s at true 7? in
              Ok { value = v; next = p })
           else Ok { value = v; next = at })))
  else if k = 6 then
    (if budget = 0 then Err (Depth t.start)
     else
       (let n = count s t.stop true? in
        match Pia.Mem.Alloc.alloc members n with
        | Err _ -> Err NoMemory
        | Ok cells ->
        let at : mutable usize = t.stop in
        let failed : mutable bool = false in
        let why : mutable dom_error = NoMemory in
        for i in 0 .. n
          invariant at <= len s && t.stop <= at
          invariant failed || (forall (j in 0 .. i). key_ok s cells.[j].key)
          invariant failed || (forall (j in 0 .. i). valid_dom s cells.[j].value)
        do
          if failed = false then
            (match key_colon s at with
             | Err e -> (failed <- true; why <- e)
             | Ok kc ->
               (match value s kc.next (budget - 1) values members with
                | Err e -> (failed <- true; why <- e)
                | Ok x ->
                  cells.[i] <- { key = kc.key; value = x.value };
                  (match after s x.next (i + 1 = n) 8 with
                   | Err e -> (failed <- true; why <- e)
                   | Ok p -> at <- p)))
        done;
        if failed then Err why
        else
          (let v = obj s cells in
           if n = 0 then
             (let p = after s at true 8? in
              Ok { value = v; next = p })
           else Ok { value = v; next = at })))
  else Err (Misplaced t.start)

let parse (s : [u8]) (max_depth : int{0..255}) (values : inout mutable Pia.Mem.Alloc.bump json) (members : inout mutable Pia.Mem.Alloc.bump member) : result json dom_error
  ensures (match result with | Ok v -> valid_dom s v | Err _ -> true)
= let x = value s 0 max_depth values members? in
  let t = token s x.next? in
  if role t.kind = 11 then Ok x.value else Err (Trailing t.start)
