(* Pia.Text.Json.Shape: what @derive(json) builds a type's conformance
   on (ADR 0045, section 6, step 7). A document conforms to a type when
   it has the type's shape, and then reads as a value of it with no
   failure path. These are the pieces for each kind of field, proved
   once here, so a derived type's conforms, check and from_dom only
   combine them.

   - `key_is s sp name`: the key's span is the name in quotes, byte for
     byte. A field's name is printable ASCII with no quote or backslash,
     so a key that matches it has no escapes.
   - `int_in s v lo hi`: v is a number with only digits after an optional
     minus, whose value is from lo to hi, both ends checked. A fraction or an exponent is
     out of every integer type's range, as for the streaming reader.
     `int_value` is that value, and `read_int` reads it, or says the
     number does not conform, from the same digit loop.
   - `is_bool v` and `bool_value v`.
   - `find s items name`: the member called name, or that there is none.

   key_is, int_in, int_value and is_bool are opaque (ADR 0063): a derived
   type's goals combine them without their bodies, which only the
   functions here, that decide them, reveal. Unfolded in every member's
   goals, they made a derived check's proof time out.

   The digits are stated by `digits_fit` and `digits_int`, which follow
   the reader's loop digit by digit, so the loop's invariant is the spec
   itself, and nothing is proved by induction. *)
module Pia.Text.Json.Shape : Shapes

import Pia.Text.Json.Spec.Grammar as Spec
import Pia.Text.Json.Lex.Lexer
import Pia.Mem.Alloc.Allocators
import Pia.Text.Json.Dom.Document as Dom

interface Shapes = sig
  (** A document that does not have the shape asked for. *)
  let nonconforming = type | Nonconforming
  (** Why to_dom made no document: the text had no room for the value,
      or the document read back from it did not parse or conform, which
      would be a fault of the writer. *)
  let to_dom_error = type | NoRoom | Unparsed of Pia.Text.Json.Dom.dom_error | Unconforming
  (** The span sp of s is name, in quotes. *)
  let spec key_is : (s : [u8]) -> (sp : Pia.Text.Json.Dom.span) -> (name : [u8]) -> bool @opaque
  (** The digits of s from k to j, after a value of acc, stay at most max. *)
  let spec digits_fit : (acc : u64) -> (s : [u8]) -> (k : usize) -> (j : usize) -> (max : u64) -> bool @opaque
  (** The value of the digits of s from k to j, after a value of acc. *)
  let spec digits_int : (acc : u64) -> (s : [u8]) -> (k : usize) -> (j : usize) -> (max : u64) -> u64 @opaque
  (** The magnitude a negative integer from lo may have. *)
  let spec neg_limit : (lo : i64) -> u64
  (** v is an integer from lo to hi, digits after an optional minus. *)
  let spec int_in : (s : [u8]) -> (v : Pia.Text.Json.Dom.json) -> (lo : i64) -> (hi : i64) -> bool @opaque
  (** The integer v is, when int_in holds. *)
  let spec int_value : (s : [u8]) -> (v : Pia.Text.Json.Dom.json) -> (lo : i64) -> (hi : i64) -> i64 @opaque
  (** v is true or false. *)
  let spec is_bool : (v : Pia.Text.Json.Dom.json) -> bool @opaque
  (** v is null. *)
  let spec is_null : (v : Pia.Text.Json.Dom.json) -> bool @opaque
  (** The integer v is, from lo to hi, or that it is not one. *)
  let read_int : (s : [u8]) -> (v : Pia.Text.Json.Dom.json) -> (lo : i64) -> (hi : i64) -> result i64 nonconforming
    requires lo <= hi
    ensures (match result with
      | Ok x -> lo <= x && x <= hi && int_in s v lo hi && x = int_value s v lo hi
      | Err _ -> int_in s v lo hi = false)
  (** The bool v is. *)
  let bool_value : (v : Pia.Text.Json.Dom.json) -> bool
    requires is_bool v
    ensures result = (v = Pia.Text.Json.Dom.Bool true)
  (** Whether v is a bool. *)
  let check_bool : (v : Pia.Text.Json.Dom.json) -> bool
    ensures result = is_bool v
  (** Whether v is null. *)
  let check_null : (v : Pia.Text.Json.Dom.json) -> bool
    ensures result = is_null v
  (** Whether the span sp of s is name, in quotes. *)
  let key_matches : (s : [u8]) -> (sp : Pia.Text.Json.Dom.span) -> (name : [u8]) -> bool
    ensures result = key_is s sp name
  (** No member but the one at i is called name. *)
  let only : (s : [u8]) -> (items : [Pia.Text.Json.Dom.member]) -> (name : [u8]) -> (i : usize) -> bool
    ensures result = (forall (j in 0 .. len items). key_is s items.[j].key name ==> j = i)
  (** v is a string whose span is name, in quotes. *)
  let spec str_is : (s : [u8]) -> (v : Pia.Text.Json.Dom.json) -> (name : [u8]) -> bool @opaque
  (** Whether v is a string whose span is name, in quotes. *)
  let check_str : (s : [u8]) -> (v : Pia.Text.Json.Dom.json) -> (name : [u8]) -> bool
    ensures result = str_is s v name
  (** Exactly one member is called tag, and its value is the string name:
      a tagged variant's constructor. *)
  let spec tag_is : (s : [u8]) -> (items : [Pia.Text.Json.Dom.member]) -> (tag : [u8]) -> (name : [u8]) -> bool @opaque
  (** Whether tag_is holds. *)
  let check_tag : (s : [u8]) -> (items : [Pia.Text.Json.Dom.member]) -> (tag : [u8]) -> (name : [u8]) -> bool
    ensures result = tag_is s items tag name
  (** @derive(json_dom): a record's or a variant's conforms, check,
      from_dom and to_dom. *)
  let meta derive_json_dom : list
  (** derive_json_dom for a record. *)
  let meta json_dom_record : list
  (** derive_json_dom for a variant. *)
  let meta json_dom_variant : list
  (** How deep a document of the record named rn nests. *)
  let meta json_depth_of : int
  (** The position of the member called name, or that none is. *)
  let find : (s : [u8]) -> (items : [Pia.Text.Json.Dom.member]) -> (name : [u8]) -> result usize nonconforming
    ensures (match result with
      | Ok i -> i < len items && key_is s items.[i].key name
      | Err _ -> forall (i in 0 .. len items). key_is s items.[i].key name = false)
end

let nonconforming = type | Nonconforming

let to_dom_error = type | NoRoom | Unparsed of Pia.Text.Json.Dom.dom_error | Unconforming

let spec key_is (s : [u8]) (sp : Pia.Text.Json.Dom.span) (name : [u8]) : bool @opaque =
  if sp.start < sp.stop && sp.stop <= len s then
    (if len name < sp.stop - sp.start then
       sp.stop - sp.start - len name = 2
       && s.[sp.start] = 0x22 && s.[sp.stop - 1] = 0x22
       && (forall (k in 0 .. len name). s.[sp.start + 1 + k] = name.[k])
     else false)
  else false

(* Both are opaque (ADR 0063): `step` unfolds them one digit at a time,
   which is all the digit loop's invariant needs. *)
let rec spec digits_fit (acc : u64) (s : [u8]) (k : usize) (j : usize) (max : u64) : bool @opaque
  decreases j - k
= if k < j && j <= len s then
    (if 0x30 <= s.[k] && s.[k] <= 0x39 then
       (let d : u64 = s.[k] - 0x30 in
        if acc < max / 10 || (acc = max / 10 && d <= max % 10) then digits_fit (acc * 10 + d) s (k + 1) j max
        else false)
     else false)
  else true

let rec spec digits_int (acc : u64) (s : [u8]) (k : usize) (j : usize) (max : u64) : u64 @opaque
  decreases j - k
= if k < j && j <= len s then
    (if 0x30 <= s.[k] && s.[k] <= 0x39 then
       (let d : u64 = s.[k] - 0x30 in
        if acc < max / 10 || (acc = max / 10 && d <= max % 10) then digits_int (acc * 10 + d) s (k + 1) j max
        else acc)
     else acc)
  else acc

(* One digit more of each: the digit at k, which keeps the value within max. *)
let lemma advance (acc : u64) (s : [u8]) (k : usize) (j : usize) (max : u64) : unit
  requires k < j && j <= len s && 0x30 <= s.[k] && s.[k] <= 0x39
  requires acc < max / 10 || (acc = max / 10 && s.[k] - 0x30 <= max % 10)
  ensures digits_fit acc s k j max = digits_fit (acc * 10 + (s.[k] - 0x30)) s (k + 1) j max
  ensures digits_int acc s k j max = digits_int (acc * 10 + (s.[k] - 0x30)) s (k + 1) j max
  with digits_fit, digits_int
= ()

(* A byte that is not a digit, or a digit that passes max, fails. *)
let lemma fails (acc : u64) (s : [u8]) (k : usize) (j : usize) (max : u64) : unit
  requires k < j && j <= len s
  requires s.[k] < 0x30 || s.[k] > 0x39
           || (acc < max / 10 || (acc = max / 10 && s.[k] - 0x30 <= max % 10)) = false
  ensures digits_fit acc s k j max = false
  with digits_fit
= ()

(* A digit more stays within max = q * 10 + r when acc is below q, or is
   q and the digit at most r (as Pia.Text.Json.Read has it). *)
let lemma fits (acc : u64) (d : u64) (max : u64) : unit
  requires d <= 9 && (acc < max / 10 || (acc = max / 10 && d <= max % 10))
  ensures acc * 10 + d <= max
= let q = max / 10 in
  let r = max % 10 in
  assert max = q * 10 + r

(* The end of each. *)
let lemma stop (acc : u64) (s : [u8]) (k : usize) (max : u64) : unit
  ensures digits_fit acc s k k max && digits_int acc s k k max = acc
  with digits_fit, digits_int
= ()

(* The magnitude a negative integer from lo may have. *)
let spec neg_limit (lo : i64) : u64 = if lo < 0 then 0 - lo else 0

let spec int_in (s : [u8]) (v : Pia.Text.Json.Dom.json) (lo : i64) (hi : i64) : bool @opaque =
  match v with
  | Num sp ->
    if sp.start < sp.stop && sp.stop <= len s then
      (if s.[sp.start] = 0x2D then
         (if lo <= 0 && sp.start + 1 < sp.stop then
            digits_fit 0 s (sp.start + 1) sp.stop (neg_limit lo)
            && (if hi < 0 then neg_limit hi <= digits_int 0 s (sp.start + 1) sp.stop (neg_limit lo)
                else true)
          else false)
       else if 0 <= hi then
         digits_fit 0 s sp.start sp.stop hi
         && lo <= digits_int 0 s sp.start sp.stop hi
       else false)
    else false
  | _ -> false

let spec int_value (s : [u8]) (v : Pia.Text.Json.Dom.json) (lo : i64) (hi : i64) : i64 @opaque =
  match v with
  | Num sp ->
    if sp.start < sp.stop && sp.stop <= len s then
      (if s.[sp.start] = 0x2D then
         (let m = digits_int 0 s (sp.start + 1) sp.stop (neg_limit lo) in
          if m <= neg_limit lo && lo <= 0 then 0 - m else 0)
       else if 0 <= hi then
         (let m = digits_int 0 s sp.start sp.stop hi in
          if m <= hi then m else 0)
       else 0)
    else 0
  | _ -> 0

let spec is_bool (v : Pia.Text.Json.Dom.json) : bool @opaque =
  match v with
  | Bool _ -> true
  | _ -> false

let spec is_null (v : Pia.Text.Json.Dom.json) : bool @opaque =
  match v with
  | JNull -> true
  | _ -> false

(* The digits from i to j, each a digit and the value at most max, or Err
   at the first that is not or that would pass max. *)
let digits (s : [u8]) (i : usize) (j : usize) (max : u64) : result u64 nonconforming
  requires i <= j && j <= len s
  ensures (match result with
    | Ok m -> m <= max && digits_fit 0 s i j max && m = digits_int 0 s i j max
    | Err _ -> digits_fit 0 s i j max = false)
= let acc : mutable u64 = 0 in
  let k : mutable usize = i in
  let bad : mutable bool = false in
  while k < j && bad = false
    invariant i <= k && k <= j && acc <= max
    invariant bad = false ==> digits_fit acc s k j max = digits_fit 0 s i j max
    invariant bad = false ==> digits_int acc s k j max = digits_int 0 s i j max
    invariant bad ==> digits_fit 0 s i j max = false
    decreases j - k + (if bad then 0 else 1)
  do
    let b = s.[k] in
    if b < 0x30 || b > 0x39 then (fails acc s k j max; bad <- true)
    else
      (let d : u64 = b - 0x30 in
       if (acc < max / 10 || (acc = max / 10 && d <= max % 10)) = false then
         (fails acc s k j max; bad <- true)
       else
         (fits acc d max;
          advance acc s k j max;
          acc <- acc * 10 + d;
          k <- k + 1))
  done;
  stop acc s k max;
  if bad then Err Nonconforming else Ok acc

let read_int (s : [u8]) (v : Pia.Text.Json.Dom.json) (lo : i64) (hi : i64) : result i64 nonconforming
  with int_in, int_value
= match v with
  | Num sp ->
    if sp.start < sp.stop && sp.stop <= len s then
      (if s.[sp.start] = 0x2D then
         (if lo > 0 || sp.start + 1 >= sp.stop then Err Nonconforming
          else
            (let limit : u64 = 0 - lo in
             assert limit = neg_limit lo;
             let m = digits s (sp.start + 1) sp.stop limit? in
             let neg : i64 = 0 - m in
             let hl : u64 = if hi < 0 then 0 - hi else 0 in
             assert hl = neg_limit hi;
             if hi < 0 && m < hl then Err Nonconforming
             else
             (assert int_in s v lo hi;
             assert neg = int_value s v lo hi;
             Ok neg)))
       else if hi < 0 then Err Nonconforming
       else
         (let m = digits s sp.start sp.stop hi? in
          if m < lo then Err Nonconforming
          else
            (assert int_in s v lo hi;
             assert m = int_value s v lo hi;
             Ok m)))
    else Err Nonconforming
  | _ -> Err Nonconforming

let bool_value (v : Pia.Text.Json.Dom.json) : bool
  with is_bool
= match v with
  | Bool b -> b
  | _ -> false

let check_bool (v : Pia.Text.Json.Dom.json) : bool
  with is_bool
= match v with
  | Bool _ -> true
  | _ -> false

let check_null (v : Pia.Text.Json.Dom.json) : bool
  with is_null
= match v with
  | JNull -> true
  | _ -> false

(* Whether the key's span is name in quotes, compared byte by byte. *)
let key_matches (s : [u8]) (sp : Pia.Text.Json.Dom.span) (name : [u8]) : bool
  with key_is
= if sp.start < sp.stop && sp.stop <= len s && len name < sp.stop - sp.start
     && sp.stop - sp.start - len name = 2 then
    (if s.[sp.start] = 0x22 && s.[sp.stop - 1] = 0x22 then
       (let same : mutable bool = true in
        for k in 0 .. len name
          invariant same = (forall (q in 0 .. k). s.[sp.start + 1 + q] = name.[q])
        do
          if s.[sp.start + 1 + k] <> name.[k] then same <- false
        done;
        same)
     else false)
  else false

let find (s : [u8]) (items : [Pia.Text.Json.Dom.member]) (name : [u8]) : result usize nonconforming
= let at : mutable usize = 0 in
  let found : mutable bool = false in
  while at < len items && found = false
    invariant at <= len items
    invariant found ==> (at < len items && key_is s items.[at].key name)
    invariant found = false ==> (forall (i in 0 .. at). key_is s items.[i].key name = false)
    decreases len items - at + (if found then 0 else 1)
  do
    if key_matches s items.[at].key name then found <- true
    else at <- at + 1
  done;
  if found then Ok at else Err Nonconforming

let only (s : [u8]) (items : [Pia.Text.Json.Dom.member]) (name : [u8]) (i : usize) : bool
= let ok : mutable bool = true in
  for j in 0 .. len items
    invariant ok = (forall (q in 0 .. j). key_is s items.[q].key name ==> q = i)
  do
    if j <> i && key_matches s items.[j].key name then ok <- false
  done;
  ok

let spec str_is (s : [u8]) (v : Pia.Text.Json.Dom.json) (name : [u8]) : bool @opaque =
  match v with
  | Str sp -> key_is s sp name
  | _ -> false

let check_str (s : [u8]) (v : Pia.Text.Json.Dom.json) (name : [u8]) : bool
  with str_is
= match v with
  | Str sp -> key_matches s sp name
  | _ -> false

let spec tag_is (s : [u8]) (items : [Pia.Text.Json.Dom.member]) (tag : [u8]) (name : [u8]) : bool @opaque =
  exists (j in 0 .. len items).
    key_is s items.[j].key tag && str_is s items.[j].value name
    && (forall (q in 0 .. len items). key_is s items.[q].key tag ==> q = j)

let check_tag (s : [u8]) (items : [Pia.Text.Json.Dom.member]) (tag : [u8]) (name : [u8]) : bool
  with tag_is
= match find s items tag with
  | Err _ -> false
  | Ok i -> only s items tag i && check_str s items.[i].value name

(* @derive(json_dom) (ADR 0045, section 6, step 7): for a record of
   integers, range types and bools, and options and fixed arrays of them, with @derive(json)'s member names
   (@json(name = "...") or the field's own):

   - `conforms_json_<t> s v`, a spec function: v is an object with
     exactly one member for each field, each called its name, each value
     a number in its field's range or a bool as its field is, and no
     other member.
   - `check_json_<t> s v`, which decides it.
   - `from_dom_json_<t> s v`, which, given that v conforms, is the
     record it denotes, with no failure path: each field is its member's
     value.
   - `to_dom_json_<t> x text values members`, the document of x over
     text, which @derive(json)'s writer writes: valid and conforming.

   A program that uses it imports Pia.Text.Json.Dom's and Shape's
   interfaces and Pia.Text.Json.Write's, writes @derive(json, json_dom),
   since to_dom uses @derive(json)'s writer, and Spec's, Lex's and Pia.Mem.Alloc's, which theirs name.
   An `option t` field's member may be missing or null, both None, as
   for @derive(json)'s reader; then each member must be called one of
   the names, which `json_known_<t>` says.
   A `[t; n]` field's member is an array of exactly n values of t.
   A field of another record type with @derive(json, json_dom) is a
   nested object, which that record's own conforms, check and from_dom
   take; `json_is_<t> s v x` says x holds what each member says. An
   option of such a record is that record, null, or missing.
   A variant is one of its constructors' JSON (json_dom_variant), or,
   tagged, an object whose tag member names the constructor.
   Not yet: an array of records. *)
(* How deep a document of the record named rn nests: the object, and
   inside it an array field's array or a nested record's own depth. *)
let meta json_depth_of (rn : string) : int =
  let ints = [ "u8"; "u16"; "u32"; "u64"; "usize"; "i8"; "i16"; "i32"; "i64"; "isize" ] in
  let inner = fold (let (acc) (f) =>
      let ft = field_type rn f in
      (* An option of a record nests as deep as the record. *)
      let ft = if eq (kind ft) "TypeApp" then nth (children ft) 1 else ft in
      let d =
        if eq (kind ft) "ArrayType" then 1
        else if eq (kind ft) "TypeName" then
          (if or (eq (name ft) "bool") (fold (let (h) (n) => or h (eq n (name ft))) false ints) then 0
           else json_depth_of (name ft))
        else 0 in
      if gt d acc then d else acc)
    0 (fields rn) in
  add 1 inner

let meta derive_json_dom (t : type_decl) : list =
  if eq (kind (nth (children (nth (children t) 3)) 0)) "Variants" then json_dom_variant t
  else json_dom_record t

(* A variant, untagged (ADR 0045, section 2): a document conforms when it
   has one constructor's JSON, null for one with no payload, a bool, an
   integer in its payload's range, or an object that conforms to its
   record payload, which derives json_dom too. @derive(json) has proved
   at derive time that no two constructors share a JSON shape, so
   from_dom takes the first that fits, and `json_is_<t> s v x` says x is
   that constructor with that payload. With @json(tag = "..."), the
   document is an object: its tag member's string names the
   constructor, and the rest are that constructor's payload's members,
   as the record's own json_ok_<r>_<f> say. *)
let meta json_dom_variant (t : type_decl) : list =
  let tn = name t in
  let shape = let (f) => concat "Pia.Text.Json.Shape." f in
  let ints = [ "u8"; "u16"; "u32"; "u64"; "usize"; "i8"; "i16"; "i32"; "i64"; "isize" ] in
  let is_int_type = let (ty) =>
    if eq (kind ty) "RangeType" then true
    else if eq (kind ty) "TypeName" then fold (let (h) (n) => or h (eq n (name ty))) false ints
    else false in
  let is_bool_type = let (ty) => if eq (kind ty) "TypeName" then eq (name ty) "bool" else false in
  let tag = fold (let (acc) (a) =>
      if eq (nth a 0) "json" then
        fold (let (acc2) (arg) => if eq (nth arg 0) "tag" then nth arg 1 else acc2) acc (nth a 1)
      else acc) "" (attrs t) in
  let tagged = ne tag "" in
  let vs = variants t in
  let cidx = range (length vs) in
  let cname = let (i) => nth (nth vs i) 0 in
  let payload = let (i) => nth (nth vs i) 1 in
  let sort = let (i) =>
    let p = payload i in
    if eq (kind p) "Unit" then "null"
    else if tagged then "object"
    else if is_bool_type p then "bool"
    else if is_int_type p then "number"
    else if eq (kind p) "TypeName" then "object"
    else fail (concat "@derive(json_dom): the payload of '" (concat (cname i) "' has a type that @derive(json_dom) cannot read yet")) in
  let bounds = let (i) =>
    let b = range_of (payload i) in
    if gt (nth b 1) 9223372036854775807 then
      fail (concat "@derive(json_dom): the payload of '" (concat (cname i) "' may be above the largest i64, which a document's conformance cannot state yet"))
    else b in
  (* ---- With a tag (ADR 0045, section 2) ----
     The document is an object with exactly one member called the tag,
     whose value is the constructor's name, its own or @json(name = ...)
     on it; the payload record's members, each as that record's own
     json_ok_<r>_<f> says; and no other member. With no option field the
     count says the last, as for a record. *)
  let rn = let (i) => name (payload i) in
  let rfs = let (i) => if eq (kind (payload i)) "Unit" then [] else fields (rn i) in
  let ckey = let (i) =>
    fold (let (acc) (a) =>
            if eq (nth a 0) "json" then
              fold (let (acc2) (arg) => if eq (nth arg 0) "name" then nth arg 1 else acc2) acc (nth a 1)
            else acc)
         (cname i) (ctor_attrs t (cname i)) in
  let rkey = let (i) (f) =>
    fold (let (acc) (a) =>
            if eq (nth a 0) "json" then
              fold (let (acc2) (arg) => if eq (nth arg 0) "name" then nth arg 1 else acc2) acc (nth a 1)
            else acc)
         f (field_attrs (rn i) f) in
  let clash = if eq tagged false then [] else map (let (i) =>
      map (let (f) =>
          if eq (rkey i f) tag then
            fail (concat "@derive(json_dom): the tag '" (concat tag (concat "' is also a member of '" (concat (rn i) "'"))))
          else true) (rfs i)) cidx in
  let r_opt = let (i) (f) =>
    let ft = field_type (rn i) f in
    if eq (kind ft) "TypeApp" then
      (let h = name (nth (children ft) 0) in or (eq h "option") (eq h "Pia.Core.Option.option"))
    else false in
  let any_opt_c = let (i) => fold (let (h) (f) => or h (r_opt i f)) false (rfs i) in
  let per = let (pre) (i) (f) => concat (concat (concat pre (rn i)) "_") f in
  let tagc = concat "json_tag_" tn in
  let ckc = let (i) => concat (concat (concat "json_ckey_" tn) "_") (cname i) in
  let tag_consts =
    if tagged then
      (let tb = bytes tag in
       let tl = length tb in
       concat [ `( let $tagc : [u8; $tl] = [ $tb ] ) ]
         (map (let (i) =>
             let kc = ckc i in
             let kb = bytes (ckey i) in
             let kl = length kb in
             `( let $kc : [u8; $kl] = [ $kb ] )) cidx))
    else [] in
  let tkn = let (i) => concat (concat (concat "json_tknown_" tn) "_") (cname i) in
  let tkc = let (i) => concat (concat (concat "json_check_tknown_" tn) "_") (cname i) in
  let tnamed = let (i) (e) =>
    fold (let (acc) (f) => let kn = per "json_name_" i f in `( $acc || $(shape "key_is") $!s $e $kn ))
      `( $(shape "key_is") $!s $e $tagc ) (rfs i) in
  let tnamed_check = let (i) (e) =>
    fold (let (acc) (f) => let kn = per "json_name_" i f in `( $acc || $(shape "key_matches") $!s $e $kn ))
      `( $(shape "key_matches") $!s $e $tagc ) (rfs i) in
  let known_fns = let (i) =>
    if any_opt_c i then
      (let kn = tkn i in
       let kc = tkc i in
       [ `( let spec $kn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool =
              forall (json_dom_j in 0 .. len $!items). (let $!kj = $!items.[json_dom_j].key in $(tnamed i `( $!kj ))) );
         `( let $kc ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
              ensures $!result = $kn $!s $!items
            = (let $!ok : mutable bool = true in
               for $!k in 0 .. len $!items
                 invariant $!ok = (forall (json_dom_j in 0 .. $!k). (let $!kj = $!items.[json_dom_j].key in $(tnamed i `( $!kj ))))
               do
                 if $(tnamed_check i `( $!items.[$!k].key )) = false then $!ok <- false
               done;
               $!ok) ) ])
    else [] in
  let tagged_fns = if tagged then fold (let (acc) (i) => concat acc (known_fns i)) [] cidx else [] in
  let nmem = let (i) => add (length (rfs i)) 1 in
  let tok = let (i) =>
    let kc = ckc i in
    let known = if any_opt_c i then (let kn = tkn i in `( $kn $!s $!o.items )) else (let n = nmem i in `( len $!o.items = $n )) in
    fold (let (acc) (f) => let okn = per "json_ok_" i f in `( $acc && $okn $!s $!o.items ))
      `( $(shape "tag_is") $!s $!o.items $tagc $kc && $known ) (rfs i) in
  let tcheck = let (i) =>
    let kc = ckc i in
    let known = if any_opt_c i then (let kc2 = tkc i in `( $kc2 $!s $!o.items )) else (let n = nmem i in `( len $!o.items = $n )) in
    fold (let (acc) (f) => let chn = per "json_check_" i f in `( $acc && $chn $!s $!o.items ))
      `( $(shape "check_tag") $!s $!o.items $tagc $kc && $known ) (rfs i) in
  let tval = let (i) =>
    let c = cname i in
    if eq (kind (payload i)) "Unit" then `( $c )
    else
      (let lit = map (let (f) => let vn = per "json_value_" i f in [ f; `( $vn $!s $!o.items ) ]) (rfs i) in
       let dn = concat "json_default_" (rn i) in
       `( match $!v with
          | Obj $!o -> $c { $lit }
          | _ -> $c $dn )) in
  (* Constructor i's JSON, of the document e. *)
  let ok = let (i) (e) =>
    let k = sort i in
    if tagged then `( match $e with | Obj $!o -> $(tok i) | _ -> false )
    else if eq k "null" then `( $(shape "is_null") $e )
    else if eq k "bool" then `( $(shape "is_bool") $e )
    else if eq k "number" then (let l = nth (bounds i) 0 in let h = nth (bounds i) 1 in `( $(shape "int_in") $!s $e $l $h ))
    else (let cn = concat "conforms_json_" (name (payload i)) in `( $cn $!s $e )) in
  (* Deciding it. *)
  let chk = let (i) =>
    let k = sort i in
    if tagged then `( (match $!v with | Obj $!o -> $(tcheck i) | _ -> false) )
    else if eq k "null" then `( $(shape "check_null") $!v )
    else if eq k "bool" then `( $(shape "check_bool") $!v )
    else if eq k "number" then
      (let l = nth (bounds i) 0 in let h = nth (bounds i) 1 in
       `( (match $(shape "read_int") $!s $!v $l $h with | Ok _ -> true | Err _ -> false) ))
    else (let ch = concat "check_json_" (name (payload i)) in `( $ch $!s $!v )) in
  (* The value, given that it holds. *)
  let val = let (i) =>
    let c = cname i in
    let k = sort i in
    if tagged then tval i
    else if eq k "null" then `( $c )
    else if eq k "bool" then `( $c ($(shape "bool_value") $!v) )
    else if eq k "number" then
      (let l = nth (bounds i) 0 in let h = nth (bounds i) 1 in
       let pt = payload i in
       `( (match $(shape "read_int") $!s $!v $l $h with
           | Ok $!x -> (let $!y : $pt = $!x in $c $!y)
           | Err _ -> (let $!z : $pt = $l in $c $!z)) ))
    else (let fr = concat "from_dom_json_" (name (payload i)) in `( $c ($fr $!s $!v) )) in
  (* What x being constructor i says of the document, else acc. *)
  let is_arm = let (acc) (i) =>
    let c = cname i in
    let k = sort i in
    if and tagged (eq (kind (payload i)) "Unit") then `( match $!x with | $c -> $(ok i `( $!v )) | _ -> $acc )
    else if eq k "null" then `( match $!x with | $c -> $(ok i `( $!v )) | _ -> $acc )
    else if eq k "bool" then
      `( match $!x with | $c $!p -> $(ok i `( $!v )) && $!p = ($!v = Pia.Text.Json.Dom.Bool true) | _ -> $acc )
    else if eq k "number" then
      (let l = nth (bounds i) 0 in let h = nth (bounds i) 1 in
       `( match $!x with | $c $!p -> $(ok i `( $!v )) && $!p = $(shape "int_value") $!s $!v $l $h | _ -> $acc ))
    else (let ri = concat "json_is_" (name (payload i)) in
          `( match $!x with | $c $!p -> $(ok i `( $!v )) && $ri $!s $!v $!p | _ -> $acc )) in
  let cname_fn = concat "conforms_json_" tn in
  let any_ok = fold (let (acc) (i) => `( $acc || $(ok i `( $!v )) )) `( false ) cidx in
  let conforms_fn =
    `( let spec $cname_fn ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) : bool = $any_ok ) in
  let chname = concat "check_json_" tn in
  let any_check = fold (let (acc) (i) => `( $acc || $(chk i) )) `( false ) cidx in
  let check_fn =
    `( let $chname ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) : bool
         ensures $!result = $cname_fn $!s $!v
       = $any_check ) in
  let isname = concat "json_is_" tn in
  let is_fn =
    `( let spec $isname ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) ($!x : $t) : bool =
         $(fold is_arm `( false ) (reverse cidx)) ) in
  let last = sub (length vs) 1 in
  let pick = fold (let (acc) (i) => `( if $(chk i) then $(val i) else $acc )) (val last) (reverse (range last)) in
  let fname = concat "from_dom_json_" tn in
  let from_fn =
    `( let $fname ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) : $t
         requires $cname_fn $!s $!v
         ensures $isname $!s $!v $!result
       = $pick ) in
  (* to_dom, as for a record: @derive(json)'s writer, then parse and
     check. A record payload nests as deep as the record. *)
  let room = concat "json_room_" tn in
  let depth = fold (let (acc) (i) =>
      if eq (sort i) "object" then (let d = json_depth_of (name (payload i)) in if gt d acc then d else acc) else acc) 1 cidx in
  let wname = concat "write_json_" tn in
  let tname = concat "to_dom_json_" tn in
  let to_fn =
    `( let $tname ($!x : $t) ($!text : borrowed inout mutable [u8]) ($!values : inout mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.json) ($!members : inout mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.member) : result Pia.Text.Json.Dom.json Pia.Text.Json.Shape.to_dom_error
         ensures (match $!result with
           | Ok $!d -> Pia.Text.Json.Dom.valid_dom $!text $!d && $cname_fn $!text $!d
           | Err _ -> true)
       = if len $!text < $room then Err NoRoom
         else
           (let $!n = $wname $!text 0 $!x in
            for $!k in $!n .. len $!text do $!text.[$!k] <- 0x20 done;
            match Pia.Text.Json.Dom.parse $!text $depth $!values $!members with
            | Err $!e -> Err (Unparsed $!e)
            | Ok $!d -> if $chname $!text $!d then Ok $!d else Err Unconforming) ) in
  concat (concat tag_consts tagged_fns) [ conforms_fn; check_fn; is_fn; from_fn; to_fn ]

let meta json_dom_record (t : type_decl) : list =
  let tn = name t in
  let shape = let (f) => concat "Pia.Text.Json.Shape." f in
  let fs = fields t in
  let nf = length fs in
  let idx = range nf in
  let key_of = let (f) =>
    fold (let (acc) (a) =>
            if eq (nth a 0) "json" then
              fold (let (acc2) (arg) => if eq (nth arg 0) "name" then nth arg 1 else acc2) acc (nth a 1)
            else acc)
         f (field_attrs t f) in
  let plain = let (k) =>
    fold (let (ok) (b) => and ok (and (ge b 32) (and (le b 126) (and (ne b 34) (ne b 92))))) (gt (length (bytes k)) 0) (bytes k) in
  let keys = map (let (f) =>
      let k = key_of f in
      if plain k then k
      else fail (concat "@derive(json_dom): the member name '" (concat k "' needs printable ASCII with no quote or backslash")))
    fs in
  let ints = [ "u8"; "u16"; "u32"; "u64"; "usize"; "i8"; "i16"; "i32"; "i64"; "isize" ] in
  (* An `option t` field is t, null, or missing: both of the last are
     None, as for @derive(json)'s reader. *)
  let is_opt = let (f) =>
    let ft = field_type t f in
    if eq (kind ft) "TypeApp" then
      (let h = name (nth (children ft) 0) in or (eq h "option") (eq h "Pia.Core.Option.option"))
    else false in
  (* A fixed array field, `[t; n]`, is a JSON array of exactly n values
     of t, as for @derive(json). *)
  let is_arr = let (f) => eq (kind (field_type t f)) "ArrayType" in
  let arr_len = let (f) => value (nth (children (field_type t f)) 1) in
  let base = let (f) =>
    if is_opt f then nth (children (field_type t f)) 1
    else if is_arr f then nth (children (field_type t f)) 0
    else field_type t f in
  let any_opt = fold (let (h) (f) => or h (is_opt f)) false fs in
  let bool_field = let (f) =>
    let ft = base f in if eq (kind ft) "TypeName" then eq (name ft) "bool" else false in
  (* A field of another record type is a nested object, which that
     type's own @derive(json, json_dom) reads and checks. *)
  let is_rec = let (f) =>
    let ft = base f in
    if eq (kind ft) "TypeName" then
      (if eq (name ft) "bool" then false else eq (fold (let (h) (n) => or h (eq n (name ft))) false ints) false)
    else false in
  let bounds = map (let (f) =>
      let ft = base f in
      if bool_field f then [ 0; 0 ]
      else if is_rec f then
        (if is_arr f then
           fail (concat "@derive(json_dom): the field '" (concat f "' is an array of records, which @derive(json_dom) cannot read yet"))
         else [ 0; 0 ])
      else if or (eq (kind ft) "RangeType")
                 (and (eq (kind ft) "TypeName") (fold (let (h) (n) => or h (eq n (name ft))) false ints)) then
        (let b = range_of ft in
         if gt (nth b 1) 9223372036854775807 then
           fail (concat "@derive(json_dom): the field '" (concat f "' may be above the largest i64, which a document's conformance cannot state yet"))
         else b)
      else fail (concat "@derive(json_dom): the field '" (concat f "' has a type that @derive(json_dom) cannot read yet; it takes integers, range types, bool, records, and an option or a fixed array of one")))
    fs in
  let lo = let (i) => nth (nth bounds i) 0 in
  let hi = let (i) => nth (nth bounds i) 1 in
  let kname = let (i) => concat (concat (concat "json_name_" tn) "_") (nth fs i) in
  (* Each member name as a constant, for the spec and the code alike. *)
  let key_consts = map (let (i) =>
      let kn = kname i in
      let kb = bytes (nth keys i) in
      let n = length kb in
      `( let $kn : [u8; $n] = [ $kb ] ))
    idx in
  (* Per field: `json_ok_<t>_<f> s items`, a spec function, that
     exactly one member is called its name and its value conforms;
     `json_check_<t>_<f>`, which decides it; and `json_value_<t>_<f>`,
     the field's value given that it holds. Each is one small proof, and
     the type's own functions only combine them. *)
  let ok_name = let (i) => concat (concat (concat "json_ok_" tn) "_") (nth fs i) in
  let check_name = let (i) => concat (concat (concat "json_check_" tn) "_") (nth fs i) in
  let value_name = let (i) => concat (concat (concat "json_value_" tn) "_") (nth fs i) in
  let field_fns = let (i) =>
    let kn = kname i in
    let okn = ok_name i in
    let chn = check_name i in
    let vn = value_name i in
    let f = nth fs i in
    let ft = field_type t f in
    let bt = base f in
    if and (is_opt f) (is_rec f) then
      (let inner = name bt in
       let icn = concat "conforms_json_" inner in
       let ich = concat "check_json_" inner in
       let ifr = concat "from_dom_json_" inner in
       let iis = concat "json_is_" inner in
       let sn = concat (concat (concat "json_some_" tn) "_") f in
       [ `( let spec $sn ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) ($!r : $ft) : bool @opaque =
              match $!r with
              | $!None -> $(shape "is_null") $!v
              | Some $!y -> $(shape "is_null") $!v = false && $iis $!s $!v $!y );
         `( let spec $okn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool =
              forall (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                ==> (($(shape "is_null") $!items.[json_dom_j].value || $icn $!s $!items.[json_dom_j].value)
                     && (forall (json_dom_q in 0 .. len $!items).
                           $(shape "key_is") $!s $!items.[json_dom_q].key $kn ==> json_dom_q = json_dom_j)) );
         `( let $chn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
              ensures $!result = $okn $!s $!items
            = match $(shape "find") $!s $!items $kn with
              | Err _ -> true
              | Ok $!i ->
                $(shape "only") $!s $!items $kn $!i
                && ($(shape "check_null") $!items.[$!i].value || $ich $!s $!items.[$!i].value) );
         `( let $vn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : $ft
              requires $okn $!s $!items
              ensures (forall (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                ==> $sn $!s $!items.[json_dom_j].value $!result)
              ensures (forall (json_dom_j in 0 .. len $!items). $(shape "key_is") $!s $!items.[json_dom_j].key $kn = false)
                ==> (match $!result with | $!None -> true | Some _ -> false)
              with $sn
            = match $(shape "find") $!s $!items $kn with
              | Err _ -> None
              | Ok $!i -> if $(shape "check_null") $!items.[$!i].value then None else Some ($ifr $!s $!items.[$!i].value) ) ])
    else if is_rec f then
      (let inner = name bt in
       let icn = concat "conforms_json_" inner in
       let ich = concat "check_json_" inner in
       let ifr = concat "from_dom_json_" inner in
       let iis = concat "json_is_" inner in
       let idf = concat "json_default_" inner in
       [ `( let spec $okn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool =
              exists (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                && $icn $!s $!items.[json_dom_j].value
                && (forall (json_dom_q in 0 .. len $!items).
                      $(shape "key_is") $!s $!items.[json_dom_q].key $kn ==> json_dom_q = json_dom_j) );
         `( let $chn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
              ensures $!result = $okn $!s $!items
            = match $(shape "find") $!s $!items $kn with
              | Err _ -> false
              | Ok $!i -> $(shape "only") $!s $!items $kn $!i && $ich $!s $!items.[$!i].value );
         `( let $vn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : $ft
              requires $okn $!s $!items
              ensures (forall (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                ==> $iis $!s $!items.[json_dom_j].value $!result)
            = match $(shape "find") $!s $!items $kn with
              | Ok $!i -> $ifr $!s $!items.[$!i].value
              | Err _ -> $idf ) ])
    else if is_arr f then
      (let l = lo i in let h = hi i in
       let n = arr_len f in
       let en = concat (concat (concat "json_elems_" tn) "_") f in
       let ecn = concat (concat (concat "json_check_elems_" tn) "_") f in
       let evn = concat (concat (concat "json_values_" tn) "_") f in
       let elem_ok = let (e) => if bool_field f then `( $(shape "is_bool") $e ) else `( $(shape "int_in") $!s $e $l $h ) in
       let elem_val = let (e) => if bool_field f then `( ($e = Pia.Text.Json.Dom.Bool true) ) else `( $(shape "int_value") $!s $e $l $h ) in
       let elem_check =
         if bool_field f then `( $(shape "check_bool") $!a.items.[$!k] )
         else `( (match $(shape "read_int") $!s $!a.items.[$!k] $l $h with | Ok _ -> true | Err _ -> false) ) in
       let elem_read =
         if bool_field f then `( $!r.[$!k] <- $(shape "bool_value") $!a.items.[$!k] )
         else `( (match $(shape "read_int") $!s $!a.items.[$!k] $l $h with
                  | Ok $!x -> (let $!y : $bt = $!x in $!r.[$!k] <- $!y)
                  | Err _ -> $!r.[$!k] <- $l) ) in
       let one = if bool_field f then `( false ) else `( $l ) in
       let inits = map (let (k) => one) (range n) in
       [ `( let spec $evn ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) ($!r : $ft) : bool =
              match $!v with
              | Arr $!a -> forall (json_dom_k in 0 .. len $!a.items). json_dom_k < $n ==> (let $!ek = $!a.items.[json_dom_k] in $!r.[json_dom_k] = $(elem_val `( $!ek )))
              | _ -> true );
         `( let spec $en ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) : bool =
              match $!v with
              | Arr $!a ->
                len $!a.items = $n
                && (forall (json_dom_k in 0 .. len $!a.items). (let $!ek = $!a.items.[json_dom_k] in $(elem_ok `( $!ek ))))
              | _ -> false );
         `( let $ecn ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) : bool
              ensures $!result = $en $!s $!v
            = match $!v with
              | Arr $!a ->
                if len $!a.items <> $n then false
                else
                  (let $!ok : mutable bool = true in
                   for $!k in 0 .. len $!a.items
                     invariant $!ok = (forall (json_dom_k in 0 .. $!k). (let $!ek = $!a.items.[json_dom_k] in $(elem_ok `( $!ek ))))
                   do
                     if $elem_check = false then $!ok <- false
                   done;
                   $!ok)
              | _ -> false );
         `( let spec $okn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool =
              exists (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                && $en $!s $!items.[json_dom_j].value
                && (forall (json_dom_q in 0 .. len $!items).
                      $(shape "key_is") $!s $!items.[json_dom_q].key $kn ==> json_dom_q = json_dom_j) );
         `( let $chn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
              ensures $!result = $okn $!s $!items
            = match $(shape "find") $!s $!items $kn with
              | Err _ -> false
              | Ok $!i -> $(shape "only") $!s $!items $kn $!i && $ecn $!s $!items.[$!i].value );
         `( let $vn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : $ft
              requires $okn $!s $!items
              ensures (forall (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                ==> $evn $!s $!items.[json_dom_j].value $!result)
            = (let $!r : mutable $ft = [ $inits ] in
               match $(shape "find") $!s $!items $kn with
               | Err _ -> $!r
               | Ok $!i ->
                 (match $!items.[$!i].value with
                  | Arr $!a ->
                    (for $!k in 0 .. $n
                       invariant forall (json_dom_k in 0 .. $!k). (let $!ek = $!a.items.[json_dom_k] in $!r.[json_dom_k] = $(elem_val `( $!ek )))
                     do
                       $elem_read
                     done;
                     $!r)
                  | _ -> $!r)) ) ])
    else if is_opt f then
      (let l = lo i in let h = hi i in
       let inner_ok = let (e) => if bool_field f then `( $(shape "is_bool") $e ) else `( $(shape "int_in") $!s $e $l $h ) in
       let inner_val = let (e) => if bool_field f then `( Some ($e = Pia.Text.Json.Dom.Bool true) ) else `( Some ($(shape "int_value") $!s $e $l $h) ) in
       let inner_check =
         if bool_field f then `( $(shape "check_bool") $!items.[$!i].value )
         else `( (match $(shape "read_int") $!s $!items.[$!i].value $l $h with | Ok _ -> true | Err _ -> false) ) in
       let inner_read =
         if bool_field f then `( Some ($(shape "bool_value") $!items.[$!i].value) )
         else `( (match $(shape "read_int") $!s $!items.[$!i].value $l $h with
                  | Ok $!x -> (let $!y : $bt = $!x in Some $!y)
                  | Err _ -> None) ) in
       [ `( let spec $okn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool =
              forall (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                ==> (($(shape "is_null") $!items.[json_dom_j].value || (let $!vj = $!items.[json_dom_j].value in $(inner_ok `( $!vj ))))
                     && (forall (json_dom_q in 0 .. len $!items).
                           $(shape "key_is") $!s $!items.[json_dom_q].key $kn ==> json_dom_q = json_dom_j)) );
         `( let $chn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
              ensures $!result = $okn $!s $!items
            = match $(shape "find") $!s $!items $kn with
              | Err _ -> true
              | Ok $!i ->
                $(shape "only") $!s $!items $kn $!i
                && ($(shape "check_null") $!items.[$!i].value || $inner_check) );
         `( let $vn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : $ft
              requires $okn $!s $!items
              ensures forall (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                ==> $!result = (if $(shape "is_null") $!items.[json_dom_j].value then None
                                else (let $!vj = $!items.[json_dom_j].value in $(inner_val `( $!vj ))))
              ensures (forall (json_dom_j in 0 .. len $!items). $(shape "key_is") $!s $!items.[json_dom_j].key $kn = false)
                ==> $!result = None
            = match $(shape "find") $!s $!items $kn with
              | Err _ -> None
              | Ok $!i -> if $(shape "check_null") $!items.[$!i].value then None else $inner_read ) ])
    else if bool_field f then
      [ `( let spec $okn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool =
             exists (json_dom_j in 0 .. len $!items).
               $(shape "key_is") $!s $!items.[json_dom_j].key $kn
               && $(shape "is_bool") $!items.[json_dom_j].value
               && (forall (json_dom_q in 0 .. len $!items).
                     $(shape "key_is") $!s $!items.[json_dom_q].key $kn ==> json_dom_q = json_dom_j) );
        `( let $chn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
             ensures $!result = $okn $!s $!items
           = match $(shape "find") $!s $!items $kn with
             | Err _ -> false
             | Ok $!i -> $(shape "only") $!s $!items $kn $!i && $(shape "check_bool") $!items.[$!i].value );
        `( let $vn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
             requires $okn $!s $!items
             ensures forall (json_dom_j in 0 .. len $!items).
               $(shape "key_is") $!s $!items.[json_dom_j].key $kn
               ==> $!result = ($!items.[json_dom_j].value = Pia.Text.Json.Dom.Bool true)
           = match $(shape "find") $!s $!items $kn with
             | Ok $!i -> $(shape "bool_value") $!items.[$!i].value
             | Err _ -> false ) ]
    else
      (let l = lo i in let h = hi i in
       [ `( let spec $okn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool =
              exists (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                && $(shape "int_in") $!s $!items.[json_dom_j].value $l $h
                && (forall (json_dom_q in 0 .. len $!items).
                      $(shape "key_is") $!s $!items.[json_dom_q].key $kn ==> json_dom_q = json_dom_j) );
         `( let $chn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
              ensures $!result = $okn $!s $!items
             = match $(shape "find") $!s $!items $kn with
              | Err _ -> false
              | Ok $!i ->
                $(shape "only") $!s $!items $kn $!i
                && (match $(shape "read_int") $!s $!items.[$!i].value $l $h with
                    | Ok _ -> true
                    | Err _ -> false) );
         `( let $vn ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : $ft
              requires $okn $!s $!items
              ensures forall (json_dom_j in 0 .. len $!items).
                $(shape "key_is") $!s $!items.[json_dom_j].key $kn
                ==> $!result = $(shape "int_value") $!s $!items.[json_dom_j].value $l $h
             = match $(shape "find") $!s $!items $kn with
              | Ok $!i ->
                (match $(shape "read_int") $!s $!items.[$!i].value $l $h with
                 | Ok $!x -> (let $!y : $ft = $!x in $!y)
                 | Err _ -> (let $!z : $ft = $l in $!z))
              | Err _ -> (let $!z : $ft = $l in $!z) ) ]) in
  (* With no option field, exactly one member per field leaves no room
     for another, so counting the members says it. A missing option
     member breaks the count, so then each member must be called one of
     the names. *)
  let knname = concat "json_known_" tn in
  let kncheck = concat "json_check_known_" tn in
  let named = let (e) => fold (let (acc) (i) => let kn = kname i in `( $acc || $(shape "key_is") $!s $e $kn )) `( false ) idx in
  let named_check = let (e) => fold (let (acc) (i) => let kn = kname i in `( $acc || $(shape "key_matches") $!s $e $kn )) `( false ) idx in
  let known_fns =
    if any_opt then
      [ `( let spec $knname ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool =
             forall (json_dom_j in 0 .. len $!items). (let $!kj = $!items.[json_dom_j].key in $(named `( $!kj ))) );
        `( let $kncheck ($!s : [u8]) ($!items : [Pia.Text.Json.Dom.member]) : bool
             ensures $!result = $knname $!s $!items
           = (let $!ok : mutable bool = true in
              for $!k in 0 .. len $!items
                invariant $!ok = (forall (json_dom_j in 0 .. $!k). (let $!kj = $!items.[json_dom_j].key in $(named `( $!kj ))))
              do
                if $(named_check `( $!items.[$!k].key )) = false then $!ok <- false
              done;
              $!ok) ) ]
    else [] in
  let all_ok = fold (let (acc) (i) => let okn = ok_name i in `( $acc && $okn $!s $!o.items ))
    (if any_opt then `( $knname $!s $!o.items ) else `( len $!o.items = $nf )) idx in
  let cname = concat "conforms_json_" tn in
  let conforms_fn =
    `( let spec $cname ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) : bool =
         match $!v with
         | Obj $!o -> $all_ok
         | _ -> false ) in
  let all_check = fold (let (acc) (i) => let chn = check_name i in `( $acc && $chn $!s $!o.items ))
    (if any_opt then `( $kncheck $!s $!o.items ) else `( len $!o.items = $nf )) idx in
  let chname = concat "check_json_" tn in
  let check_fn =
    `( let $chname ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) : bool
         ensures $!result = $cname $!s $!v
       = match $!v with
         | Obj $!o -> $all_check
         | _ -> false ) in
  let lowest = let (i) =>
    let f = nth fs i in
    let ft = field_type t f in
    if is_opt f then `( None )
    else if is_rec f then (let idf = concat "json_default_" (name (base f)) in `( $idf ))
    else if is_arr f then
      (let one = if bool_field f then `( false ) else (let l = lo i in `( $l )) in
       let inits = map (let (k) => one) (range (arr_len f)) in `( [ $inits ] ))
    else if bool_field f then `( false ) else (let l = lo i in `( (let $!z : $ft = $l in $!z) )) in
  let from_member = let (i) => let vn = value_name i in `( $vn $!s $!o.items ) in
  let record_of = let (val) => (let lit = map (let (i) => [ nth fs i; val i ]) idx in `( { $lit } )) in
  let field_post = let (i) =>
    let kn = kname i in
    let f = nth fs i in
    if and (is_opt f) (is_rec f) then
      (let sn = concat (concat (concat "json_some_" tn) "_") f in
       `( (forall (json_dom_j in 0 .. len $!o.items).
             $(shape "key_is") $!s $!o.items.[json_dom_j].key $kn
             ==> $sn $!s $!o.items.[json_dom_j].value $!x.$f)
          && ((forall (json_dom_j in 0 .. len $!o.items). $(shape "key_is") $!s $!o.items.[json_dom_j].key $kn = false)
              ==> (match $!x.$f with | $!None -> true | Some _ -> false)) ))
    else if is_rec f then
      (let iis = concat "json_is_" (name (base f)) in
       `( (forall (json_dom_j in 0 .. len $!o.items).
             $(shape "key_is") $!s $!o.items.[json_dom_j].key $kn
             ==> $iis $!s $!o.items.[json_dom_j].value $!x.$f) ))
    else if is_arr f then
      (let l = lo i in let h = hi i in
       let n = arr_len f in
       let elem_val = let (e) => if bool_field f then `( ($e = Pia.Text.Json.Dom.Bool true) ) else `( $(shape "int_value") $!s $e $l $h ) in
       let evn = concat (concat (concat "json_values_" tn) "_") f in
       `( (forall (json_dom_j in 0 .. len $!o.items).
             $(shape "key_is") $!s $!o.items.[json_dom_j].key $kn
             ==> $evn $!s $!o.items.[json_dom_j].value $!x.$f) ))
    else if is_opt f then
      (let l = lo i in let h = hi i in
       let inner_val = let (e) => if bool_field f then `( Some ($e = Pia.Text.Json.Dom.Bool true) ) else `( Some ($(shape "int_value") $!s $e $l $h) ) in
       `( (forall (json_dom_j in 0 .. len $!o.items).
             $(shape "key_is") $!s $!o.items.[json_dom_j].key $kn
             ==> $!x.$f = (if $(shape "is_null") $!o.items.[json_dom_j].value then None
                                else (let $!vj = $!o.items.[json_dom_j].value in $(inner_val `( $!vj )))))
          && ((forall (json_dom_j in 0 .. len $!o.items). $(shape "key_is") $!s $!o.items.[json_dom_j].key $kn = false)
              ==> $!x.$f = None) ))
    else if bool_field f then
      `( (forall (json_dom_j in 0 .. len $!o.items).
            $(shape "key_is") $!s $!o.items.[json_dom_j].key $kn
            ==> $!x.$f = ($!o.items.[json_dom_j].value = Pia.Text.Json.Dom.Bool true)) )
    else
      (let l = lo i in let h = hi i in
       `( (forall (json_dom_j in 0 .. len $!o.items).
             $(shape "key_is") $!s $!o.items.[json_dom_j].key $kn
             ==> $!x.$f = $(shape "int_value") $!s $!o.items.[json_dom_j].value $l $h) )) in
  let all_post = fold (let (acc) (i) => `( $acc && $(field_post i) )) `( true ) idx in
  (* `json_is_<t> s v x`: x is the value v denotes, field by field, which
     from_dom ensures and a type that nests this one states its field
     with. *)
  let isname = concat "json_is_" tn in
  let is_fn =
    `( let spec $isname ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) ($!x : $t) : bool =
         match $!v with
         | Obj $!o -> $all_post
         | _ -> true ) in
  let fname = concat "from_dom_json_" tn in
  let from_fn =
    `( let $fname ($!s : [u8]) ($!v : Pia.Text.Json.Dom.json) : $t
         requires $cname $!s $!v
         ensures $isname $!s $!v $!result
       = match $!v with
         | Obj $!o -> $(record_of from_member)
         | _ -> $(record_of lowest) ) in
  (* to_dom: @derive(json)'s writer writes the value into text, spaces
     fill the rest, and the document is parsed back and checked. Its Ok
     is proved valid and conforming by parse's and check's contracts; that
     the writer's text always conforms, so that Unparsed and Unconforming
     never happen, is not proved yet: it needs the writer's digits stated
     as Shape's. The room is the writer's, computed as json_record does. *)
  (* The writer's room, which @derive(json) emits as json_room_<t>. *)
  let room = concat "json_room_" tn in
  (* The object, and what nests inside it: an array field's array, a
     nested record's own depth. *)
  let depth = json_depth_of tn in
  let wname = concat "write_json_" tn in
  let tname = concat "to_dom_json_" tn in
  let to_fn =
    `( let $tname ($!x : $t) ($!text : borrowed inout mutable [u8]) ($!values : inout mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.json) ($!members : inout mutable Pia.Mem.Alloc.bump Pia.Text.Json.Dom.member) : result Pia.Text.Json.Dom.json Pia.Text.Json.Shape.to_dom_error
         ensures (match $!result with
           | Ok $!v -> Pia.Text.Json.Dom.valid_dom $!text $!v && $cname $!text $!v
           | Err _ -> true)
       = if len $!text < $room then Err NoRoom
         else
           (let $!n = $wname $!text 0 $!x in
            for $!k in $!n .. len $!text do $!text.[$!k] <- 0x20 done;
            match Pia.Text.Json.Dom.parse $!text $depth $!values $!members with
            | Err $!e -> Err (Unparsed $!e)
            | Ok $!v -> if $chname $!text $!v then Ok $!v else Err Unconforming) ) in
  concat (concat (concat key_consts (fold (let (acc) (i) => concat acc (field_fns i)) [] idx)) known_fns)
    [ conforms_fn; check_fn; is_fn; from_fn; to_fn ]

