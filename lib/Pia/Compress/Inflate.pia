(* Pia.Compress.Inflate: deflate decoding (RFC 1951; ADR 0054, step 5),
   proved total and safe on every input, into a caller's buffer, with no
   allocation.

   The decoder follows zlib's puff.c. Each block is stored, fixed Huffman
   or dynamic Huffman; codes are read with Pia.Compress.Huffman over
   tables the caller lends (a 320-byte buffer of code lengths and two
   704-byte tables). Proved, besides safety: every back-reference's
   distance is at most the bytes written so far, and its copy stays inside
   the output; the length and distance of each code are Inflate.Spec's
   base plus extra bits; a stored block's LEN is the complement of its
   NLEN; the code length code is complete; and a literal/length or
   distance code is complete, or a single code. codes_ref proves a
   Huffman block's theorem: given tables built from code lengths ll and
   dl, and x what the block's trace (Inflate.Ref) writes, it writes x.
   The whole stream's theorem is next; the run tests compare the output
   with zlib's. *)
module Pia.Compress.Inflate : Inflate

import Pia.Image.Bits.Bits as B
import Pia.Compress.Huffman.Huffman as H
import Pia.Compress.Inflate.Spec.Deflate as F
import Pia.Compress.Inflate.Ref.Ref as R

interface Inflate = sig
  let inflate_error = type
    | Ends of usize | BadBlock of usize | BadCode of usize
    | BadLengths of usize | TooFar of usize | Full of usize
  let inflated = type { written : usize; pos : usize }
  let inflate : (s : [u8]) -> (pos : usize) -> (dst : borrowed inout mutable [u8]) -> (lb : borrowed inout mutable [u8]) -> (ltab : borrowed inout mutable [u8]) -> (dtab : borrowed inout mutable [u8]) -> result inflated inflate_error
    requires len s <= 1152921504606846975 && pos <= B.nbits s
    requires len lb = 320 && len ltab = 704 && len dtab = 704
    ensures (match result with
      | Ok r -> r.written <= len dst && pos < r.pos && r.pos <= B.nbits s
      | Err _ -> true)
end

(** Ends: the input ends inside the block at the bit offset. BadBlock: a
    block type 3, or a stored block whose NLEN is not ~LEN. BadCode: a code
    no table holds, or a length or distance code past the end of its
    table. BadLengths: a dynamic block's code lengths do not make codes.
    TooFar: a distance past the start of the output. Full: the output
    buffer is full. *)
let inflate_error = type
  | Ends of usize | BadBlock of usize | BadCode of usize
  | BadLengths of usize | TooFar of usize | Full of usize

(** The bytes written, and the bit position after the last block. *)
let inflated = type { written : usize; pos : usize }

(* Where decoding is: the bit position and the bytes written. *)
let at = type { p : usize; o : usize }

(* The code lengths of a dynamic block, decoded: where it goes on, and how
   many literal/length and distance codes it has. *)
let dyn = type { dp : usize; nl : int{257..286}; nd : int{1..30} }

let len_extra_of (c : int{0..28}) : int{0..5}
  ensures result = F.len_extra c
= if c < 8 || c = 28 then 0 else (let e : int{0..5} = c / 4 - 1 in e)

let len_base_of (c : int{0..28}) : int{3..258}
  ensures result = F.len_base c
= if c < 8 then 3 + c
  else if c = 28 then 258
  else (let e : u16 = c / 4 - 1 in let m : u16 = 4 + (c & 3) in let v : int{3..258} = (m << e) + 3 in v)

let dist_extra_of (c : int{0..29}) : int{0..13}
  ensures result = F.dist_extra c
= if c < 4 then 0 else (let e : int{0..13} = c / 2 - 1 in e)

let dist_base_of (c : int{0..29}) : int{1..24577}
  ensures result = F.dist_base c
= if c < 4 then 1 + c
  else (let e : u16 = c / 2 - 1 in let m : u16 = 2 + (c & 1) in let v : int{1..24577} = (m << e) + 1 in v)

let clen_order_of (i : int{0..18}) : int{0..18}
  ensures result = F.clen_order i
= if i = 0 then 16 else if i = 1 then 17 else if i = 2 then 18 else if i = 3 then 0
  else if i = 4 then 8 else if i = 5 then 7 else if i = 6 then 9 else if i = 7 then 6
  else if i = 8 then 10 else if i = 9 then 5 else if i = 10 then 11 else if i = 11 then 4
  else if i = 12 then 12 else if i = 13 then 3 else if i = 14 then 13 else if i = 15 then 2
  else if i = 16 then 14 else if i = 17 then 1 else 15

(* A stored block from bit p: its LEN bytes copied to dst.[o ..]. *)
let stored (s : [u8]) (p : usize) (dst : borrowed inout mutable [u8]) (o : usize) : result at inflate_error
  requires len s <= 1152921504606846975 && p <= B.nbits s && o <= len dst
  ensures (match result with
    | Ok r -> p < r.p && r.p <= B.nbits s && o <= r.o && r.o <= len dst
    | Err _ -> true)
= let q : usize = (p + 7) / 8 in
  if q >= len s || len s - q < 4 then Err (Ends p)
  else (
    let lo : u16 = s.[q] in
    let hi : u16 = s.[q + 1] in
    let ln : u16 = (lo | (hi << 8)) in
    let nlo : u16 = s.[q + 2] in
    let nhi : u16 = s.[q + 3] in
    let nl : u16 = (nlo | (nhi << 8)) in
    if (ln ^ nl) <> 65535 then Err (BadBlock p)
    else if len s - q - 4 < ln then Err (Ends p)
    else if len dst - o < ln then Err (Full p)
    else (
      let n : usize = ln in
      for j in 0 .. n do dst.[o + j] <- s.[q + 4 + j] done;
      Ok { p = 8 * (q + 4 + n); o = o + n }))

(* The n-bit field at p, which the caller has checked is there. *)
let field (s : [u8]) (p : usize) (n : int{0..16}) : u32
  requires p + n <= B.nbits s
  ensures result < B.pow2 n && result = B.bits_at s p n
= B.read_bits s p n

(* What the trace says, where h holds, for codes_ref's loop: where it
   starts, and what its symbol j is. *)
let lemma start_when (h : bool) (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (p0 : usize) (o0 : usize) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) : unit
  requires h ==> R.blk_ok s ll nl dl nd x p0 o0 k tp ts td to
  ensures h ==> 1 <= k && k <= len tp && k <= len ts && k <= len td && k <= len to
  ensures h ==> tp.[0] = p0 && to.[0] = o0 && R.blk_from s ll nl dl nd x k tp ts td to 0
= if h then R.ok_start s ll nl dl nd x p0 o0 k tp ts td to else ()

let lemma step_when (h : bool) (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) : unit
  requires h ==> k <= len tp && k <= len ts && k <= len td && k <= len to && j < k
  requires h ==> R.blk_from s ll nl dl nd x k tp ts td to j
  ensures h ==> R.code_at s tp.[j] ll nl ts.[j] && to.[j] <= len x
  ensures h && j + 1 < k ==> R.blk_step s ll nl dl nd x tp ts td to j && R.blk_from s ll nl dl nd x k tp ts td to (j + 1)
  ensures h && j + 1 < k ==> ts.[j] <> 256 && ts.[j] <= 285 && to.[j] <= to.[j + 1] && to.[j + 1] <= len x
  ensures h && j + 1 = k ==> ts.[j] = 256
= if h then (
    R.from_step s ll nl dl nd x k tp ts td to j;
    if j + 1 < k then R.step_code s ll nl dl nd x tp ts td to j else ())
  else ()

(* The trace's facts for a literal at symbol j, the next at q. *)
let lemma lit_when (h : bool) (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) (q : usize) : unit
  requires h ==> k <= len tp && k <= len ts && k <= len td && k <= len to && j + 1 < k
  requires h ==> R.blk_step s ll nl dl nd x tp ts td to j && ts.[j] < 256
  requires h ==> ts.[j] < len ll && q = tp.[j] + ll.[ts.[j]]
  ensures h ==> tp.[j + 1] = q && to.[j + 1] - to.[j] = 1 && to.[j] < len x && x.[to.[j]] = ts.[j]
= if h then R.step_lit s ll nl dl nd x tp ts td to j q else ()

(* The trace's facts for length code 257 + c at symbol j, its extra bits
   at q. *)
let lemma len_when (h : bool) (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) (q : usize) (c : int{0..28}) : unit
  requires h ==> k <= len tp && k <= len ts && k <= len td && k <= len to && j + 1 < k
  requires h ==> R.blk_step s ll nl dl nd x tp ts td to j && 256 < ts.[j] && c = ts.[j] - 257
  requires h ==> ts.[j] < len ll && q = tp.[j] + ll.[ts.[j]]
  ensures h ==> F.len_extra c <= B.nbits s - q && td.[j] <= 29 && R.code_at s (q + F.len_extra c) dl nd td.[j]
= if h then R.step_len s ll nl dl nd x tp ts td to j q c else ()

(* The trace's facts for that code's distance code dc and copy, the
   distance's extra bits at qx. *)
let lemma dist_when (h : bool) (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) (q : usize) (c : int{0..28}) (qx : usize) (dc : int{0..29}) : unit
  requires h ==> k <= len tp && k <= len ts && k <= len td && k <= len to && j + 1 < k
  requires h ==> R.blk_step s ll nl dl nd x tp ts td to j && 256 < ts.[j] && c = ts.[j] - 257
  requires h ==> ts.[j] < len ll && q = tp.[j] + ll.[ts.[j]] && F.len_extra c <= B.nbits s - q
  requires h ==> td.[j] = dc && dc < len dl && qx = q + F.len_extra c + dl.[dc]
  ensures h ==> F.dist_extra dc <= B.nbits s - qx && tp.[j + 1] = qx + F.dist_extra dc
= if h then R.step_dist s ll nl dl nd x tp ts td to j q c qx dc else ()

(* The trace's facts for that code's copy of n bytes from dist back. *)
let lemma copy_at (h : bool) (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) (q : usize) (c : int{0..28}) (qx : usize) (dc : int{0..29}) (n : usize) (dist : usize) : unit
  requires h ==> k <= len tp && k <= len ts && k <= len td && k <= len to && j + 1 < k
  requires h ==> R.blk_step s ll nl dl nd x tp ts td to j && 256 < ts.[j] && c = ts.[j] - 257
  requires h ==> ts.[j] < len ll && q = tp.[j] + ll.[ts.[j]] && F.len_extra c <= B.nbits s - q
  requires h ==> td.[j] = dc && dc < len dl && qx = q + F.len_extra c + dl.[dc] && F.dist_extra dc <= B.nbits s - qx
  requires h ==> n = F.len_base c + B.bits_at s q (F.len_extra c) && dist = F.dist_base dc + B.bits_at s qx (F.dist_extra dc)
  ensures h ==> to.[j + 1] - to.[j] = n && R.copy_ok x to.[j] n dist
= if h then R.step_copy s ll nl dl nd x tp ts td to j q c qx dc n dist else ()

(* The symbol decode read at p is the trace's, because the code is
   prefix-free. *)
let lemma sym_when (h : bool) (s : [u8]) (p : usize) (q : usize) (l : [u8]) (n : int{0..320}) (ts : [int{0..319}]) (j : usize) (b : u16) : unit
  requires h ==> j < len ts && R.code_at s p l n ts.[j]
  requires h ==> b < n && n <= len l && p < q && q - p <= 15 && q <= B.nbits s
  requires h ==> l.[b] = q - p && H.code_of l n b = H.hbits s p (q - p)
  ensures h ==> ts.[j] = b
= if h then (let b' : int{0..319} = b in R.at_same s p l n ts.[j] b') else ()

(* decode fails only where no code is, and the trace has one at p. *)
let lemma miss_when (h : bool) (s : [u8]) (p : usize) (l : [u8]) (n : int{0..320}) (ts : [int{0..319}]) (j : usize) : unit
  requires h ==> j < len ts && R.code_at s p l n ts.[j]
  requires h ==> H.none_at s p l n
  ensures h ==> false
= if h then R.at_none s p l n ts.[j] else ()

let lemma copy_when (h : bool) (x : [u8]) (o : usize) (n : usize) (dist : usize) (d : usize) : unit
  requires h ==> R.copy_ok x o n dist && d < n
  ensures h ==> dist <= o && o + n <= len x && x.[o + d] = x.[o - dist + d]
= if h then R.copy_byte x o n dist d else ()

(** codes, with the block's theorem (ADR 0058): whenever h holds, the
    tables are the canonical codes of ll and dl, and x from o0 is what
    the block at p0 writes (R.blk_ok, by the trace tp, ts, td, to of its
    k symbols), with what is before o0 already in dst, codes returns Ok
    at the end of the block with x up to there in dst. The trace, ll, dl
    and x are spec state, which codegen erases. *)
let codes_ref (s : [u8]) (p0 : usize) (dst : borrowed inout mutable [u8]) (o0 : usize) (ltab : [u8]) (nl : int{1..288}) (dtab : [u8]) (nd : int{1..30}) (spec ll : [u8]) (spec dl : [u8]) (spec x : [u8]) (spec k : usize) (spec tp : [usize]) (spec ts : [int{0..319}]) (spec td : [int{0..319}]) (spec to : [usize]) (spec h : bool) : result at inflate_error
  requires len ltab = 704 && len dtab = 704 && p0 <= B.nbits s && o0 <= len dst
  requires h ==> nl <= len ll && H.room ll nl 1 && H.tab_from ltab ll nl 1
  requires h ==> nd <= len dl && H.room dl nd 1 && H.tab_from dtab dl nd 1
  requires h ==> R.blk_ok s ll nl dl nd x p0 o0 k tp ts td to && len x <= len dst
  requires h ==> (forall (i in 0 .. o0). dst.[i] = x.[i])
  ensures (match result with
    | Ok r -> p0 < r.p && r.p <= B.nbits s && o0 <= r.o && r.o <= len dst
    | Err _ -> true)
  ensures h ==> (match result with
    | Ok r -> (if k < 1 || k > len tp || k > len to || len ll <= 256 then false
               else r.p = tp.[k - 1] + ll.[256] && r.o = to.[k - 1] && (forall (i in 0 .. r.o). dst.[i] = x.[i]))
    | Err _ -> false)
= let nb = B.bit_len s in
  let p : mutable usize = p0 in
  let o : mutable usize = o0 in
  let st : mutable int{0..7} = 0 in
  let at' : mutable usize = p0 in
  let j : mutable usize = 0 in
  start_when h s ll nl dl nd x p0 o0 k tp ts td to;
  while st = 0
    invariant p0 <= p && p <= nb && o0 <= o && o <= len dst
    invariant st = 1 ==> p0 < p
    invariant h ==> nl <= len ll && nd <= len dl && len x <= len dst
    invariant h ==> k <= len tp && k <= len ts && k <= len td && k <= len to
    invariant h ==> (st = 0 || st = 1)
    invariant h ==> (forall (i in 0 .. o). dst.[i] = x.[i])
    invariant h && st = 0 ==> j < k && R.blk_from s ll nl dl nd x k tp ts td to j
    invariant h && st = 0 ==> p = tp.[j] && o = to.[j]
    invariant h && st = 1 ==> j + 1 = k && 256 < len ll && p = tp.[j] + ll.[256] && o = to.[j]
    decreases nb - p + (if st = 0 then 1 else 0)
  do
    step_when h s ll nl dl nd x k tp ts td to j;
    match H.decode s p ltab nl ll h with
    | Err e -> (miss_when h s p ll nl ts j; at' <- p; if e >= nb then st <- 2 else st <- 3)
    | Ok d -> (
        let here = p in
        sym_when h s p d.pos ll nl ts j d.sym;
        p <- d.pos;
        let sym = d.sym in
        if sym < 256 then (
          lit_when h s ll nl dl nd x k tp ts td to j p;
          if o >= len dst then (at' <- here; st <- 6)
          else (let v : u8 = sym in dst.[o] <- v; o <- o + 1; j <- j +| 1))
        else if sym = 256 then st <- 1
        else if sym > 285 then (at' <- here; st <- 3)
        else (
          let c : int{0..28} = sym - 257 in
          len_when h s ll nl dl nd x k tp ts td to j p c;
          let e = len_extra_of c in
          if e > nb - p then (at' <- here; st <- 2)
          else (
            let q = p in
            let ln : usize = len_base_of c + field s p e in
            p <- p + e;
            match H.decode s p dtab nd dl h with
            | Err e2 -> (miss_when h s p dl nd td j; at' <- p; if e2 >= nb then st <- 2 else st <- 3)
            | Ok dd -> (
                sym_when h s p dd.pos dl nd td j dd.sym;
                p <- dd.pos;
                if dd.sym > 29 then (at' <- here; st <- 3)
                else (
                  let dc : int{0..29} = dd.sym in
                  dist_when h s ll nl dl nd x k tp ts td to j q c p dc;
                  let de = dist_extra_of dc in
                  if de > nb - p then (at' <- here; st <- 2)
                  else (
                    let dist : usize = dist_base_of dc + field s p de in
                    copy_at h s ll nl dl nd x k tp ts td to j q c p dc ln dist;
                    p <- p + de;
                    copy_when h x o ln dist 0;
                    if dist > o then (at' <- here; st <- 5)
                    else if len dst - o < ln then (at' <- here; st <- 6)
                    else (
                      for jj in 0 .. ln
                        invariant h ==> (forall (i in 0 .. o + jj). dst.[i] = x.[i])
                      do
                        copy_when h x o ln dist jj;
                        dst.[o + jj] <- dst.[o + jj - dist]
                      done;
                      o <- o + ln;
                      j <- j +| 1)))))))
  done;
  if st = 1 then Ok { p = p; o = o }
  else if st = 2 then Err (Ends at')
  else if st = 3 then Err (BadCode at')
  else if st = 5 then Err (TooFar at')
  else Err (Full at')

(* The literals and back-references of a Huffman block, from bit p, up to
   its end code: codes_ref with no stream to compare against. *)
let codes (s : [u8]) (p0 : usize) (dst : borrowed inout mutable [u8]) (o0 : usize) (ltab : [u8]) (nl : int{1..288}) (dtab : [u8]) (nd : int{1..30}) : result at inflate_error
  requires len ltab = 704 && len dtab = 704 && p0 <= B.nbits s && o0 <= len dst
  ensures (match result with
    | Ok r -> p0 < r.p && r.p <= B.nbits s && o0 <= r.o && r.o <= len dst
    | Err _ -> true)
= let spec zu : [usize; 1] = zeros in
  let spec zs : [int{0..319}; 1] = zeros in
  codes_ref s p0 dst o0 ltab nl dtab nd s s s 0 zu zs zs zu false

(* The fixed code's tables. *)
let fixed_tables (lb : borrowed inout mutable [u8]) (ltab : borrowed inout mutable [u8]) (dtab : borrowed inout mutable [u8]) : unit
  requires len lb = 320 && len ltab = 704 && len dtab = 704
= for i in 0 .. 288 do
    lb.[i] <- (if i < 144 then 8 else if i < 256 then 9 else if i < 280 then 7 else 8)
  done;
  let f1 = H.build lb 288 ltab in
  for i in 0 .. 30 do lb.[i] <- 5 done;
  let f2 = H.build lb 30 dtab in
  ()

(* A literal/length or distance code is usable: complete, or one code. *)
let usable (lb : [u8]) (n : int{0..320}) (f : H.fill) : bool
  requires n <= len lb
= match f with
  | Complete -> true
  | Oversubscribed -> false
  | Incomplete -> (
      let used : mutable usize = 0 in
      for i in 0 .. n
        invariant used <= i
      do
        if lb.[i] <> 0 then used <- used + 1 else ()
      done;
      used = 1)

(* A dynamic block's header and code lengths from bit p, and its tables. *)
let dynamic (s : [u8]) (p0 : usize) (lb : borrowed inout mutable [u8]) (ltab : borrowed inout mutable [u8]) (dtab : borrowed inout mutable [u8]) : result dyn inflate_error
  requires len lb = 320 && len ltab = 704 && len dtab = 704 && p0 <= B.nbits s
  ensures (match result with
    | Ok r -> p0 < r.dp && r.dp <= B.nbits s
    | Err _ -> true)
= let nb = B.bit_len s in
  if 14 > nb - p0 then Err (Ends p0)
  else (
    let hlit : u32 = field s p0 5 + 257 in
    let hdist : u32 = field s (p0 + 5) 5 + 1 in
    let hclen : u32 = field s (p0 + 10) 4 + 4 in
    let p : mutable usize = p0 + 14 in
    if hlit > 286 || hdist > 30 then Err (BadLengths p0)
    else if 3 * hclen > nb - p then Err (Ends p0)
    else (
      let nl : int{257..286} = hlit in
      let nd : int{1..30} = hdist in
      for i in 0 .. 19 do lb.[i] <- 0 done;
      let hc : usize = hclen in
      for i in 0 .. hc
        invariant p + 3 * (hc - i) <= nb && p0 < p
      do
        let ii : int{0..18} = i in
        let v : u8 = field s p 3 in
        lb.[clen_order_of ii] <- v;
        p <- p + 3
      done;
      match H.build lb 19 ltab with
      | Incomplete -> Err (BadLengths p0)
      | Oversubscribed -> Err (BadLengths p0)
      | Complete -> (
          let total : usize = nl + nd in
          let k : mutable usize = 0 in
          let st : mutable int{0..3} = 0 in
          let at' : mutable usize = p in
          while st = 0 && k < total
            invariant k <= total && p0 < p && p <= nb
            decreases nb - p + (if st = 0 then 1 else 0)
          do
            match H.decode s p ltab 19 lb false with
            | Err e -> (at' <- p; if e >= nb then st <- 1 else st <- 2)
            | Ok d -> (
                p <- d.pos;
                let sym = d.sym in
                if sym < 16 then (let v : u8 = sym in lb.[k] <- v; k <- k + 1)
                else (
                  let eb : int{0..7} = (if sym = 16 then 2 else if sym = 17 then 3 else 7) in
                  if eb > nb - p then (at' <- p; st <- 1)
                  else (
                    let x : usize = field s p eb in
                    p <- p + eb;
                    let rep : usize = (if sym = 16 then 3 + x else if sym = 17 then 3 + x else 11 + x) in
                    if sym = 16 && k = 0 then (at' <- p; st <- 2)
                    else if rep > total - k then (at' <- p; st <- 2)
                    else (
                      let v : u8 = (if sym = 16 then lb.[k - 1] else 0) in
                      for r in 0 .. rep do lb.[k + r] <- v done;
                      k <- k + rep))))
          done;
          if st = 1 then Err (Ends at')
          else if st = 2 then Err (BadLengths at')
          else if lb.[256] = 0 then Err (BadLengths p0)
          else (
            let fl = H.build lb nl ltab in
            let dl = lb.[nl .. nl + nd] in
            let fd = H.build dl nd dtab in
            if usable lb nl fl = false || usable dl nd fd = false then Err (BadLengths p0)
            else Ok { dp = p; nl = nl; nd = nd }))))

(** Decodes the deflate stream starting at bit pos of s into dst, and
    returns the bytes written and the bit position after the last block.
    lb, ltab and dtab are scratch. *)
let inflate (s : [u8]) (pos : usize) (dst : borrowed inout mutable [u8]) (lb : borrowed inout mutable [u8]) (ltab : borrowed inout mutable [u8]) (dtab : borrowed inout mutable [u8]) : result inflated inflate_error
  requires len s <= 1152921504606846975 && pos <= B.nbits s
  requires len lb = 320 && len ltab = 704 && len dtab = 704
  ensures (match result with
    | Ok r -> r.written <= len dst && pos < r.pos && r.pos <= B.nbits s
    | Err _ -> true)
= let nb = B.bit_len s in
  let p : mutable usize = pos in
  let o : mutable usize = 0 in
  let last : mutable bool = false in
  let err : mutable bool = false in
  let e' : mutable inflate_error = Ends 0 in
  while last = false && err = false
    invariant pos <= p && p <= nb && o <= len dst
    invariant last ==> pos < p
    decreases nb - p + (if last = false && err = false then 1 else 0)
  do
    if 3 > nb - p then (err <- true; e' <- Ends p)
    else (
      let final = field s p 1 in
      let ty = field s (p + 1) 2 in
      p <- p + 3;
      let r : result at inflate_error =
        (if ty = 0 then stored s p dst o
         else if ty = 1 then (fixed_tables lb ltab dtab; codes s p dst o ltab 288 dtab 30)
         else if ty = 2 then (
           match dynamic s p lb ltab dtab with
           | Ok d -> codes s d.dp dst o ltab d.nl dtab d.nd
           | Err x -> Err x)
         else Err (BadBlock p)) in
      match r with
      | Ok a -> (p <- a.p; o <- a.o; if final = 1 then last <- true else ())
      | Err x -> (err <- true; e' <- x))
  done;
  if err then Err e' else Ok { written = o; pos = p }
