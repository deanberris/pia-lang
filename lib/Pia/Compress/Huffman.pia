(* Pia.Compress.Huffman: canonical Huffman codes from code lengths, as
   deflate (RFC 1951, section 3.2.2) defines them, with the completeness
   check and decoding (ADR 0054, step 5).

   A table is 704 bytes the caller lends: the number of codes of each
   length 0 to 15 (u16 at bytes 2 len), the symbols in canonical order
   (u16 at 32 + 2 i, up to 320 of them), and scratch offsets (u16 at
   672 + 2 len). `build` fills it from the lengths of n symbols and
   returns how complete the code is, by the Kraft sum `kraft`: each code
   of length l takes 2^(15 - l) of the 2^15 the code space holds.
   `decode` reads one code a bit at a time, as puff.c does: the codes of
   each length are consecutive, so a code of length l is the symbol at
   its offset from the first code of that length.

   `len_count`, `first_code` and `code_of` are the canonical code itself, the
   three steps of RFC 1951 3.2.2, and `hbits` is the bits of a code as the
   stream holds them. build is proved to fill its table as the canonical
   code says (`tab_from`), and decode, given such a table and a code
   within the Kraft bound (`room`, which `kraft_room` gives from `kraft l
   n <= 32768`), to return the symbol whose code is the bits it read. The
   RFC's own example is proved of them too (`rfc_example`). *)
module Pia.Compress.Huffman : Huffman

import Pia.Image.Bits.Bits as B

interface Huffman = sig
  let fill = type | Complete | Incomplete | Oversubscribed
  let decoded = type { sym : u16; pos : usize }
  let spec weight : (l : u8) -> int{0..32768}
  let spec kcap : (k : int{0..320}) -> u32
  let spec kraft : (l : [u8]) -> (k : int{0..320}) -> u32
  let spec len_count : (l : [u8]) -> (k : int{0..320}) -> (bits : int{1..15}) -> int{0..320}
  let spec first_code : (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..15}) -> u32
  let spec code_of : (l : [u8]) -> (n : int{0..320}) -> (sym : int{0..319}) -> u32
  let spec hbits : (s : [u8]) -> (pos : usize) -> (k : int{0..15}) -> u32
  let spec room : (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..16}) -> bool
  let spec offs : (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..16}) -> int{0..4800}
  let spec u16at : (t : [u8]) -> (i : usize) -> u16
  let spec sym_ok : (t : [u8]) -> (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..15}) -> (i : int{0..319}) -> (r : int{0..320}) -> bool
  let spec tab_from : (t : [u8]) -> (l : [u8]) -> (n : int{0..320}) -> (bits : int{1..16}) -> bool
  let spec miss : (s : [u8]) -> (pos : usize) -> (l : [u8]) -> (n : int{0..320}) -> (b : int{1..15}) -> bool
  let spec none_at : (s : [u8]) -> (pos : usize) -> (l : [u8]) -> (n : int{0..320}) -> bool
  let build : (l : [u8]) -> (n : int{0..320}) -> (t : borrowed inout mutable [u8]) -> fill
    requires len t = 704 && n <= len l
    ensures result = Complete <==> kraft l n = 32768
    ensures result = Oversubscribed <==> kraft l n > 32768
    ensures tab_from t l n 1
  let decode : (s : [u8]) -> (pos : usize) -> (t : [u8]) -> (n : int{0..320}) -> (spec l : [u8]) -> (spec h : bool) -> result decoded usize
    requires len t = 704 && pos <= B.nbits s
    requires h ==> n <= len l && room l n 1 && tab_from t l n 1
    ensures (match result with
      | Ok d -> pos < d.pos && d.pos - pos <= 15 && d.pos <= B.nbits s && d.sym < n
      | Err p -> p <= B.nbits s)
    ensures h ==> (match result with
      | Ok d -> (if d.sym < len l && d.sym < n && n <= len l && pos < d.pos && d.pos - pos <= 15 then (if l.[d.sym] = d.pos - pos then code_of l n d.sym = hbits s pos (d.pos - pos) else false) else false)
      | Err _ -> none_at s pos l n)
  let lemma kraft_room : (l : [u8]) -> (n : int{0..320}) -> (b : int{1..16}) -> unit
    requires n <= len l && kraft l n <= 32768
    ensures room l n b
  let lemma kraft_run : (l : [u8]) -> (a : int{0..320}) -> (b : int{0..320}) -> (c : u8) -> unit
    requires a <= b && b <= len l
    requires forall (i in a .. b). l.[i] = c
    ensures kraft l b = kraft l a + (b - a) * weight c
  let lemma code_same : (l : [u8]) -> (m : [u8]) -> (n : int{0..320}) -> (sym : int{0..319}) -> unit
    requires n <= len l && n <= len m && sym < n && 1 <= l.[sym] && l.[sym] <= 15
    requires forall (i in 0 .. n). l.[i] = m.[i]
    ensures m.[sym] = l.[sym] && code_of m n sym = code_of l n sym
  let lemma prefix_free : (s : [u8]) -> (p : usize) -> (l : [u8]) -> (n : int{0..320}) -> (a : int{0..319}) -> (b : int{0..319}) -> unit
    requires a < n && b < n && n <= len l
    requires 1 <= l.[a] && l.[a] <= 15 && 1 <= l.[b] && l.[b] <= 15
    requires p <= B.nbits s && l.[a] <= B.nbits s - p && l.[b] <= B.nbits s - p
    requires code_of l n a = hbits s p l.[a] && code_of l n b = hbits s p l.[b]
    ensures a = b
  let lemma no_code : (s : [u8]) -> (pos : usize) -> (l : [u8]) -> (n : int{0..320}) -> (sym : int{0..319}) -> unit
    requires pos <= B.nbits s && n <= len l && sym < n && 1 <= l.[sym] && l.[sym] <= 15
    requires none_at s pos l n
    ensures l.[sym] > B.nbits s - pos || code_of l n sym <> hbits s pos l.[sym]
end

(** How complete a code is. *)
let fill = type | Complete | Incomplete | Oversubscribed

(** A decoded symbol, and the bit position after its code. *)
let decoded = type { sym : u16; pos : usize }

(** The share of the code space a code of length l takes: 2^(15 - l), or
    none for an unused symbol. Lengths over 15 take more than all of it. *)
let spec weight (l : u8) : int{0..32768} =
  if l = 0 then 0 else if l > 15 then 32768 else (let one : u16 = 32768 in let w : int{0..32768} = one >> l in w)

(** 2^15 for each of k symbols: more than k lengths can sum to. *)
let spec kcap (k : int{0..320}) : u32 =
  (let c : int{0..32768} = 32768 in let kk : int{0..320} = k in kk * c)

(** The Kraft sum of the first k lengths, in units of 2^-15. *)
let spec kraft (l : [u8]) (k : int{0..320}) : u32 @opaque
  requires k <= len l
  ensures result <= kcap k
  decreases k
= if k = 0 then 0 else (let k' : int{0..319} = k - 1 in kraft l k' + weight l.[k'])

(** The canonical code of RFC 1951 3.2.2, which build's tables hold and
    decode reads (ADR 0054, step 5): how many of the first k lengths are
    bits long, step 1. *)
let spec len_count (l : [u8]) (k : int{0..320}) (bits : int{1..15}) : int{0..320} @opaque
  requires k <= len l
  ensures result <= k
  decreases k
= if k = 0 then 0
  else (let k' : int{0..319} = k - 1 in len_count l k' bits + (if l.[k'] = bits then 1 else 0))

(** The first code of length bits, step 2: next_code. *)
let spec first_code (l : [u8]) (n : int{0..320}) (bits : int{1..15}) : u32
  requires n <= len l
  ensures result + 640 <= 640 * B.pow2 (bits - 1)
  decreases bits
= if bits = 1 then 0
  else (let b : int{1..14} = bits - 1 in 2 * (first_code l n b + len_count l n b))

(** Symbol sym's code, step 3: the first code of its length, plus the
    symbols of that length before it. *)
let spec code_of (l : [u8]) (n : int{0..320}) (sym : int{0..319}) : u32
  requires sym < n && n <= len l && 1 <= l.[sym] && l.[sym] <= 15
= first_code l n l.[sym] + len_count l sym l.[sym]

(** The k bits at pos read as a Huffman code: deflate packs a code first
    bit first, so the first bit read is the most significant (3.1.1). *)
let spec hbits (s : [u8]) (pos : usize) (k : int{0..15}) : u32
  requires pos <= B.nbits s && k <= B.nbits s - pos
  ensures result < B.pow2 k
  decreases k
= if k = 0 then 0
  else (let k' : int{0..14} = k - 1 in 2 * hbits s pos k' + B.bit s (pos + k'))

(** Where length bits' symbols start in a table: how many symbols are
    shorter. *)
let spec offs (l : [u8]) (n : int{0..320}) (bits : int{1..16}) : int{0..4800} @fuel(1)
  requires n <= len l
  ensures result <= 320 * (bits - 1)
  decreases bits
= if bits = 1 then 0
  else (let b : int{1..15} = bits - 1 in let v : int{0..4800} = offs l n b + len_count l n b in v)

(** From length bits up, the codes of each length fit below 2^bits: what
    a code within the Kraft bound has, one length at a time. *)
let spec room (l : [u8]) (n : int{0..320}) (bits : int{1..16}) : bool @opaque
  requires n <= len l
  decreases 16 - bits
= if bits = 16 then true
  else (let b : int{1..15} = bits in
    if first_code l n b + len_count l n b > B.pow2 b then false
    else room l n (bits + 1))

(* The Kraft sum by length: each length's count times its weight, for
   the first k lengths. Written out, so each weight is a constant. *)
(* The Kraft sum by length on values: count i weighs 2^(15 - i). Opaque,
   so the step lemmas see it as one term. *)
let spec kflat (a1 : int{0..320}) (a2 : int{0..320}) (a3 : int{0..320}) (a4 : int{0..320}) (a5 : int{0..320}) (a6 : int{0..320}) (a7 : int{0..320}) (a8 : int{0..320}) (a9 : int{0..320}) (a10 : int{0..320}) (a11 : int{0..320}) (a12 : int{0..320}) (a13 : int{0..320}) (a14 : int{0..320}) (a15 : int{0..320}) : u32 @opaque
= a1 * 16384u32 + a2 * 8192u32 + a3 * 4096u32 + a4 * 2048u32 + a5 * 1024u32 + a6 * 512u32 + a7 * 256u32 + a8 * 128u32 + a9 * 64u32 + a10 * 32u32 + a11 * 16u32 + a12 * 8u32 + a13 * 4u32 + a14 * 2u32 + a15 * 1u32

let spec ksum (l : [u8]) (k : int{0..320}) : u32
  requires k <= len l
= kflat (len_count l k 1) (len_count l k 2) (len_count l k 3) (len_count l k 4) (len_count l k 5) (len_count l k 6) (len_count l k 7) (len_count l k 8) (len_count l k 9) (len_count l k 10) (len_count l k 11) (len_count l k 12) (len_count l k 13) (len_count l k 14) (len_count l k 15)

(* One more length adds one to its own count: len_count's step, the
   only place the step lemmas below reveal it. *)
let lemma lc_succ (l : [u8]) (k : int{0..319}) (i : int{1..15}) : unit
  requires k < len l
  ensures len_count l (k + 1) i = len_count l k i + (if l.[k] = i then 1 else 0)
  with len_count
= ()

(* The step lemmas below work on plain values, so that no goal sees
   len_count: one more length adds one to its own count only. Five
   lengths at a time keep each goal small. *)
let lemma g5 (x : u8) (i : int{0..10}) (a1 : int{0..320}) (a2 : int{0..320}) (a3 : int{0..320}) (a4 : int{0..320}) (a5 : int{0..320}) (b1 : int{0..320}) (b2 : int{0..320}) (b3 : int{0..320}) (b4 : int{0..320}) (b5 : int{0..320}) : unit
  requires b1 = a1 + (if x = i + 1 then 1 else 0) && b2 = a2 + (if x = i + 2 then 1 else 0) && b3 = a3 + (if x = i + 3 then 1 else 0) && b4 = a4 + (if x = i + 4 then 1 else 0) && b5 = a5 + (if x = i + 5 then 1 else 0)
  ensures b1 + b2 + b3 + b4 + b5 = a1 + a2 + a3 + a4 + a5 + (if i + 1 <= x && x <= i + 5 then 1 else 0)
= ()

(* Five counts weighted 16, 8, 4, 2, 1. *)
let spec w5v (a1 : int{0..320}) (a2 : int{0..320}) (a3 : int{0..320}) (a4 : int{0..320}) (a5 : int{0..320}) : u32 = a1 * 16u32 + a2 * 8u32 + a3 * 4u32 + a4 * 2u32 + a5 * 1u32

let lemma gw5 (x : u8) (i : int{0..10}) (a1 : int{0..320}) (a2 : int{0..320}) (a3 : int{0..320}) (a4 : int{0..320}) (a5 : int{0..320}) (b1 : int{0..320}) (b2 : int{0..320}) (b3 : int{0..320}) (b4 : int{0..320}) (b5 : int{0..320}) : unit
  requires b1 = a1 + (if x = i + 1 then 1 else 0) && b2 = a2 + (if x = i + 2 then 1 else 0) && b3 = a3 + (if x = i + 3 then 1 else 0) && b4 = a4 + (if x = i + 4 then 1 else 0) && b5 = a5 + (if x = i + 5 then 1 else 0)
  ensures w5v b1 b2 b3 b4 b5 = w5v a1 a2 a3 a4 a5 + (if x = i + 1 then 16 else if x = i + 2 then 8 else if x = i + 3 then 4 else if x = i + 4 then 2 else if x = i + 5 then 1 else 0)
= ()

(* ksum's step on values: the 15 counts a before and b after. *)
let lemma ks_vals (x : u8) (a1 : int{0..320}) (a2 : int{0..320}) (a3 : int{0..320}) (a4 : int{0..320}) (a5 : int{0..320}) (a6 : int{0..320}) (a7 : int{0..320}) (a8 : int{0..320}) (a9 : int{0..320}) (a10 : int{0..320}) (a11 : int{0..320}) (a12 : int{0..320}) (a13 : int{0..320}) (a14 : int{0..320}) (a15 : int{0..320}) (b1 : int{0..320}) (b2 : int{0..320}) (b3 : int{0..320}) (b4 : int{0..320}) (b5 : int{0..320}) (b6 : int{0..320}) (b7 : int{0..320}) (b8 : int{0..320}) (b9 : int{0..320}) (b10 : int{0..320}) (b11 : int{0..320}) (b12 : int{0..320}) (b13 : int{0..320}) (b14 : int{0..320}) (b15 : int{0..320}) : unit
  requires b1 = a1 + (if x = 1 then 1 else 0) && b2 = a2 + (if x = 2 then 1 else 0) && b3 = a3 + (if x = 3 then 1 else 0) && b4 = a4 + (if x = 4 then 1 else 0) && b5 = a5 + (if x = 5 then 1 else 0)
  requires b6 = a6 + (if x = 6 then 1 else 0) && b7 = a7 + (if x = 7 then 1 else 0) && b8 = a8 + (if x = 8 then 1 else 0) && b9 = a9 + (if x = 9 then 1 else 0) && b10 = a10 + (if x = 10 then 1 else 0)
  requires b11 = a11 + (if x = 11 then 1 else 0) && b12 = a12 + (if x = 12 then 1 else 0) && b13 = a13 + (if x = 13 then 1 else 0) && b14 = a14 + (if x = 14 then 1 else 0) && b15 = a15 + (if x = 15 then 1 else 0)
  ensures kflat b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 = kflat a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 + (if 1 <= x && x <= 15 then weight x else 0)
  with kflat
= gw5 x 0 a1 a2 a3 a4 a5 b1 b2 b3 b4 b5; gw5 x 5 a6 a7 a8 a9 a10 b6 b7 b8 b9 b10; gw5 x 10 a11 a12 a13 a14 a15 b11 b12 b13 b14 b15;
  assert a1 * 16384u32 + a2 * 8192u32 + a3 * 4096u32 + a4 * 2048u32 + a5 * 1024u32 + a6 * 512u32 + a7 * 256u32 + a8 * 128u32 + a9 * 64u32 + a10 * 32u32 + a11 * 16u32 + a12 * 8u32 + a13 * 4u32 + a14 * 2u32 + a15 * 1u32 = w5v a1 a2 a3 a4 a5 * 1024u32 + w5v a6 a7 a8 a9 a10 * 32u32 + w5v a11 a12 a13 a14 a15;
  assert b1 * 16384u32 + b2 * 8192u32 + b3 * 4096u32 + b4 * 2048u32 + b5 * 1024u32 + b6 * 512u32 + b7 * 256u32 + b8 * 128u32 + b9 * 64u32 + b10 * 32u32 + b11 * 16u32 + b12 * 8u32 + b13 * 4u32 + b14 * 2u32 + b15 * 1u32 = w5v b1 b2 b3 b4 b5 * 1024u32 + w5v b6 b7 b8 b9 b10 * 32u32 + w5v b11 b12 b13 b14 b15

(* ctotal's step on values. *)
let lemma ct_vals (x : u8) (a1 : int{0..320}) (a2 : int{0..320}) (a3 : int{0..320}) (a4 : int{0..320}) (a5 : int{0..320}) (a6 : int{0..320}) (a7 : int{0..320}) (a8 : int{0..320}) (a9 : int{0..320}) (a10 : int{0..320}) (a11 : int{0..320}) (a12 : int{0..320}) (a13 : int{0..320}) (a14 : int{0..320}) (a15 : int{0..320}) (b1 : int{0..320}) (b2 : int{0..320}) (b3 : int{0..320}) (b4 : int{0..320}) (b5 : int{0..320}) (b6 : int{0..320}) (b7 : int{0..320}) (b8 : int{0..320}) (b9 : int{0..320}) (b10 : int{0..320}) (b11 : int{0..320}) (b12 : int{0..320}) (b13 : int{0..320}) (b14 : int{0..320}) (b15 : int{0..320}) : unit
  requires b1 = a1 + (if x = 1 then 1 else 0) && b2 = a2 + (if x = 2 then 1 else 0) && b3 = a3 + (if x = 3 then 1 else 0) && b4 = a4 + (if x = 4 then 1 else 0) && b5 = a5 + (if x = 5 then 1 else 0)
  requires b6 = a6 + (if x = 6 then 1 else 0) && b7 = a7 + (if x = 7 then 1 else 0) && b8 = a8 + (if x = 8 then 1 else 0) && b9 = a9 + (if x = 9 then 1 else 0) && b10 = a10 + (if x = 10 then 1 else 0)
  requires b11 = a11 + (if x = 11 then 1 else 0) && b12 = a12 + (if x = 12 then 1 else 0) && b13 = a13 + (if x = 13 then 1 else 0) && b14 = a14 + (if x = 14 then 1 else 0) && b15 = a15 + (if x = 15 then 1 else 0)
  ensures b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + b10 + b11 + b12 + b13 + b14 + b15 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + (if 1 <= x && x <= 15 then 1 else 0)
= g5 x 0 a1 a2 a3 a4 a5 b1 b2 b3 b4 b5; g5 x 5 a6 a7 a8 a9 a10 b6 b7 b8 b9 b10; g5 x 10 a11 a12 a13 a14 a15 b11 b12 b13 b14 b15;
  assert a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 = (a1 + a2 + a3 + a4 + a5) + (a6 + a7 + a8 + a9 + a10) + (a11 + a12 + a13 + a14 + a15);
  assert b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + b10 + b11 + b12 + b13 + b14 + b15 = (b1 + b2 + b3 + b4 + b5) + (b6 + b7 + b8 + b9 + b10) + (b11 + b12 + b13 + b14 + b15)

(* One more length moves ksum by its weight, when it is 1 to 15. *)
let lemma ks_step (l : [u8]) (k : int{0..319}) : unit
  requires k < len l
  ensures ksum l (k + 1) = ksum l k + (if 1 <= l.[k] && l.[k] <= 15 then weight l.[k] else 0)
= let k1 : int{1..320} = k + 1 in
  lc_succ l k 1;
  lc_succ l k 2;
  lc_succ l k 3;
  lc_succ l k 4;
  lc_succ l k 5;
  lc_succ l k 6;
  lc_succ l k 7;
  lc_succ l k 8;
  lc_succ l k 9;
  lc_succ l k 10;
  lc_succ l k 11;
  lc_succ l k 12;
  lc_succ l k 13;
  lc_succ l k 14;
  lc_succ l k 15;
  ks_vals l.[k] (len_count l k 1) (len_count l k 2) (len_count l k 3) (len_count l k 4) (len_count l k 5) (len_count l k 6) (len_count l k 7) (len_count l k 8) (len_count l k 9) (len_count l k 10) (len_count l k 11) (len_count l k 12) (len_count l k 13) (len_count l k 14) (len_count l k 15) (len_count l k1 1) (len_count l k1 2) (len_count l k1 3) (len_count l k1 4) (len_count l k1 5) (len_count l k1 6) (len_count l k1 7) (len_count l k1 8) (len_count l k1 9) (len_count l k1 10) (len_count l k1 11) (len_count l k1 12) (len_count l k1 13) (len_count l k1 14) (len_count l k1 15)

(* The sum by length is at most the Kraft sum, which counts lengths over
   15 too. *)
let lemma ks_kraft (l : [u8]) (k : int{0..320}) : unit
  requires k <= len l
  ensures ksum l k <= kraft l k
  decreases k
  with kraft, len_count, kflat
= if k > 0 then (let k' : int{0..319} = k - 1 in ks_kraft l k'; ks_step l k') else ()

(* Within the Kraft bound, the codes of length b fit below 2^b: for each
   b, first_code unfolds to a sum of counts with constant weights. *)
let lemma room_at (l : [u8]) (n : int{0..320}) (b : int{1..15}) : unit @fuel(16) @allow(deep_fuel)
  requires n <= len l && kraft l n <= 32768
  ensures first_code l n b + len_count l n b <= B.pow2 b
  with kflat
= ks_kraft l n;
  if b = 1 then assert first_code l n b + len_count l n b <= 2
  else if b = 2 then assert first_code l n b + len_count l n b <= 4
  else if b = 3 then assert first_code l n b + len_count l n b <= 8
  else if b = 4 then assert first_code l n b + len_count l n b <= 16
  else if b = 5 then assert first_code l n b + len_count l n b <= 32
  else if b = 6 then assert first_code l n b + len_count l n b <= 64
  else if b = 7 then assert first_code l n b + len_count l n b <= 128
  else if b = 8 then assert first_code l n b + len_count l n b <= 256
  else if b = 9 then assert first_code l n b + len_count l n b <= 512
  else if b = 10 then assert first_code l n b + len_count l n b <= 1024
  else if b = 11 then assert first_code l n b + len_count l n b <= 2048
  else if b = 12 then assert first_code l n b + len_count l n b <= 4096
  else if b = 13 then assert first_code l n b + len_count l n b <= 8192
  else if b = 14 then assert first_code l n b + len_count l n b <= 16384
  else assert first_code l n b + len_count l n b <= 32768

(* A code within the Kraft bound has room at every length from b up. *)
let lemma kraft_room (l : [u8]) (n : int{0..320}) (b : int{1..16}) : unit
  requires n <= len l && kraft l n <= 32768
  ensures room l n b
  decreases 16 - b
  with room
= if b < 16 then (
    let bb : int{1..15} = b in
    room_at l n bb;
    let b1 : int{1..16} = b + 1 in
    kraft_room l n b1)
  else ()

(** The little-endian u16 at t.[i]. *)
let spec u16at (t : [u8]) (i : usize) : u16
  requires i < len t && 1 < len t - i
= let lo : u16 = t.[i] in let hi : u16 = t.[i + 1] in (lo | (hi << 8))

(** The symbol at place i of table t is the r-th symbol of length bits. *)
let spec sym_ok (t : [u8]) (l : [u8]) (n : int{0..320}) (bits : int{1..15}) (i : int{0..319}) (r : int{0..320}) : bool
  requires len t = 704 && n <= len l
= let sy : u16 = u16at t (32 + 2 * i) in
  if sy >= n then false else l.[sy] = bits && len_count l sy bits = r

(** From length bits up, table t holds the canonical code of the n
    lengths l: how many codes each length has, and its symbols in
    order. One length at a time, so decode takes its facts length by
    length. *)
let spec tab_from (t : [u8]) (l : [u8]) (n : int{0..320}) (bits : int{1..16}) : bool @opaque
  requires len t = 704 && n <= len l
  decreases 16 - bits
= if bits = 16 then true
  else (
    let b : int{1..15} = bits in
    if u16at t (2 * b) <> len_count l n b then false
    else if offs l n b + len_count l n b > 320 then false
    else if tab_from t l n (bits + 1) = false then false
    else (forall (r in 0 .. len_count l n b). sym_ok t l n b (offs l n b + r) r))

(* RFC 1951's example in 3.2.2: lengths (2, 1, 3, 3) give the codes 10, 0,
   110 and 111. *)
let lemma rfc_example (l : [u8]) : unit @fuel(5) @allow(deep_fuel)
  requires len l = 4 && l.[0] = 2 && l.[1] = 1 && l.[2] = 3 && l.[3] = 3
  ensures code_of l 4 0 = 2 && code_of l 4 1 = 0 && code_of l 4 2 = 6 && code_of l 4 3 = 7
  with len_count
= ()

(* weight, in code. *)
let weight_of (l : u8) : int{0..32768}
  ensures result = weight l
= if l = 0 then 0 else if l > 15 then 32768 else (let one : u16 = 32768 in let w : int{0..32768} = one >> l in w)

let get16 (t : [u8]) (i : usize) : u16 @allow(duplicate_function)
  requires i < len t && 1 < len t - i
  ensures result = u16at t i
= let lo : u16 = t.[i] in
  let hi : u16 = t.[i + 1] in
  (lo | (hi << 8))

let put16 (t : borrowed inout mutable [u8]) (i : usize) (v : u16) : unit
  requires i < len t && 1 < len t - i
  ensures u16at t i = v && len t = old (len t)
  ensures forall (j in 0 .. len t). j <> i && j <> i + 1 ==> t.[j] = old (t.[j])
= let lo : u8 = v & 0xFF in
  let hi : u8 = v >> 8 in
  t.[i] <- lo;
  t.[i + 1] <- hi

(* How many of the first k lengths are 1 to 15, written out. *)
let spec ctotal (l : [u8]) (k : int{0..320}) : int{0..4800}
  requires k <= len l
= len_count l k 1 + len_count l k 2 + len_count l k 3 + len_count l k 4 + len_count l k 5 + len_count l k 6 + len_count l k 7 + len_count l k 8 + len_count l k 9 + len_count l k 10 + len_count l k 11 + len_count l k 12 + len_count l k 13 + len_count l k 14 + len_count l k 15

(* At most one per length. *)
let lemma ct_le (l : [u8]) (k : int{0..320}) : unit
  requires k <= len l
  ensures ctotal l k <= k
  decreases k
= if k > 0 then (
    let k' : int{0..319} = k - 1 in
    ct_le l k';
    lc_succ l k' 1;
    lc_succ l k' 2;
    lc_succ l k' 3;
    lc_succ l k' 4;
    lc_succ l k' 5;
    lc_succ l k' 6;
    lc_succ l k' 7;
    lc_succ l k' 8;
    lc_succ l k' 9;
    lc_succ l k' 10;
    lc_succ l k' 11;
    lc_succ l k' 12;
    lc_succ l k' 13;
    lc_succ l k' 14;
    lc_succ l k' 15;
    ct_vals l.[k'] (len_count l k' 1) (len_count l k' 2) (len_count l k' 3) (len_count l k' 4) (len_count l k' 5) (len_count l k' 6) (len_count l k' 7) (len_count l k' 8) (len_count l k' 9) (len_count l k' 10) (len_count l k' 11) (len_count l k' 12) (len_count l k' 13) (len_count l k' 14) (len_count l k' 15) (len_count l k 1) (len_count l k 2) (len_count l k 3) (len_count l k 4) (len_count l k 5) (len_count l k 6) (len_count l k 7) (len_count l k 8) (len_count l k 9) (len_count l k 10) (len_count l k 11) (len_count l k 12) (len_count l k 13) (len_count l k 14) (len_count l k 15);
    assert ctotal l k = ctotal l k' + (if 1 <= l.[k'] && l.[k'] <= 15 then 1 else 0))
  else ()

(* Length b's symbols end within the n symbols: offs, unfolded for each
   b, adds the counts below it. *)
let lemma offs_fit (l : [u8]) (n : int{0..320}) (b : int{1..15}) : unit @fuel(16) @allow(deep_fuel)
  requires n <= len l
  ensures offs l n b + len_count l n b <= n
= ct_le l n;
  if b = 1 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 2 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 3 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 4 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 5 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 6 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 7 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 8 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 9 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 10 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 11 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 12 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 13 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 14 then assert offs l n b + len_count l n b <= ctotal l n
  else if b = 15 then assert offs l n b + len_count l n b <= ctotal l n
  else ()

(* Shorter lengths' symbols come first. *)
let lemma offs_order (l : [u8]) (n : int{0..320}) : unit
  requires n <= len l
  ensures forall (c in 1 .. 16) (d in 1 .. 16). c < d ==> offs l n c + len_count l n c <= offs l n d
= for d in 2 .. 16
    invariant forall (c in 1 .. 16) (e in 1 .. d). c < e ==> offs l n c + len_count l n c <= offs l n e
  do
    let d' : int{1..15} = d - 1 in
    assert offs l n d = offs l n d' + len_count l n d'
  done

(* More symbols, no fewer of each length. *)
let lemma lc_le (l : [u8]) (a : int{0..320}) (c : int{0..320}) (b : int{1..15}) : unit
  requires a <= c && c <= len l
  ensures len_count l a b <= len_count l c b
  decreases c - a
  with len_count
= if c > a then (let c' : int{0..319} = c - 1 in lc_le l a c' b) else ()

(* tab_from from its facts at every length. *)
let lemma tab_intro (t : [u8]) (l : [u8]) (n : int{0..320}) (b : int{1..16}) : unit
  requires len t = 704 && n <= len l
  requires forall (c in 1 .. 16). u16at t (2 * c) = len_count l n c
  requires forall (c in 1 .. 16). offs l n c + len_count l n c <= 320
  requires forall (c in 1 .. 16) (r in 0 .. len_count l n c). sym_ok t l n c (offs l n c + r) r
  ensures tab_from t l n b
  decreases 16 - b
  with tab_from
= if b < 16 then (let b1 : int{1..16} = b + 1 in tab_intro t l n b1) else ()

(* Every length's symbols fit in the table. *)
let lemma tab_facts (t : [u8]) (l : [u8]) (n : int{0..320}) : unit
  requires len t = 704 && n <= len l
  ensures forall (c in 1 .. 16). offs l n c + len_count l n c <= 320
= for c in 1 .. 16
    invariant forall (e in 1 .. c). offs l n e + len_count l n e <= 320
  do offs_fit l n c done

(** Fills table t with the canonical code of the n lengths in l, and says
    whether the code is complete. *)
let build (l : [u8]) (n : int{0..320}) (t : borrowed inout mutable [u8]) : fill
  requires len t = 704 && n <= len l
  ensures result = Complete <==> kraft l n = 32768
  ensures result = Oversubscribed <==> kraft l n > 32768
  ensures tab_from t l n 1
  with kraft, len_count
= for j in 0 .. 704
    invariant len t = 704 && (forall (i in 0 .. j). t.[i] = 0)
  do t.[j] <- 0 done;
  (* The counts, and the Kraft sum. *)
  let sum : mutable u32 = 0 in
  let k : mutable int{0..320} = 0 in
  while k < n
    invariant k <= n && sum = kraft l k && sum <= kcap k
    invariant len t = 704 && (forall (c in 1 .. 16). u16at t (2 * c) = len_count l k c)
    decreases n - k
  do
    let len' = l.[k] in
    (if len' <= 15 then (
       let c = get16 t (2 * len') in
       if c < 65535 then put16 t (2 * len') (c + 1) else ())
     else ());
    sum <- sum + weight_of len';
    k <- k + 1
  done;
  (* The offset of each length's first symbol, then the symbols. *)
  let off : mutable u16 = 0 in
  for len' in 1 .. 16
    invariant len t = 704 && (forall (c in 1 .. 16). u16at t (2 * c) = len_count l n c)
    invariant off = offs l n len'
    invariant forall (c in 1 .. len'). u16at t (672 + 2 * c) = offs l n c
  do
    let l' : usize = len' in
    offs_fit l n len';
    put16 t (672 + 2 * l') off;
    off <- off +| get16 t (2 * l')
  done;
  offs_order l n;
  for sy in 0 .. n
    invariant len t = 704 && (forall (c in 1 .. 16). u16at t (2 * c) = len_count l n c)
    invariant forall (c in 1 .. 16). u16at t (672 + 2 * c) = offs l n c + len_count l sy c
    invariant forall (c in 1 .. 16). len_count l sy c <= len_count l n c
    invariant forall (c in 1 .. 16) (r in 0 .. len_count l sy c). sym_ok t l n c (offs l n c + r) r
  do
    let len' = l.[sy] in
    if len' > 0 && len' <= 15 then (
      let l' : usize = len' in
      let o = get16 t (672 + 2 * l') in
      lc_le l (sy + 1) n len';
      offs_fit l n len';
      if o < 320 then (
        let sv : u16 = sy in
        put16 t (32 + 2 * o) sv;
        put16 t (672 + 2 * l') (o + 1))
      else ())
    else ()
  done;
  tab_facts t l n;
  tab_intro t l n 1;
  if sum = 32768 then Complete else if sum > 32768 then Oversubscribed else Incomplete

(* What tab_from and room say of length b, for decode, which keeps them
   opaque: b's count, its symbols in canonical order, room for its codes,
   and the same from b + 1 up. *)
let lemma tab_step (h : bool) (t : [u8]) (l : [u8]) (n : int{0..320}) (b : u8) : unit
  requires len t = 704
  requires h ==> n <= len l
  requires h && 1 <= b && b <= 15 ==> tab_from t l n b && room l n b
  ensures (if h && 1 <= b && b <= 15 then u16at t (2 * b) = len_count l n b && offs l n b + len_count l n b <= 320 && first_code l n b + len_count l n b <= B.pow2 b && tab_from t l n (b + 1) && room l n (b + 1) && (forall (r in 0 .. len_count l n b). sym_ok t l n b (offs l n b + r) r) else true)
  with tab_from, room
= ()

(* No code of length b is the b bits at pos: they run past the input, or
   fall outside length b's codes. *)
let spec miss (s : [u8]) (pos : usize) (l : [u8]) (n : int{0..320}) (b : int{1..15}) : bool
  requires pos <= B.nbits s && n <= len l
= if b > B.nbits s - pos then true
  else (let v : u32 = hbits s pos b in v < first_code l n b || v >= first_code l n b + len_count l n b)

(* No code at all is at pos. Opaque, so a caller that passes h = false
   carries one atom, not the quantifier. *)
let spec none_at (s : [u8]) (pos : usize) (l : [u8]) (n : int{0..320}) : bool @opaque
= if pos > B.nbits s || n > len l then false
  else (forall (b in 1 .. 16). miss s pos l n b)

(* none_at from its definition, where h holds: the one place decode
   needs it revealed. *)
let lemma none_when (h : bool) (s : [u8]) (pos : usize) (l : [u8]) (n : int{0..320}) : unit
  requires pos <= B.nbits s
  requires h ==> n <= len l && (forall (b in 1 .. 16). miss s pos l n b)
  ensures h ==> n <= len l && none_at s pos l n
  with none_at
= ()

(** The symbol whose code starts at bit pos of s, read a bit at a time, or
    where the input ends or names no code. *)
let decode (s : [u8]) (pos : usize) (t : [u8]) (n : int{0..320}) (spec l : [u8]) (spec h : bool) : result decoded usize
  requires len t = 704 && pos <= B.nbits s
  requires h ==> n <= len l && room l n 1 && tab_from t l n 1
  ensures (match result with
    | Ok d -> pos < d.pos && d.pos - pos <= 15 && d.pos <= B.nbits s && d.sym < n
    | Err p -> p <= B.nbits s)
  ensures h ==> (match result with
    | Ok d -> (if d.sym < len l && d.sym < n && n <= len l && pos < d.pos && d.pos - pos <= 15 then (if l.[d.sym] = d.pos - pos then code_of l n d.sym = hbits s pos (d.pos - pos) else false) else false)
    | Err _ -> none_at s pos l n)
= let nb = B.bit_len s in
  let p : mutable usize = pos in
  let code : mutable u32 = 0 in
  let first : mutable u32 = 0 in
  let index : mutable u32 = 0 in
  let len' : mutable u8 = 1 in
  let st : mutable int{0..3} = 0 in
  let sym : mutable u16 = 0 in
  while st = 0
    invariant 1 <= len' && len' <= 16 && pos <= p && p - pos <= len' && p <= nb
    invariant st = 0 ==> p - pos + 1 = len'
    invariant code < 65536 && first < 65536 && index <= 65535
    invariant st = 1 ==> (pos < p && p - pos <= 15 && sym < n)
    invariant st >= 2 ==> p <= nb
    invariant h && st = 0 && len' <= 15 ==> tab_from t l n len' && room l n len'
    invariant h && st = 0 && len' <= 15 ==> code = 2 * hbits s pos (len' - 1)
    invariant h && st = 0 && len' <= 15 ==> first = first_code l n len' && index = offs l n len'
    invariant h && st = 1 ==> l.[sym] = p - pos && code_of l n sym = hbits s pos (p - pos)
    invariant h && st <> 1 ==> (forall (b in 1 .. len'). miss s pos l n b)
    invariant h && st = 2 ==> p = nb && p - pos + 1 = len'
    invariant h && st = 3 ==> len' = 16
    decreases 17 - len' + (if st = 0 then 1 else 0)
  do
    tab_step h t l n len';
    if len' > 15 then st <- 3
    else if p >= nb then st <- 2
    else (
      let bit = B.read_bits s p 1 in
      code <- code | bit;
      p <- p + 1;
      let count : u32 = get16 t (2 * len') in
      if code >= first && code - first < count then (
        let i : u32 = index + (code - first) in
        assert h ==> i < 320;
        if i < 320 then (
          let v = get16 t (32 + 2 * i) in
          assert h ==> sym_ok t l n len' (offs l n len' + (code - first)) (code - first);
          assert h ==> v < n && l.[v] = len' && len_count l v len' = code - first;
          if v < n then (sym <- v; st <- 1) else st <- 3)
        else st <- 3)
      else (
        index <- (if index + count > 65535 then 65535 else index + count);
        let f2 : u32 = first + count in
        first <- (if f2 > 32767 then 65535 else f2 << 1);
        code <- (if code > 32767 then 65535 else code << 1);
        len' <- len' + 1))
  done;
  if st = 1 then Ok { sym = sym; pos = p } else (none_when h s pos l n; Err p)

(* The canonical code is prefix-free. hbits splits at any length a: the
   first a bits, shifted up, then the rest. *)
let lemma hbits_split (s : [u8]) (p : usize) (a : int{0..15}) (b : int{0..15}) : unit
  requires a <= b && p <= B.nbits s && b <= B.nbits s - p
  ensures hbits s p b = hbits s p a * B.pow2 (b - a) + hbits s (p + a) (b - a)
  decreases b - a
= if b > a then (let b' : int{0..14} = b - 1 in hbits_split s p a b') else ()

(* Longer codes start past every prefix of the shorter ones. *)
let lemma fc_grow (l : [u8]) (n : int{0..320}) (a : int{1..15}) (b : int{1..15}) : unit
  requires a < b && n <= len l
  ensures first_code l n b >= (first_code l n a + len_count l n a) * B.pow2 (b - a)
  decreases b - a
= if b > a + 1 then (let b' : int{1..14} = b - 1 in fc_grow l n a b') else ()

(* A later symbol of the same length has a larger count before it. *)
let lemma lc_lt (l : [u8]) (a : int{0..319}) (c : int{0..320}) (x : int{1..15}) : unit
  requires a < c && c <= len l && l.[a] = x
  ensures len_count l a x < len_count l c x
= lc_succ l a x;
  let a1 : int{1..320} = a + 1 in
  lc_le l a1 c x

(* Two symbols whose codes are read at the same position are one symbol. *)
let lemma code_unique (s : [u8]) (p : usize) (l : [u8]) (n : int{0..320}) (a : int{0..319}) (b : int{0..319}) : unit
  requires a < n && b < n && n <= len l
  requires 1 <= l.[a] && l.[a] <= l.[b] && l.[b] <= 15
  requires p <= B.nbits s && l.[b] <= B.nbits s - p
  requires code_of l n a = hbits s p l.[a] && code_of l n b = hbits s p l.[b]
  ensures a = b
= let la : int{1..15} = l.[a] in
  let lb : int{1..15} = l.[b] in
  lc_lt l a n la;
  if la < lb then (
    hbits_split s p la lb;
    fc_grow l n la lb;
    assert false)
  else if a < b then (lc_lt l a b la; assert false)
  else if b < a then (lc_lt l b a la; assert false)
  else ()

(* Either way round. *)
let lemma prefix_free (s : [u8]) (p : usize) (l : [u8]) (n : int{0..320}) (a : int{0..319}) (b : int{0..319}) : unit
  requires a < n && b < n && n <= len l
  requires 1 <= l.[a] && l.[a] <= 15 && 1 <= l.[b] && l.[b] <= 15
  requires p <= B.nbits s && l.[a] <= B.nbits s - p && l.[b] <= B.nbits s - p
  requires code_of l n a = hbits s p l.[a] && code_of l n b = hbits s p l.[b]
  ensures a = b
= if l.[a] <= l.[b] then code_unique s p l n a b else code_unique s p l n b a

(* none_at at one length. *)
let lemma none_miss (s : [u8]) (pos : usize) (l : [u8]) (n : int{0..320}) (b : int{1..15}) : unit
  requires pos <= B.nbits s && n <= len l && none_at s pos l n
  ensures miss s pos l n b
  with none_at
= ()

(* When decode misses at every length, no symbol's code is at pos. *)
let lemma no_code (s : [u8]) (pos : usize) (l : [u8]) (n : int{0..320}) (sym : int{0..319}) : unit
  requires pos <= B.nbits s && n <= len l && sym < n && 1 <= l.[sym] && l.[sym] <= 15
  requires none_at s pos l n
  ensures l.[sym] > B.nbits s - pos || code_of l n sym <> hbits s pos l.[sym]
= let b : int{1..15} = l.[sym] in
  none_miss s pos l n b;
  lc_lt l sym n b

(* The Kraft sum over a run of equal lengths, for a code given as runs,
   as the fixed code is. *)
let lemma kraft_run (l : [u8]) (a : int{0..320}) (b : int{0..320}) (c : u8) : unit
  requires a <= b && b <= len l
  requires forall (i in a .. b). l.[i] = c
  ensures kraft l b = kraft l a + (b - a) * weight c
  decreases b - a
  with kraft
= if b > a then (let b' : int{0..319} = b - 1 in kraft_run l a b' c) else ()

(* The canonical code depends only on the lengths, not on which buffer
   holds them: len_count, first_code and code_of agree on two buffers
   whose first n lengths are the same. *)
let lemma lc_same (l : [u8]) (m : [u8]) (k : int{0..320}) (b : int{1..15}) : unit
  requires k <= len l && k <= len m
  requires forall (i in 0 .. k). l.[i] = m.[i]
  ensures len_count m k b = len_count l k b
  decreases k
  with len_count
= if k > 0 then (let k' : int{0..319} = k - 1 in lc_same l m k' b) else ()

let lemma fc_same (l : [u8]) (m : [u8]) (n : int{0..320}) (b : int{1..15}) : unit
  requires n <= len l && n <= len m
  requires forall (i in 0 .. n). l.[i] = m.[i]
  ensures first_code m n b = first_code l n b
  decreases b
= if b > 1 then (let b' : int{1..14} = b - 1 in fc_same l m n b'; lc_same l m n b') else ()

let lemma code_same (l : [u8]) (m : [u8]) (n : int{0..320}) (sym : int{0..319}) : unit
  requires n <= len l && n <= len m && sym < n && 1 <= l.[sym] && l.[sym] <= 15
  requires forall (i in 0 .. n). l.[i] = m.[i]
  ensures m.[sym] = l.[sym] && code_of m n sym = code_of l n sym
= let b : int{1..15} = l.[sym] in
  fc_same l m n b;
  lc_same l m sym b
