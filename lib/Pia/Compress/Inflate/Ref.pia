(* Pia.Compress.Inflate.Ref: what a deflate stream says, as a trace of
   its blocks (stream_ok: stored, or in the fixed code, so far) and of a
   Huffman block's symbols (RFC 1951, section 3.2.5; ADR 0054,
   step 5), for a decoder to be proved against.

   Symbol j of the trace is the literal/length code ts.[j] at bit tp.[j],
   in the code whose lengths are ll (nl symbols). A literal is the byte
   at to.[j] of the output x. A length code is followed by its extra
   bits, the distance code td.[j] in the code whose lengths are dl (nd
   symbols) and its extra bits, and writes the bytes from to.[j] to
   to.[j + 1] as copies of the bytes dist before them, one at a time, so
   that a copy may overlap what it writes. The last symbol is the end
   code, 256. A code is read where the canonical code (Pia.Compress.
   Huffman) has it, so a decoder that returns the symbol whose code it
   read returns the trace's symbol, because the code is prefix-free.

   The trace is a recursion over the symbols (blk_from), not a
   quantified step, and it and copy_ok are opaque, so that a decoder's
   loop takes its facts one symbol at a time (skills/pia-contracts,
   "A whole-stream theorem").

   Block bi of a stream starts at bit bp.[bi] and writes x from bo.[bi]
   to bo.[bi + 1]; a block in the fixed code is the trace's symbols
   bj.[bi] to bj.[bi + 1] - 1, read with the lengths fl and fd, which
   fixed_ok says are the fixed code's. A decoder whose tables hold the
   same lengths in other buffers reads the same codes (same_lens,
   at_moved). *)
module Pia.Compress.Inflate.Ref : Ref

import Pia.Image.Bits.Bits as B
import Pia.Compress.Huffman.Huffman as H
import Pia.Compress.Inflate.Spec.Deflate as F

interface Ref = sig
  let spec code_at : (s : [u8]) -> (p : usize) -> (l : [u8]) -> (n : int{0..320}) -> (sym : int{0..319}) -> bool
  let spec copy_ok : (x : [u8]) -> (o : usize) -> (n : usize) -> (dist : usize) -> bool
  let spec dist_tail : (s : [u8]) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (tp : [usize]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> (qd : usize) -> (n : usize) -> bool
  let spec blk_step : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> bool
  let spec blk_from : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (k : usize) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> bool
  let spec blk_ok : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (p0 : usize) -> (o0 : usize) -> (j0 : usize) -> (k : usize) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> bool
  let lemma at_same : (s : [u8]) -> (p : usize) -> (l : [u8]) -> (n : int{0..320}) -> (a : int{0..319}) -> (b : int{0..319}) -> unit
    requires code_at s p l n a
    requires b < n && n <= len l && 1 <= l.[b] && l.[b] <= 15 && p <= B.nbits s && l.[b] <= B.nbits s - p
    requires H.code_of l n b = H.hbits s p l.[b]
    ensures a = b
  let lemma at_none : (s : [u8]) -> (p : usize) -> (l : [u8]) -> (n : int{0..320}) -> (a : int{0..319}) -> unit
    requires code_at s p l n a && H.none_at s p l n
    ensures false
  let lemma copy_byte : (x : [u8]) -> (o : usize) -> (n : usize) -> (dist : usize) -> (d : usize) -> unit
    requires copy_ok x o n dist && d < n
    ensures 1 <= dist && dist <= o && o + n <= len x && x.[o + d] = x.[o - dist + d]
  let lemma step_code : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> unit
    requires j + 1 < len tp && j + 1 < len ts && j + 1 < len td && j + 1 < len to
    requires blk_step s ll nl dl nd x tp ts td to j
    ensures code_at s tp.[j] ll nl ts.[j] && ts.[j] <> 256 && ts.[j] <= 285
    ensures to.[j] <= to.[j + 1] && to.[j + 1] <= len x
  let lemma step_lit : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> (q : usize) -> unit
    requires j + 1 < len tp && j + 1 < len ts && j + 1 < len td && j + 1 < len to
    requires blk_step s ll nl dl nd x tp ts td to j && ts.[j] < 256
    requires ts.[j] < len ll && q = tp.[j] + ll.[ts.[j]]
    ensures tp.[j + 1] = q && to.[j + 1] - to.[j] = 1 && to.[j] < len x && x.[to.[j]] = ts.[j]
  let lemma step_len : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> (q : usize) -> (c : int{0..28}) -> unit
    requires j + 1 < len tp && j + 1 < len ts && j + 1 < len td && j + 1 < len to
    requires blk_step s ll nl dl nd x tp ts td to j && 256 < ts.[j] && c = ts.[j] - 257
    requires ts.[j] < len ll && q = tp.[j] + ll.[ts.[j]]
    ensures F.len_extra c <= B.nbits s - q && td.[j] <= 29 && code_at s (q + F.len_extra c) dl nd td.[j]
  let lemma step_dist : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> (q : usize) -> (c : int{0..28}) -> (qx : usize) -> (dc : int{0..29}) -> unit
    requires j + 1 < len tp && j + 1 < len ts && j + 1 < len td && j + 1 < len to
    requires blk_step s ll nl dl nd x tp ts td to j && 256 < ts.[j] && c = ts.[j] - 257
    requires ts.[j] < len ll && q = tp.[j] + ll.[ts.[j]] && F.len_extra c <= B.nbits s - q
    requires td.[j] = dc && dc < len dl && qx = q + F.len_extra c + dl.[dc]
    ensures F.dist_extra dc <= B.nbits s - qx && tp.[j + 1] = qx + F.dist_extra dc
  let lemma step_copy : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> (q : usize) -> (c : int{0..28}) -> (qx : usize) -> (dc : int{0..29}) -> (n : usize) -> (dist : usize) -> unit
    requires j + 1 < len tp && j + 1 < len ts && j + 1 < len td && j + 1 < len to
    requires blk_step s ll nl dl nd x tp ts td to j && 256 < ts.[j] && c = ts.[j] - 257
    requires ts.[j] < len ll && q = tp.[j] + ll.[ts.[j]] && F.len_extra c <= B.nbits s - q
    requires td.[j] = dc && dc < len dl && qx = q + F.len_extra c + dl.[dc] && F.dist_extra dc <= B.nbits s - qx
    requires n = F.len_base c + B.bits_at s q (F.len_extra c) && dist = F.dist_base dc + B.bits_at s qx (F.dist_extra dc)
    ensures to.[j + 1] - to.[j] = n && copy_ok x to.[j] n dist
  let lemma from_step : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (k : usize) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (j : usize) -> unit
    requires k <= len tp && k <= len ts && k <= len td && k <= len to && j < k
    requires blk_from s ll nl dl nd x k tp ts td to j
    ensures j + 1 < k ==> blk_step s ll nl dl nd x tp ts td to j && blk_from s ll nl dl nd x k tp ts td to (j + 1)
    ensures j + 1 = k ==> code_at s tp.[j] ll nl ts.[j] && ts.[j] = 256 && to.[j] <= len x
  let lemma ok_start : (s : [u8]) -> (ll : [u8]) -> (nl : int{1..288}) -> (dl : [u8]) -> (nd : int{1..30}) -> (x : [u8]) -> (p0 : usize) -> (o0 : usize) -> (j0 : usize) -> (k : usize) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> unit
    requires blk_ok s ll nl dl nd x p0 o0 j0 k tp ts td to
    ensures j0 < k && k <= len tp && k <= len ts && k <= len td && k <= len to
    ensures tp.[j0] = p0 && to.[j0] = o0
    ensures blk_from s ll nl dl nd x k tp ts td to j0
  let spec same_lens : (l : [u8]) -> (m : [u8]) -> (n : int{0..320}) -> bool
  let lemma at_moved : (s : [u8]) -> (p : usize) -> (l : [u8]) -> (m : [u8]) -> (n : int{0..320}) -> (a : int{0..319}) -> unit
    requires code_at s p l n a && same_lens l m n
    ensures code_at s p m n a && m.[a] = l.[a]
  let spec fixed_ok : (fl : [u8]) -> (fd : [u8]) -> bool
  let lemma fixed_same : (fl : [u8]) -> (fd : [u8]) -> (lb : [u8]) -> (db : [u8]) -> unit
    requires fixed_ok fl fd && 288 <= len lb && 30 <= len db
    requires forall (i in 0 .. 288). lb.[i] = F.fixed_length i
    requires forall (i in 0 .. 30). db.[i] = 5
    ensures same_lens fl lb 288 && same_lens fd db 30 && 288 <= len fl && 30 <= len fd
  let spec stored_copy : (s : [u8]) -> (q : usize) -> (x : [u8]) -> (o : usize) -> (n : usize) -> bool
  let lemma stored_byte : (s : [u8]) -> (q : usize) -> (x : [u8]) -> (o : usize) -> (n : usize) -> (d : usize) -> unit
    requires stored_copy s q x o n && d < n
    ensures q + 4 + n <= len s && o + n <= len x && x.[o + d] = s.[q + 4 + d]
  let spec block_ok : (s : [u8]) -> (x : [u8]) -> (fl : [u8]) -> (fd : [u8]) -> (nbk : usize) -> (bp : [usize]) -> (bo : [usize]) -> (bj : [usize]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (bi : usize) -> bool
  let lemma block_head : (s : [u8]) -> (x : [u8]) -> (fl : [u8]) -> (fd : [u8]) -> (nbk : usize) -> (bp : [usize]) -> (bo : [usize]) -> (bj : [usize]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (bi : usize) -> unit
    requires bi < nbk && nbk < len bp && nbk < len bo && nbk < len bj
    requires block_ok s x fl fd nbk bp bo bj tp ts td to bi
    ensures bp.[bi] <= B.nbits s && 3 <= B.nbits s - bp.[bi]
    ensures (if bp.[bi] > B.nbits s then false else if 3 > B.nbits s - bp.[bi] then false else (B.bits_at s bp.[bi] 1 = 1) = (bi + 1 = nbk))
    ensures bo.[bi] <= bo.[bi + 1] && bo.[bi + 1] <= len x
    ensures (if bp.[bi] > B.nbits s then false else if 3 > B.nbits s - bp.[bi] then false else B.bits_at s (bp.[bi] + 1) 2 <= 1)
  let lemma block_stored : (s : [u8]) -> (x : [u8]) -> (fl : [u8]) -> (fd : [u8]) -> (nbk : usize) -> (bp : [usize]) -> (bo : [usize]) -> (bj : [usize]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (bi : usize) -> (q : usize) -> unit
    requires bi < nbk && nbk < len bp && nbk < len bo && nbk < len bj
    requires block_ok s x fl fd nbk bp bo bj tp ts td to bi && (if bp.[bi] > B.nbits s then false else if 3 > B.nbits s - bp.[bi] then false else B.bits_at s (bp.[bi] + 1) 2 = 0)
    requires q = (bp.[bi] + 3 + 7) / 8
    ensures q < len s && 4 <= len s - q && F.stored_ok s q
    ensures F.stored_len s q <= len s - q - 4 && bo.[bi + 1] - bo.[bi] = F.stored_len s q
    ensures bp.[bi + 1] = 8 * (q + 4 + F.stored_len s q) && bj.[bi + 1] = bj.[bi] && stored_copy s q x bo.[bi] (F.stored_len s q)
  let lemma block_fixed : (s : [u8]) -> (x : [u8]) -> (fl : [u8]) -> (fd : [u8]) -> (nbk : usize) -> (bp : [usize]) -> (bo : [usize]) -> (bj : [usize]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (bi : usize) -> unit
    requires bi < nbk && nbk < len bp && nbk < len bo && nbk < len bj
    requires block_ok s x fl fd nbk bp bo bj tp ts td to bi && (if bp.[bi] > B.nbits s then false else if 3 > B.nbits s - bp.[bi] then false else B.bits_at s (bp.[bi] + 1) 2 = 1)
    ensures bj.[bi] < bj.[bi + 1] && bj.[bi + 1] <= len tp && bj.[bi + 1] <= len to && 256 < len fl
    ensures blk_ok s fl 288 fd 30 x (bp.[bi] + 3) bo.[bi] bj.[bi] bj.[bi + 1] tp ts td to
    ensures bp.[bi + 1] = tp.[bj.[bi + 1] - 1] + fl.[256] && bo.[bi + 1] = to.[bj.[bi + 1] - 1]
  let spec blocks_from : (s : [u8]) -> (x : [u8]) -> (fl : [u8]) -> (fd : [u8]) -> (nbk : usize) -> (bp : [usize]) -> (bo : [usize]) -> (bj : [usize]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (bi : usize) -> bool
  let spec stream_ok : (s : [u8]) -> (pos : usize) -> (x : [u8]) -> (fl : [u8]) -> (fd : [u8]) -> (nbk : usize) -> (bp : [usize]) -> (bo : [usize]) -> (bj : [usize]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> bool
  let lemma blocks_step : (s : [u8]) -> (x : [u8]) -> (fl : [u8]) -> (fd : [u8]) -> (nbk : usize) -> (bp : [usize]) -> (bo : [usize]) -> (bj : [usize]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> (bi : usize) -> unit
    requires bi <= nbk && nbk < len bp && nbk < len bo && nbk < len bj
    requires blocks_from s x fl fd nbk bp bo bj tp ts td to bi
    ensures bi < nbk ==> block_ok s x fl fd nbk bp bo bj tp ts td to bi && blocks_from s x fl fd nbk bp bo bj tp ts td to (bi + 1)
    ensures bi = nbk ==> bo.[nbk] = len x
  let lemma stream_start : (s : [u8]) -> (pos : usize) -> (x : [u8]) -> (fl : [u8]) -> (fd : [u8]) -> (nbk : usize) -> (bp : [usize]) -> (bo : [usize]) -> (bj : [usize]) -> (tp : [usize]) -> (ts : [int{0..319}]) -> (td : [int{0..319}]) -> (to : [usize]) -> unit
    requires stream_ok s pos x fl fd nbk bp bo bj tp ts td to
    ensures 1 <= nbk && nbk < len bp && nbk < len bo && nbk < len bj
    ensures bp.[0] = pos && bo.[0] = 0 && bj.[0] = 0 && fixed_ok fl fd
    ensures blocks_from s x fl fd nbk bp bo bj tp ts td to 0
end

(** sym's code, in the code whose lengths are l (n symbols), is the bits
    at p of s. *)
let spec code_at (s : [u8]) (p : usize) (l : [u8]) (n : int{0..320}) (sym : int{0..319}) : bool =
  if sym >= n || n > len l || p > B.nbits s then false
  else if l.[sym] < 1 || l.[sym] > 15 || l.[sym] > B.nbits s - p then false
  else (let b : int{1..15} = l.[sym] in H.code_of l n sym = H.hbits s p b)

(** The n bytes of x from o are each the byte dist before it, one at a
    time, so a copy may read what it wrote. *)
let spec copy_ok (x : [u8]) (o : usize) (n : usize) (dist : usize) : bool @opaque =
  if dist < 1 || o > len x then false
  else if dist > o || n > len x - o then false
  else (forall (d in 0 .. n). x.[o + d] = x.[o - dist + d])

(** The rest of a length code's symbol j, from its distance code at bit
    qd: the distance code, its extra bits, and the copy of n bytes. *)
let spec dist_tail (s : [u8]) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (tp : [usize]) (td : [int{0..319}]) (to : [usize]) (j : usize) (qd : usize) (n : usize) : bool
  requires j + 1 < len tp && j + 1 < len td && j + 1 < len to && to.[j] <= to.[j + 1]
= if td.[j] > 29 || code_at s qd dl nd td.[j] = false then false
  else (
    let dc : int{0..29} = td.[j] in
    let qx : usize = qd + dl.[td.[j]] in
    let de = F.dist_extra dc in
    if qx > B.nbits s then false
    else if de > B.nbits s - qx then false
    else (
      let dist : usize = F.dist_base dc + B.bits_at s qx de in
      tp.[j + 1] = qx + de && to.[j + 1] - to.[j] = n && copy_ok x to.[j] n dist))

(** Symbol j of the trace, which is not the last, read as RFC 1951 3.2.5
    reads it: a literal writes itself, and a length code, with its extra
    bits, a distance code and its extra bits, writes a copy. The next
    symbol follows. *)
let spec blk_step (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) : bool @opaque
  requires j + 1 < len tp && j + 1 < len ts && j + 1 < len td && j + 1 < len to
= if code_at s tp.[j] ll nl ts.[j] = false then false
  else if to.[j] > to.[j + 1] || to.[j + 1] > len x then false
  else (
    let q : usize = tp.[j] + ll.[ts.[j]] in
    if ts.[j] < 256 then (if to.[j + 1] - to.[j] <> 1 then false else tp.[j + 1] = q && x.[to.[j]] = ts.[j])
    else if ts.[j] = 256 || ts.[j] > 285 || td.[j] > 29 then false
    else (
      let c : int{0..28} = ts.[j] - 257 in
      let e = F.len_extra c in
      if e > B.nbits s - q then false
      else (
        let n : usize = F.len_base c + B.bits_at s q e in
        dist_tail s dl nd x tp td to j (q + e) n)))

(** From symbol j on, the trace reads s as RFC 1951 does, up to its last
    symbol k - 1, the end code. *)
let spec blk_from (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) : bool @opaque
  requires k <= len tp && k <= len ts && k <= len td && k <= len to && j < k
  decreases k - j
= if j + 1 = k then (if code_at s tp.[j] ll nl ts.[j] = false then false else ts.[j] = 256 && to.[j] <= len x)
  else if blk_step s ll nl dl nd x tp ts td to j = false then false
  else blk_from s ll nl dl nd x k tp ts td to (j + 1)

(** x from o0 is what the Huffman block at bit p0 of s writes, with the
    literal/length code ll and the distance code dl, by the trace's
    symbols j0 to k - 1. *)
let spec blk_ok (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (p0 : usize) (o0 : usize) (j0 : usize) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) : bool @opaque =
  if k <= j0 || k > len tp || k > len ts || k > len td || k > len to then false
  else if tp.[j0] <> p0 || to.[j0] <> o0 then false
  else blk_from s ll nl dl nd x k tp ts td to j0

(** Two symbols whose codes are both at p are the same symbol. *)
let lemma at_same (s : [u8]) (p : usize) (l : [u8]) (n : int{0..320}) (a : int{0..319}) (b : int{0..319}) : unit
= H.prefix_free s p l n a b

(** Where no code is, no symbol's code is. *)
let lemma at_none (s : [u8]) (p : usize) (l : [u8]) (n : int{0..320}) (a : int{0..319}) : unit
= H.no_code s p l n a

(** copy_ok's fact for byte d of the copy. *)
let lemma copy_byte (x : [u8]) (o : usize) (n : usize) (dist : usize) (d : usize) : unit
  with copy_ok
= ()

(** blk_step's facts for any symbol that is not the last. *)
let lemma step_code (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) : unit
  with blk_step
= ()

(** blk_step's facts for a literal, with the next code's position q
    explicit. *)
let lemma step_lit (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) (q : usize) : unit
  with blk_step
= ()

(** blk_step's facts for a length code 257 + c, up to its distance code,
    with the extra bits' position q explicit. *)
let lemma step_len (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) (q : usize) (c : int{0..28}) : unit
  with blk_step
= ()

(** blk_step's facts for a length code's distance, with the
    distance's extra bits' position qx explicit. *)
let lemma step_dist (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) (q : usize) (c : int{0..28}) (qx : usize) (dc : int{0..29}) : unit
  with blk_step
= ()

(** blk_step's facts for a length code's copy, its length n and distance
    dist explicit. *)
let lemma step_copy (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) (q : usize) (c : int{0..28}) (qx : usize) (dc : int{0..29}) (n : usize) (dist : usize) : unit
  with blk_step
= ()

(** What blk_from says of symbol j, for a proof that keeps it opaque. *)
let lemma from_step (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (j : usize) : unit
  with blk_from
= ()

(** What blk_ok says, for a proof that keeps it opaque. *)
let lemma ok_start (s : [u8]) (ll : [u8]) (nl : int{1..288}) (dl : [u8]) (nd : int{1..30}) (x : [u8]) (p0 : usize) (o0 : usize) (j0 : usize) (k : usize) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) : unit
  with blk_ok
= ()

(** The first n lengths of l and m are the same. *)
let spec same_lens (l : [u8]) (m : [u8]) (n : int{0..320}) : bool @opaque =
  if n > len l || n > len m then false else (forall (i in 0 .. n). l.[i] = m.[i])

(** A code is where it is whichever buffer holds its lengths. *)
let lemma at_moved (s : [u8]) (p : usize) (l : [u8]) (m : [u8]) (n : int{0..320}) (a : int{0..319}) : unit
  with same_lens
= H.code_same l m n a

(** fl and fd are the fixed code's lengths (RFC 1951 3.2.6). *)
let spec fixed_ok (fl : [u8]) (fd : [u8]) : bool @opaque =
  if len fl < 288 || len fd < 30 then false
  else (forall (i in 0 .. 288). fl.[i] = F.fixed_length i) && (forall (i in 0 .. 30). fd.[i] = 5)

(** Buffers that hold the fixed code's lengths hold fl's and fd's. *)
let lemma fixed_same (fl : [u8]) (fd : [u8]) (lb : [u8]) (db : [u8]) : unit
  with fixed_ok, same_lens
= ()

(** The n bytes of x from o are the n bytes of s after a stored block's
    header at byte q (RFC 1951 3.2.4). *)
let spec stored_copy (s : [u8]) (q : usize) (x : [u8]) (o : usize) (n : usize) : bool @opaque =
  if q > len s then false
  else if 4 > len s - q then false
  else if n > len s - q - 4 || o > len x then false
  else if n > len x - o then false
  else (forall (d in 0 .. n). x.[o + d] = s.[q + 4 + d])

(** stored_copy's fact for byte d. *)
let lemma stored_byte (s : [u8]) (q : usize) (x : [u8]) (o : usize) (n : usize) (d : usize) : unit
  with stored_copy
= ()

(** Block bi of the stream, at bit bp.[bi], writing x from bo.[bi] to
    bo.[bi + 1]: its header, whose final bit is set on the last block
    only, then a stored block, or a block in the fixed code whose symbols
    are the trace's bj.[bi] to bj.[bi + 1] - 1 (a stored block has
    none). Dynamic blocks are not in the trace yet. *)
let spec block_ok (s : [u8]) (x : [u8]) (fl : [u8]) (fd : [u8]) (nbk : usize) (bp : [usize]) (bo : [usize]) (bj : [usize]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (bi : usize) : bool @opaque
  requires bi < nbk && nbk < len bp && nbk < len bo && nbk < len bj
= let p : usize = bp.[bi] in
  let o : usize = bo.[bi] in
  if p > B.nbits s then false
  else if 3 > B.nbits s - p then false
  else if (B.bits_at s p 1 = 1) <> (bi + 1 = nbk) then false
  else if o > bo.[bi + 1] || bo.[bi + 1] > len x then false
  else (
    let ty = B.bits_at s (p + 1) 2 in
    if ty = 0 then (
      let pb : usize = p + 3 in
      let q : usize = pb / 8 + (if pb % 8 = 0 then 0 else 1) in
      if q >= len s || len s - q < 4 then false
      else if F.stored_ok s q = false then false
      else (
        let n : usize = F.stored_len s q in
        if n > len s - q - 4 then false
        else bo.[bi + 1] - o = n && bp.[bi + 1] % 8 = 0 && bp.[bi + 1] / 8 = q + 4 + n && bj.[bi + 1] = bj.[bi] && stored_copy s q x o n))
    else if ty = 1 then (
      let j0 : usize = bj.[bi] in
      let k : usize = bj.[bi + 1] in
      if k <= j0 || k > len tp || k > len to || len fl <= 256 then false
      else if bp.[bi + 1] < tp.[k - 1] then false
      else blk_ok s fl 288 fd 30 x (p + 3) o j0 k tp ts td to && bp.[bi + 1] - tp.[k - 1] = fl.[256] && bo.[bi + 1] = to.[k - 1])
    else false)

(** block_ok's header facts. *)
let lemma block_head (s : [u8]) (x : [u8]) (fl : [u8]) (fd : [u8]) (nbk : usize) (bp : [usize]) (bo : [usize]) (bj : [usize]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (bi : usize) : unit
  with block_ok
= ()

(** block_ok's facts for a stored block, its header's byte q explicit. *)
let lemma block_stored (s : [u8]) (x : [u8]) (fl : [u8]) (fd : [u8]) (nbk : usize) (bp : [usize]) (bo : [usize]) (bj : [usize]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (bi : usize) (q : usize) : unit
  with block_ok
= ()

(** block_ok's facts for a block in the fixed code. *)
let lemma block_fixed (s : [u8]) (x : [u8]) (fl : [u8]) (fd : [u8]) (nbk : usize) (bp : [usize]) (bo : [usize]) (bj : [usize]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (bi : usize) : unit
  with block_ok
= ()

(** From block bi on, the stream's blocks are as block_ok says, up to
    its last block nbk - 1, after which x ends. *)
let spec blocks_from (s : [u8]) (x : [u8]) (fl : [u8]) (fd : [u8]) (nbk : usize) (bp : [usize]) (bo : [usize]) (bj : [usize]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (bi : usize) : bool @opaque
  requires bi <= nbk && nbk < len bp && nbk < len bo && nbk < len bj
  decreases nbk - bi
= if bi = nbk then bo.[nbk] = len x
  else if block_ok s x fl fd nbk bp bo bj tp ts td to bi = false then false
  else blocks_from s x fl fd nbk bp bo bj tp ts td to (bi + 1)

(** x is what RFC 1951 reads the deflate stream at bit pos of s as, by
    the trace of its nbk blocks and their symbols: the first block at
    pos, writing x from 0, with fl and fd the fixed code's lengths. *)
let spec stream_ok (s : [u8]) (pos : usize) (x : [u8]) (fl : [u8]) (fd : [u8]) (nbk : usize) (bp : [usize]) (bo : [usize]) (bj : [usize]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) : bool @opaque =
  if nbk < 1 || nbk >= len bp || nbk >= len bo || nbk >= len bj then false
  else if bp.[0] <> pos || bo.[0] <> 0 || bj.[0] <> 0 || fixed_ok fl fd = false then false
  else blocks_from s x fl fd nbk bp bo bj tp ts td to 0

(** What blocks_from says of block bi. *)
let lemma blocks_step (s : [u8]) (x : [u8]) (fl : [u8]) (fd : [u8]) (nbk : usize) (bp : [usize]) (bo : [usize]) (bj : [usize]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) (bi : usize) : unit
  with blocks_from
= ()

(** What stream_ok says. *)
let lemma stream_start (s : [u8]) (pos : usize) (x : [u8]) (fl : [u8]) (fd : [u8]) (nbk : usize) (bp : [usize]) (bo : [usize]) (bj : [usize]) (tp : [usize]) (ts : [int{0..319}]) (td : [int{0..319}]) (to : [usize]) : unit
  with stream_ok
= ()
