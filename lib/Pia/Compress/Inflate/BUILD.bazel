load("//tools/piac:pia.bzl", "pia_library")
load("//tools/piac:targets.bzl", "PIA_TARGETS")

# Pia.Compress.Inflate.Spec (ADR 0054, step 5): the parts of RFC 1951 a
# deflate block is made of, as spec functions; Pia.Compress.Inflate.Ref,
# what a Huffman block says, as a trace of its symbols.

package(default_visibility = ["//visibility:public"])

exports_files([
    "Ref.pia",
    "Spec.pia",
])

# tests/std/inflate.pia checks its goals.
pia_library(
    name = "spec",
    src = "Spec.pia",
    target_compatible_with = PIA_TARGETS,
)

# What a Huffman block says, as a trace spec that Inflate's codes_ref is
# proved against: tests/std/inflate.pia checks its goals.
pia_library(
    name = "ref",
    src = "Ref.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        ":spec",
        "//lib/Pia/Compress:huffman",
        "//lib/Pia/Image:bits",
    ],
)
