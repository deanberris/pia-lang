(* The interface's functions: each row's modifiers and contract, checked
   against the C declaration above it. *)

\ int open(const char *, int, ...)
let open (path : [u8]) (flags : i32) : i32 @variadic(2)
  requires len path >= 1 && path.[len path - 1] = 0
  ensures result >= -1
= extern "open"

\ int open(const char *, int, ...)
let open_mode (path : [u8]) (flags : i32) (mode : u32) : i32 @variadic(2)
  requires len path >= 1 && path.[len path - 1] = 0
  requires mode <= 4095
  ensures result >= -1
= extern "open"

\ int close(int)
let close (fd : i32) : i32
  ensures result >= -1 && result <= 0
= extern "close"

\ ssize_t read(int, void *, size_t)
let read (fd : i32) (buf : out mutable [u8]) (n : usize) : isize
  requires n <= len buf
  ensures result >= -1 && result <= n
= extern "read"

\ ssize_t write(int, const void *, size_t)
let write (fd : i32) (buf : [u8]) (n : usize) : isize
  requires n <= len buf
  ensures result >= -1 && result <= n
= extern "write"

\ ssize_t pread(int, void *, size_t, __off_t)
let pread (fd : i32) (buf : out mutable [u8]) (n : usize) (offset : i64) : isize
  requires n <= len buf && offset >= 0
  ensures result >= -1 && result <= n
= extern "pread"

\ ssize_t pwrite(int, const void *, size_t, __off_t)
let pwrite (fd : i32) (buf : [u8]) (n : usize) (offset : i64) : isize
  requires n <= len buf && offset >= 0
  ensures result >= -1 && result <= n
= extern "pwrite"

\ __off_t lseek(int, __off_t, int)
let lseek (fd : i32) (offset : i64) (whence : i32) : i64
  ensures result >= -1
= extern "lseek"

\ int fsync(int)
let fsync (fd : i32) : i32
  ensures result >= -1 && result <= 0
= extern "fsync"

\ int ftruncate(int, __off_t)
let ftruncate (fd : i32) (length : i64) : i32
  requires length >= 0
  ensures result >= -1 && result <= 0
= extern "ftruncate"

\ int unlink(const char *)
let unlink (path : [u8]) : i32
  requires len path >= 1 && path.[len path - 1] = 0
  ensures result >= -1 && result <= 0
= extern "unlink"

\ int isatty(int)
let isatty (fd : i32) : i32
  ensures result >= 0 && result <= 1
= extern "isatty"

\ int * __errno_location(void)
let errno () : i32 @deref
  ensures true
= extern "__errno_location"

(* The other functions: C's signatures, with no contract, private to this
   module until the interface gives them a row. A pointer is a byte
   buffer, and a variadic function takes only its named parameters. *)

\ int fstat(int, struct stat *)
let fstat (fd : i32) (buf : [u8]) : i32
= extern "fstat"

\ int mkdir(const char *, __mode_t)
let mkdir (path : [u8]) (mode : u32) : i32
= extern "mkdir"

\ int rmdir(const char *)
let rmdir (path : [u8]) : i32
= extern "rmdir"

\ int rename(const char *, const char *)
let rename (old_ : [u8]) (new : [u8]) : i32
= extern "rename"

\ int fcntl(int, int, ...)
let fcntl (fd : i32) (cmd : i32) : i32 @variadic(2)
= extern "fcntl"

\ int ioctl(int, unsigned long, ...)
let ioctl (fd : i32) (request : u64) : i32 @variadic(2)
= extern "ioctl"

\ int pipe(int *)
let pipe (pipedes : [u8]) : i32
= extern "pipe"

\ int dup(int)
let dup (fd : i32) : i32
= extern "dup"

\ int dup2(int, int)
let dup2 (fd : i32) (fd2 : i32) : i32
= extern "dup2"

\ __pid_t getpid(void)
let getpid () : i32
= extern "getpid"

\ int getpagesize(void)
let getpagesize () : i32
= extern "getpagesize"

\ void _exit(int) __attribute__((noreturn))
let _exit (status : i32) : unit
= extern "_exit"

\ int socket(int, int, int)
let socket (domain : i32) (type_ : i32) (protocol : i32) : i32
= extern "socket"

\ int socketpair(int, int, int, int *)
