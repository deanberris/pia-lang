load("//tools/piac:pia.bzl", "pia_library")
load("//tools/piac:targets.bzl", "PIA_TARGETS")

# Pia.Fn: the laws of function arguments (ADR 0044, section 5), exported as
# generic spec functions with their definitions.

package(default_visibility = ["//visibility:public"])

exports_files([
    "Fn.pia",
    "Gpu.pia",
    "Math.pia",
    "Par.pia",
    "Time.pia",
])

pia_library(
    name = "fn",
    src = "Fn.pia",
    target_compatible_with = PIA_TARGETS,
)

# Pia.Math (#487): sqrt, proved correctly rounded over the bits and
# lowered to math.sqrt (ADR 0078). tests/std/math.pia checks its goals and
# lowering; tests/std:math_sqrt_test runs it against C's sqrtf.
pia_library(
    name = "math",
    src = "Math.pia",
    target_compatible_with = PIA_TARGETS,
)

# Pia.Par (ADR 0086): the collectives of a spread, as @collective
# functions over every iteration's argument; tests/std/par.pia proves them
# and an importer's spreads.
pia_library(
    name = "par",
    src = "Par.pia",
    target_compatible_with = PIA_TARGETS,
)

# <chrono>'s durations, as metaprograms over Pia.Core.Ratio that importers
# run, and the civil calendar: tests/std/time.pia checks its goals and
# interfaces; tests/std/time_edges.pia and :time_run make and prove the
# standard durations in an importer; tests/std/calendar_edges.pia and
# :calendar_run use the calendar.
pia_library(
    name = "time",
    src = "Time.pia",
    target_compatible_with = PIA_TARGETS,
    deps = ["//lib/Pia/Core:ratio"],
)

# Pia.Gpu (ADR 0068): devices, buffers, libraries and synchronous dispatch,
# over the Metal shim in //src/runtime/metal, whose calls it declares as
# trusted externs. A program that uses it links that shim.
pia_library(
    name = "gpu",
    src = "Gpu.pia",
    target_compatible_with = PIA_TARGETS,
)
