load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/piac:pia.bzl", "pia_library", "pia_object")
load("//tools/piac:targets.bzl", "APPLE_SILICON", "PIA_TARGETS")

# The stream delineation demo. The program is the literate pages
# docs/streams.pia.md and docs/sediment.pia.md, which are also its documentation; main.c reads and
# writes images around it with macOS's ImageIO, because Pia has no I/O yet.
#
#   bazel run //examples/streams                     # a synthetic terrain
#   bazel run //examples/streams -- in.png out.png [threshold]
#   bazel run //examples/streams:srtm -- tile.hgt out.png   # an SRTM tile
#
# examples/streams/fetch_srtm.sh downloads a tile; it is not checked in.
#
# The Pia program and its C test build on every platform piac compiles for
# (ADR 0049). The demo binary needs ImageIO, so it is Apple silicon only.

# Every goal in the page must be proved, or piac refuses to compile it.
pia_object(
    name = "streams_obj",
    src = "//docs:streams.pia.md",
    target_compatible_with = PIA_TARGETS,
)

# Sediment transport is its own page and module, proved in parallel.
pia_object(
    name = "sediment_obj",
    src = "//docs:sediment.pia.md",
    target_compatible_with = PIA_TARGETS,
)

# The animated GIF of the evolving landscape: a C entry point for the
# proved encoder of Pia.Image.Gif.Encode (ADR 0054).
pia_library(
    name = "gif",
    src = "gif.pia",
    target_compatible_with = PIA_TARGETS,
    deps = [
        "//lib/Pia/Image:bits",
        "//lib/Pia/Image:raster",
        "//lib/Pia/Image/Gif:decode",
        "//lib/Pia/Image/Gif:encode",
        "//lib/Pia/Image/Gif:lzw",
        "//lib/Pia/Image/Gif:lzw_encode",
        "//lib/Pia/Image/Gif:spec",
    ],
)

# Sediment by basin, a spread over the basins (ADR 0060).
pia_object(
    name = "basins_obj",
    src = "//docs:basins.pia.md",
    target_compatible_with = PIA_TARGETS,
)

# Sediment in pull form, waves of a spread, proved equal to the sequential
# step (docs/pull.pia.md).
pia_object(
    name = "pull_obj",
    src = "//docs:pull.pia.md",
    target_compatible_with = PIA_TARGETS,
)

cc_library(
    name = "streams_pia",
    srcs = [":basins_obj", ":gif", ":pull_obj", ":sediment_obj", ":streams_obj"],
    hdrs = ["pia_streams.h"],
    target_compatible_with = PIA_TARGETS,
)

# Image and file I/O for the two programs, with ImageIO.
cc_library(
    name = "demo_io",
    srcs = ["demo_io.c"],
    hdrs = ["demo_io.h"],
    linkopts = [
        "-framework",
        "ApplicationServices",
        "-framework",
        "ImageIO",
        "-framework",
        "CoreFoundation",
    ],
    target_compatible_with = APPLE_SILICON,
)

cc_binary(
    name = "streams",
    srcs = ["main.c"],
    linkopts = [
        "-framework",
        "ApplicationServices",
        "-framework",
        "ImageIO",
        "-framework",
        "CoreFoundation",
    ],
    target_compatible_with = APPLE_SILICON,
    deps = [
        ":demo_io",
        ":streams_pia",
        "@llvm-project//mlir:mlir_async_runtime",
    ],
)

# The pipeline on a real SRTM tile, timed stage by stage.
cc_binary(
    name = "srtm",
    srcs = ["srtm.c"],
    target_compatible_with = APPLE_SILICON,
    deps = [
        ":demo_io",
        ":streams_pia",
        "@llvm-project//mlir:mlir_async_runtime",
    ],
)

cc_test(
    name = "streams_test",
    srcs = ["streams_test.c"],
    target_compatible_with = PIA_TARGETS,
    deps = [":streams_pia"],
)

# The demo itself runs too: it draws the terrain and writes both images.
sh_test(
    name = "streams_run_test",
    srcs = ["streams_run_test.sh"],
    args = ["$(rootpath :streams)"],
    data = [":streams"],
    target_compatible_with = APPLE_SILICON,
)

# The SRTM program on a 256 x 256 crop of a real tile (testdata/README.md).
sh_test(
    name = "srtm_run_test",
    srcs = ["srtm_run_test.sh"],
    args = [
        "$(rootpath :srtm)",
        "$(rootpath testdata/N46E008_crop256.hgt)",
    ],
    data = [
        "testdata/N46E008_crop256.hgt",
        ":srtm",
    ],
    target_compatible_with = APPLE_SILICON,
)

# D8 directions and the picture on the GPU (docs/placed.pia.md, ADR 0068,
# step 3). piac compiles the placed spreads with Xcode's Metal toolchain,
# outside the sandbox, so this needs a Mac with it installed.
pia_object(
    name = "placed_obj",
    src = "//docs:placed.pia.md",
    tags = [
        "no-sandbox",
        "requires-metal",
    ],
    target_compatible_with = APPLE_SILICON,
)

cc_binary(
    name = "srtm_gpu",
    srcs = [
        "srtm_gpu.c",
        ":placed_obj",
    ],
    tags = ["requires-metal"],
    target_compatible_with = APPLE_SILICON,
    deps = [
        ":demo_io",
        ":streams_pia",
        "//src/runtime/metal",
        "@llvm-project//mlir:mlir_async_runtime",
    ],
)

# The GPU against the CPU on the crop of testdata/README.md. The whole tile
# is a manual run: bazel run //examples/streams:srtm_gpu -- N46E008.hgt.
sh_test(
    name = "srtm_gpu_run_test",
    srcs = ["srtm_gpu_run_test.sh"],
    args = [
        "$(rootpath :srtm_gpu)",
        "$(rootpath testdata/N46E008_crop256.hgt)",
    ],
    data = [
        "testdata/N46E008_crop256.hgt",
        ":srtm_gpu",
    ],
    tags = [
        "requires-gpu",
        "requires-metal",
    ],
    target_compatible_with = APPLE_SILICON,
)
